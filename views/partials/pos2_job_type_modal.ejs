<!-- POS-2 Modal: Select Service (Single-Click Parent Grid Layout) -->
<div class="modal fade" id="pos2JobTypeModal" tabindex="-1" aria-labelledby="pos2JobTypeModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-sm-down" role="document">
    <div class="modal-content border-0 shadow-lg rounded-3">
      <!-- Modal Header -->
      <div class="modal-header border-bottom py-3 px-4 d-flex align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2">
          <span class="d-inline-flex align-items-center justify-content-center rounded-circle text-primary bg-primary-subtle flex-shrink-0" style="width: 34px; height: 34px;">
            <i class="fa fa-sitemap"></i>
          </span>
          <div>
            <h5 class="modal-title fw-bold mb-0" id="pos2JobTypeModalLabel">Select Service</h5>
            <small class="text-muted d-none d-sm-block">Click any service below to start ordering</small>
          </div>
        </div>
        <button type="button" class="btn-close d-none" id="btnPos2JobTypeModalClose" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body px-4 py-3">
        <% if (typeof showStoreSelect !== 'undefined' && showStoreSelect) { %>
        <!-- Store Selector inside Modal (Master Admin) -->
        <div class="mb-3">
          <label class="form-label fw-bold small mb-1" for="pos2ModalStoreSelect">
            <i class="fa fa-store text-primary me-1"></i>
            Select Store <span class="text-danger">*</span>
          </label>
          <select class="form-select form-select-sm" id="pos2ModalStoreSelect">
            <option value="0" <%= (!cart.store_id || cart.store_id == 0) ? 'selected' : '' %> disabled>Choose a store to view its Services...</option>
            <% (storeList || []).forEach(function(st) { %>
            <option value="<%= st.id %>" <%= (String(cart.store_id) === String(st.id)) ? 'selected' : '' %>><%= st.name %></option>
            <% }); %>
          </select>
        </div>
        <% } %>

        <!-- Parent Services Grid (Single-Click Immediate Selection) -->
        <section id="pos2ParentSection" class="pos2-jt-section">
          <div id="pos2ParentSliderTrack" class="pos2-jt-parent-grid" role="listbox" aria-label="Services">
            <div class="text-center py-4 text-muted w-100">
              <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
              <span>Loading services...</span>
            </div>
          </div>
        </section>
      </div>

      <!-- Modal Footer -->
      <div class="modal-footer border-top py-2.5 px-4 d-flex justify-content-end align-items-center">
        <a href="/index" class="btn btn-sm btn-outline-secondary" id="btnPos2JobTypeCancel">
          <i class="fa fa-times me-1"></i>
          <span>Cancel</span>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- POS-2 Modal: Confirm Clear Cart Before Switching Service -->
<div class="modal fade" id="pos2SwitchJobTypeConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content border-0 shadow-lg rounded-3">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
          <span class="d-inline-flex align-items-center justify-content-center rounded-circle text-warning bg-warning-subtle" style="width: 34px; height: 34px;">
            <i class="fas fa-exchange-alt"></i>
          </span>
          <span>Switch Service?</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <p class="mb-2">
          Your cart currently has items from <strong id="pos2SwitchCurrentJtName"></strong>.
        </p>
        <div class="alert alert-warning py-2 px-3 small mb-0">
          <i class="fas fa-exclamation-triangle me-1"></i>
          Switching to a different Service will clear the items currently in this cart so each order uses a single Service.
        </div>
      </div>
      <div class="modal-footer border-top">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
          Keep Current Order
        </button>
        <button type="button" class="btn btn-sm btn-warning fw-semibold" id="btnPos2ConfirmClearAndSwitch">
          <i class="fa fa-trash-alt me-1"></i>Clear Cart &amp; Switch
        </button>
      </div>
    </div>
  </div>
</div>
