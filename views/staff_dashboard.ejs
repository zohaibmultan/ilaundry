<!DOCTYPE html>
<html>

<head>
    <!-- meta and links start -->
    <%- include('templet/meta') -%>
</head>

<body>
    <%- include('templet/preloder_topbar_sidebar', { titel: accessdata?.topbardata?.name || 'Staff Dashboard' }) -%>
    
    <!-- Content body start -->
    <div class="content-body">
        <div class="container-fluid" style="min-height: 100vh;">
            <div class="row">
                <div class="d-none">
                    <input type="hidden" name="sym" value="<%= accessdata?.symbol || '$' %>">
                    <input type="hidden" id="currencySymbol" value="<%= accessdata?.masterstore?.currency_symbol || accessdata?.symbol || '$' %>">
                </div>

                <!-- 1. Staff Greeting & Quick Action Header -->
                <div class="col-12 mb-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-4 bg-primary bg-opacity-10 text-white p-3 d-inline-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                                        <i class="fas fa-id-badge fs-3"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                            <h2 class="fw-bold text-dark mb-0 fs-4">
                                                <%= language.Welcome_back || 'Welcome back' %>, <%= accessdata?.topbardata?.name || 'Staff' %>!
                                            </h2>
                                            <span class="badge bg-primary bg-opacity-10 text-white rounded-pill px-3 py-1 fs-12 fw-semibold">
                                                <i class="fas fa-user-tag me-1"></i>
                                                <%= (roll && roll.roll) ? roll.roll : (language.Staff || 'Staff Member') %>
                                            </span>
                                            <% if (typeof storeName !== 'undefined' && storeName) { %>
                                                <span class="badge bg-light text-dark border rounded-pill px-3 py-1 fs-12 fw-semibold">
                                                    <i class="fas fa-store text-primary me-1"></i>
                                                    <%= storeName %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <p class="text-muted mb-0 fs-13">
                                            <%= language.Staff_Dashboard_Subtitle || 'Track your personal daily performance, order bookings, and sales revenue.' %>
                                        </p>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <% if (typeof canAccessPos !== 'undefined' && canAccessPos) { %>
                                        <a href="/admin/pos" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm d-inline-flex align-items-center gap-2">
                                            <i class="fas fa-cash-register"></i>
                                            <span><%= language.POS_Screen || 'Open POS Screen' %></span>
                                        </a>
                                    <% } %>
                                    <% if (typeof canReadOrders !== 'undefined' && canReadOrders) { %>
                                        <a href="/order/list" class="btn btn-outline-secondary px-3 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2">
                                            <i class="fas fa-boxes"></i>
                                            <span><%= language.Orders || 'Orders' %></span>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Staff Personal KPI Counter Cards -->
                <% const showOrdersCard = (typeof canReadOrders === 'undefined' || canReadOrders); %>
                <% const showReportsCard = (typeof canReadReports === 'undefined' || canReadReports); %>
                <% const colClass = (showOrdersCard && showReportsCard) ? 'col-12 col-md-6' : 'col-12'; %>

                <% if (showOrdersCard) { %>
                    <!-- Total Orders Created by Staff -->
                    <div class="<%= colClass %> mb-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fas fa-shopping-bag fs-4"></i>
                                    </div>
                                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1 fs-11">
                                        <i class="fas fa-check-circle text-success me-1"></i><%= language.Active_Volume || 'Active Volume' %>
                                    </span>
                                </div>
                                <h3 class="display-6 fw-bold text-dark mb-1" id="stat-orders">
                                    <%= Number(data?.totalorder || 0).toLocaleString('en-US') %>
                                </h3>
                                <div class="text-dark fw-semibold fs-14 mb-1">
                                    <%= language.Total_Orders || 'Total Orders Created by You' %>
                                </div>
                                <small class="text-muted fs-12">
                                    <%= language.Staff_Orders_Note || 'Lifetime valid customer orders booked under your login' %>
                                </small>
                            </div>
                        </div>
                    </div>
                <% } %>

                <% if (showReportsCard) { %>
                    <!-- Total Sales Generated by Staff -->
                    <div class="<%= colClass %> mb-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="rounded-3 bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fas fa-wallet fs-4"></i>
                                    </div>
                                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1 fs-11">
                                        <i class="fas fa-arrow-up text-success me-1"></i><%= language.Gross_Revenue || 'Gross Revenue' %>
                                    </span>
                                </div>
                                <h3 class="display-6 fw-bold text-success mb-1" id="stat-sales">
                                    <%= accessdata?.masterstore?.currency_symbol || accessdata?.symbol || '$' %> <%= Number(data?.tottalsales || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                </h3>
                                <div class="text-dark fw-semibold fs-14 mb-1">
                                    <%= language.Total_Sales || 'Total Sales Revenue Generated' %>
                                </div>
                                <small class="text-muted fs-12">
                                    <%= language.Staff_Sales_Note || 'Accumulated order value from bookings created by you' %>
                                </small>
                            </div>
                        </div>
                    </div>
                <% } %>

                <!-- 3. Recent Orders Created by Staff -->
                <% if (typeof canReadOrders === 'undefined' || canReadOrders) { %>
                    <div class="col-12 mb-4">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <i class="fas fa-history"></i>
                                    </div>
                                    <div>
                                        <h4 class="card-title mb-0 fw-bold text-dark fs-6">
                                            <%= language.Recent_Order || 'My Recent Orders' %> (Top 10)
                                        </h4>
                                        <small class="text-muted fs-12">
                                            <%= language.Staff_Recent_Orders_Subtitle || 'Live list of the most recent bookings created under your account' %>
                                        </small>
                                    </div>
                                </div>
                                <% if (typeof canAccessPos !== 'undefined' && canAccessPos) { %>
                                    <a href="/admin" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1">
                                        <i class="fas fa-plus"></i>
                                        <span><%= language.New_Order || 'New Order' %></span>
                                    </a>
                                <% } %>
                            </div>
                            <div class="card-body p-0">
                                <% if (recentOrder && recentOrder.length > 0) { %>
                                    <div class="table-responsive">
                                        <table class="table verticle-middle table-responsive-md mb-0">
                                            <thead>
                                                <tr>
                                                    <th scope="col" class="ps-4">
                                                        <%= language.Order_Info || 'Order Info' %>
                                                    </th>
                                                    <th scope="col">
                                                        <%= language.Customer || language.Customers || 'Customer' %>
                                                    </th>
                                                    <th scope="col">
                                                        <%= language.Order_Amount || 'Order Amount' %>
                                                    </th>
                                                    <th scope="col">
                                                        <%= language.Status || 'Status' %>
                                                    </th>
                                                    <th scope="col">
                                                        <%= language.Payment || language.Payment_Amount || 'Payment' %>
                                                    </th>
                                                    <th scope="col" class="text-center pe-4" style="width: 170px;">
                                                        <%= language.Action || 'Action' %>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% recentOrder.forEach(function(order) { %>
                                                    <tr>
                                                        <td class="ps-4">
                                                            <div class="server-dt-primary-text mb-1">
                                                                <a href="/order/view/<%= order.id %>" class="me-1 fw-bold text-primary"><%= order.order_id || '' %></a>
                                                            </div>
                                                            <% if (order.order_type) { %>
                                                                <div class="mb-1">
                                                                    <span class="badge bg-light text-dark border py-1 px-2 text-wrap d-inline-block mt-1" style="font-size: 0.72rem; line-height: 1.1;">
                                                                        <%= order.order_type %>
                                                                    </span>
                                                                </div>
                                                            <% } %>
                                                            <% if (order.isZeroItemOrder) { %>
                                                                <div class="mb-1">
                                                                    <span class="badge bg-warning-subtle text-dark border border-warning py-0 px-1 text-wrap d-inline-block mt-1" style="font-size: 0.68rem; line-height: 1.1;">
                                                                        0 Items (Pending Intake)
                                                                    </span>
                                                                </div>
                                                            <% } %>
                                                            <div class="server-dt-secondary-text mb-0">
                                                                <span class="me-1 opacity-75"><%= language.Order_Date || 'Order Date' %>:</span>
                                                                <span><%= order.formattedOrderDate || '' %></span>
                                                            </div>
                                                            <% 
                                                                var hasPickup = (order.order_type === 'Route & Counter' || order.order_type === 'Route & Route' || order.order_type === 'R & C' || order.order_type === 'R & R' || order.order_type === 'Pick-up & Counter' || order.order_type === 'Pick-up & Delivery' || order.order_type === 'Store collection & Store delivery' || order.order_type === 'Store collection & Customer pick-up');
                                                                var hasDelivery = (order.order_type === 'Counter & Route' || order.order_type === 'Route & Route' || order.order_type === 'C & R' || order.order_type === 'R & R' || order.order_type === 'Counter & Delivery' || order.order_type === 'Pick-up & Delivery' || order.order_type === 'Customer drop-off & Store delivery' || order.order_type === 'Store collection & Store delivery');
                                                                var readyDateVal = order.formattedReadyDate || order.formattedDeliveryDate || '';
                                                            %>
                                                            <% if (hasPickup && order.formattedPickupDate) { %>
                                                                <div class="server-dt-secondary-text mb-0">
                                                                    <span class="me-1 opacity-75"><%= language.Pickup_Date || 'Pick-up' %>:</span>
                                                                    <span><%= order.formattedPickupDate %></span>
                                                                </div>
                                                            <% } %>
                                                            <div class="server-dt-secondary-text mb-0">
                                                                <span class="me-1 opacity-75 fw-semibold text-success"><%= language.Ready_Schedule || 'Ready' %>:</span>
                                                                <span class="fw-semibold"><%= readyDateVal %></span>
                                                            </div>
                                                            <% if (hasDelivery && order.formattedDeliveryDate) { %>
                                                                <div class="server-dt-secondary-text mb-0">
                                                                    <span class="me-1 opacity-75"><%= language.Delivery_Date || 'Delivery' %>:</span>
                                                                    <span><%= order.formattedDeliveryDate %></span>
                                                                </div>
                                                            <% } %>
                                                        </td>

                                                        <td>
                                                            <div class="server-dt-primary-text"><%= order.customer_name || order.customer || 'Walk In Customer' %></div>
                                                            <% if (order.customer_number) { %>
                                                                <div class="server-dt-secondary-text">
                                                                    <i class="fa fa-phone me-1 opacity-50"></i><%= order.customer_number %>
                                                                </div>
                                                            <% } %>
                                                        </td>
                                                        <td class="symbol font-w600">
                                                            <%= parseFloat(order.gross_total || 0).toFixed(2) %>
                                                        </td>
                                                        <td>
                                                            <span class="badge-status-pill <%= order.statusClass %>">
                                                                <%= order.orderStatusName || order.status || 'Pending' %>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <% 
                                                                var gross = parseFloat(order.gross_total || 0).toFixed(2);
                                                                var paid = parseFloat(order.paid_amount || 0).toFixed(2);
                                                                var balance = parseFloat(order.balance_amount !== undefined ? order.balance_amount : (order.gross_total - order.paid_amount));
                                                            %>
                                                            <div class="server-dt-secondary-text mb-1">
                                                                <span class="me-1">Total:</span><span class="symbol fw-bold"><%= gross %></span>
                                                                | <span class="me-1">Paid:</span><span class="symbol text-success"><%= paid %></span>
                                                            </div>
                                                            <div>
                                                                <% if (balance > 0.001) { %>
                                                                    <% if (accessdata?.logas === 'custmor') { %>
                                                                        <span class="badge badge-warning light btn-xxs"><%= language.Pending || 'Pending' %></span>
                                                                    <% } else { %>
                                                                        <button type="button" onclick="open_patment_model('<%= order.id %>')" class="btn btn-xs btn-outline-success py-1 px-2">
                                                                            <i class="fa fa-plus-circle me-1"></i> <%= language.Add_Payment || 'Add Payment' %>
                                                                        </button>
                                                                    <% } %>
                                                                <% } else { %>
                                                                    <span class="badge badge-dark light btn-xxs"><%= language.Fully_Paid || 'Fully Paid' %></span>
                                                                <% } %>
                                                            </div>
                                                        </td>
                                                        <td class="text-center pe-4">
                                                            <div class="server-dt-actions justify-content-center">
                                                                <% if (accessdata?.logas === 'custmor') { %>
                                                                    <a href="/order/view/<%= order.id %>" class="btn-dt-action btn-view" title="<%= language.View || 'View' %>">
                                                                        <i class="fa fa-eye"></i>
                                                                    </a>
                                                                <% } else { %>
                                                                    <% if (order.order_status != 6 && order.canEdit) { %>
                                                                        <a href="/admin/edit/<%= order.id %>" class="btn-dt-action btn-edit" title="<%= language.Edit || 'Edit' %>">
                                                                            <i class="fas fa-pencil-alt"></i>
                                                                        </a>
                                                                    <% } %>
                                                                    <a href="/order/view/<%= order.id %>" class="btn-dt-action btn-view" title="<%= language.View || 'View' %>">
                                                                        <i class="fa fa-eye"></i>
                                                                    </a>
                                                                    <button type="button" class="btn-dt-action btn-print" id="print_barcode" data-bs-toggle="modal" data-bs-target="#exampleModalLong" data-id="<%= order.id %>" title="<%= language.Barcode || 'Barcode' %>">
                                                                        <i class="fa fa-barcode"></i>
                                                                    </button>
                                                                    <a href="/order/pos_invoice/<%= order.id %>" class="btn-dt-action btn-print" target="_blank" title="POS Thermal Invoice">
                                                                        <i class="fa fa-receipt"></i>
                                                                    </a>
                                                                    <% if (order.canDelete) { %>
                                                                        <button type="button" class="btn-dt-action btn-delete" data-bs-toggle="modal" data-bs-target="#deleteOrderModal" data-id="<%= order.id %>" data-orderid="<%= order.order_id %>" title="<%= language.Delete || 'Delete' %>">
                                                                            <i class="fa fa-trash"></i>
                                                                        </button>
                                                                    <% } %>
                                                                <% } %>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <div class="text-center py-5 px-4">
                                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                                            <i class="fas fa-clipboard-list text-muted fs-3"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-1"><%= language.No_Orders_Found || 'No Orders Created Yet' %></h5>
                                        <p class="text-muted fs-13 mb-3">You have not created any customer orders yet. Use the POS screen to place your first booking.</p>
                                        <% if (typeof canAccessPos !== 'undefined' && canAccessPos) { %>
                                            <a href="/admin" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                                                <i class="fas fa-plus me-1"></i> <%= language.Create_First_Order || 'Create First Order' %>
                                            </a>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <!-- Content body end -->

    <!-- Modal add Payment -->
    <div class="modal fade" id="addpaymentmodel1">
        <div class="modal-dialog modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <%= language.Payment || 'Add Payment' %>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body" id="orderlistpaymentmodel">
                    <form id="add_order_payment" method="post" class="need-validation">
                        <div class="row g-2 align-items-center">
                            <div class="col-12">
                                <div class="row mb-50 align-items-center">
                                    <div class="col text-sm">
                                        <%= language.Customer_Name || 'Customer Name' %> :
                                    </div>
                                    <div class="col-auto text-sm"></div>
                                </div>

                                <div class="row mb-50 align-items-center">
                                    <div class="col text-sm">
                                        <%= language.Order_ID || 'Order ID' %> :
                                    </div>
                                    <div class="col-auto text-sm"></div>
                                </div>

                                <div class="row mb-50 align-items-center">
                                    <div class="col text-sm">
                                        <%= language.Order_Date || 'Order Date' %> :
                                    </div>
                                    <div class="col-auto text-sm"></div>
                                </div>

                                <div class="row mb-50 align-items-center">
                                    <div class="col text-sm">
                                        <%= language.Delivery_Date || 'Delivery Date' %> :
                                    </div>
                                    <div class="col-auto text-sm"></div>
                                </div>

                                <hr>

                                <div class="row mb-50 align-items-center">
                                    <div class="col text-sm">
                                        <%= language.Order_Amount || 'Order Amount' %> :
                                    </div>
                                    <div class="col-auto text-sm"></div>
                                </div>

                                <div class="row mb-50 align-items-center">
                                    <div class="col text-sm">
                                        <%= language.Paid_Amount || 'Paid Amount' %> :
                                    </div>
                                    <div class="col-auto text-sm"></div>
                                </div>

                                <hr>

                                <div class="row align-items-center">
                                    <div class="col text-sm">
                                        <%= language.Balance || 'Balance' %> :
                                    </div>
                                    <div class="col-auto text-sm"></div>
                                </div>

                                <hr>

                                <div class="row align-items-center">
                                    <div class="col-md-6 mb-1">
                                        <label class="form-label">
                                            <%= language.Paid_Amount || 'Paid Amount' %>
                                        </label>
                                        <input type="number" class="form-control" name="paid" id="paid"
                                            placeholder="Enter Amount">
                                    </div>
                                    <div class="col-md-6 mb-1">
                                        <label class="form-label">
                                            <%= language.Payment_Type || 'Payment Type' %>
                                        </label>
                                        <select class="form-control wide" name="payment" id="payment">
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                    </button>
                    <button type="submit" value="submit" class="btn btn-primary" id="add_order_payment_submit">
                        <i class="fa fa-save me-2"></i><%= language.Save || 'Save' %>
                    </button>
                </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Barcode Modal -->
    <div class="modal fade" id="exampleModalLong">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <%= language.Barcode || 'Barcode' %>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center" id="add_barcode"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-info" id="print_label" data-bs-dismiss="modal">
                        <i class="fa fa-print me-2"></i><%= language.Print_Barcode || 'Print Barcode' %>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Order Confirmation Modal -->
    <div class="modal fade" id="deleteOrderModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content text-center p-3" style="border-radius: 16px;">
                <div class="modal-body pt-4">
                    <div class="mb-3">
                        <div
                            style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
                            <i class="fa fa-exclamation-triangle"></i>
                        </div>
                    </div>
                    <h4 class="mb-2 fw-bold text-dark">
                        <%= language.Delete_Order || 'Delete Order' %>
                    </h4>
                    <p class="text-muted mb-1">
                        <%= language.Are_you_sure_delete || 'Are you sure you want to delete this order?' %>
                    </p>
                    <p class="fw-bold text-danger fs-5 mb-3" id="deleteOrderModalCode"></p>
                    <p class="text-xs text-muted mb-4">
                        <%= language.Action_cannot_be_undone
                            || 'This action will remove the order, related payments, and ledger transactions permanently.'
                            %>
                    </p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                        </button>
                        <a href="#" id="deleteOrderConfirmBtn" class="btn btn-danger">
                            <i class="fa fa-trash me-2"></i>
                            <%= language.Delete || 'Yes, Delete' %>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer start -->
    <%- include('templet/footer') -%>
    <!-- Footer end -->

    <!-- Scripts -->
    <%- include('templet/script') -%>
    <script>
        $('#addpaymentmodel1').on('shown.bs.modal', function () {
            $('#payment').select2({
                dropdownParent: $('#addpaymentmodel1'),
                placeholder: 'Select Account',
                width: '100%',
                allowClear: true
            });
        });

        $(document).on('click', '.btn-dt-action.btn-delete[data-bs-target="#deleteOrderModal"]', function () {
            const orderId = $(this).attr('data-id');
            const orderCode = $(this).attr('data-orderid');
            $('#deleteOrderModalCode').text(orderCode || ('#' + orderId));
            $('#deleteOrderConfirmBtn').attr('href', '/order/delete/' + orderId);
        });

        (function () {
            function updateStaffMetrics(d) {
                var ordersEl = document.getElementById('stat-orders');
                var salesEl = document.getElementById('stat-sales');
                var currencySymbol = (document.getElementById('currencySymbol') && document.getElementById('currencySymbol').value) || '$';

                if (ordersEl && typeof d.totalorder !== 'undefined') {
                    ordersEl.textContent = Number(d.totalorder || 0).toLocaleString('en-US');
                }

                if (salesEl && typeof d.tottalsales !== 'undefined') {
                    salesEl.textContent = currencySymbol + ' ' + Number(d.tottalsales || 0).toLocaleString('en-US', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                }
            }

            function refreshStaffStats() {
                fetch('/api/dashboard-stats')
                    .then(function (res) { return res.json(); })
                    .then(function (result) {
                        if (result && result.success && result.data) {
                            updateStaffMetrics(result.data);
                        }
                    })
                    .catch(function (err) {
                        console.warn('Live staff stats refresh error:', err);
                    });
            }

            // Auto-refresh staff stats every 30 seconds
            setInterval(refreshStaffStats, 30000);
        })();
    </script>
</body>

</html>
