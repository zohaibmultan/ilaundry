<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>
</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                        <i class="fa fa-shopping-bag text-primary me-2"></i><%= language.Order_List %>
                                    </h3>
                                    <small class="text-muted"><%= language.Order_List_Subtitle || 'Track customer laundry orders, processing stages, and delivery status' %></small>
                                </div>
                                <div>
                                    <a href="/admin/pos" class="btn btn-sm btn-primary">
                                        <i class="fa fa-plus me-2"></i>
                                        <%= language.Add_New_Orders %>
                                    </a>
                                </div>
                            </div>
                            <div class="d-none">
                                <input type="hiden" name="sym" value="<%= accessdata.symbol %>">
                                <input type="hiden" name="pls" value="<%= accessdata.plac %>">
                                <input type="hiden" name="thousands_separator"
                                    value="<%= accessdata.thousands_separator %>">
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-2 mb-3">
                                    <div class="<%= (login==='master' && typeof storeList !=='undefined' && storeList.length > 0) ? 'col-12 col-md-4 col-lg-3' : 'col-12 col-md-5 col-lg-4' %>">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                            <input type="text" class="form-control" id="order_search_input"
                                                placeholder="<%= language.Search || 'Search by Order ID, Customer, Phone, Store, Ref...' %>">
                                        </div>
                                    </div>
                                    <div class="<%= (login==='master' && typeof storeList !=='undefined' && storeList.length > 0) ? 'col-6 col-sm-6 col-md-4 col-lg-2' : 'col-6 col-sm-6 col-md-3 col-lg-2' %>">
                                        <select class="form-select" id="order_status_filter">
                                            <option value="" selected><%= language.All_Orders || 'All Statuses' %></option>
                                            <% Ordersatus.forEach(function (data){ %>
                                                <option value="<%= data.id %>"><%= data.status %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <% if (login==='master' && typeof storeList !=='undefined' && storeList.length > 0) { %>
                                        <div class="col-6 col-sm-6 col-md-4 col-lg-2">
                                            <select class="form-select" id="order_store_filter">
                                                <option value="" selected><%= language.All_Stores || 'All Stores' %></option>
                                                <% storeList.forEach(function (st){ %>
                                                    <option value="<%= st.id %>"><%= st.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    <% } %>
                                    <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                        <input type="date" class="form-control" id="order_start_date" title="Start Date">
                                    </div>
                                    <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                                        <input type="date" class="form-control" id="order_end_date" title="End Date">
                                    </div>
                                    <div class="<%= (login==='master' && typeof storeList !=='undefined' && storeList.length > 0) ? 'col-12 col-sm-4 col-md-2 col-lg-1' : 'col-12 col-sm-4 col-md-3 col-lg-2' %>">
                                        <select class="form-select" id="order_page_length">
                                            <option value="10" selected>10 / page</option>
                                            <option value="25">25 / page</option>
                                            <option value="50">50 / page</option>
                                            <option value="100">100 / page</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="server-datatable-wrapper">
                                    <div class="table-responsive">
                                        <table id="server_order_table" class="table display w-100">
                                            <thead>
                                                <tr>
                                                    <th>
                                                        <%= language.Order_Info || 'Order Info' %>
                                                    </th>
                                                    <th>
                                                        <%= language.Customer || 'Customer' %>
                                                    </th>
                                                    <th>
                                                        <%= language.Order_Amount || 'Order Amount' %>
                                                    </th>
                                                    <th>
                                                        <%= language.Status || 'Status' %>
                                                    </th>
                                                    <th>
                                                        <%= language.Payment || 'Payment' %>
                                                    </th>
                                                    <th
                                                        class="<%= ((typeof isStaff !== 'undefined' && isStaff) || login !== 'master') ? 'd-none' : '' %>">
                                                        <%= language.Store_Name || 'Store Name' %>
                                                    </th>
                                                    <th class="text-center" style="width: 170px;">
                                                        <%= language.Action || 'Action' %>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <!--********** Content body end **********-->

        <!-- Modal add Payment -->
        <div class="modal fade" id="addpaymentmodel1">
            <div class="modal-dialog  modal-dialog-scrollable" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Edit_Service_Type %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body" id="orderlistpaymentmodel">
                        <form id="add_order_payment" method="post" class="need-validation">
                            <div class="row g-2 align-items-center">
                                <div class=" col-12">

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Customer_Name %> :
                                        </div>
                                        <div class="col-auto text-sm">saitest</div>
                                    </div>

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Order_ID %> :
                                        </div>
                                        <div class="col-auto text-sm">ORD-2169</div>
                                    </div>

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Order_Date %> :
                                        </div>
                                        <div class="col-auto text-sm">07/01/2023</div>
                                    </div>

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Delivery_Date %> :
                                        </div>
                                        <div class="col-auto text-sm">07/01/2023</div>
                                    </div>

                                    <hr>

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Order_Amount %> :
                                        </div>
                                        <div class="col-auto text-sm"></div>
                                    </div>

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Paid_Amount %> :
                                        </div>
                                        <div class="col-auto text-sm"></div>
                                    </div>

                                    <hr>

                                    <div class="row align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Balance %> :
                                        </div>
                                        <div class="col-auto text-sm"></div>
                                    </div>

                                    <hr>

                                    <div class="row align-items-center">
                                        <div class="col-md-6 mb-1">
                                            <label class="form-label">
                                                <%= language.Paid_Amount %>
                                            </label>
                                            <input type="number" class="form-control" name="paid" id="paid"
                                                placeholder="Enter Amount">
                                        </div>
                                        <div class="col-md-6 mb-1">
                                            <label class="form-label">
                                                <%= language.Payment_Type %>
                                            </label>
                                            <select class="form-control wide" name="payment" id="payment">
                                                <!-- <option value selected disabled>Choose Payment Type</option>
                                                <option value="cash">Cash</option>
                                                <option value="upi">UPI</option>
                                                <option value="card">Card</option>
                                                <option value="cheque">Cheque</option>
                                                <option value="bank_transfer">Bank Transfer</option> -->
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>


                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fa fa-times me-2"></i><%= language.Cancel %>
                        </button>
                        <button type="submit" value="submit" class="btn btn-primary" id="add_order_payment_submit">
                            <i class="fa fa-save me-2"></i><%= language.Save %>
                        </button>
                    </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="exampleModalLong">
            <div class="modal-dialog  modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Barcode %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center" id="add_barcode">

                        </div>
                        <!-- <svg id="barcode"></svg> -->
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-info" id="print_label" data-bs-dismiss="modal">
                            <i class="fa fa-print me-2"></i><%= language.Print_Barcode %>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        </div>

        <!-- Delete Order Confirmation Modal -->
        <div class="modal fade" id="deleteOrderModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                <div class="modal-content text-center p-3" style="border-radius: 16px;">
                    <div class="modal-body pt-4">
                        <div class="mb-3">
                            <div
                                style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
                                <i class="fa fa-exclamation-triangle"></i>
                            </div>
                        </div>
                        <h4 class="mb-2 fw-bold text-dark">
                            <%= language.Delete_Order || 'Delete Order' %>
                        </h4>
                        <p class="text-muted mb-1">
                            <%= language.Are_you_sure_delete || 'Are you sure you want to delete this order?' %>
                        </p>
                        <p class="fw-bold text-danger fs-5 mb-3" id="deleteOrderModalCode"></p>
                        <p class="text-xs text-muted mb-4">
                            <%= language.Action_cannot_be_undone
                                || 'This action will remove the order, related payments, and ledger transactions permanently.'
                                %>
                        </p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                            </button>
                            <a href="#" id="deleteOrderConfirmBtn" class="btn btn-danger">
                                <i class="fa fa-trash me-2"></i>
                                <%= language.Delete || 'Yes, Delete' %>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

            <!--**********************************
            Footer end
        ***********************************-->

            </div>

            <!--********** Main wrapper end **********-->
            <%- include('templet/script')-%>
                <script>
                    $(document).ready(function () {
                        var isMaster = '<%= login %>' === 'master';
                        var isStaff = <%= (typeof isStaff !== 'undefined' && isStaff) ? 'true' : 'false' %>;

                        window.orderTable = initServerDataTable('#server_order_table', {
                            ajaxUrl: '/order/list/data',
                            searchInput: '#order_search_input',
                            pageLengthSelect: '#order_page_length',
                            filterInputs: '#order_status_filter, #order_store_filter, #order_start_date, #order_end_date',
                            getFilters: function () {
                                return {
                                    status_filter: $('#order_status_filter').val() || '',
                                    store_filter: $('#order_store_filter').length ? ($('#order_store_filter').val() || '') : '',
                                    start_date: $('#order_start_date').val() || '',
                                    end_date: $('#order_end_date').val() || ''
                                };
                            },
                            columns: [
                                {
                                    data: 'order_id',
                                    render: function (data, type, row) {
                                        return '<div class="server-dt-primary-text mb-1">' +
                                            '<span class="me-1 fw-bold text-primary">' + (data || '') + '</span>' +
                                            '</div>' +
                                            '<div class="server-dt-secondary-text mb-0">' +
                                            '<span class="me-1 opacity-75"><%= language.Order_Date || "Order Date" %>:</span>' +
                                            '<span>' + (row.formattedOrderDate || '') + '</span>' +
                                            '</div>' +
                                            '<div class="server-dt-secondary-text mb-0">' +
                                            '<span class="me-1 opacity-75"><%= language.Delivery_Date || "Delivery Date" %>:</span>' +
                                            '<span>' + (row.formattedDeliveryDate || '') + '</span>' +
                                            '</div>';
                                    }
                                },
                                {
                                    data: 'customer_name',
                                    render: function (data, type, row) {
                                        return '<div class="server-dt-primary-text">' + (data || 'Walk In Customer') + '</div>' +
                                            (row.customer_number ? '<div class="server-dt-secondary-text"><i class="fa fa-phone me-1 opacity-50"></i>' + row.customer_number + '</div>' : '');
                                    }
                                },
                                {
                                    data: 'gross_total',
                                    className: 'symbol font-w600',
                                    render: function (data) {
                                        return parseFloat(data || 0).toFixed(2);
                                    }
                                },
                                {
                                    data: 'orderStatusName',
                                    render: function (data, type, row) {
                                        return '<span class="badge-status-pill ' + row.statusClass + '">' +
                                            (data || 'Pending') +
                                            '</span>';
                                    }
                                },
                                {
                                    data: 'gross_total',
                                    orderable: false,
                                    render: function (data, type, row) {
                                        var gross = parseFloat(row.gross_total || 0).toFixed(2);
                                        var paid = parseFloat(row.paid_amount || 0).toFixed(2);
                                        var balance = parseFloat(row.balance_amount || 0);

                                        var paymentBtn = '';
                                        if (balance > 0) {
                                            if ('<%= accessdata.logas %>' === 'custmor') {
                                                paymentBtn = '<span class="badge badge-warning light btn-xxs"><%= language.Pending || "Pending" %></span>';
                                            } else {
                                                paymentBtn = '<button type="button" onclick="open_patment_model(\'' + row.id + '\')" class="btn btn-xs btn-outline-success py-1 px-2">' +
                                                    '<i class="fa fa-plus-circle me-1"></i> <%= language.Add_Payment || "Add Payment" %>' +
                                                    '</button>';
                                            }
                                        } else {
                                            paymentBtn = '<span class="badge badge-dark light btn-xxs"><%= language.Fully_Paid || "Fully Paid" %></span>';
                                        }

                                        return '<div class="server-dt-secondary-text mb-1">' +
                                            '<span class="me-1">Total:</span><span class="symbol fw-bold">' + gross + '</span>' +
                                            ' | <span class="me-1">Paid:</span><span class="symbol text-success">' + paid + '</span>' +
                                            '</div>' +
                                            '<div>' + paymentBtn + '</div>';
                                    }
                                },
                                {
                                    data: 'storeName',
                                    visible: isMaster && !isStaff,
                                    render: function (data) {
                                        return data;
                                    }
                                },
                                {
                                    data: 'id',
                                    orderable: false,
                                    className: 'text-center',
                                    render: function (data, type, row) {
                                        var actions = '<div class="server-dt-actions justify-content-center">';

                                        if (row.order_status != 6 && row.canEdit) {
                                            actions += '<a href="/admin/edit/' + data + '" class="btn-dt-action btn-edit" title="<%= language.Edit || "Edit" %>">' +
                                                '<i class="fas fa-pencil-alt"></i></a>';
                                        }

                                        actions += '<a href="/order/view/' + data + '" class="btn-dt-action btn-view" title="<%= language.View || "View" %>">' +
                                            '<i class="fa fa-eye"></i></a>';

                                        actions += '<button type="button" class="btn-dt-action btn-print" id="print_barcode" data-bs-toggle="modal" data-bs-target="#exampleModalLong" data-id="' + data + '" title="<%= language.Barcode || "Barcode" %>">' +
                                            '<i class="fa fa-barcode"></i></button>';

                                        actions += '<a href="/order/pos_invoice/' + data + '" class="btn-dt-action btn-print" target="_blank" title="POS Thermal Invoice">' +
                                            '<i class="fa fa-receipt"></i></a>';

                                        if (row.canDelete) {
                                            actions += '<button type="button" class="btn-dt-action btn-delete" data-bs-toggle="modal" data-bs-target="#deleteOrderModal" data-id="' + data + '" data-orderid="' + row.order_id + '" title="<%= language.Delete || "Delete" %>">' +
                                                '<i class="fa fa-trash"></i></button>';
                                        }

                                        actions += '</div>';
                                        return actions;
                                    }
                                }
                            ]
                        });
                    });

                    $('#addpaymentmodel1').on('shown.bs.modal', function () {
                        $('#payment').select2({
                            dropdownParent: $('#addpaymentmodel1'),
                            placeholder: 'Select Account(a)',
                            width: '100%',
                            allowClear: true
                        });
                    });

                    $(document).on('click', '.btn-dt-action.btn-delete[data-bs-target="#deleteOrderModal"]', function () {
                        const orderId = $(this).attr('data-id');
                        const orderCode = $(this).attr('data-orderid');
                        $('#deleteOrderModalCode').text(orderCode || ('#' + orderId));
                        $('#deleteOrderConfirmBtn').attr('href', '/order/delete/' + orderId);
                    });
                </script>
</body>


</html>