<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
  <!-- meta and links start -->
  <%- include('templet/meta')-%>
  <link rel="stylesheet" href="/css/pos-compact.css?v=5">

</head>

<body>
  <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
  <!--********** Content body start **********-->

  <div class="content-body pos-content-body">

    <div class="container-fluid" style="min-height: 100vh;">
      <!-- Mobile / Tablet Segmented View Switcher (<992px) -->
      <div class="pos-responsive-segmented-bar d-lg-none">
        <button type="button" class="pos-segmented-btn active" id="posBtnShowCatalog" onclick="switchPosMobileTab('catalog')">
          <i class="fas fa-tshirt"></i>
          <span><%= language.Services || 'Services' %></span>
        </button>
        <button type="button" class="pos-segmented-btn" id="posBtnShowCart" onclick="switchPosMobileTab('cart')">
          <i class="fas fa-shopping-cart"></i>
          <span><%= language.Order_Cart || 'Cart & Checkout' %></span>
          <span class="badge bg-primary text-white ms-1 rounded-pill" id="posMobileCartBadge"><%= (typeof cartservice !== 'undefined' && cartservice) ? cartservice.length : 0 %></span>
        </button>
      </div>

      <div class="row pos-main-row">
        <!-- left side service list part -->
        <div class="d-none">
          <input type="hiden" name="sym" value="<%= accessdata.symbol %>">
          <input type="hiden" name="pls" value="<%= accessdata.plac %>">
          <input type="hiden" name="thousands_separator" value="<%= accessdata.thousands_separator %>">
        </div>

        <div class="col-xl-7 col-lg-6 pos-tab-panel-catalog" id="posCatalogColumn">
          <div class="pos-card">
            <div class="pos-card-body">
              <div class="pos-search-box">
                <i class="fa fa-search pos-search-icon"></i>
                <input type="text" class="form-control pos-search-input" id="service_pos_search" placeholder="Search services..." autocomplete="off">
                <span class="pos-search-clear" id="pos_search_clear" style="display:none;" title="Clear search">
                  <i class="fa fa-times"></i>
                </span>
              </div>
              <div class="pos-services-grid" id="pos_service">
                <% if(service_list.length < 1 && login=='master' && cart.store_id==0){ %>
                <div class="p-3 text-center w-100">
                  <h5 class="text-center text-danger">
                    <%= language.Please_Select_Store %>
                  </h5>
                </div>
                <% }else if(service_list.length < 1){ %>
                <div class="p-3 text-center w-100">
                  <img src="../images/empty.png" style="max-height: 80px; margin-bottom: 8px;">
                  <h5 class="text-center text-danger">
                    <%= language.Not_listed_any_services_yet %>
                  </h5>
                </div>
                <% }else{ %>
                <% service_list.forEach(function(data){ %>
                <a href="#" class="pos-service-item services text-decoration-none" data-name="<%= (data.name || '').toLowerCase() %>" data-bs-toggle="modal" data-bs-target="#service_type_model" data-id="<%= data.id %>">
                  <div class="card h-100 shadow-sm border rounded-3 text-center overflow-hidden pos-service-card position-relative">
                    <% if (data.no_of_items && parseInt(data.no_of_items) > 1) { %>
                    <span class="position-absolute top-0 end-0 badge bg-primary text-white m-1 rounded-pill shadow-sm" style="z-index: 2; font-size: 0.7rem;">
                      <%= data.no_of_items %> Pcs
                    </span>
                    <% } %>
                    <div class="ratio ratio-1x1 bg-light position-relative">
                      <img src="../../uploads/<%= data.image %>" class="card-img-top w-100 h-100" style="object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none'); this.nextElementSibling.classList.add('d-flex');" alt="<%= data.name %>">
                      <div class="pos-service-fallback-icon position-absolute top-0 start-0 w-100 h-100 align-items-center justify-content-center text-primary fs-3 d-none">
                        <i class="fa fa-tshirt"></i>
                      </div>
                    </div>
                    <div class="card-body p-2 d-flex align-items-center justify-content-center">
                      <h6 class="card-title m-0 fw-bold text-dark fs-7 pos-service-name" title="<%= data.name %>">
                        <%= data.name %>
                      </h6>
                    </div>
                  </div>
                </a>
                <% }) %>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- right side pos part -->
        <div class="col-xl-5 col-lg-6 pos-tab-panel-cart pos-panel-hidden" id="posCartColumn">
          <div class="pos-card pos-cart-card">
            <div class="pos-card-body">
              <div class="row g-2 mb-1.5 align-items-stretch">
                <!-- Column 1: Order Info & Scheduling (col-12 col-md-6) -->
                <div class="col-12 col-md-6">
                  <% if ((typeof roll !== 'undefined' && roll == 1) || (typeof login !== 'undefined' && login === 'master')) { %>
                  <div class="pos-date-group mb-1.5">
                    <label class="pos-field-label mb-0"><%= language.Store || 'Store' %></label>
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-light-subtle border-end-0 py-0 px-2 text-secondary">
                        <i class="fa fa-store"></i>
                      </span>
                      <input type="text" class="form-control pos-input-sm border-start-0 ps-1 fw-semibold text-dark" value="<%= order_date[0].store_name %>" readonly placeholder="Store" title="<%= order_date[0].store_name %>">
                    </div>
                  </div>
                  <% } %>

                  <div class="pos-date-group mb-1.5">
                    <label class="pos-field-label mb-0"><%= language.Customer || 'Customer' %></label>
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-light-subtle border-end-0 py-0 px-2 text-primary">
                        <i class="fa fa-user"></i>
                      </span>
                      <input type="text" class="form-control pos-input-sm border-start-0 ps-1 fw-semibold text-dark" value="<%= order_date[0].customer_name %>" readonly placeholder="Customer" title="<%= order_date[0].customer_name %>">
                    </div>
                  </div>

                  <div class="d-none">
                    <input type="hidden" id="customer_id" value="<%= order_date[0].customer_id %>">
                    <input type="hidden" id="order_id" value="<%= order_date[0].id %>">
                  </div>

                  <!-- Customer Type Dropdown -->
                  <div class="pos-date-group mb-1.5">
                    <label class="pos-field-label mb-0" for="edit_pos_order_type"><%= language.Customer_Type || 'Customer Type' %></label>
                    <select class="form-select form-select-sm pos-input-sm w-100" id="edit_pos_order_type" name="edit_pos_order_type">
                      <% if (typeof customer_types !== 'undefined' && customer_types && customer_types.length > 0) { %>
                      <% customer_types.forEach(function(ct, idx) { %>
                      <option value="<%= ct.name %>" data-code="<%= ct.code || '' %>" title="<%= ct.name %><%= ct.description ? ' - ' + ct.description : '' %>" <%= (order_date[0].order_type === ct.name || order_date[0].order_type === ct.code || (!order_date[0].order_type && (ct.name === 'Counter & Counter' || ct.code === 'C & C' || idx === 0))) ? 'selected' : '' %>><%= ct.code || ct.name %></option>
                      <% }); %>
                      <% } else { %>
                      <option value="Counter & Counter" data-code="C & C" title="Counter & Counter - Customer will drop-off and customer will pickup" <%= (!order_date[0].order_type || order_date[0].order_type === 'Counter & Counter' || order_date[0].order_type === 'C & C' || order_date[0].order_type === 'Customer drop-off & Customer pick-up') ? 'selected' : '' %>>C & C</option>
                      <option value="Counter & Route" data-code="C & R" title="Counter & Route - Customer will drop-off and store will deliver" <%= (order_date[0].order_type === 'Counter & Route' || order_date[0].order_type === 'C & R' || order_date[0].order_type === 'Counter & Delivery' || order_date[0].order_type === 'Customer drop-off & Store delivery') ? 'selected' : '' %>>C & R</option>
                      <option value="Route & Route" data-code="R & R" title="Route & Route - Store will pickup and store will deliver" <%= (order_date[0].order_type === 'Route & Route' || order_date[0].order_type === 'R & R' || order_date[0].order_type === 'Pick-up & Delivery' || order_date[0].order_type === 'Store collection & Store delivery') ? 'selected' : '' %>>R & R</option>
                      <option value="Route & Counter" data-code="R & C" title="Route & Counter - Store will pickup and customer will pickup" <%= (order_date[0].order_type === 'Route & Counter' || order_date[0].order_type === 'R & C' || order_date[0].order_type === 'Pick-up & Counter' || order_date[0].order_type === 'Store collection & Customer pick-up') ? 'selected' : '' %>>R & C</option>
                      <% } %>
                    </select>
                  </div>

                  <!-- Row with Order No and Order Date -->
                  <div class="row g-1 mb-1.5">
                    <div class="col-6">
                      <div class="pos-date-group">
                        <label class="pos-field-label mb-0"><%= language.Order_No || 'Order #' %></label>
                        <input type="text" id="pos_order_id" class="form-control pos-input-sm w-100 fw-bold text-dark" value="<%= order_date[0].order_id %>" readonly title="Order ID">
                      </div>
                    </div>
                    <div class="col-6">
                      <div class="pos-date-group">
                        <label class="pos-field-label mb-0"><%= language.Order_Date || 'Order Date' %></label>
                        <% let new_date=new Date(order_date[0].order_date) %>
                        <% let year=new_date.getFullYear() %>
                        <% let new_day=(new_date.getDate() < 10 ? '0' : '' ) + new_date.getDate() %>
                        <% let new_month=((new_date.getMonth()+1) < 10 ? '0' : '' ) + (new_date.getMonth()+1) %>
                        <% let fullDate=`${year}-${new_month}-${new_day}` %>
                        <input type="date" class="form-control pos-input-sm w-100" id="edit_POS_order_date" value="<%=fullDate %>" title="<%= language.Order_Date || 'Order Date' %>">
                      </div>
                    </div>
                  </div>

                  <% 
                    let editOrderType = order_date[0].order_type || 'Counter & Counter';
                    let editIsRoutePickup = editOrderType === 'Route & Route' || editOrderType === 'Route & Counter' || editOrderType === 'R & R' || editOrderType === 'R & C' || editOrderType === 'Store collection & Store delivery' || editOrderType === 'Pick-up & Delivery' || editOrderType === 'Pick-up & Counter';
                    let editIsRouteDelivery = editOrderType === 'Route & Route' || editOrderType === 'Counter & Route' || editOrderType === 'R & R' || editOrderType === 'C & R' || editOrderType === 'Counter & Delivery' || editOrderType === 'Pick-up & Delivery' || editOrderType === 'Customer drop-off & Store delivery' || editOrderType === 'Store collection & Store delivery';

                    let ready_raw = order_date[0].ready_date || order_date[0].delivery_date || order_date[0].order_date;
                    let ready_date = new Date(ready_raw);
                    let ready_year = ready_date.getFullYear();
                    let ready_day = (ready_date.getDate() < 10 ? '0' : '' ) + ready_date.getDate();
                    let ready_month = ((ready_date.getMonth()+1) < 10 ? '0' : '' ) + (ready_date.getMonth()+1);
                    let ready_fullDate = `${ready_year}-${ready_month}-${ready_day}`;
                    let ready_hours = (ready_date.getHours() < 10 ? '0' : '') + ready_date.getHours();
                    let ready_mins = (ready_date.getMinutes() < 10 ? '0' : '') + ready_date.getMinutes();
                    let ready_time = (ready_hours !== '00' || ready_mins !== '00') ? `${ready_hours}:${ready_mins}` : '16:00';

                    let pick_raw = order_date[0].pickup_date || order_date[0].order_date;
                    let pick_date = new Date(pick_raw);
                    let pick_year = pick_date.getFullYear();
                    let pick_day = (pick_date.getDate() < 10 ? '0' : '' ) + pick_date.getDate();
                    let pick_month = ((pick_date.getMonth()+1) < 10 ? '0' : '' ) + (pick_date.getMonth()+1);
                    let pick_fullDate = `${pick_year}-${pick_month}-${pick_day}`;
                    let pick_hours = (pick_date.getHours() < 10 ? '0' : '') + pick_date.getHours();
                    let pick_mins = (pick_date.getMinutes() < 10 ? '0' : '') + pick_date.getMinutes();
                    let pick_time = (pick_hours !== '00' || pick_mins !== '00') ? `${pick_hours}:${pick_mins}` : '10:00';

                    let del_raw = order_date[0].delivery_date || order_date[0].ready_date || order_date[0].order_date;
                    let del_date = new Date(del_raw);
                    let del_year = del_date.getFullYear();
                    let del_day = (del_date.getDate() < 10 ? '0' : '' ) + del_date.getDate();
                    let del_month = ((del_date.getMonth()+1) < 10 ? '0' : '' ) + (del_date.getMonth()+1);
                    let del_fullDate = `${del_year}-${del_month}-${del_day}`;
                    let del_hours = (del_date.getHours() < 10 ? '0' : '') + del_date.getHours();
                    let del_mins = (del_date.getMinutes() < 10 ? '0' : '') + del_date.getMinutes();
                    let del_time = (del_hours !== '00' || del_mins !== '00') ? `${del_hours}:${del_mins}` : '16:00';
                  %>

                  <!-- Route Pick-up Date & Time -->
                  <div class="pos-date-group mb-1" id="edit_pos_pickup_date_group" style="<%= !editIsRoutePickup ? 'display: none;' : '' %>">
                    <div class="d-flex align-items-center justify-content-between mb-0.5">
                      <label class="pos-field-label mb-0">
                        <i class="fa fa-truck text-primary me-1"></i><%= language.Route_Pickup_Date || 'Route Pick-up Schedule' %>
                      </label>
                    </div>
                    <div class="input-group input-group-sm">
                      <input type="date" class="form-control pos-input-sm" id="edit_POS_pickup_date" name="edit_pos_pickup_date" value="<%= pick_fullDate %>" min="<%= fullDate %>" title="<%= language.Route_Pickup_Date || 'Route Pick-up Date' %>">
                      <input type="time" class="form-control pos-input-sm" id="edit_POS_pickup_time" name="edit_pos_pickup_time" value="<%= pick_time %>" style="max-width: 50%;" title="Pick-up Time">
                    </div>
                  </div>

                  <!-- Ready Schedule (Always Visible) -->
                  <div class="pos-date-group mb-1" id="edit_pos_ready_date_group">
                    <div class="d-flex align-items-center justify-content-between mb-0.5">
                      <label class="pos-field-label mb-0">
                        <i class="fa fa-check-circle text-success me-1"></i><%= language.Ready_Schedule || 'Ready Schedule' %>
                      </label>
                      <button type="button" class="btn btn-outline-primary py-0 px-1.5 border-0 btn-auto-ready-sched" id="btn_auto_edit_ready_schedule" title="Reset to automated ready schedule" style="font-size: 11px;">
                        <i class="fas fa-magic me-1"></i>Auto
                      </button>
                    </div>
                    <div class="input-group input-group-sm">
                      <input type="date" class="form-control pos-input-sm" id="edit_POS_ready_date" name="edit_pos_ready_date" value="<%= ready_fullDate %>" min="<%= fullDate %>" title="<%= language.Ready_Schedule || 'Ready Schedule Date' %>">
                      <input type="time" class="form-control pos-input-sm" id="edit_POS_ready_time" name="edit_pos_ready_time" value="<%= ready_time %>" style="max-width: 50%;" title="Ready Time">
                    </div>
                  </div>

                  <!-- Route Delivery Date & Time -->
                  <div class="pos-date-group mb-1" id="edit_pos_delivery_date_group" style="<%= !editIsRouteDelivery ? 'display: none;' : '' %>">
                    <div class="d-flex align-items-center justify-content-between mb-0.5">
                      <label class="pos-field-label mb-0">
                        <i class="fa fa-home text-info me-1"></i><%= language.Route_Delivery_Date || 'Route Delivery Schedule' %>
                      </label>
                    </div>
                    <div class="input-group input-group-sm">
                      <input type="date" class="form-control pos-input-sm" id="edit_POS_delivery_date" name="edit_pos_delivery_date" value="<%= del_fullDate %>" min="<%= fullDate %>" title="<%= language.Route_Delivery_Date || 'Route Delivery Date' %>">
                      <input type="time" class="form-control pos-input-sm" id="edit_POS_delivery_time" name="edit_pos_delivery_time" value="<%= del_time %>" style="max-width: 50%;" title="Delivery Time">
                    </div>
                  </div>
                </div>

                <!-- Column 2: Customer Intelligence & Memo (col-12 col-md-6) -->
                <div class="col-12 col-md-6 d-flex flex-column justify-content-between">
                  <!-- 3 Compact Stat Tiles (Horizontal Row) -->
                  <div>
                    <div class="pos-cust-stats-row mb-1.5">
                      <!-- Total Orders -->
                      <div class="pos-cust-stat-tile tile-total" title="Total Lifetime Orders">
                        <div class="stat-icon"><i class="fa fa-shopping-bag"></i></div>
                        <div class="stat-meta">
                          <span class="stat-num" id="pos_cust_stat_total">0</span>
                          <span class="stat-lbl">Total Orders</span>
                        </div>
                      </div>

                      <!-- Unpaid Orders Count -->
                      <div class="pos-cust-stat-tile tile-unpaid" title="Orders Unpaid / Partially Paid">
                        <div class="stat-icon"><i class="fa fa-clock"></i></div>
                        <div class="stat-meta">
                          <span class="stat-num" id="pos_cust_stat_unpaid">0</span>
                          <span class="stat-lbl">Unpaid Orders</span>
                        </div>
                      </div>

                      <!-- Unpaid Balance Amount -->
                      <div class="pos-cust-stat-tile tile-balance" title="Total Outstanding Balance">
                        <div class="stat-icon"><i class="fa fa-exclamation-triangle"></i></div>
                        <div class="stat-meta">
                          <span class="stat-num" id="pos_cust_stat_balance"><%= accessdata.symbol %> 0.00</span>
                          <span class="stat-lbl">Total Due</span>
                        </div>
                      </div>
                    </div>

                    <!-- Customer Memo Card with Quick-Edit -->
                    <div class="pos-cust-memo-card">
                      <div class="memo-header d-flex align-items-center justify-content-between pb-1 border-bottom">
                        <span class="memo-title d-flex align-items-center gap-1">
                          <i class="fa fa-sticky-note text-warning"></i>
                          <strong><%= language.Customer_Memo || 'Customer Memo' %></strong>
                        </span>
                        <button type="button" class="btn btn-xs btn-link p-0 text-primary text-decoration-none" id="btn_toggle_pos_memo_edit" title="Edit Memo">
                          <i class="fas fa-pencil-alt fs-11"></i> <span class="fs-11">Edit</span>
                        </button>
                      </div>

                      <!-- View Mode -->
                      <div class="memo-view-mode pt-1" id="pos_memo_view_container">
                        <p class="memo-text mb-0 text-muted" id="pos_cust_memo_text">
                          <em>Loading customer notes...</em>
                        </p>
                      </div>

                      <!-- Quick Edit Mode (Hidden by default) -->
                      <div class="memo-edit-mode pt-1 d-none" id="pos_memo_edit_container">
                        <textarea class="form-control form-control-sm mb-1 pos-memo-textarea" id="pos_cust_memo_input" rows="2" placeholder="Add laundry preferences, allergies, or special notes..."></textarea>
                        <div class="d-flex align-items-center justify-content-end gap-1">
                          <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" id="btn_cancel_pos_memo">
                            Cancel
                          </button>
                          <button type="button" class="btn btn-xs btn-primary py-0 px-2" id="btn_save_pos_memo">
                            <i class="fa fa-check me-1"></i>Save Note
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Cart Items Table with Scroll -->
              <div class="pos-table-scroll">
                <table class="pos-cart-table table-bordered verticle-middle text-center">
                  <thead>
                    <tr>
                      <th style="text-align: left; padding-left: 8px !important;">
                        <%= language.Service %>
                      </th>
                      <th style="width: 65px !important; text-align: center;">
                        <%= language.Color %>
                      </th>
                      <th style="width: 120px !important; text-align: center;">
                        <%= language.Rate %>
                      </th>
                      <th style="width: 110px !important; text-align: center;">
                        <%= language.Qty %>
                      </th>
                      <th style="width: 35px !important; text-align: center;"></th>
                    </tr>
                  </thead>
                  <tbody id="POS_service_added_list">
                    <% cartservice.forEach(function(x){ %>
                    <tr>
                      <td>
                        <div class="pos-cart-service-info">
                          <span class="pos-cart-item-title" title="<%= x.service_name %>">
                            <%= x.service_name %>
                            <% if (x.no_of_items && parseInt(x.no_of_items) > 1) { %>
                            <span class="badge bg-secondary text-white ms-1" style="font-size:0.75rem;"><%= x.no_of_items %> Pcs</span>
                            <% } %>
                          </span>
                          <span class="pos-cart-item-badge">[<%= x.service_type_name %>]</span>
                        </div>
                      </td>
                      <td class="text-center">
                        <input type="color" class="pos-color-circle" value="<%= x.service_color %>" id="POS_service_color" data-id="<%= x.id %>">
                      </td>
                      <td class="text-center">
                        <div class="pos-stepper pos-stepper-rate <%= (typeof login !== 'undefined' && (login=='master' || login=='store')) ? '' : ((typeof login === 'undefined') ? '' : 'is-readonly') %>">
                          <button type="button" class="pos-stepper-btn pos-stepper-btn-minus" <%= (typeof login !== 'undefined' && (login=='master' || login=='store')) ? '' : ((typeof login === 'undefined') ? '' : 'disabled') %> tabindex="-1"></button>
                          <input type="number" step="0.25" class="pos-stepper-input pos-table-input-price" value="<%= x.service_type_price %>" name="service_type_price" id="edit_POSservice_type_price" data-id="<%= x.id %>" data-order_id="<%= order_date[0].id %>" min="0" <%= (typeof login !== 'undefined' && (login=='master' || login=='store')) ? '' : ((typeof login === 'undefined') ? '' : 'readonly') %>>
                          <button type="button" class="pos-stepper-btn pos-stepper-btn-plus" <%= (typeof login !== 'undefined' && (login=='master' || login=='store')) ? '' : ((typeof login === 'undefined') ? '' : 'disabled') %> tabindex="-1"></button>
                        </div>
                      </td>
                      <td class="text-center">
                        <div class="pos-stepper pos-stepper-qty">
                          <button type="button" class="pos-stepper-btn pos-stepper-btn-minus" tabindex="-1"></button>
                          <input type="number" class="pos-stepper-input pos-table-input-qty" id="edit_POSservice_type_quntity" value="<%= x.service_quntity %>" min="1" step="1" data-id="<%= x.id %>" data-order_id="<%= order_date[0].id %>">
                          <button type="button" class="pos-stepper-btn pos-stepper-btn-plus" tabindex="-1"></button>
                        </div>
                      </td>
                      <td class="text-center">
                        <a class="pos-btn-del" id="edit_remove_service_list" data-id="<%= x.id %>" data-order_id="<%= order_date[0].id %>" title="Delete">
                          <i class="fa fa-trash"></i>
                        </a>
                      </td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <!-- Bottom Actions & Totals Area -->
              <div class="pos-bottom-section">
                <div class="row g-1 align-items-center">
                  <div class="col-5">
                    <div class="pos-actions-grid">
                      <button type="button" class="btn btn-primary pos-btn-mini" data-bs-toggle="modal" data-bs-target="#addons">
                        <i class="fa fa-plus-circle me-1"></i><%= language.Addons %>
                      </button>
                      <button type="button" class="btn btn-primary pos-btn-mini" id="edit_POS_coupon_model_show">
                        <i class="fa fa-tag me-1"></i><%= language.Coupon %>
                      </button>
                      <button type="button" class="btn btn-success pos-btn-mini" id="edit_direct_save_btn">
                        <i class="fa fa-save me-1"></i><%= language.Save || 'Save' %>
                      </button>
                      <a class="btn btn-outline-danger pos-btn-mini" href="/order/view/<%= order_date[0].id %>">
                        <i class="fa fa-arrow-left me-1"></i><%= language.Back || 'Back' %>
                      </a>
                    </div>
                    <button type="button" class="btn btn-info text-white pos-btn-pay-primary shadow-sm" id="edit_POS_payment_model_show">
