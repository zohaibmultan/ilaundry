<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>
    <style>
        /* Stacking Context & Dropdown Layering */
        .filter-section {
            position: relative !important;
            z-index: 1050 !important;
            overflow: visible !important;
            background-color: rgba(0, 0, 0, 0.02);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
        [data-theme-version="dark"] .filter-section {
            background-color: rgba(255, 255, 255, 0.03) !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
        }
        .filter-section .bootstrap-select {
            width: 100% !important;
            position: relative !important;
            z-index: 1055 !important;
        }
        .filter-section .bootstrap-select .dropdown-menu {
            z-index: 1060 !important;
        }
        .filter-section .bootstrap-select.show {
            z-index: 1070 !important;
        }
        .kpi-row {
            position: relative;
            z-index: 1;
        }

        /* Metric Icon Avatars */
        .daily-metric-icon {
            width: 36px;
            height: 36px;
            min-width: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-size: 14px;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }
        .daily-metric-icon.icon-orders {
            background-color: rgba(0, 129, 238, 0.12) !important;
            color: #0081EE !important;
            border: 1px solid rgba(0, 129, 238, 0.25) !important;
        }
        .daily-metric-icon.icon-sales {
            background-color: rgba(16, 185, 129, 0.12) !important;
            color: #10b981 !important;
            border: 1px solid rgba(16, 185, 129, 0.25) !important;
        }
        .daily-metric-icon.icon-tax {
            background-color: rgba(99, 102, 241, 0.12) !important;
            color: #6366f1 !important;
            border: 1px solid rgba(99, 102, 241, 0.25) !important;
        }
        .daily-metric-icon.icon-discount {
            background-color: rgba(245, 158, 11, 0.12) !important;
            color: #d97706 !important;
            border: 1px solid rgba(245, 158, 11, 0.25) !important;
        }

        /* Dark Mode Metric Icons */
        [data-theme-version="dark"] .daily-metric-icon.icon-orders {
            background-color: rgba(56, 189, 248, 0.2) !important;
            color: #38bdf8 !important;
            border-color: rgba(56, 189, 248, 0.4) !important;
        }
        [data-theme-version="dark"] .daily-metric-icon.icon-sales {
            background-color: rgba(52, 211, 153, 0.2) !important;
            color: #34d399 !important;
            border-color: rgba(52, 211, 153, 0.4) !important;
        }
        [data-theme-version="dark"] .daily-metric-icon.icon-tax {
            background-color: rgba(165, 180, 252, 0.2) !important;
            color: #a5b4fc !important;
            border-color: rgba(165, 180, 252, 0.4) !important;
        }
        [data-theme-version="dark"] .daily-metric-icon.icon-discount {
            background-color: rgba(251, 191, 36, 0.2) !important;
            color: #fbbf24 !important;
            border-color: rgba(251, 191, 36, 0.4) !important;
        }

        /* KPI Cards & Typography */
        [data-theme-version="dark"] .daily-kpi-card {
            background: rgba(18, 26, 44, 0.78) !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
        }
        [data-theme-version="dark"] .daily-val-text {
            color: #f8fafc !important;
        }
        [data-theme-version="dark"] .daily-sub-text {
            color: #94a3b8 !important;
        }

        /* Status & Metric Badges */
        .daily-badge {
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
        }
        .daily-badge.badge-orders {
            background: rgba(0, 129, 238, 0.1);
            color: #0081ee;
            border: 1px solid rgba(0, 129, 238, 0.25);
        }
        .daily-badge.badge-sales {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.25);
        }
        .daily-badge.badge-tax {
            background: rgba(99, 102, 241, 0.1);
            color: #6366f1;
            border: 1px solid rgba(99, 102, 241, 0.25);
        }
        .daily-badge.badge-discount {
            background: rgba(245, 158, 11, 0.1);
            color: #d97706;
            border: 1px solid rgba(245, 158, 11, 0.25);
        }
        [data-theme-version="dark"] .daily-badge.badge-orders {
            background: rgba(56, 189, 248, 0.18) !important;
            color: #38bdf8 !important;
            border-color: rgba(56, 189, 248, 0.35) !important;
        }
        [data-theme-version="dark"] .daily-badge.badge-sales {
            background: rgba(52, 211, 153, 0.18) !important;
            color: #34d399 !important;
            border-color: rgba(52, 211, 153, 0.35) !important;
        }
        [data-theme-version="dark"] .daily-badge.badge-tax {
            background: rgba(165, 180, 252, 0.18) !important;
            color: #a5b4fc !important;
            border-color: rgba(165, 180, 252, 0.35) !important;
        }
        [data-theme-version="dark"] .daily-badge.badge-discount {
            background: rgba(251, 191, 36, 0.18) !important;
            color: #fbbf24 !important;
            border-color: rgba(251, 191, 36, 0.35) !important;
        }

        /* Order ID Pill */
        .order-id-badge {
            font-family: var(--bs-font-monospace, monospace);
            font-weight: 600;
            font-size: 12px;
            padding: 3px 8px;
            background: rgba(0, 129, 238, 0.08);
            color: #0081ee;
            border-radius: 6px;
            border: 1px solid rgba(0, 129, 238, 0.2);
            display: inline-flex;
            align-items: center;
        }
        [data-theme-version="dark"] .order-id-badge {
            background: rgba(56, 189, 248, 0.15);
            color: #38bdf8;
            border-color: rgba(56, 189, 248, 0.3);
        }

        /* Sales Table Typography & Monospace Formatting */
        #sales_report_table th:nth-child(4), #sales_report_table td:nth-child(4),
        #sales_report_table th:nth-child(5), #sales_report_table td:nth-child(5),
        #sales_report_table th:nth-child(6), #sales_report_table td:nth-child(6),
        #sales_report_table th:nth-child(7), #sales_report_table td:nth-child(7),
        #sales_report_table th:nth-child(8), #sales_report_table td:nth-child(8),
        #sales_report_table th:nth-child(9), #sales_report_table td:nth-child(9) {
            text-align: right !important;
            font-family: var(--bs-font-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace) !important;
        }
        #sales_report_table th:nth-child(9), #sales_report_table td:nth-child(9) {
            font-weight: 700 !important;
        }

        /* Dark Mode Native Date Inputs */
        [data-theme-version="dark"] input[type="date"],
        html[data-theme-version="dark"] input[type="date"],
        body[data-theme-version="dark"] input[type="date"],
        .dark-only input[type="date"] {
            color-scheme: dark !important;
        }
        [data-theme-version="dark"] input[type="date"]::-webkit-calendar-picker-indicator,
        html[data-theme-version="dark"] input[type="date"]::-webkit-calendar-picker-indicator,
        body[data-theme-version="dark"] input[type="date"]::-webkit-calendar-picker-indicator,
        .dark-only input[type="date"]::-webkit-calendar-picker-indicator {
            cursor: pointer !important;
            opacity: 0.95 !important;
            filter: invert(1) brightness(1.2) !important;
            transition: opacity 0.2s ease, filter 0.2s ease, transform 0.15s ease !important;
        }
        [data-theme-version="dark"] input[type="date"]::-webkit-calendar-picker-indicator:hover {
            opacity: 1 !important;
            filter: invert(1) brightness(1.4) !important;
            transform: scale(1.1);
        }

        /* Dark Mode Table Styling */
        [data-theme-version="dark"] #sales_report_table thead.table-light,
        [data-theme-version="dark"] #sales_report_table thead.table-light th {
            background-color: rgba(255, 255, 255, 0.04) !important;
            color: #94a3b8 !important;
            border-bottom-color: rgba(255, 255, 255, 0.08) !important;
        }
        [data-theme-version="dark"] #sales_report_table tbody tr {
            border-bottom-color: rgba(255, 255, 255, 0.05) !important;
        }
        [data-theme-version="dark"] #sales_report_table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.03) !important;
        }

        /* Print styles */
        @media print {
            .nav-header,
            .header,
            .deznav,
            .footer,
            .filter-section,
            .header-actions,
            .bottom-summary-actions,
            .btn {
                display: none !important;
            }
            .content-body {
                margin: 0 !important;
                padding: 0 !important;
            }
            .container-fluid {
                padding: 0 !important;
            }
            .card {
                border: none !important;
                box-shadow: none !important;
                background: transparent !important;
            }
            .card-header {
                border-bottom: 2px solid #000 !important;
                padding: 8px 0 !important;
            }
            .kpi-row {
                display: flex !important;
                margin-bottom: 20px !important;
            }
            .table {
                width: 100% !important;
                border: 1px solid #dee2e6 !important;
            }
            .table thead th,
            .table tbody td {
                border-bottom: 1px solid #dee2e6 !important;
                padding: 8px 12px !important;
            }
            body {
                background: #fff !important;
                color: #000 !important;
            }
        }
    </style>
</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
    <!--********** Content body start **********-->
    <div class="content-body">
        <div class="container-fluid" style="min-height: 100vh;">
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3" style="height: auto;">
                        <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                    <i class="fa fa-chart-line text-primary me-2"></i><%= language.Sales_Report || 'Sales Report' %>
                                </h3>
                                <small class="text-muted"><%= language.Sales_Report_Subtitle || 'Analyze sales revenue, order volumes, and financial turnover across date ranges' %></small>
                            </div>
                            <div class="d-flex align-items-center gap-2 header-actions">
                                <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" onclick="downloadsalesreport()" id="Download_order_report">
                                    <i class="fa fa-download me-1"></i><%= language.Download_Report || 'Download Report' %>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" id="order_report_print">
                                    <i class="fa fa-print me-1"></i><%= language.Print_Report || 'Print' %>
                                </button>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <!-- Hidden inputs required for currency formatting -->
                            <div class="d-none">
                                <input type="hidden" name="sym" value="<%= accessdata.symbol %>">
                                <input type="hidden" name="pls" value="<%= accessdata.plac %>">
                                <input type="hidden" name="thousands_separator" value="<%= accessdata.thousands_separator %>">
                            </div>

                            <!-- Filter Section -->
                            <div class="filter-section p-3 rounded-3 mb-4">
                                <div class="row g-3 align-items-end">
                                    <div class="col-12 col-sm-6 col-md-4 <%= accessdata.logas == 'master' && accessdata.mutibranch ? '' : 'd-none' %>">
                                        <label class="form-label fw-semibold text-secondary small mb-1" for="sales_report_store">
                                            <i class="fa fa-store text-primary me-1"></i><%= language.Store_Name || 'Store Name' %>
                                        </label>
                                        <select class="default-select form-control wide w-100" data-width="100%" name="storeid" id="sales_report_store">
                                            <% storeList.forEach(function(x){ %>
                                                <option value="<%= x.id %>" <%= x.id == store ? 'selected' : '' %>><%= x.name %></option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <div class="col-6 col-md-4">
                                        <label class="form-label fw-semibold text-secondary small mb-1" for="sales_report_start_date">
                                            <i class="fa fa-calendar-alt text-primary me-1"></i><%= language.Start_Date || 'Start Date' %>
                                        </label>
                                        <input type="date" class="form-control" name="start_date" id="sales_report_start_date">
                                    </div>

                                    <div class="col-6 col-md-4">
                                        <label class="form-label fw-semibold text-secondary small mb-1" for="sales_report_end_date">
                                            <i class="fa fa-calendar-alt text-primary me-1"></i><%= language.End_Date || 'End Date' %>
                                        </label>
                                        <input type="date" class="form-control" name="end_date" id="sales_report_end_date">
                                    </div>
                                </div>
                            </div>

                            <% 
                                let initialGross = 0;
                                let initialTax = 0;
                                let initialDiscounts = 0;
                                (salesdata || []).forEach(function(d){
                                    initialGross += Number(d.gross_total || 0);
                                    initialTax += Number(d.tax_amount || 0);
                                    initialDiscounts += (Number(d.extra_discount || 0) + Number(d.coupon_discount || 0));
                                });
                            %>

                            <!-- Top 4 KPI Summary Metric Cards -->
                            <div class="row g-3 mb-4 kpi-row position-relative" style="z-index: 1;">
                                <!-- Total Orders -->
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="daily-sub-text small fw-medium text-truncate"><%= language.Total_Orders || 'Total Orders' %></span>
                                                <span class="daily-badge badge-orders">Volume</span>
                                            </div>
                                            <div class="d-flex align-items-baseline justify-content-between">
                                                <h4 class="mb-0 fw-bold daily-val-text font-monospace" id="kpi_sales_orders"><%= (salesdata || []).length %></h4>
                                                <div class="daily-metric-icon icon-orders">
                                                    <i class="fa fa-shopping-bag"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Gross Sales / Revenue -->
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="daily-sub-text small fw-medium text-truncate"><%= language.Total_Sales || 'Total Sales' %></span>
                                                <span class="daily-badge badge-sales">Revenue</span>
                                            </div>
                                            <div class="d-flex align-items-baseline justify-content-between">
                                                <h4 class="mb-0 fw-bold daily-val-text font-monospace text-success symbol invosymbol" id="kpi_sales_gross"><%= initialGross.toFixed(2) %></h4>
                                                <div class="daily-metric-icon icon-sales">
                                                    <i class="fa fa-chart-line"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Total Tax Collected -->
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="daily-sub-text small fw-medium text-truncate"><%= language.Total_Tax_Amount || 'Tax Collected' %></span>
                                                <span class="daily-badge badge-tax">Tax</span>
                                            </div>
                                            <div class="d-flex align-items-baseline justify-content-between">
                                                <h4 class="mb-0 fw-bold daily-val-text font-monospace text-info symbol invosymbol" id="kpi_sales_tax"><%= initialTax.toFixed(2) %></h4>
                                                <div class="daily-metric-icon icon-tax">
                                                    <i class="fa fa-file-invoice-dollar"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Total Discounts -->
                                <div class="col-12 col-sm-6 col-xl-3">
                                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="daily-sub-text small fw-medium text-truncate"><%= language.Discounts || 'Total Discounts' %></span>
                                                <span class="daily-badge badge-discount">Savings</span>
                                            </div>
                                            <div class="d-flex align-items-baseline justify-content-between">
                                                <h4 class="mb-0 fw-bold daily-val-text font-monospace text-warning symbol invosymbol" id="kpi_sales_discount"><%= initialDiscounts.toFixed(2) %></h4>
                                                <div class="daily-metric-icon icon-discount">
                                                    <i class="fa fa-tags"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Detailed Sales History Table -->
                            <div class="card border rounded-3 overflow-hidden shadow-none mb-4 daily-kpi-card" id="invoice_page">
                                <div class="card-header py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                                    <h6 class="mb-0 fw-semibold text-secondary">
                                        <i class="fa fa-list text-primary me-2"></i><%= language.Sales_Report || 'Sales Breakdown' %>
                                    </h6>
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Standard Report</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" id="sales_report_table">
                                        <thead class="table-light text-secondary border-bottom">
                                            <tr>
                                                <th class="ps-3 py-3" style="width: 10%;"><%= language.Date || 'Date' %></th>
                                                <th class="py-3" style="width: 11%;"><%= language.Order_ID || 'Order ID' %></th>
                                                <th class="py-3" style="width: 18%;"><%= language.Customers || 'Customer' %></th>
                                                <th class="py-3 text-end" style="width: 10%;"><%= language.Sub_Total || 'Sub Total' %></th>
                                                <th class="py-3 text-end" style="width: 10%;"><%= language.Addon_Total || 'Addon Total' %></th>
                                                <th class="py-3 text-end" style="width: 10%;"><%= language.Extra_Discount || 'Extra Disc.' %></th>
                                                <th class="py-3 text-end" style="width: 10%;"><%= language.Coupon_Discount || 'Coupon Disc.' %></th>
                                                <th class="py-3 text-end" style="width: 9%;"><%= language.Tax_Amount || 'Tax' %></th>
                                                <th class="pe-3 py-3 text-end" style="width: 12%;"><%= language.Gross_Total || 'Gross Total' %></th>
                                            </tr>
                                        </thead>
                                        <tbody id="tb_row_sales_report">
                                            <% if (salesdata && salesdata.length > 0) { %>
                                                <% salesdata.forEach(function (data){ %>
                                                    <tr>
                                                        <% let new_date = new Date(data.order_date) %>
                                                        <% let year = new_date.getFullYear() %>
                                                        <% let new_day = (new_date.getDate() < 10 ? '0' : '' ) + new_date.getDate() %>
                                                        <% let new_month = ((new_date.getMonth()+1) < 10 ? '0' : '' ) + (new_date.getMonth()+1) %>
                                                        <% let fullDate = `${year}-${new_month}-${new_day}` %>
                                                        <td class="ps-3 py-3 text-nowrap">
                                                            <i class="fa fa-calendar-alt text-muted me-1 fs-12"></i><%= fullDate %>
                                                        </td>
                                                        <td class="py-3">
                                                            <span class="order-id-badge">
                                                                <i class="fa fa-receipt me-1"></i><%= data.order_id %>
                                                            </span>
                                                        </td>
                                                        <td class="py-3 text-nowrap">
                                                            <div class="d-flex align-items-center">
                                                                <div class="bg-light rounded-circle p-1 me-2 d-inline-flex align-items-center justify-content-center" style="width: 26px; height: 26px;">
                                                                    <i class="fa fa-user text-muted fs-11"></i>
                                                                </div>
                                                                <span class="fw-medium daily-val-text"><%= data.custoname %></span>
                                                            </div>
                                                        </td>
                                                        <td class="symbol py-3 text-end font-monospace">
                                                            <%= Number(data.sub_total || 0).toFixed(2) %>
                                                        </td>
                                                        <td class="symbol py-3 text-end font-monospace">
                                                            <%= Number(data.addon_price || 0).toFixed(2) %>
                                                        </td>
                                                        <td class="symbol py-3 text-end font-monospace text-danger">
                                                            <%= Number(data.extra_discount || 0).toFixed(2) %>
                                                        </td>
                                                        <td class="symbol py-3 text-end font-monospace text-danger">
                                                            <%= Number(data.coupon_discount || 0).toFixed(2) %>
                                                        </td>
                                                        <td class="symbol py-3 text-end font-monospace">
                                                            <%= Number(data.tax_amount || 0).toFixed(2) %>
                                                        </td>
                                                        <td class="symbol py-3 pe-3 text-end font-monospace fw-bold fs-6 text-success">
                                                            <%= Number(data.gross_total || 0).toFixed(2) %>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="9" class="text-center py-4 text-muted">
                                                        <i class="fa fa-inbox fs-2 mb-2 d-block text-secondary opacity-50"></i>
                                                        No sales records found for the selected criteria.
                                                    </td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Bottom Summary & Action Bar -->
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 p-3 rounded-3 border bg-light-subtle filter-section">
                                <div class="d-flex align-items-center gap-3 flex-wrap">
                                    <div>
                                        <span class="text-muted small fw-medium"><%= language.Total_Orders || 'Total Orders' %>:</span>
                                        <span class="fw-bold font-monospace daily-val-text ms-1" id="sales_report"><%= (salesdata || []).length %></span>
                                    </div>
                                    <div class="vr"></div>
                                    <div>
                                        <span class="text-muted small fw-medium"><%= language.Total_Sales || 'Total Sales' %>:</span>
                                        <span class="fw-bold font-monospace text-success ms-1 symbol invosymbol" id="sales_report_amount"><%= initialGross.toFixed(2) %></span>
                                    </div>
                                    <div class="vr"></div>
                                    <div>
                                        <span class="text-muted small fw-medium"><%= language.Total_Tax_Amount || 'Total Tax' %>:</span>
                                        <span class="fw-bold font-monospace text-info ms-1 symbol invosymbol" id="sales_report_tax"><%= initialTax.toFixed(2) %></span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 bottom-summary-actions">
                                    <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" onclick="downloadsalesreport()">
                                        <i class="fa fa-download me-1"></i><%= language.Download_Report || 'Download' %>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" onclick="$('#order_report_print').click()">
                                        <i class="fa fa-print me-1"></i><%= language.Print_Report || 'Print' %>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--********** Content body end **********-->

    <!--********************************** Footer start ***********************************-->
    <%- include('templet/footer')-%>
    <!--********************************** Footer end ***********************************-->

    <!--********** Main wrapper end **********-->
    <%- include('templet/script')-%>

    <script>
        $(document).ready(function () {
            // Function to synchronize top KPI cards with the table and totals
            function syncSalesKpiMetrics() {
                var count = $('#sales_report').text().trim() || '0';
                var gross = $('#sales_report_amount').text().trim() || '0.00';
                var tax = $('#sales_report_tax').text().trim() || '0.00';
                $('#kpi_sales_orders').text(count);
                $('#kpi_sales_gross').text(gross);
                $('#kpi_sales_tax').text(tax);

                // Calculate total discounts (extra discount col 6 + coupon discount col 7)
                var discounts = 0;
                $('#tb_row_sales_report tr').each(function () {
                    var extraCell = $(this).find('td:nth-child(6)');
                    var couponCell = $(this).find('td:nth-child(7)');
                    if (extraCell.length > 0 && couponCell.length > 0) {
                        var extraVal = parseFloat(extraCell.text().replace(/[^0-9.-]+/g, "")) || 0;
                        var couponVal = parseFloat(couponCell.text().replace(/[^0-9.-]+/g, "")) || 0;
                        discounts += (extraVal + couponVal);
                    }
                });
                $('#kpi_sales_discount').text(discounts.toFixed(2));
            }

            // Sync on initial load
            setTimeout(syncSalesKpiMetrics, 200);

            // Observe table DOM mutations (triggered by salesreports AJAX in call.ejs)
            var targetTbody = document.getElementById('tb_row_sales_report');
            if (targetTbody && window.MutationObserver) {
                var observer = new MutationObserver(function () {
                    setTimeout(syncSalesKpiMetrics, 50);
                });
                observer.observe(targetTbody, { childList: true, subtree: true, characterData: true });
            }
        });
    </script>
</body>

</html>