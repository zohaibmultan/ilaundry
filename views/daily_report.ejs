<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>
    <style>
        /* Ensure filter dropdown displays on top of KPI metric cards */
        .filter-section {
            position: relative !important;
            z-index: 1050 !important;
            overflow: visible !important;
            background-color: rgba(0, 0, 0, 0.02);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
        [data-theme-version="dark"] .filter-section {
            background-color: rgba(255, 255, 255, 0.03) !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
        }
        .filter-section .bootstrap-select {
            width: 100% !important;
            position: relative !important;
            z-index: 1055 !important;
        }
        .filter-section .bootstrap-select .dropdown-menu {
            z-index: 1060 !important;
        }
        .filter-section .bootstrap-select.show {
            z-index: 1070 !important;
        }
        .kpi-row {
            position: relative;
            z-index: 1;
        }

        /* Metric & Table Icon Avatars - Crisp in Light & Dark Mode */
        .daily-metric-icon {
            width: 36px;
            height: 36px;
            min-width: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-size: 14px;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }

        /* Light Mode Icon Colors */
        .daily-metric-icon.icon-orders {
            background-color: rgba(0, 129, 238, 0.12) !important;
            color: #0081EE !important;
            border: 1px solid rgba(0, 129, 238, 0.25) !important;
        }
        .daily-metric-icon.icon-delivered {
            background-color: rgba(16, 185, 129, 0.12) !important;
            color: #10b981 !important;
            border: 1px solid rgba(16, 185, 129, 0.25) !important;
        }
        .daily-metric-icon.icon-sales {
            background-color: rgba(99, 102, 241, 0.12) !important;
            color: #6366f1 !important;
            border: 1px solid rgba(99, 102, 241, 0.25) !important;
        }
        .daily-metric-icon.icon-payment {
            background-color: rgba(6, 182, 212, 0.12) !important;
            color: #0891b2 !important;
            border: 1px solid rgba(6, 182, 212, 0.25) !important;
        }
        .daily-metric-icon.icon-expense {
            background-color: rgba(239, 68, 68, 0.12) !important;
            color: #ef4444 !important;
            border: 1px solid rgba(239, 68, 68, 0.25) !important;
        }

        /* Dark Mode Icon Colors - Vibrant High-Contrast */
        [data-theme-version="dark"] .daily-metric-icon.icon-orders {
            background-color: rgba(56, 189, 248, 0.2) !important;
            color: #38bdf8 !important;
            border-color: rgba(56, 189, 248, 0.4) !important;
        }
        [data-theme-version="dark"] .daily-metric-icon.icon-delivered {
            background-color: rgba(52, 211, 153, 0.2) !important;
            color: #34d399 !important;
            border-color: rgba(52, 211, 153, 0.4) !important;
        }
        [data-theme-version="dark"] .daily-metric-icon.icon-sales {
            background-color: rgba(165, 180, 252, 0.2) !important;
            color: #a5b4fc !important;
            border-color: rgba(165, 180, 252, 0.4) !important;
        }
        [data-theme-version="dark"] .daily-metric-icon.icon-payment {
            background-color: rgba(34, 211, 238, 0.2) !important;
            color: #22d3ee !important;
            border-color: rgba(34, 211, 238, 0.4) !important;
        }
        [data-theme-version="dark"] .daily-metric-icon.icon-expense {
            background-color: rgba(248, 113, 113, 0.2) !important;
            color: #f87171 !important;
            border-color: rgba(248, 113, 113, 0.4) !important;
        }

        /* Status Badges - Light & Dark Mode */
        .daily-badge {
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
        }
        .daily-badge.badge-orders {
            background: rgba(0, 129, 238, 0.1);
            color: #0081ee;
            border: 1px solid rgba(0, 129, 238, 0.25);
        }
        .daily-badge.badge-delivered {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.25);
        }
        .daily-badge.badge-sales {
            background: rgba(99, 102, 241, 0.1);
            color: #6366f1;
            border: 1px solid rgba(99, 102, 241, 0.25);
        }
        .daily-badge.badge-payment {
            background: rgba(6, 182, 212, 0.1);
            color: #0891b2;
            border: 1px solid rgba(6, 182, 212, 0.25);
        }
        .daily-badge.badge-expense {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.25);
        }

        [data-theme-version="dark"] .daily-badge.badge-orders {
            background: rgba(56, 189, 248, 0.18) !important;
            color: #38bdf8 !important;
            border-color: rgba(56, 189, 248, 0.35) !important;
        }
        [data-theme-version="dark"] .daily-badge.badge-delivered {
            background: rgba(52, 211, 153, 0.18) !important;
            color: #34d399 !important;
            border-color: rgba(52, 211, 153, 0.35) !important;
        }
        [data-theme-version="dark"] .daily-badge.badge-sales {
            background: rgba(165, 180, 252, 0.18) !important;
            color: #a5b4fc !important;
            border-color: rgba(165, 180, 252, 0.35) !important;
        }
        [data-theme-version="dark"] .daily-badge.badge-payment {
            background: rgba(34, 211, 238, 0.18) !important;
            color: #22d3ee !important;
            border-color: rgba(34, 211, 238, 0.35) !important;
        }
        [data-theme-version="dark"] .daily-badge.badge-expense {
            background: rgba(248, 113, 113, 0.18) !important;
            color: #f87171 !important;
            border-color: rgba(248, 113, 113, 0.35) !important;
        }

        /* Dark Mode Card Background & Text */
        [data-theme-version="dark"] .daily-kpi-card {
            background: rgba(18, 26, 44, 0.78) !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
        }
        [data-theme-version="dark"] .daily-val-text {
            color: #f8fafc !important;
        }
        [data-theme-version="dark"] .daily-sub-text {
            color: #94a3b8 !important;
        }
        [data-theme-version="dark"] .daily-amount-sales {
            color: #34d399 !important;
        }
        [data-theme-version="dark"] .daily-amount-payment {
            color: #38bdf8 !important;
        }
        [data-theme-version="dark"] .daily-amount-expense {
            color: #f87171 !important;
        }

        /* Dark Mode Table Styling */
        [data-theme-version="dark"] #daily_report_table thead.table-light,
        [data-theme-version="dark"] #daily_report_table thead.table-light th {
            background-color: rgba(255, 255, 255, 0.04) !important;
            color: #94a3b8 !important;
            border-bottom-color: rgba(255, 255, 255, 0.08) !important;
        }
        [data-theme-version="dark"] #daily_report_table tbody tr {
            border-bottom-color: rgba(255, 255, 255, 0.05) !important;
        }
        [data-theme-version="dark"] #daily_report_table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.03) !important;
        }

        /* Dark Mode Date Input & Calendar Picker Icon */
        [data-theme-version="dark"] input[type="date"],
        html[data-theme-version="dark"] input[type="date"],
        body[data-theme-version="dark"] input[type="date"],
        .dark-only input[type="date"] {
            color-scheme: dark !important;
        }
        [data-theme-version="dark"] input[type="date"]::-webkit-calendar-picker-indicator,
        html[data-theme-version="dark"] input[type="date"]::-webkit-calendar-picker-indicator,
        body[data-theme-version="dark"] input[type="date"]::-webkit-calendar-picker-indicator,
        .dark-only input[type="date"]::-webkit-calendar-picker-indicator {
            cursor: pointer !important;
            opacity: 0.95 !important;
            filter: invert(1) brightness(1.2) !important;
            transition: opacity 0.2s ease, filter 0.2s ease, transform 0.15s ease !important;
        }
        [data-theme-version="dark"] input[type="date"]::-webkit-calendar-picker-indicator:hover,
        html[data-theme-version="dark"] input[type="date"]::-webkit-calendar-picker-indicator:hover,
        body[data-theme-version="dark"] input[type="date"]::-webkit-calendar-picker-indicator:hover,
        .dark-only input[type="date"]::-webkit-calendar-picker-indicator:hover {
            opacity: 1 !important;
            filter: invert(1) brightness(1.4) !important;
            transform: scale(1.1);
        }

        /* Print styles for Daily Report */
        @media print {
            .nav-header,
            .header,
            .deznav,
            .footer,
            .filter-section,
            .btn-print,
            .btn {
                display: none !important;
            }
            .content-body {
                margin: 0 !important;
                padding: 0 !important;
            }
            .container-fluid {
                padding: 0 !important;
            }
            .card {
                border: 0 !important;
                box-shadow: none !important;
            }
            .card-header {
                border-bottom: 2px solid #000 !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
            }
            .table {
                width: 100% !important;
                border-collapse: collapse !important;
            }
            .table th, .table td {
                border-bottom: 1px solid #dee2e6 !important;
                padding: 8px 12px !important;
            }
            body {
                background: #fff !important;
                color: #000 !important;
            }
        }
    </style>
</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
    <!--********** Content body start **********-->
    <div class="content-body">
        <div class="container-fluid" style="min-height: 100vh;">
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3"  style="height: auto;">
                        <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                    <i class="fa fa-calendar-day text-primary me-2"></i><%= language.Daily_Report || 'Daily Report' %>
                                </h3>
                                <small class="text-muted"><%= language.Daily_Report_Subtitle || 'Review day-to-day revenue, order processing, and cash movements' %></small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 btn-print" onclick="window.print()">
                                    <i class="fa fa-print me-1"></i><%= language.Print || 'Print' %>
                                </button>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <!-- Hidden inputs required for global currency formatting -->
                            <div class="d-none">
                                <input type="hidden" name="sym" value="<%= accessdata.symbol %>">
                                <input type="hidden" name="pls" value="<%= accessdata.plac %>">
                                <input type="hidden" name="thousands_separator" value="<%= accessdata.thousands_separator %>">
                            </div>

                            <!-- Filter Section -->
                            <div class="filter-section p-3 rounded-3 mb-4">
                                <div class="row g-3 align-items-end">
                                    <div class="col-12 col-sm-6 col-md-4">
                                        <label for="daily_report_date" class="form-label fw-semibold text-secondary small mb-1">
                                            <i class="fa fa-calendar-alt text-primary me-1"></i><%= language.Date || 'Date' %>
                                        </label>
                                        <% let new_date = new Date(date) %>
                                        <% let year = new_date.getFullYear() %>
                                        <% let new_day = (new_date.getDate() < 10 ? '0' : '') + new_date.getDate() %>
                                        <% let new_month = ((new_date.getMonth() + 1) < 10 ? '0' : '') + (new_date.getMonth() + 1) %>
                                        <% let fullDate = `${year}-${new_month}-${new_day}` %>
                                        <input type="date" class="form-control" name="date" id="daily_report_date" value="<%= fullDate %>">
                                    </div>

                                    <div class="col-12 col-sm-6 col-md-4 <%= accessdata.logas == 'master' && accessdata.mutibranch ? '' : 'd-none' %>">
                                        <label class="form-label fw-semibold text-secondary small mb-1" for="daily_report_store">
                                            <i class="fa fa-store text-primary me-1"></i><%= language.Store_Name || 'Store Name' %>
                                        </label>
                                        <select class="default-select form-control wide w-100" data-width="100%" name="storeid" id="daily_report_store">
                                            <% storeList.forEach(function(x){ %>
                                                <option value="<%= x.id %>" <%=x.id==store ? 'selected' :'' %> ><%= x.name %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Top 5 KPI Summary Metric Cards -->
                            <div class="row g-3 mb-4 kpi-row position-relative" style="z-index: 1;">
                                <!-- Orders Booked -->
                                <div class="col-12 col-sm-6 col-xl">
                                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="daily-sub-text small fw-medium text-truncate"><%= language.Orders || 'Orders Booked' %></span>
                                                <span class="daily-badge badge-orders">Booked</span>
                                            </div>
                                            <div class="d-flex align-items-baseline justify-content-between">
                                                <h4 class="mb-0 fw-bold daily-val-text font-monospace" id="kpi_daily_orders"><%= orders %></h4>
                                                <div class="daily-metric-icon icon-orders">
                                                    <i class="fa fa-shopping-bag"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Delivered Orders -->
                                <div class="col-12 col-sm-6 col-xl">
                                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="daily-sub-text small fw-medium text-truncate"><%= language.No_of_Orders_Delivered || 'Delivered Orders' %></span>
                                                <span class="daily-badge badge-delivered">Delivered</span>
                                            </div>
                                            <div class="d-flex align-items-baseline justify-content-between">
                                                <h4 class="mb-0 fw-bold daily-val-text font-monospace" id="kpi_daily_ordersdelivery"><%= ordersdeliver %></h4>
                                                <div class="daily-metric-icon icon-delivered">
                                                    <i class="fa fa-check-circle"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Total Sales -->
                                <div class="col-12 col-sm-6 col-xl">
                                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="daily-sub-text small fw-medium text-truncate"><%= language.Total_Sales || 'Total Sales' %></span>
                                                <span class="daily-badge badge-sales">Invoiced</span>
                                            </div>
                                            <div class="d-flex align-items-baseline justify-content-between">
                                                <h4 class="mb-0 fw-bold daily-val-text font-monospace" id="kpi_daily_totalsale"><%= Number(orderstotalseal || 0).toFixed(0) %></h4>
                                                <div class="daily-metric-icon icon-sales">
                                                    <i class="fa fa-chart-line"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Collections / Payments -->
                                <div class="col-12 col-sm-6 col-xl">
                                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="daily-sub-text small fw-medium text-truncate"><%= language.Total_Payment || 'Collections' %></span>
                                                <span class="daily-badge badge-payment">Collected</span>
                                            </div>
                                            <div class="d-flex align-items-baseline justify-content-between">
                                                <h4 class="mb-0 fw-bold daily-val-text font-monospace" id="kpi_daily_payment"><%= Number(totalpay || 0).toFixed(0) %></h4>
                                                <div class="daily-metric-icon icon-payment">
                                                    <i class="fa fa-wallet"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Expenses -->
                                <div class="col-12 col-sm-6 col-xl">
                                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <span class="daily-sub-text small fw-medium text-truncate"><%= language.Total_Expence || 'Expenses' %></span>
                                                <span class="daily-badge badge-expense">Spent</span>
                                            </div>
                                            <div class="d-flex align-items-baseline justify-content-between">
                                                <h4 class="mb-0 fw-bold daily-val-text font-monospace" id="kpi_daily_expence"><%= Number(expence || 0).toFixed(0) %></h4>
                                                <div class="daily-metric-icon icon-expense">
                                                    <i class="fa fa-receipt"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Detailed Breakdown Table -->
                            <div class="card border rounded-3 overflow-hidden shadow-none mb-0 daily-kpi-card">
                                <div class="card-header py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                                    <h6 class="mb-0 fw-semibold text-secondary">
                                        <i class="fa fa-list-alt text-primary me-2"></i><%= language.Daily_Breakdown || 'Summary Breakdown' %>
                                    </h6>
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Standard Report</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" id="daily_report_table">
                                        <thead class="table-light text-secondary border-bottom">
                                            <tr>
                                                <th class="ps-3 py-3" style="width: 45%;"><%= language.Particulars || 'Particulars' %></th>
                                                <th class="py-3" style="width: 25%;"><%= language.Category || 'Category' %></th>
                                                <th class="pe-3 py-3 text-end" style="width: 30%;"><%= language.Value || 'Amount / Value' %></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="ps-3 py-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="daily-metric-icon icon-orders me-3">
                                                            <i class="fa fa-shopping-bag"></i>
                                                        </div>
                                                        <div>
                                                            <div class="fw-semibold daily-val-text"><%= language.Orders || 'Orders Booked' %></div>
                                                            <small class="daily-sub-text">Total orders registered on this day</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="py-3">
                                                    <span class="daily-badge badge-orders">Order Volume</span>
                                                </td>
                                                <td class="pe-3 py-3 text-end font-monospace fw-bold fs-6 daily-val-text" id="daily_report_orders">
                                                    <%= orders %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="ps-3 py-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="daily-metric-icon icon-delivered me-3">
                                                            <i class="fa fa-check-circle"></i>
                                                        </div>
                                                        <div>
                                                            <div class="fw-semibold daily-val-text"><%= language.No_of_Orders_Delivered || 'No. of Orders Delivered' %></div>
                                                            <small class="daily-sub-text">Orders marked as delivered on this day</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="py-3">
                                                    <span class="daily-badge badge-delivered">Fulfillment</span>
                                                </td>
                                                <td class="pe-3 py-3 text-end font-monospace fw-bold fs-6 daily-val-text" id="daily_report_ordersdelivery">
                                                    <%= ordersdeliver %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="ps-3 py-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="daily-metric-icon icon-sales me-3">
                                                            <i class="fa fa-chart-line"></i>
                                                        </div>
                                                        <div>
                                                            <div class="fw-semibold daily-val-text"><%= language.Total_Sales || 'Total Sales' %></div>
                                                            <small class="daily-sub-text">Gross order value booked</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="py-3">
                                                    <span class="daily-badge badge-sales">Revenue</span>
                                                </td>
                                                <td class="pe-3 py-3 text-end font-monospace fw-bold fs-6 text-success daily-amount-sales symbol" id="daily_report_totalsale">
                                                    <%= Number(orderstotalseal || 0).toFixed(0) %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="ps-3 py-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="daily-metric-icon icon-payment me-3">
                                                            <i class="fa fa-wallet"></i>
                                                        </div>
                                                        <div>
                                                            <div class="fw-semibold daily-val-text"><%= language.Total_Payment || 'Total Payment' %></div>
                                                            <small class="daily-sub-text">Total payments received / collected</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="py-3">
                                                    <span class="daily-badge badge-payment">Collections</span>
                                                </td>
                                                <td class="pe-3 py-3 text-end font-monospace fw-bold fs-6 text-info daily-amount-payment symbol" id="daily_report_payment">
                                                    <%= Number(totalpay || 0).toFixed(0) %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="ps-3 py-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="daily-metric-icon icon-expense me-3">
                                                            <i class="fa fa-receipt"></i>
                                                        </div>
                                                        <div>
                                                            <div class="fw-semibold daily-val-text"><%= language.Total_Expence || 'Total Expense' %></div>
                                                            <small class="daily-sub-text">Total expenses debited</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="py-3">
                                                    <span class="daily-badge badge-expense">Expenditure</span>
                                                </td>
                                                <td class="pe-3 py-3 text-end font-monospace fw-bold fs-6 text-danger daily-amount-expense symbol" id="daily_report_expence">
                                                    <%= Number(expence || 0).toFixed(0) %>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--********** Content body end **********-->

    <!--********************************** Footer start ***********************************-->
    <%- include('templet/footer')-%>
    <!--********************************** Footer end ***********************************-->

    <!--********** Main wrapper end **********-->
    <%- include('templet/script')-%>

    <script>
        $(document).ready(function () {
            // Function to sync top KPI summary cards with the breakdown table values
            function syncKpiCards() {
                var orders = $('#daily_report_orders').text().trim();
                var ordersdelivery = $('#daily_report_ordersdelivery').text().trim();
                var totalsale = $('#daily_report_totalsale').text().trim();
                var payment = $('#daily_report_payment').text().trim();
                var expence = $('#daily_report_expence').text().trim();

                if (orders) $('#kpi_daily_orders').text(orders);
                if (ordersdelivery) $('#kpi_daily_ordersdelivery').text(ordersdelivery);
                if (totalsale) $('#kpi_daily_totalsale').text(totalsale);
                if (payment) $('#kpi_daily_payment').text(payment);
                if (expence) $('#kpi_daily_expence').text(expence);
            }

            // Sync on initial page load after currency formatting runs
            setTimeout(syncKpiCards, 150);

            // Observe table DOM mutations (triggered by dailyorder AJAX updates)
            var targetTable = document.getElementById('daily_report_table');
            if (targetTable && window.MutationObserver) {
                var observer = new MutationObserver(function () {
                    syncKpiCards();
                });
                observer.observe(targetTable, { childList: true, subtree: true, characterData: true });
            }
        });
    </script>
</body>

</html>