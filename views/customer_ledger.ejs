<!DOCTYPE html>
<html lang="en" class="h-100">


<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>
        <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="d-none">
                        <input type="hiden" name="sym" value="<%= accessdata.symbol %>">
                        <input type="hiden" name="pls" value="<%= accessdata.plac %>">
                        <input type="hiden" name="thousands_separator" value="<%= accessdata.thousands_separator %>">
                    </div>
                    <div class="col-12">
                        <div class="card ">
                            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div>
                                    <h4 class="card-title mb-1 text-primary fw-bold">
                                        <i class="fas fa-book-open me-2"></i>
                                        <%= language.Customer_Ledger || 'Customer Ledger' %>: 
                                        <span class="text-dark"><%= customer ? customer.name : '' %></span>
                                    </h4>
                                    <% if (customer) { %>
                                        <div class="text-muted text-sm d-flex flex-wrap align-items-center gap-3">
                                            <% if (customer.number) { %>
                                                <span>
                                                    <i class="fas fa-phone-alt me-1 text-success"></i> <strong><%= customer.number %></strong>
                                                </span>
                                            <% } %>
                                            <% if (customer.email) { %>
                                                <span>
                                                    <i class="fas fa-envelope me-1 text-info"></i> <%= customer.email %>
                                                </span>
                                            <% } %>
                                            <% if (customer.address) { %>
                                                <span>
                                                    <i class="fas fa-map-marker-alt me-1 text-secondary"></i> <%= customer.address %>
                                                </span>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                                <div>
                                    <a href="/coustomer/list" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-arrow-left me-1"></i> <%= language.Back || 'Back to Customers' %>
                                    </a>
                                </div>
                            </div>
                            <div class="card-body">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="row g-2 mb-3">
                                    <div class="col-12 col-md-4 col-lg-3">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                            <input class="form-control" type="search" id="dtLedgerSearch" placeholder="<%= language.Search || 'Search account, description, type, amount...' %>">
                                        </div>
                                    </div>
                                    <div class="col-6 col-sm-6 col-md-2 col-lg-2">
                                        <select class="form-select" id="dtLedgerType">
                                            <option value="all"><%= language.All_Type || 'All Types' %></option>
                                            <option value="Debit"><%= language.Debit || 'Debit' %></option>
                                            <option value="Credit"><%= language.Credit || 'Credit' %></option>
                                        </select>
                                    </div>

                                    <div class="col-6 col-sm-3 col-md-3 col-lg-2">
                                        <input type="date" class="form-control" id="dtLedgerStartDate" title="<%= language.Start_Date || 'Start Date' %>">
                                    </div>
                                    <div class="col-6 col-sm-3 col-md-3 col-lg-2">
                                        <input type="date" class="form-control" id="dtLedgerEndDate" title="<%= language.End_Date || 'End Date' %>">
                                    </div>

                                    <div class="col-6 col-sm-6 col-md-2 col-lg-3">
                                        <select class="form-select" id="dtLedgerPageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_ledger_table" class="table display server-side-dt" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th style="width: 120px;"><%= language.Date %></th>
                                                <th><%= language.Account %></th>
                                                <th style="width: 110px;"><%= language.Type %></th>
                                                <th><%= language.Description %></th>
                                                <th class="text-end" style="width: 120px;"><%= language.Debit %></th>
                                                <th class="text-end" style="width: 120px;"><%= language.Credit %></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <!--********** Content body end **********-->

        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

            <!--**********************************
            Footer end
        ***********************************-->

            </div>

            <!--********** Main wrapper end **********-->
            <%- include('templet/script')-%>
<script>
  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  $(document).ready(function () {
    const customerId = "<%= customer ? customer.id : '' %>";

    window.ledgerTable = window.initServerDataTable('#server_ledger_table', {
      ajaxUrl: '/coustomer/ledger/' + customerId + '/data',
      columns: [
        {
          data: null,
          orderable: false,
          searchable: false,
          render: function(data, type, row, meta) {
            return meta.settings._iDisplayStart + meta.row + 1;
          }
        },
        {
          data: 'date',
          render: function(data) {
            return `<span class="fw-semibold text-dark">${escapeHtml(data) || '—'}</span>`;
          }
        },
        {
          data: 'ac_name',
          render: function(data) {
            return `<span class="badge bg-light text-dark px-2 py-1">${escapeHtml(data) || '—'}</span>`;
          }
        },
        {
          data: 'transec_type',
          render: function(data) {
            const isDebit = String(data).toLowerCase() === 'debit';
            if (isDebit) {
              return '<span class="badge-status-pill badge-pill-cancelled"><i class="fa fa-arrow-circle-up"></i> ' + escapeHtml(data) + '</span>';
            }
            return '<span class="badge-status-pill badge-pill-completed"><i class="fa fa-arrow-circle-down"></i> ' + escapeHtml(data) + '</span>';
          }
        },
        {
          data: 'transec_detail',
          render: function(data) {
            return `<span class="text-sm text-secondary">${escapeHtml(data) || '—'}</span>`;
          }
        },
        {
          data: 'debit_amount',
          className: 'text-end',
          render: function(data) {
            const amt = parseFloat(data) || 0;
            if (amt <= 0) return '<span class="text-muted">—</span>';
            return `<span class="fw-bold text-danger">${window.formatDtCurrency(amt)}</span>`;
          }
        },
        {
          data: 'credit_amount',
          className: 'text-end',
          render: function(data) {
            const amt = parseFloat(data) || 0;
            if (amt <= 0) return '<span class="text-muted">—</span>';
            return `<span class="fw-bold text-success">${window.formatDtCurrency(amt)}</span>`;
          }
        }
      ],
      order: [[0, 'desc']],
      searchInput: '#dtLedgerSearch',
      pageLengthSelect: '#dtLedgerPageLength',
      filterElements: {
        type_filter: '#dtLedgerType',
        start_date: '#dtLedgerStartDate',
        end_date: '#dtLedgerEndDate'
      }
    });
  });
</script>         


</body>


</html>