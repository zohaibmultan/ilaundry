  <!-- Embedded Enriched Order Data (XSS-safe JSON payload) -->
  <script type="application/json" id="customer_orders_json"><%- JSON.stringify(allOrders).replace(/</g, '\\u003c') %></script>

  <%- include('templet/footer') -%>
  <%- include('templet/script') -%>

  <script>
    (function () {
      'use strict';

      var rawJsonEl = document.getElementById('customer_orders_json');
      var allOrdersList = [];
      try {
        allOrdersList = rawJsonEl ? JSON.parse(rawJsonEl.textContent || '[]') : [];
      } catch (err) {
        allOrdersList = [];
      }

      var ordersById = {};
      allOrdersList.forEach(function (ord) {
        ordersById[String(ord.id)] = ord;
      });

      var curSymbol = <%- JSON.stringify(curSymbol) %>;

      function escHtml(str) {
        return String(str === undefined || str === null ? '' : str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function notifySuccess(msg) {
        if (typeof toastr !== 'undefined') toastr.success(msg);
        else alert(msg);
      }

      function notifyError(msg) {
        if (typeof toastr !== 'undefined') toastr.error(msg);
        else alert(msg);
      }

      function toggleSubmitLoading($btn, isLoading, defaultHtml) {
        if (isLoading) {
          $btn.data('orig-html', $btn.html());
          $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Please wait...');
        } else {
          $btn.prop('disabled', false).html(defaultHtml || $btn.data('orig-html') || 'Submit');
        }
      }

      // 1. Submit New Pick-up Request
      $('#newPickupRequestForm').on('submit', function (e) {
        e.preventDefault();
        var pickupDate = $('#new_pickup_date').val();
        var pickupTime = $('#new_pickup_time').val();
        var orderType = $('input[name="order_type"]:checked', '#newPickupRequestForm').val() || 'Route • Route';
        var pickupAddress = ($('#new_pickup_address').val() || '').trim();
        var saveAddress = $('#new_save_address').is(':checked');
        var note = ($('#new_pickup_note').val() || '').trim();

        if (!pickupDate || !pickupTime) {
          notifyError('Please choose both pick-up date and time.');
          return;
        }
        if (!pickupAddress) {
          notifyError('Please provide a pick-up address.');
          $('#new_pickup_address').focus();
          return;
        }

        var $btn = $('#btnSubmitNewPickup');
        toggleSubmitLoading($btn, true);

        $.ajax({
          url: '/order/customer/pickup-request',
          type: 'POST',
          contentType: 'application/json',
          data: JSON.stringify({
            pickup_date: pickupDate,
            pickup_time: pickupTime,
            order_type: orderType,
            pickup_address: pickupAddress,
            save_address: saveAddress,
            note: note
          }),
          success: function (res) {
            toggleSubmitLoading($btn, false);
            if (res && res.success) {
              $('#newPickupRequestModal').modal('hide');
              notifySuccess(res.message || 'Pick-up request submitted!');
              setTimeout(function () { window.location.reload(); }, 600);
            } else {
              notifyError((res && res.message) || 'Could not submit pick-up request.');
            }
          },
          error: function (xhr) {
            toggleSubmitLoading($btn, false);
            var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to submit pick-up request.';
            notifyError(msg);
          }
        });
      });

      // 2. Populate Edit Modal (Dual-binding: button click + show.bs.modal with closest trigger resolution)
      function populateEditPickupModal(orderId) {
        var ord = ordersById[String(orderId)];
        if (!ord) return;

        $('#edit_order_id').val(ord.id);
        $('#edit_order_code_label').text('#' + (ord.order_id || ord.id));
        $('#editPickupRequestForm').attr('data-target-url', '/order/customer/pickup-request/' + encodeURIComponent(ord.id) + '/update');
        $('#edit_pickup_date').val(ord.pickupDateIso || '');
        $('#edit_pickup_time').val(ord.pickupTimeIso || '10:00');
        $('#edit_pickup_address').val(ord.pickup_address || '');
        $('#edit_save_address').prop('checked', false);
        $('#edit_pickup_note').val(ord.note || '');

        var isCounterReturn = String(ord.canonicalOrderType || '').indexOf('Counter') !== -1 &&
          String(ord.canonicalOrderType || '').indexOf('Route • Counter') !== -1;
        $('#edit_type_delivery').prop('checked', !isCounterReturn);
        $('#edit_type_counter').prop('checked', isCounterReturn);
      }

      $(document).on('click', '.btn-edit-pickup', function () {
        var orderId = $(this).closest('.btn-edit-pickup').attr('data-order-id');
        if (orderId) populateEditPickupModal(orderId);
      });

      $('#editPickupRequestModal').on('show.bs.modal', function (e) {
        var $btn = $(e.relatedTarget).closest('.btn-edit-pickup, [data-bs-target="#editPickupRequestModal"]');
        var orderId = $btn.attr('data-order-id');
        if (orderId) populateEditPickupModal(orderId);
      });

      $('#editPickupRequestForm').on('submit', function (e) {
        e.preventDefault();
        var orderId = $('#edit_order_id').val();
        var targetUrl = $(this).attr('data-target-url') || '';
        if (!orderId || !targetUrl || targetUrl.indexOf('undefined') !== -1) {
          notifyError('Invalid request selection. Please close and reopen the dialog.');
          return false;
        }

        var pickupDate = $('#edit_pickup_date').val();
        var pickupTime = $('#edit_pickup_time').val();
        var orderType = $('input[name="order_type"]:checked', '#editPickupRequestForm').val() || 'Route • Route';
        var pickupAddress = ($('#edit_pickup_address').val() || '').trim();
        var saveAddress = $('#edit_save_address').is(':checked');
        var note = ($('#edit_pickup_note').val() || '').trim();

        if (!pickupDate || !pickupTime || !pickupAddress) {
          notifyError('Please fill in date, time, and pick-up address.');
          return;
        }

        var $btn = $('#btnSubmitEditPickup');
        toggleSubmitLoading($btn, true);

        $.ajax({
          url: targetUrl,
          type: 'POST',
          contentType: 'application/json',
          data: JSON.stringify({
            pickup_date: pickupDate,
            pickup_time: pickupTime,
            order_type: orderType,
            pickup_address: pickupAddress,
            save_address: saveAddress,
            note: note
          }),
          success: function (res) {
            toggleSubmitLoading($btn, false);
            if (res && res.success) {
              $('#editPickupRequestModal').modal('hide');
              notifySuccess(res.message || 'Pick-up schedule updated.');
              setTimeout(function () { window.location.reload(); }, 600);
            } else {
              notifyError((res && res.message) || 'Could not update pick-up request.');
            }
          },
          error: function (xhr) {
            toggleSubmitLoading($btn, false);
            var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to update pick-up request.';
            notifyError(msg);
          }
        });
      });

      // 3. Populate & Submit Cancel Modal (Dual-binding + Submission Guard)
      function populateCancelPickupModal(orderId) {
        var ord = ordersById[String(orderId)];
        if (!ord) return;

        $('#cancel_order_id').val(ord.id);
        $('#cancel_order_code_label').text('#' + (ord.order_id || ord.id));
        $('#cancel_schedule_summary').text(
          ord.hasPickup && ord.formattedPickupDateTime
            ? ('Currently scheduled for: ' + ord.formattedPickupDateTime)
            : ''
        );
        $('#cancel_reason').val('');
        $('#cancelPickupRequestForm').attr('data-target-url', '/order/customer/pickup-request/' + encodeURIComponent(ord.id) + '/cancel');
      }

      $(document).on('click', '.btn-cancel-pickup', function () {
        var orderId = $(this).closest('.btn-cancel-pickup').attr('data-order-id');
        if (orderId) populateCancelPickupModal(orderId);
      });

      $('#cancelPickupRequestModal').on('show.bs.modal', function (e) {
        var $btn = $(e.relatedTarget).closest('.btn-cancel-pickup, [data-bs-target="#cancelPickupRequestModal"]');
        var orderId = $btn.attr('data-order-id');
        if (orderId) populateCancelPickupModal(orderId);
      });

      $('#cancelPickupRequestForm').on('submit', function (e) {
        e.preventDefault();
        var orderId = $('#cancel_order_id').val();
        var targetUrl = $(this).attr('data-target-url') || '';
        if (!orderId || !targetUrl || targetUrl.indexOf('undefined') !== -1) {
          notifyError('Invalid request selection. Please close and reopen the dialog.');
          return false;
        }

        var $btn = $('#btnConfirmCancelPickup');
        toggleSubmitLoading($btn, true);

        $.ajax({
          url: targetUrl,
          type: 'POST',
          contentType: 'application/json',
          data: JSON.stringify({
            reason: ($('#cancel_reason').val() || '').trim()
          }),
          success: function (res) {
            toggleSubmitLoading($btn, false);
            if (res && res.success) {
              $('#cancelPickupRequestModal').modal('hide');
              notifySuccess(res.message || 'Pick-up request cancelled.');
              setTimeout(function () { window.location.reload(); }, 600);
            } else {
              notifyError((res && res.message) || 'Could not cancel pick-up request.');
            }
          },
          error: function (xhr) {
            toggleSubmitLoading($btn, false);
            var msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Failed to cancel pick-up request.';
            notifyError(msg);
          }
        });
      });

      // 4. Populate History Timeline Modal
      function populateTimelineModal(orderId) {
        var ord = ordersById[String(orderId)];
        if (!ord) return;

        $('#tl_modal_code').text('#' + (ord.order_id || ord.id));
        $('#tl_modal_invoice_link').attr('href', '/order/view/' + encodeURIComponent(ord.id));

        var html = '<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-2 border-bottom">';
        html += '<div><span class="badge-status-pill ' + escHtml(ord.statusBadgeClass) + ' me-2">' + escHtml(ord.statusDisplay) + '</span>';
        html += '<span class="badge bg-info-subtle">' + escHtml(ord.orderTypeDisplay) + '</span></div>';
        html += '<small class="text-muted">Store: <strong>' + escHtml(ord.storeLabel) + '</strong></small>';
        html += '</div>';

        if (ord.isCancelled) {
          html += '<div class="alert alert-danger py-2 px-3 fs-12 mb-3">';
          html += '<i class="fas fa-ban me-1"></i><strong>Cancelled</strong>';
          if (ord.void_reason) html += ' — Reason: ' + escHtml(ord.void_reason);
          html += '</div>';
        }

        html += '<div class="d-flex flex-column gap-2 mb-3">';
        (ord.stages || []).forEach(function (st, idx) {
          var badgeCls = st.state === 'done'
            ? 'bg-success text-white'
            : (st.state === 'current' ? 'bg-primary text-white' : (st.state === 'cancelled' ? 'bg-danger-subtle' : 'bg-secondary-subtle'));
          html += '<div class="border rounded-3 p-2 d-flex align-items-center gap-3">';
          html += '<span class="badge ' + badgeCls + ' rounded-pill"><i class="fas ' + escHtml(st.state === 'done' ? 'fa-check' : st.icon) + '"></i></span>';
          html += '<div><div class="fw-bold fs-13 server-dt-primary-text">' + (idx + 1) + '. ' + escHtml(st.title) + '</div>';
          html += '<div class="text-muted fs-12">' + escHtml(st.subtitle) + '</div></div>';
          html += '</div>';
        });
        html += '</div>';

        if (ord.pickup_address) {
          html += '<div class="fs-12 text-muted mb-2"><i class="fas fa-map-marker-alt text-danger me-1"></i><strong>Pick-up Address:</strong> ' + escHtml(ord.pickup_address) + '</div>';
        }
        if (ord.note) {
          html += '<div class="fs-12 text-muted mb-3"><i class="fas fa-comment-dots text-primary me-1"></i><strong>Notes:</strong> ' + escHtml(ord.note) + '</div>';
        }

        if (ord.items && ord.items.length > 0) {
          html += '<div class="table-responsive border rounded-3"><table class="table table-sm mb-0"><thead><tr><th>Service</th><th>Type</th><th class="text-center">Qty</th><th class="text-end">Total</th></tr></thead><tbody>';
          ord.items.forEach(function (it) {
            html += '<tr><td>' + escHtml(it.service_name) + '</td><td class="text-muted fs-12">' + escHtml(it.service_type_name) + '</td><td class="text-center">' + escHtml(it.qty) + '</td><td class="text-end">' + escHtml(curSymbol) + Number(it.lineTotal || 0).toFixed(2) + '</td></tr>';
          });
          html += '</tbody><tfoot><tr><td colspan="3" class="text-end fw-bold">Gross Total:</td><td class="text-end fw-bold">' + escHtml(curSymbol) + Number(ord.grossTotal || 0).toFixed(2) + '</td></tr></tfoot></table></div>';
        } else {
          html += '<div class="alert alert-info py-2 px-3 fs-12 mb-0"><i class="fas fa-info-circle me-1"></i>0 items itemized on this request.</div>';
        }

        $('#tl_modal_body').html(html);
      }

      $(document).on('click', '.btn-view-timeline', function () {
        var orderId = $(this).closest('.btn-view-timeline').attr('data-order-id');
        if (orderId) populateTimelineModal(orderId);
      });

      $('#requestTimelineModal').on('show.bs.modal', function (e) {
        var $btn = $(e.relatedTarget).closest('.btn-view-timeline, [data-bs-target="#requestTimelineModal"]');
        var orderId = $btn.attr('data-order-id');
        if (orderId) populateTimelineModal(orderId);
      });

      // 5. Request History Filter & Search
      var currentCategory = 'all';

      function applyHistoryFilters() {
        var query = ($('#portalHistorySearch').val() || '').trim().toLowerCase();
        var visibleCount = 0;

        $('.portal-history-row').each(function () {
          var $row = $(this);
          var cat = $row.attr('data-category');
          var searchBlob = $row.attr('data-search') || '';
          var matchesCategory = currentCategory === 'all' || cat === currentCategory;
          var matchesSearch = !query || searchBlob.indexOf(query) !== -1;

          if (matchesCategory && matchesSearch) {
            $row.removeClass('d-none');
            visibleCount++;
          } else {
            $row.addClass('d-none');
          }
        });

        if (visibleCount === 0 && $('.portal-history-row').length > 0) {
          $('#portalHistoryEmptyRow').removeClass('d-none');
        } else {
          $('#portalHistoryEmptyRow').addClass('d-none');
        }
      }

      $('.portal-filter-btn').on('click', function () {
        var $clicked = $(this);
        currentCategory = $clicked.attr('data-filter') || 'all';
        $('.portal-filter-btn').each(function () {
          var $btn = $(this);
          var f = $btn.attr('data-filter');
          $btn.removeClass('active btn-primary btn-success btn-danger');
          if (f === 'all' || f === 'active') $btn.addClass('btn-outline-primary');
          if (f === 'completed') $btn.addClass('btn-outline-success');
          if (f === 'cancelled') $btn.addClass('btn-outline-danger');
        });
        $clicked.removeClass('btn-outline-primary btn-outline-success btn-outline-danger').addClass('active');
        if (currentCategory === 'completed') $clicked.addClass('btn-success');
        else if (currentCategory === 'cancelled') $clicked.addClass('btn-danger');
        else $clicked.addClass('btn-primary');
        applyHistoryFilters();
      });

      $('#portalHistorySearch').on('input keyup', applyHistoryFilters);
    })();
  </script>
</body>

</html>
