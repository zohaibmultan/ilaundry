<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="iLaundry">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= data?.app_name || '' %> &bull; Set New Password
    </title>

    <!-- Early Theme Loader -->
    <script>
        (function () {
            try {
                function getCookie(name) {
                    var nameEQ = name + "=";
                    var ca = document.cookie.split(';');
                    for (var i = 0; i < ca.length; i++) {
                        var c = ca[i];
                        while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                        if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
                    }
                    return null;
                }
                var savedTheme = getCookie('theme_version') || localStorage.getItem('theme_version') || 'light';
                if (savedTheme === 'dark') {
                    document.documentElement.setAttribute('data-theme-version', 'dark');
                    document.documentElement.classList.add('dark-only');
                } else {
                    document.documentElement.setAttribute('data-theme-version', 'light');
                    document.documentElement.classList.remove('dark-only');
                }
            } catch (e) { }
        })();
    </script>

    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="/uploads/<%= data?.app_favicon || '' %>">
    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="/vendor/bootstrap-select/dist/css/bootstrap-select.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/liquid-glass-theme.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Toastr -->
    <link rel="stylesheet" href="/vendor/toastr/css/toastr.min.css">
</head>

<body>
    <div class="auth-split-wrapper">
        <!-- Floating Theme Switcher -->
        <div class="auth-top-controls">
            <button type="button" class="auth-theme-btn" id="auth_theme_toggle" title="Switch Theme">
                <i class="fas fa-moon lighticon"></i>
                <i class="fas fa-sun darkicon d-none"></i>
                <span id="theme_label">Dark Mode</span>
            </button>
        </div>

        <!-- Left Canvas: Branding & Hero Showcase -->
        <div class="auth-hero-canvas">
            <div class="auth-hero-glow-1"></div>
            <div class="auth-hero-glow-2"></div>

            <div class="auth-hero-brand">
                <img src="/uploads/<%= data?.app_logo || '' %>" class="auth-hero-brand-logo"
                    alt="<%= data?.app_name || '' %> Logo">
                <h2 class="auth-hero-brand-title">
                    <%= data?.app_name || '' %>
                </h2>
            </div>

            <div class="auth-hero-content">
                <div class="auth-hero-badge">
                    <i class="fas fa-shield-check"></i> Verified Token Session
                </div>
                <h1 class="auth-hero-heading">
                    Create a Strong<br>New Password.
                </h1>
                <p class="auth-hero-lead">
                    Choose a secure, memorable password to protect your account, orders, and customer data. Once saved,
                    you will be redirected to sign in immediately.
                </p>

                <div class="auth-hero-pills">
                    <div class="auth-hero-pill">
                        <div class="auth-pill-icon"><i class="fas fa-fingerprint"></i></div>
                        <div>
                            <div class="auth-pill-text">Verified Identity</div>
                            <div class="fs-11 text-muted">Account: <%= user?.username || user?.email %>
                            </div>
                        </div>
                    </div>
                    <div class="auth-hero-pill">
                        <div class="auth-pill-icon"><i class="fas fa-lock"></i></div>
                        <div>
                            <div class="auth-pill-text">Bcrypt Salted Hash</div>
                            <div class="fs-11 text-muted">10-Round Security</div>
                        </div>
                    </div>
                    <div class="auth-hero-pill">
                        <div class="auth-pill-icon"><i class="fas fa-sync-alt"></i></div>
                        <div>
                            <div class="auth-pill-text">Instant Sync</div>
                            <div class="fs-11 text-muted">Immediate Session Update</div>
                        </div>
                    </div>
                    <div class="auth-hero-pill">
                        <div class="auth-pill-icon"><i class="fas fa-history"></i></div>
                        <div>
                            <div class="auth-pill-text">Token Burned</div>
                            <div class="fs-11 text-muted">Single-Use Guarantee</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-hero-footer">
                <span>
                    <%= data?.footer_text || 'Copyright &copy; 2026 iLaundry Inc.' %>
                </span>
                <span><i class="fas fa-circle text-success me-1 fs-9"></i> Secure Tunnel Active</span>
            </div>
        </div>

        <!-- Right Canvas: Auth Form -->
        <div class="auth-form-canvas">
            <div class="auth-glass-card">
                <div class="auth-card-header">
                    <a href="/">
                        <img src="/uploads/<%= data?.app_logo || '' %>" class="auth-card-logo"
                            alt="<%= data?.app_name || '' %>">
                    </a>
                    <h3 class="auth-card-title">Set New Password</h3>
                    <p class="auth-card-subtitle">
                        Resetting credentials for <strong class="text-primary">
                            <%= user?.username || user?.email %>
                        </strong>
                    </p>
                </div>

                <form action="/reset-password" method="POST" id="reset_form">
                    <input type="hidden" name="token" value="<%= token %>">

                    <!-- New Password -->
                    <div class="mb-3">
                        <label class="form-label mb-1"><strong>New Password</strong> <span
                                class="text-danger">*</span></label>
                        <div class="position-relative">
                            <input type="password" class="form-control pe-5" id="new_password" name="password"
                                placeholder="At least 6 characters" required autofocus minlength="4">
                            <button type="button" class="password-toggle-btn"
                                onclick="togglePasswordVisibility('new_password', this)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <div class="pw-strength-bar">
                            <div class="pw-strength-fill" id="strength_fill"></div>
                        </div>
                        <div class="fs-11 text-muted mt-1 d-flex justify-content-between">
                            <span id="strength_text">Password strength: Weak</span>
                            <span>Min. 4 characters</span>
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-3">
                        <label class="form-label mb-1"><strong>Confirm New Password</strong> <span
                                class="text-danger">*</span></label>
                        <div class="position-relative">
                            <input type="password" class="form-control pe-5" id="confirm_password"
                                name="confirm_password" placeholder="Re-enter your new password" required minlength="4">
                            <button type="button" class="password-toggle-btn"
                                onclick="togglePasswordVisibility('confirm_password', this)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <div class="fs-11 mt-1" id="match_feedback"></div>
                    </div>

                    <button type="submit" class="auth-submit-btn mt-4" id="submit_btn">
                        <i class="fas fa-check-circle me-1"></i> Update Password & Sign In
                    </button>
                </form>

                <div class="text-center mt-4 pt-2 border-top">
                    <p class="fs-13 text-muted mb-0">
                        Cancel and return to
                        <a href="/" class="text-primary fw-bold text-decoration-none ms-1">
                            <i class="fas fa-arrow-left me-1"></i> Sign In
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/vendor/global/global.min.js"></script>
    <script src="/vendor/toastr/js/toastr.min.js"></script>

    <!-- Theme Switcher & Password Handlers -->
    <script>
        function setCookie(name, value, days) {
            var expires = "";
            if (days) {
                var date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }
            document.cookie = name + "=" + (value || "") + expires + "; path=/";
        }

        function getCookie(name) {
            var nameEQ = name + "=";
            var ca = document.cookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
            }
            return null;
        }

        function applyAuthTheme(theme) {
            if (theme === 'dark') {
                $('html, body').attr('data-theme-version', 'dark').addClass('dark-only');
                $('.lighticon').addClass('d-none');
                $('.darkicon').removeClass('d-none');
                $('#theme_label').text('Light Mode');
            } else {
                $('html, body').attr('data-theme-version', 'light').removeClass('dark-only');
                $('.lighticon').removeClass('d-none');
                $('.darkicon').addClass('d-none');
                $('#theme_label').text('Dark Mode');
            }
        }

        function togglePasswordVisibility(fieldId, btn) {
            var input = document.getElementById(fieldId);
            var icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        $(document).ready(function () {
            var currentTheme = getCookie('theme_version') || localStorage.getItem('theme_version') || 'light';
            applyAuthTheme(currentTheme);

            $('#auth_theme_toggle').on('click', function (e) {
                e.preventDefault();
                var active = $('html').attr('data-theme-version');
                var newTheme = (active === 'dark') ? 'light' : 'dark';
                setCookie('theme_version', newTheme, 365);
                localStorage.setItem('theme_version', newTheme);
                applyAuthTheme(newTheme);
            });

            // Password strength and matching validation
            $('#new_password').on('input', function () {
                var val = $(this).val();
                var fill = $('#strength_fill');
                var text = $('#strength_text');

                var score = 0;
                if (val.length >= 4) score += 25;
                if (val.length >= 8) score += 25;
                if (/[0-9]/.test(val)) score += 25;
                if (/[A-Z]/.test(val) || /[^A-Za-z0-9]/.test(val)) score += 25;

                fill.css('width', score + '%');
                if (score <= 25) {
                    fill.css('background', '#ef4444');
                    text.text('Password strength: Weak').css('color', '#ef4444');
                } else if (score <= 50) {
                    fill.css('background', '#f59e0b');
                    text.text('Password strength: Fair').css('color', '#f59e0b');
                } else if (score <= 75) {
                    fill.css('background', '#3b82f6');
                    text.text('Password strength: Good').css('color', '#3b82f6');
                } else {
                    fill.css('background', '#10b981');
                    text.text('Password strength: Strong').css('color', '#10b981');
                }
                checkMatch();
            });

            $('#confirm_password').on('input', checkMatch);

            function checkMatch() {
                var p1 = $('#new_password').val();
                var p2 = $('#confirm_password').val();
                var fb = $('#match_feedback');

                if (p2.length === 0) {
                    fb.text('');
                    return;
                }
                if (p1 === p2) {
                    fb.html('<i class="fas fa-check-circle text-success me-1"></i> Passwords match perfectly.').css('color', '#10b981');
                } else {
                    fb.html('<i class="fas fa-times-circle text-danger me-1"></i> Passwords do not match yet.').css('color', '#ef4444');
                }
            }

            $('#reset_form').on('submit', function (e) {
                var p1 = $('#new_password').val();
                var p2 = $('#confirm_password').val();
                if (p1 !== p2) {
                    e.preventDefault();
                    toastr.error('Passwords do not match. Please verify before submitting.');
                }
            });
        });
    </script>

    <!-- Toastr Notifications -->
    <% if(typeof success !=='undefined' && success && success.length> 0){ %>
        <script>
            toastr.success('<%= success %>', {
                timeOut: 8000,
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right"
            });
        </script>
        <% } %>

            <% if(typeof error !=='undefined' && error && error.length> 0){ %>
                <script>
                    toastr.error('<%= error %>', {
                        timeOut: 6000,
                        closeButton: true,
                        progressBar: true,
                        positionClass: "toast-top-right"
                    });
                </script>
                <% } %>
</body>

</html>