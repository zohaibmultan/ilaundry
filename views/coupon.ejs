<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>
    <style>
        .select2-container .select2-search--inline .select2-search__field {
            padding: 4px !important;
        }
        /* Fix dropdown appearing behind date box */
        .coupon-type-row {
            position: relative !important;
            z-index: 30 !important;
        }
        .coupon-date-row {
            position: relative !important;
            z-index: 10 !important;
        }
        .bootstrap-select {
            position: relative;
        }
        .bootstrap-select.show {
            z-index: 1060 !important;
        }
        .bootstrap-select.show .dropdown-menu,
        .bootstrap-select .dropdown-menu.show {
            z-index: 1070 !important;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2) !important;
        }
    </style>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                        <i class="fa fa-ticket-alt text-primary me-2"></i><%= language.Coupon_List %>
                                    </h3>
                                    <small class="text-muted"><%= language.Coupon_List_Subtitle || 'Manage promotional discount coupons, validity dates, and redemption limits' %></small>
                                </div>
                                <div>
                                    <button class="btn btn-sm btn-primary <%= ((typeof canAdd !== 'undefined' && canAdd) || isadmin) ? '': 'd-none' %>"
                                        data-bs-toggle="modal" data-bs-target="#coupon_add">
                                        <i class="fa fa-plus me-2"></i><%= language.Add_New_Coupon %>
                                    </button>
                                </div>
                            </div>
                            <div class="d-none">
                                <input type="hiden" name="sym" value="<%= accessdata?.symbol %>">
                                <input type="hiden" name="pls" value="<%= accessdata?.plac %>">
                                <input type="hiden" name="thousands_separator"
                                    value="<%= accessdata?.thousands_separator %>">
                            </div>
                            <div class="card-body p-4">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="row g-2 mb-3">
                                    <div class="<%= mlty ? 'col-12 col-md-4 col-lg-3' : 'col-12 col-md-5 col-lg-4' %>">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                            <input class="form-control" type="search" id="dtCouponSearch" placeholder="<%= language.Search || 'Search coupons...' %>">
                                        </div>
                                    </div>
                                    <div class="<%= mlty ? 'col-6 col-sm-4 col-md-2' : 'col-6 col-sm-4 col-md-2 col-lg-2' %>">
                                        <select class="form-select" id="dtCouponStatus">
                                            <option value="all"><%= language.All_Status || 'All Status' %></option>
                                            <option value="0"><%= language.Active || 'Active' %></option>
                                            <option value="1"><%= language.Deactive || 'Deactive' %></option>
                                        </select>
                                    </div>

                                    <div class="<%= mlty ? 'col-6 col-sm-4 col-md-2' : 'col-6 col-sm-4 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtCouponType">
                                            <option value="all"><%= language.All_Type || 'All Types' %></option>
                                            <option value="fixed">Fixed</option>
                                            <option value="percentage">Percentage</option>
                                        </select>
                                    </div>

                                    <% if (mlty) { %>
                                        <div class="col-6 col-sm-6 col-md-2 col-lg-3">
                                            <select class="form-select" id="dtCouponStore">
                                                <option value="all"><%= language.All_Store || 'All Stores' %></option>
                                                <% (storeList || []).forEach(function(st) { %>
                                                    <option value="<%= st.id %>"><%= st.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    <% } %>

                                    <div class="<%= mlty ? 'col-6 col-sm-6 col-md-2 col-lg-2' : 'col-6 col-sm-4 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtCouponPageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_coupon_table" class="table display server-side-dt" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th><%= language.Title %></th>
                                                <th><%= language.Code %></th>
                                                <th><%= language.Minmum_Purchase %></th>
                                                <th><%= language.Discount %></th>
                                                <th><%= language.Start_Date %></th>
                                                <th><%= language.End_Date %></th>
                                                <th class="<%= mlty && isadmin ? '' : 'd-none' %>">
                                                    <%= language.Store_Name %>
                                                </th>
                                                <th style="width: 110px;"><%= language.Status %></th>
                                                <th class="<%= (isadmin || (typeof canEdit !== 'undefined' && canEdit) || (typeof canDelete !== 'undefined' && canDelete)) ? '': 'd-none' %> text-center" style="width: 110px;"><%= language.Action %></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <!--********** Content body end **********-->

        <!-- Modal update -->
        <div class="modal fade" id="coupon_update">
            <div class="modal-dialog modal-dialog-scrollable modal-lg modal-fullscreen-sm-down" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Edit_Coupon_Details %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="" id="coupon_update_form" method="post" class="need-validation">
                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Coupon_Title %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" name="coupon_titel_update"
                                            id="coupon_titel_update" placeholder="Enter Coupon Titel" required>
                                    </div>
                                </div>
                                <% if (mlty) { %>
                                <div class="col-6">
                                    <div class="form-group">
                                        <label class="form-label"><strong>
                                                <%= language.Store_List %>
                                            </strong><span class="text-danger">*</span></label>
                                        <select multiple class="form-control wide mb-3" name="storelist"
                                            id="cupon_update">

                                            <% storeList.forEach(function(x){ %>
                                                <option value="<%= x.id %>">
                                                    <%= x.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                </div>
                                <% } else { %>
                                    <input type="hidden" name="storelist" value="<%= (storeList && storeList[0]) ? storeList[0].id : '' %>">
                                <% } %>
                            </div>

                            <div class="row coupon-type-row">
                                <div class="col">
                                    <div class="form-group">
                                        <label class="form-label"><strong>
                                                <%= language.Coupon_type %>
                                            </strong><span class="text-danger">*</span></label>
                                        <select class="default-select form-control wide mb-3" name="coupon_type_update"
                                            id="coupon_type_update" required>
                                            <option value="1">Default</option>
                                            <option value="2">First Order</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Limit_for_same_user %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="number" class="form-control " name="coupon_limit_update"
                                            id="coupon_limit_update" placeholder="Enter Limit" required>
                                    </div>
                                </div>
                            </div>

                            <div class="row coupon-date-row">
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Start_Date %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="date" class="form-control " name="coupon_start_date_update"
                                            id="coupon_start_date_update" required>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Expire_date %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="date" class="form-control " name="coupon_end_date_update"
                                            id="coupon_end_date_update" required>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Minmum_Purchase_Order %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="number" class="form-control " name="coupon_purchase_update"
                                            id="coupon_purchase_update" placeholder="Enter Purchase Order" required>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Discount_Amount %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="number" class="form-control " name="coupon_discount_amount_update"
                                            id="coupon_discount_amount_update" placeholder="Enter Discount Amount"
                                            required>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="coupon_status_update"
                                                name="status" value="0">
                                            <label class="form-check-label" for="coupon_status_update">
                                                <%= language.Is_Active %> ?
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fa fa-times me-2"></i><%= language.Cancel %>
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-2"></i><%= language.Save %>
                        </button>
                    </div>
                </div>
                </form>

            </div>
        </div>

        <!-- Modal add -->
        <div class="modal fade" id="coupon_add">
            <div class="modal-dialog modal-dialog-scrollable modal-lg modal-fullscreen-sm-down" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Add_New_Coupon %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/coupon/add" method="post" class="need-validation">

                            <div class="row g-3">
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Coupon_Title %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="text" class="form-control " name="coupon_titel" id="coupon_titel"
                                            placeholder="Enter Coupon Titel" required>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Coupon_code %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="text" class="form-control text-uppercase" name="coupon_code"
                                            id="coupon_code" maxlength="6" minlength="6" placeholder="Enter Coupon code"
                                            required>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label> </label><br>
                                        <button type="button" class="btn btn-sm btn-primary mt-1" id="gen_code">
                                            <i class="fa fa-sync me-2"></i><%= language.Generate_code %>
                                        </button>

                                    </div>
                                </div>
                            </div>

                            <div class="row coupon-type-row  g-3">
                                <div class="col">
                                    <div class="form-group">
                                        <label class="form-label"><strong>
                                                <%= language.Coupon_type %>
                                            </strong><span class="text-danger">*</span></label>
                                        <select class="default-select form-control wide mb-3" name="coupon_type"
                                            id="coupon_type" required>
                                            <option value selected disabled><%= language.Select_Coupon_Type || 'Select Coupon Type' %></option>
                                            <option value="1">Default</option>
                                            <option value="2">First Order</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Limit_for_same_user %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="number" class="form-control " name="coupon_limit" id="coupon_limit"
                                            placeholder="Enter Limit" required>
                                    </div>
                                </div>
                            </div>

                            <div class="row coupon-date-row g-3">
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Start_Date %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="date" class="form-control " name="coupon_start_date"
                                            id="coupon_start_date" required>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Expire_date %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="date" class="form-control " name="coupon_end_date"
                                            id="coupon_end_date" required>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Minmum_Purchase_Order %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="number" class="form-control " name="coupon_purchase"
                                            id="coupon_purchase" placeholder="Enter Purchase Order" required>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Discount_Amount %>
                                            </strong><span class="text-danger">*</span></label>
                                        <input type="number" class="form-control " name="coupon_discount_amount"
                                            id="coupon_discount_amount" placeholder="Enter Discount Amount" required>
                                    </div>
                                </div>
                            </div>

                            <% if (mlty) { %>
                            <div class="row">
                                <div class="col-6">
                                    <div class="form-group">
                                        <label class="form-label"><strong>
                                                <%= language.Store_List %>
                                            </strong><span class="text-danger">*</span></label>
                                        <select multiple class="form-control mb-3" name="storelist" id="storelist"
                                            required>
                                            <% storeList.forEach(function(x){ %>
                                                <option value="<%= x.id %>" <%=storeList.length===1 ?'selected' : '' %>>
                                                    <%= x.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <% } else { %>
                                <input type="hidden" name="storelist" value="<%= (storeList && storeList[0]) ? storeList[0].id : '' %>">
                            <% } %>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fa fa-times me-2"></i><%= language.Cancel %>
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-2"></i><%= language.Save %>
                        </button>
                    </div>
                </div>

                </form>



            </div>
        </div>


        </div>

        <!-- Delete Coupon Confirmation Modal -->
        <div class="modal fade" id="deleteCouponModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                <div class="modal-content text-center p-3" style="border-radius: 16px;">
                    <div class="modal-body pt-4">
                        <div class="mb-3">
                            <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
                                <i class="fa fa-tag"></i>
                            </div>
                        </div>
                        <h4 class="mb-2 fw-bold text-dark"><%= language.Delete_Coupon || 'Delete Coupon' %></h4>
                        <p class="text-muted mb-1"><%= language.Are_you_sure_delete || 'Are you sure you want to delete this coupon?' %></p>
                        <p class="fw-bold text-danger fs-5 mb-3" id="deleteCouponModalTitle"></p>
                        <p class="text-xs text-muted mb-4"><%= language.Action_cannot_be_undone || 'This action cannot be undone.' %></p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                            </button>
                            <a href="#" id="deleteCouponConfirmBtn" class="btn btn-danger">
                                <i class="fa fa-trash me-2"></i><%= language.Delete || 'Yes, Delete' %>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

            <!--**********************************
            Footer end
        ***********************************-->

            </div>

            <!--********** Main wrapper end **********-->
            <%- include('templet/script')-%>
                <script>
                    function escapeHtml(str) {
                        if (!str) return '';
                        return String(str)
                          .replace(/&/g, '&amp;')
                          .replace(/</g, '&lt;')
                          .replace(/>/g, '&gt;')
                          .replace(/"/g, '&quot;')
                          .replace(/'/g, '&#039;');
                    }

                    function formatCouponDate(dStr) {
                        if (!dStr) return '-';
                        try {
                            const d = new Date(dStr);
                            if (isNaN(d.getTime())) return dStr;
                            const day = (d.getDate() < 10 ? '0' : '') + d.getDate();
                            const month = ((d.getMonth() + 1) < 10 ? '0' : '') + (d.getMonth() + 1);
                            const year = d.getFullYear();
                            return `${year}-${month}-${day}`;
                        } catch(e) {
                            return dStr;
                        }
                    }

                    $(document).ready(function() {
                        const isAdmin = <%= isadmin ? 'true' : 'false' %>;

                        const columns = [
                            {
                                data: null,
                                orderable: false,
                                searchable: false,
                                render: function(data, type, row, meta) {
                                    return meta.settings._iDisplayStart + meta.row + 1;
                                }
                            },
                            {
                                data: 'titel',
                                render: function(data, type, row) {
                                    return `<span class="fw-semibold text-dark">${escapeHtml(data)}</span>`;
                                }
                            },
                            {
                                data: 'code',
                                render: function(data, type, row) {
                                    return `<span class="badge bg-light text-primary font-monospace fw-bold px-2 py-1">${escapeHtml(data)}</span>`;
                                }
                            },
                            {
                                data: 'min_purchase',
                                render: function(data, type, row) {
                                    return `<span class="fw-semibold">${window.formatDtCurrency(data)}</span>`;
                                }
                            },
                            {
                                data: 'discount',
                                render: function(data, type, row) {
                                    if (row.coupon_type === 'percentage') {
                                        return `<span class="badge light badge-info font-weight-bold">${data}%</span>`;
                                    }
                                    return `<span class="fw-semibold">${window.formatDtCurrency(data)}</span>`;
                                }
                            },
                            {
                                data: 'start_date',
                                render: function(data) {
                                    return `<span class="text-muted">${formatCouponDate(data)}</span>`;
                                }
                            },
                            {
                                data: 'end_date',
                                render: function(data) {
                                    return `<span class="text-muted">${formatCouponDate(data)}</span>`;
                                }
                            },
                            {
                                data: 'storeList',
                                visible: isAdmin,
                                render: function(data, type, row) {
                                    return `<span class="badge bg-light text-dark px-2 py-1">${escapeHtml(data) || '—'}</span>`;
                                }
                            },
                            {
                                data: 'status',
                                render: function(data, type, row) {
                                    if (parseInt(data) === 0) {
                                        return '<span class="badge-status-pill badge-status-active">Active</span>';
                                    } else {
                                        return '<span class="badge-status-pill badge-status-inactive">Deactive</span>';
                                    }
                                }
                            },
                            {
                                data: null,
                                orderable: false,
                                searchable: false,
                                className: 'text-center',
                                render: function(data, type, row) {
                                    const editBtn = row.canEdit ? `
                                        <a href="#" class="btn-tbl-action btn-tbl-edit"
                                           id="coupons_update" data-bs-toggle="modal"
                                           data-bs-target="#coupon_update" 
                                           data-id="${row.id}"
                                           data-titel="${escapeHtml(row.titel)}"
                                           data-type="${row.coupon_type}"
                                           data-limit="${row.limit_forsame_user}"
                                           data-start="${row.start_date}"
                                           data-end="${row.end_date}"
                                           data-minorder="${row.min_purchase}"
                                           data-discount="${row.discount}"
                                           data-status="${row.status}"
                                           data-storelist="${row.store_list_id}"
                                           title="<%= language.Edit || 'Edit' %>">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>` : '';

                                    const deleteBtn = row.canDelete ? `
                                        <button type="button"
                                           class="btn-tbl-action btn-tbl-delete"
                                           data-bs-toggle="modal"
                                           data-bs-target="#deleteCouponModal"
                                           data-id="${row.id}"
                                           data-title="${escapeHtml(row.titel)}"
                                           title="<%= language.Delete || 'Delete' %>">
                                            <i class="fa fa-trash"></i>
                                        </button>` : '';

                                    return `<div class="tbl-action-group">${editBtn}${deleteBtn}</div>`;
                                }
                            }
                        ];

                        window.initServerDataTable('#server_coupon_table', {
                            ajaxUrl: '/coupon/list/data',
                            columns: columns,
                            searchInput: '#dtCouponSearch',
                            pageLengthSelect: '#dtCouponPageLength',
                            filterSelectors: {
                                status: '#dtCouponStatus',
                                type: '#dtCouponType',
                                store_id: '#dtCouponStore'
                            },
                            order: [[0, 'desc']],
                            language: {
                                emptyTable: '<%= language.No_data_available_in_table || "No coupons found" %>'
                            }
                        });

                        $('#coupon_add').on('shown.bs.modal', function () {
                            setTimeout(() => {
                                $('#storelist').select2({
                                    dropdownParent: $('#coupon_add'),
                                    placeholder: 'Select Store(s)',
                                    width: '100%',
                                    allowClear: true
                                });
                            }, 100);
                        });

                        $('#coupon_update').on('shown.bs.modal', function () {
                            if ($.fn.select2 && $('#cupon_update').hasClass('select2-hidden-accessible')) {
                                $('#cupon_update').select2('destroy');
                            }

                            $('#cupon_update').select2({
                                dropdownParent: $('#coupon_update'),
                                placeholder: 'Select Store(s)',
                                width: '100%',
                                allowClear: true
                            });
                        });

                        $(document).on('click', '.btn-tbl-delete[data-bs-target="#deleteCouponModal"]', function() {
                            const couponId = $(this).attr('data-id');
                            const couponTitle = $(this).attr('data-title');
                            $('#deleteCouponModalTitle').text(couponTitle || ('#' + couponId));
                            $('#deleteCouponConfirmBtn').attr('href', '/coupon/delete/' + couponId);
                        });
                    });
                </script>


</body>


</html>