<!DOCTYPE html>
<html>

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>
        <link rel="stylesheet" href="/css/command-center.css">
</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->
        <div class="content-body">
            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <% 
                        const isScopedUser = (typeof isStoreScoped !== 'undefined' && isStoreScoped) || (typeof isStaff !== 'undefined' && isStaff);
                        const currentStoreName = (typeof storeName !== 'undefined' && storeName) ? storeName : ((typeof staffStoreName !== 'undefined' && staffStoreName) ? staffStoreName : 'Assigned Store');
                    %>
                    <div class="d-none">
                        <input type="hidden" name="sym" value="<%= accessdata?.symbol %>">
                        <input type="hidden" name="pls" value="<%= accessdata?.plac %>">
                        <input type="hidden" name="thousands_separator" value="<%= accessdata?.thousands_separator %>">

                        <input type="hidden" id="indextosales" value="<%= countsales %>">
                        <input type="hidden" id="currencySymbol" value="<%= accessdata?.masterstore?.currency_symbol %>">

                    </div>

                    <div class="col-12">
                        <div class="command-center-widget">
                            <div class="cc-container" style="flex-direction: column;">
                                <div class="cc-snapshot-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas fa-tachometer-alt text-primary"></i>
                                        <span class="cc-snapshot-title mb-0"><%= language.Live_Performance_Snapshot || 'Live Performance' %></span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <% if (!isScopedUser && typeof storeList !== 'undefined' && storeList.length > 0) { %>
                                            <div class="cc-store-filter-wrap">
                                                <select id="dashboard-store-filter"
                                                    class="form-select form-select-sm py-1 px-2 border-0 shadow-sm"
                                                    style="font-size: 0.8rem; font-weight: 600; border-radius: 8px; background-color: #f8fafc; color: #1e293b; min-width: 160px;">
                                                    <option value="all" selected><%= language.All_Stores_Combined || 'All Stores (Combined)' %></option>
                                                    <% storeList.forEach(function(st) { %>
                                                        <option value="<%= st.id %>">
                                                            <%= st.name %>
                                                        </option>
                                                        <% }) %>
                                                </select>
                                            </div>
                                            <% } %>
                                    </div>
                                </div>
                                <div class="cc-metrics-grid">
                                    <!-- SALES -->
                                    <div class="cc-metric-tile tile-sales">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="cc-metric-label"><%= language.Total_Sales || 'TOTAL SALES' %></span>
                                            <i class="fas fa-wallet text-primary"></i>
                                        </div>
                                        <div class="cc-metric-value-wrap">
                                            <span class="cc-metric-value text-primary" id="stat-sales">
                                                <%= accessdata?.masterstore?.currency_symbol || '$' %>
                                                    <%= Number(data?.tottalsales || 0).toLocaleString('en-US', {
                                                        minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                            </span>
                                        </div>
                                        <span class="fs-11 text-muted mt-1"><i class="fas fa-arrow-up text-success me-1"></i><%= language.Gross_Revenue || 'Gross Revenue' %></span>
                                    </div>

                                    <!-- ORDERS -->
                                    <div class="cc-metric-tile tile-orders">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="cc-metric-label"><%= language.Total_Orders || 'TOTAL ORDERS' %></span>
                                            <i class="fas fa-shopping-bag text-success"></i>
                                        </div>
                                        <div class="cc-metric-value-wrap">
                                            <span class="cc-metric-value text-dark" id="stat-orders">
                                                <%= Number(data?.totalorder || 0).toLocaleString('en-US') %>
                                            </span>
                                        </div>
                                        <span class="fs-11 text-muted mt-1"><i class="fas fa-check-circle text-success me-1"></i><%= language.Active_Volume || 'Active Volume' %></span>
                                    </div>

                                    <!-- SERVICES -->
                                    <div class="cc-metric-tile tile-services">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="cc-metric-label"><%= language.Services || 'SERVICES' %></span>
                                            <i class="fas fa-tshirt text-info"></i>
                                        </div>
                                        <div class="cc-metric-value-wrap">
                                            <span class="cc-metric-value text-dark" id="stat-services">
                                                <%= Number(data?.totalservices || 0).toLocaleString('en-US') %>
                                            </span>
                                        </div>
                                        <span class="fs-11 text-muted mt-1"><i class="fas fa-tags text-info me-1"></i><%= language.Catalog_Offerings || 'Catalog Offerings' %></span>
                                    </div>

                                    <!-- CUSTOMERS -->
                                    <div class="cc-metric-tile tile-customers">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="cc-metric-label"><%= language.Customers || 'CUSTOMERS' %></span>
                                            <i class="fas fa-user-friends text-warning"></i>
                                        </div>
                                        <div class="cc-metric-value-wrap">
                                            <span class="cc-metric-value text-dark" id="stat-customers">
                                                <%= Number(data?.totalcustomer || 0).toLocaleString('en-US') %>
                                            </span>
                                        </div>
                                        <span class="fs-11 text-muted mt-1"><i class="fas fa-users text-warning me-1"></i><%= language.Client_Profiles || 'Client Profiles' %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <% if (!isScopedUser && typeof storeStatsList !== 'undefined' && storeStatsList.length > 0) { %>
                        <!-- Per-Store Counters & Performance Breakdown for Admin -->
                        <div class="col-12">
                            <div class="card shadow-sm border-0" style="border-radius: 16px; overflow: hidden;">
                                <div
                                    class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                                            style="width: 36px; height: 36px;">
                                            <i class="fas fa-store-alt text-primary"></i>
                                        </div>
                                        <div>
                                            <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                                <%= language.Per_Store_Counters || 'Per-Store Counters & Performance' %>
                                            </h3>
                                            <small class="text-muted"><%= language.Per_Store_Subtitle || 'Live counters breakdown across each individual store location' %></small>
                                        </div>
                                    </div>
                                    <span class="badge bg-light text-dark fw-bold py-2 px-3 fs-14 border rounded-pill">
                                        <%= storeStatsList.length %> <%= language.Active_Stores || 'Active Stores' %>
                                    </span>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0" id="table-per-store-stats">
                                            <thead
                                                style="background-color: #f8fafc; color: #475569; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                                                <tr>
                                                    <th class="ps-4 py-3"><%= language.Store_Name || 'Store Name' %></th>
                                                    <th class="py-3 text-end"><%= language.Sales || 'Sales' %></th>
                                                    <th class="py-3 text-center"><%= language.Orders %></th>
                                                    <th class="py-3 text-center"><%= language.Services %></th>
                                                    <th class="py-3 text-center"><%= language.Customers %></th>
                                                    <th class="pe-4 py-3 text-end"><%= language.Quick_Action || 'Quick Action' %></th>
                                                </tr>
                                            </thead>
                                            <tbody style="font-size: 0.9rem; color: #1e293b;">
                                                <% storeStatsList.forEach(function(s) { %>
                                                    <tr id="store-stat-row-<%= s.store_id %>">
                                                        <td class="ps-4 py-3 font-weight-bold">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span
                                                                    class="badge rounded-pill bg-light text-primary border"
                                                                    style="font-size: 0.75rem;">#<%= s.store_id %>
                                                                        </span>
                                                                <span class="store-name-text">
                                                                    <%= s.store_name %>
                                                                </span>
                                                            </div>
                                                        </td>
                                                        <td class="py-3 text-end font-weight-bold text-success"
                                                            id="store-sales-<%= s.store_id %>">
                                                            <%= accessdata?.masterstore?.currency_symbol || '$' %>
                                                                <%= Number(s.tottalsales || 0).toLocaleString('en-US', {
                                                                    minimumFractionDigits: 2, maximumFractionDigits: 2
                                                                    }) %>
                                                        </td>
                                                        <td class="py-3 text-center"
                                                            id="store-orders-<%= s.store_id %>">
                                                            <span
                                                                class="badge bg-secondary-subtle text-secondary px-3 py-1 font-weight-bold"
                                                                style="border-radius: 12px; font-size: 0.85rem;">
                                                                <%= Number(s.totalorder || 0).toLocaleString('en-US') %>
                                                            </span>
                                                        </td>
                                                        <td class="py-3 text-center"
                                                            id="store-services-<%= s.store_id %>">
                                                            <span
                                                                class="badge bg-info-subtle text-info px-3 py-1 font-weight-bold"
                                                                style="border-radius: 12px; font-size: 0.85rem;">
                                                                <%= Number(s.totalservices || 0).toLocaleString('en-US')
                                                                    %>
                                                            </span>
                                                        </td>
                                                        <td class="py-3 text-center"
                                                            id="store-customers-<%= s.store_id %>">
                                                            <span
                                                                class="badge bg-success-subtle text-success px-3 py-1 font-weight-bold"
                                                                style="border-radius: 12px; font-size: 0.85rem;">
                                                                <%= Number(s.totalcustomer || 0).toLocaleString('en-US')
                                                                    %>
                                                            </span>
                                                        </td>
                                                        <td class="pe-4 py-3 text-end">
                                                            <button type="button"
                                                                class="btn btn-outline-primary btn-xs filter-store-btn"
                                                                data-store-id="<%= s.store_id %>">
                                                                <i class="fas fa-filter me-1"></i> <%= language.Snapshot || 'Snapshot' %>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>

                            <div class="col-xl-12 col-lg-12 col-xxl-12 col-sm-12">
                                <div class="card border-0 shadow-sm rounded-3">
                                    <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                                <i class="fa fa-history text-primary me-2"></i><%= language.Recent_Order %> (Top 10)
                                            </h3>
                                            <small class="text-muted"><%= language.Recent_Orders_Subtitle || 'Live tracking of the most recent laundry bookings across stores' %></small>
                                        </div>
                                        <div>
                                            <a href="/order/list" class="btn btn-sm btn-outline-primary">
                                                <i class="fa fa-boxes me-1"></i> <%= language.View_All || 'View All' %>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive recentOrderTable">
                                            <table class="table verticle-middle table-responsive-md mb-0">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">
                                                            <%= language.Order_Info || 'Order Info' %>
                                                        </th>
                                                        <th scope="col">
                                                            <%= language.Customer || language.Customers || 'Customer' %>
                                                        </th>
                                                        <th scope="col">
                                                            <%= language.Order_Amount || 'Order Amount' %>
                                                        </th>
                                                        <th scope="col">
                                                            <%= language.Status || 'Status' %>
                                                        </th>
                                                        <th scope="col">
                                                            <%= language.Payment || language.Payment_Amount || 'Payment' %>
                                                        </th>
                                                        <% if (!isScopedUser && accessdata?.mutibranch === true) { %>
                                                            <th scope="col">
                                                                <%= language.Store_Name || 'Store Name' %>
                                                            </th>
                                                        <% } %>
                                                        <th scope="col" class="text-center" style="width: 170px;">
                                                            <%= language.Action || 'Action' %>
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (recentOrder && recentOrder.length > 0) { %>
                                                        <% recentOrder.forEach(function (data) { %>
                                                            <tr>
                                                                <td>
                                                                    <div class="server-dt-primary-text mb-1">
                                                                        <a href="/order/view/<%= data.id %>" class="me-1 fw-bold text-primary"><%= data.order_id || '' %></a>
                                                                    </div>
                                                                    <% if (data.order_type) { %>
                                                                        <div class="mb-1">
                                                                            <span class="badge bg-light text-dark border py-1 px-2 text-wrap d-inline-block mt-1" style="font-size: 0.72rem; line-height: 1.1;">
                                                                                <%= data.order_type %>
                                                                            </span>
                                                                        </div>
                                                                    <% } %>
                                                                    <div class="server-dt-secondary-text mb-0">
                                                                        <span class="me-1 opacity-75"><%= language.Order_Date || 'Order Date' %>:</span>
                                                                        <span><%= data.formattedOrderDate || '' %></span>
                                                                    </div>
                                                                    <div class="server-dt-secondary-text mb-0">
                                                                        <% 
                                                                            var isDel = (data.order_type === 'Counter & Delivery' || data.order_type === 'Pick-up & Delivery' || data.order_type === 'Customer drop-off & Store delivery' || data.order_type === 'Store collection & Store delivery');
                                                                            var dateLabel = isDel ? (language.Delivery_Date || 'Delivery Date') : (language.Pickup_Date || 'Pick-up Date');
                                                                            var dateValue = isDel ? (data.formattedDeliveryDate || '') : (data.formattedPickupDate || data.formattedDeliveryDate || '');
                                                                        %>
                                                                        <span class="me-1 opacity-75"><%= dateLabel %>:</span>
                                                                        <span><%= dateValue %></span>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="server-dt-primary-text"><%= data.customer_name || data.customer || 'Walk In Customer' %></div>
                                                                    <% if (data.customer_number) { %>
                                                                        <div class="server-dt-secondary-text">
                                                                            <i class="fa fa-phone me-1 opacity-50"></i><%= data.customer_number %>
                                                                        </div>
                                                                    <% } %>
                                                                </td>
                                                                <td class="symbol font-w600">
                                                                    <%= parseFloat(data.gross_total || 0).toFixed(2) %>
                                                                </td>
                                                                <td>
                                                                    <span class="badge-status-pill <%= data.statusClass %>">
                                                                        <%= data.orderStatusName || data.status || 'Pending' %>
                                                                    </span>
                                                                </td>
                                                                <td>
                                                                    <% 
                                                                        var gross = parseFloat(data.gross_total || 0).toFixed(2);
                                                                        var paid = parseFloat(data.paid_amount || 0).toFixed(2);
                                                                        var balance = parseFloat(data.balance_amount !== undefined ? data.balance_amount : (data.gross_total - data.paid_amount));
                                                                    %>
                                                                    <div class="server-dt-secondary-text mb-1">
                                                                        <span class="me-1">Total:</span><span class="symbol fw-bold"><%= gross %></span>
                                                                        | <span class="me-1">Paid:</span><span class="symbol text-success"><%= paid %></span>
                                                                    </div>
                                                                    <div>
                                                                        <% if (balance > 0.001) { %>
                                                                            <% if (accessdata?.logas === 'custmor') { %>
                                                                                <span class="badge badge-warning light btn-xxs"><%= language.Pending || 'Pending' %></span>
                                                                            <% } else { %>
                                                                                <button type="button" onclick="open_patment_model('<%= data.id %>')" class="btn btn-xs btn-outline-success py-1 px-2">
                                                                                    <i class="fa fa-plus-circle me-1"></i> <%= language.Add_Payment || 'Add Payment' %>
                                                                                </button>
                                                                            <% } %>
                                                                        <% } else { %>
                                                                            <span class="badge badge-dark light btn-xxs"><%= language.Fully_Paid || 'Fully Paid' %></span>
                                                                        <% } %>
                                                                    </div>
                                                                </td>
                                                                <% if (!isScopedUser && accessdata?.mutibranch === true) { %>
                                                                    <td>
                                                                        <span class="badge bg-light text-dark fw-bold border">
                                                                            <%= data.storeName || data.store || '-' %>
                                                                        </span>
                                                                    </td>
                                                                <% } %>
                                                                <td class="text-center">
                                                                    <div class="server-dt-actions justify-content-center">
                                                                        <% if (accessdata?.logas === 'custmor') { %>
                                                                            <a href="/order/view/<%= data.id %>" class="btn-dt-action btn-view" title="<%= language.View || 'View' %>">
                                                                                <i class="fa fa-eye"></i>
                                                                            </a>
                                                                        <% } else { %>
                                                                            <% if (data.order_status != 6 && data.canEdit) { %>
                                                                                <a href="/admin/edit/<%= data.id %>" class="btn-dt-action btn-edit" title="<%= language.Edit || 'Edit' %>">
                                                                                    <i class="fas fa-pencil-alt"></i>
                                                                                </a>
                                                                            <% } %>
                                                                            <a href="/order/view/<%= data.id %>" class="btn-dt-action btn-view" title="<%= language.View || 'View' %>">
                                                                                <i class="fa fa-eye"></i>
                                                                            </a>
                                                                            <button type="button" class="btn-dt-action btn-print" id="print_barcode" data-bs-toggle="modal" data-bs-target="#exampleModalLong" data-id="<%= data.id %>" title="<%= language.Barcode || 'Barcode' %>">
                                                                                <i class="fa fa-barcode"></i>
                                                                            </button>
                                                                            <a href="/order/pos_invoice/<%= data.id %>" class="btn-dt-action btn-print" target="_blank" title="POS Thermal Invoice">
                                                                                <i class="fa fa-receipt"></i>
                                                                            </a>
                                                                            <% if (data.canDelete) { %>
                                                                                <button type="button" class="btn-dt-action btn-delete" data-bs-toggle="modal" data-bs-target="#deleteOrderModal" data-id="<%= data.id %>" data-orderid="<%= data.order_id %>" title="<%= language.Delete || 'Delete' %>">
                                                                                    <i class="fa fa-trash"></i>
                                                                                </button>
                                                                            <% } %>
                                                                        <% } %>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        <% }) %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="<%= (!isScopedUser && accessdata?.mutibranch === true) ? 7 : 6 %>" class="text-center py-4 text-muted">
                                                                <i class="fa fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                                                                <%= language.No_data_found || 'No recent orders found' %>
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-6 col-lg-12 col-sm-12">
                                <div class="card border-0 shadow-sm rounded-3">
                                    <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-3 bg-primary bg-opacity-10 text-white d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                                <i class="fas fa-shopping-bag fs-5"></i>
                                            </div>
                                            <div>
                                                <h4 class="card-title mb-0 fw-bold"><%= language.Total_Order_Volume || 'Total Order Volume' %></h4>
                                                <small class="text-muted"><%= language.Order_Volume_Subtitle || 'Monthly and daily order intake throughput' %></small>
                                            </div>
                                        </div>
                                        <span class="badge bg-light text-muted border px-2 py-1 fs-12 rounded-pill">
                                            <i class="fas fa-chart-bar me-1 text-primary"></i> <%= language.Order_Analytics || 'Order Analytics' %>
                                        </span>
                                    </div>
                                    <div class="card-body p-4">
                                        <canvas id="barChart_2"></canvas>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" id="indextotorder" value="<%=countorder%>">

                            <div class="col-xl-6 col-lg-12 col-sm-12">
                                <div class="card border-0 shadow-sm rounded-3">
                                    <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                                <i class="fas fa-chart-line fs-5"></i>
                                            </div>
                                            <div>
                                                <h4 class="card-title mb-0 fw-bold"><%= language.Total_Sales_Revenue || 'Total Sales Revenue' %> (<span class="symbol"><%= accessdata?.symbol || '$' %></span>)</h4>
                                                <small class="text-muted"><%= language.Sales_Revenue_Subtitle || 'Revenue stream and sales trend analysis' %></small>
                                            </div>
                                        </div>
                                        <span class="badge bg-light text-muted border px-2 py-1 fs-12 rounded-pill">
                                            <i class="fas fa-dollar-sign me-1 text-success"></i> <%= language.Sales_Analytics || 'Sales Analytics' %>
                                        </span>
                                    </div>
                                    <div class="card-body p-4">
                                        <canvas id="areaChart_2"></canvas>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" id="indextosales" value="<%=countsales%>">

                </div>
            </div>


        </div>

        <!--********** Content body end **********-->

        <!-- Modal add Payment -->
        <div class="modal fade" id="addpaymentmodel1">
            <div class="modal-dialog modal-dialog-scrollable" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Payment || 'Add Payment' %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body" id="orderlistpaymentmodel">
                        <form id="add_order_payment" method="post" class="need-validation">
                            <div class="row g-2 align-items-center">
                                <div class="col-12">
                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Customer_Name || 'Customer Name' %> :
                                        </div>
                                        <div class="col-auto text-sm"></div>
                                    </div>

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Order_ID || 'Order ID' %> :
                                        </div>
                                        <div class="col-auto text-sm"></div>
                                    </div>

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Order_Date || 'Order Date' %> :
                                        </div>
                                        <div class="col-auto text-sm"></div>
                                    </div>

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Delivery_Date || 'Delivery Date' %> :
                                        </div>
                                        <div class="col-auto text-sm"></div>
                                    </div>

                                    <hr>

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Order_Amount || 'Order Amount' %> :
                                        </div>
                                        <div class="col-auto text-sm"></div>
                                    </div>

                                    <div class="row mb-50 align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Paid_Amount || 'Paid Amount' %> :
                                        </div>
                                        <div class="col-auto text-sm"></div>
                                    </div>

                                    <hr>

                                    <div class="row align-items-center">
                                        <div class="col text-sm">
                                            <%= language.Balance || 'Balance' %> :
                                        </div>
                                        <div class="col-auto text-sm"></div>
                                    </div>

                                    <hr>

                                    <div class="row align-items-center">
                                        <div class="col-md-6 mb-1">
                                            <label class="form-label">
                                                <%= language.Paid_Amount || 'Paid Amount' %>
                                            </label>
                                            <input type="number" class="form-control" name="paid" id="paid"
                                                placeholder="Enter Amount">
                                        </div>
                                        <div class="col-md-6 mb-1">
                                            <label class="form-label">
                                                <%= language.Payment_Type || 'Payment Type' %>
                                            </label>
                                            <select class="form-control wide" name="payment" id="payment">
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                        </button>
                        <button type="submit" value="submit" class="btn btn-primary" id="add_order_payment_submit">
                            <i class="fa fa-save me-2"></i><%= language.Save || 'Save' %>
                        </button>
                    </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Barcode Modal -->
        <div class="modal fade" id="exampleModalLong">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Barcode || 'Barcode' %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center" id="add_barcode"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-info" id="print_label" data-bs-dismiss="modal">
                            <i class="fa fa-print me-2"></i><%= language.Print_Barcode || 'Print Barcode' %>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Order Confirmation Modal -->
        <div class="modal fade" id="deleteOrderModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                <div class="modal-content text-center p-3" style="border-radius: 16px;">
                    <div class="modal-body pt-4">
                        <div class="mb-3">
                            <div
                                style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
                                <i class="fa fa-exclamation-triangle"></i>
                            </div>
                        </div>
                        <h4 class="mb-2 fw-bold text-dark">
                            <%= language.Delete_Order || 'Delete Order' %>
                        </h4>
                        <p class="text-muted mb-1">
                            <%= language.Are_you_sure_delete || 'Are you sure you want to delete this order?' %>
                        </p>
                        <p class="fw-bold text-danger fs-5 mb-3" id="deleteOrderModalCode"></p>
                        <p class="text-xs text-muted mb-4">
                            <%= language.Action_cannot_be_undone
                                || 'This action will remove the order, related payments, and ledger transactions permanently.'
                                %>
                        </p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                            </button>
                            <a href="#" id="deleteOrderConfirmBtn" class="btn btn-danger">
                                <i class="fa fa-trash me-2"></i>
                                <%= language.Delete || 'Yes, Delete' %>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--**********************************
            Footer start
        ***********************************-->

        <%- include('templet/footer')-%>

            <!--**********************************
            Footer end
        ***********************************-->

            </div>

            <!--********** Main wrapper end **********-->
            <!--**********************************
        Scripts
    ***********************************-->

            <%- include('templet/script')-%>
                <script src="/vendor/chart.js/Chart.bundle.min.js"></script>
                <script src="/js/plugins-init/chartjs-init.js"></script>
                <script>
                    $('#addpaymentmodel1').on('shown.bs.modal', function () {
                        $('#payment').select2({
                            dropdownParent: $('#addpaymentmodel1'),
                            placeholder: 'Select Account',
                            width: '100%',
                            allowClear: true
                        });
                    });

                    $(document).on('click', '.btn-dt-action.btn-delete[data-bs-target="#deleteOrderModal"]', function () {
                        const orderId = $(this).attr('data-id');
                        const orderCode = $(this).attr('data-orderid');
                        $('#deleteOrderModalCode').text(orderCode || ('#' + orderId));
                        $('#deleteOrderConfirmBtn').attr('href', '/order/delete/' + orderId);
                    });

                    (function () {
                        var storeFilterEl = document.getElementById('dashboard-store-filter');

                        function getActiveStoreFilter() {
                            return storeFilterEl ? storeFilterEl.value : 'all';
                        }

                        function updateSnapshotMetrics(d) {
                            var salesEl = document.getElementById('stat-sales');
                            var ordersEl = document.getElementById('stat-orders');
                            var servicesEl = document.getElementById('stat-services');
                            var customersEl = document.getElementById('stat-customers');
                            var currencySymbol = (document.getElementById('currencySymbol') && document.getElementById('currencySymbol').value) || '$';

                            if (salesEl) {
                                var formattedSales = currencySymbol + ' ' + Number(d.tottalsales || 0).toLocaleString('en-US', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                                if (salesEl.textContent.trim() !== formattedSales.trim()) {
                                    salesEl.textContent = formattedSales;
                                    salesEl.classList.add('cc-stat-highlight');
                                    setTimeout(function () { salesEl.classList.remove('cc-stat-highlight'); }, 1000);
                                }
                            }

                            if (ordersEl) {
                                var formattedOrders = Number(d.totalorder || 0).toLocaleString('en-US');
                                if (ordersEl.textContent.trim() !== formattedOrders) {
                                    ordersEl.textContent = formattedOrders;
                                    ordersEl.classList.add('cc-stat-highlight');
                                    setTimeout(function () { ordersEl.classList.remove('cc-stat-highlight'); }, 1000);
                                }
                            }

                            if (servicesEl) {
                                var formattedServices = Number(d.totalservices || 0).toLocaleString('en-US');
                                if (servicesEl.textContent.trim() !== formattedServices) {
                                    servicesEl.textContent = formattedServices;
                                    servicesEl.classList.add('cc-stat-highlight');
                                    setTimeout(function () { servicesEl.classList.remove('cc-stat-highlight'); }, 1000);
                                }
                            }

                            if (customersEl) {
                                var formattedCustomers = Number(d.totalcustomer || 0).toLocaleString('en-US');
                                if (customersEl.textContent.trim() !== formattedCustomers) {
                                    customersEl.textContent = formattedCustomers;
                                    customersEl.classList.add('cc-stat-highlight');
                                    setTimeout(function () { customersEl.classList.remove('cc-stat-highlight'); }, 1000);
                                }
                            }
                        }

                        function updatePerStoreTable(storeStatsList) {
                            if (!storeStatsList || !Array.isArray(storeStatsList)) return;
                            var currencySymbol = (document.getElementById('currencySymbol') && document.getElementById('currencySymbol').value) || '$';

                            storeStatsList.forEach(function (s) {
                                var sSalesEl = document.getElementById('store-sales-' + s.store_id);
                                var sOrdersEl = document.getElementById('store-orders-' + s.store_id);
                                var sServicesEl = document.getElementById('store-services-' + s.store_id);
                                var sCustomersEl = document.getElementById('store-customers-' + s.store_id);

                                if (sSalesEl) {
                                    sSalesEl.textContent = currencySymbol + Number(s.tottalsales || 0).toLocaleString('en-US', {
                                        minimumFractionDigits: 2,
                                        maximumFractionDigits: 2
                                    });
                                }
                                if (sOrdersEl) {
                                    var badge = sOrdersEl.querySelector('.badge');
                                    if (badge) badge.textContent = Number(s.totalorder || 0).toLocaleString('en-US');
                                }
                                if (sServicesEl) {
                                    var badge = sServicesEl.querySelector('.badge');
                                    if (badge) badge.textContent = Number(s.totalservices || 0).toLocaleString('en-US');
                                }
                                if (sCustomersEl) {
                                    var badge = sCustomersEl.querySelector('.badge');
                                    if (badge) badge.textContent = Number(s.totalcustomer || 0).toLocaleString('en-US');
                                }
                            });
                        }

                        function refreshDashboardStats(forcedStoreId) {
                            var currentStore = (forcedStoreId !== undefined) ? forcedStoreId : getActiveStoreFilter();
                            var url = '/api/dashboard-stats?store_id=' + encodeURIComponent(currentStore);

                            fetch(url)
                                .then(function (res) { return res.json(); })
                                .then(function (result) {
                                    if (result && result.success && result.data) {
                                        updateSnapshotMetrics(result.data);
                                        if (result.storeStatsList) {
                                            updatePerStoreTable(result.storeStatsList);
                                        }
                                    }
                                })
                                .catch(function (err) {
                                    console.warn('Live stats refresh error:', err);
                                });
                        }

                        if (storeFilterEl) {
                            storeFilterEl.addEventListener('change', function () {
                                refreshDashboardStats(this.value);
                            });
                        }

                        document.addEventListener('click', function (e) {
                            var filterBtn = e.target.closest('.filter-store-btn');
                            if (filterBtn) {
                                var storeId = filterBtn.getAttribute('data-store-id');
                                if (storeFilterEl && storeId) {
                                    storeFilterEl.value = storeId;
                                    refreshDashboardStats(storeId);
                                    var snapCard = document.querySelector('.cc-snapshot-card');
                                    if (snapCard) {
                                        snapCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                    }
                                }
                            }
                        });

                        // Poll every 30 seconds
                        setInterval(function () {
                            refreshDashboardStats();
                        }, 30000);
                    })();
                </script>

</body>

</html>