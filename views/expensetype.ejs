<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>
        <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                        <i class="fa fa-sitemap text-primary me-2"></i><%= language.Expence_Category_Type_List %>
                                    </h3>
                                    <small class="text-muted"><%= language.Expence_Category_Type_List_Subtitle || 'Manage expense types, tax deductibility, and high-level expenditure categories' %></small>
                                </div>
                                <div>
                                    <button
                                        class="btn btn-sm btn-primary <%= accessdata.roll.expense.includes('write') ?'':'d-none' %>"
                                        data-bs-toggle="modal" data-bs-target="#addexpcattype">
                                        <i class="fa fa-plus me-2"></i>
                                        <%= language.Add_Category_Type %>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="row g-2 mb-3">
                                    <div class="<%= ismulty ? 'col-12 col-md-6 col-lg-6' : 'col-12 col-md-8 col-lg-8' %>">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                            <input class="form-control" type="search" id="dtExpTypeSearch" placeholder="<%= language.Search || 'Search category types...' %>">
                                        </div>
                                    </div>

                                    <% if (ismulty) { %>
                                        <div class="col-6 col-sm-6 col-md-3 col-lg-3">
                                            <select class="form-select" id="dtExpTypeStore">
                                                <option value="all"><%= language.All_Store || 'All Stores' %></option>
                                                <% (storeList || []).forEach(function(st) { %>
                                                    <option value="<%= st.id %>"><%= st.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    <% } %>

                                    <div class="<%= ismulty ? 'col-6 col-sm-6 col-md-3 col-lg-3' : 'col-6 col-sm-4 col-md-4 col-lg-4' %>">
                                        <select class="form-select" id="dtExpTypePageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_expensetype_table" class="table display server-side-dt" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th><%= language.Expence_Category_Type %></th>
                                                <th class="<%= ismulty ? '': 'd-none' %>"><%= language.Store_Name %></th>
                                                <th class="text-center <%= accessdata.roll.expense.includes('edit') || accessdata.roll.expense.includes('delete') ?'':'d-none' %>" style="width: 110px;">
                                                    <%= language.Action %>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        <!--********** Content body end **********-->

        <!-- Modal update -->
        <div class="modal fade" id="editexpcattype">
            <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Coustomer_Detail %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="" id="editexpcattype_form" method="post" class="need-validation">

                            <div class="row g-1 align-items-center">
                                <div class="form-group">
                                    <label><strong>
                                            <%= language.Type_Name %>
                                        </strong></label>
                                    <input type="text" class="form-control" id="name" name="name" required>
                                </div>
                            </div>
                    </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="fa fa-times me-2"></i><%= language.Cancel %>
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save me-2"></i><%= language.Save %>
                                </button>
                            </div>
                        </form>



                </div>
            </div>
        </div>

        <!-- Modal add -->
        <div class="modal fade" id="addexpcattype">
            <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Add_Expence_Category_Type %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/expense/addcategorytype" method="post" class="need-validation">

                            <div class="col-md-12 mb-1 <%= ismulty ? '': 'd-none' %>">
                                <div class="form-group">
                                    <label class="form-label"><strong>
                                            <%= language.Store_List %>
                                        </strong><span class="text-danger">*</span></label>
                                    <select class="form-control wide mb-3" name="storeid" id="coupon_storlist_update">
                                        <option value="" selected disabled> Select Store </option>
                                        <% storeList.forEach(function(x){ %>
                                            <option value="<%= x.id %>">
                                                <%= x.name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                            </div>

                            <div class="row g-1 align-items-center">
                                <div class="form-group">
                                    <label><strong>
                                            <%= language.Type_Name %>
                                        </strong></label>
                                    <input type="text" class="form-control " name="name" required>
                                </div>

                            </div>
                    </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="fa fa-times me-2"></i><%= language.Cancel %>
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save me-2"></i><%= language.Save %>
                                </button>
                            </div>
                        </form>



                </div>
            </div>


        </div>


        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

            <!--**********************************
            Footer end
        ***********************************-->

            </div>

            <!--********** Main wrapper end **********-->
            <%- include('templet/script')-%>

                <script>
                    function escapeHtml(str) {
                        if (!str) return '';
                        return String(str)
                          .replace(/&/g, '&amp;')
                          .replace(/</g, '&lt;')
                          .replace(/>/g, '&gt;')
                          .replace(/"/g, '&quot;')
                          .replace(/'/g, '&#039;');
                    }

                    $(document).ready(function() {
                        const isMultistore = <%= ismulty ? 'true' : 'false' %>;

                        const columns = [
                            {
                                data: null,
                                orderable: false,
                                searchable: false,
                                render: function(data, type, row, meta) {
                                    return meta.settings._iDisplayStart + meta.row + 1;
                                }
                            },
                            {
                                data: 'type_name',
                                render: function(data) {
                                    return `<span class="fw-semibold text-dark">${escapeHtml(data)}</span>`;
                                }
                            },
                            {
                                data: 'store',
                                visible: isMultistore,
                                render: function(data) {
                                    return `<span class="badge light badge-light text-dark">${escapeHtml(data || 'All Stores')}</span>`;
                                }
                            },
                            {
                                data: null,
                                orderable: false,
                                searchable: false,
                                className: 'text-center',
                                render: function(data, type, row) {
                                    const editBtn = row.canEdit ? `
                                        <a href="#" class="btn-tbl-action btn-tbl-edit" 
                                           id="action" data-bs-toggle="modal"
                                           data-bs-target="#editexpcattype"
                                           data-name="${escapeHtml(row.type_name)}" 
                                           data-id="${row.id}"
                                           title="<%= language.Edit || 'Edit' %>">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>` : '';

                                    const deleteBtn = row.canDelete ? `
                                        <a href="/expense/deletcategorytype/${row.id}" 
                                           class="btn-tbl-action btn-tbl-delete" 
                                           id="delete"
                                           title="<%= language.Delete || 'Delete' %>">
                                            <i class="fa fa-trash"></i>
                                        </a>` : '';

                                    return `<div class="tbl-action-group">${editBtn}${deleteBtn}</div>`;
                                }
                            }
                        ];

                        window.initServerDataTable('#server_expensetype_table', {
                            ajaxUrl: '/expense/categorytype/data',
                            columns: columns,
                            searchInput: '#dtExpTypeSearch',
                            pageLengthSelect: '#dtExpTypePageLength',
                            filterSelectors: {
                                store_id: '#dtExpTypeStore'
                            },
                            order: [[0, 'desc']],
                            language: {
                                emptyTable: '<%= language.No_data_available_in_table || "No category types found" %>'
                            }
                        });

                        $('#addexpcattype').on('shown.bs.modal', function () {
                            $('#coupon_storlist_update').select2({
                                dropdownParent: $('#addexpcattype'),
                                placeholder: 'Select Store(s)',
                                width: '100%',
                                allowClear: true
                            });
                        });
                    });
                </script>

</body>

</html>