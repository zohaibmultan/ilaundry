<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>


</head>

<body>

        <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                        <i class="fa fa-tags text-primary me-2"></i><%= language.Service_Type %>
                                    </h3>
                                    <small class="text-muted"><%= language.Service_Type_Subtitle || 'Configure service categories, dry cleaning types, and laundry classifications' %></small>
                                </div>
                                <div>
                                    <button
                                        class="btn btn-sm btn-primary <%= accessdata.roll.service.includes('write') ? '' : 'd-none' %>"
                                        data-bs-toggle="modal" data-bs-target="#service_types">
                                        <i class="fa fa-plus me-2"></i>
                                        <%= language.Add_New_Service_Type %>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="row g-2 mb-3">
                                    <div class="<%= ismulty ? 'col-12 col-md-4 col-lg-4' : 'col-12 col-md-6 col-lg-6' %>">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                            <input class="form-control" type="search" id="dtServiceTypeSearch" placeholder="<%= language.Search || 'Search service types...' %>">
                                        </div>
                                    </div>
                                    <div class="<%= ismulty ? 'col-6 col-sm-4 col-md-3 col-lg-3' : 'col-6 col-sm-6 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtServiceTypeStatus">
                                            <option value="all"><%= language.All_Status || 'All Status' %></option>
                                            <option value="0"><%= language.Active || 'Active' %></option>
                                            <option value="1"><%= language.Deactive || 'Deactive' %></option>
                                        </select>
                                    </div>

                                    <% if (ismulty) { %>
                                        <div class="col-6 col-sm-4 col-md-3 col-lg-3">
                                            <select class="form-select" id="dtServiceTypeStore">
                                                <option value="all"><%= language.All_Store || 'All Stores' %></option>
                                                <% (storeList || []).forEach(function(st) { %>
                                                    <option value="<%= st.id %>"><%= st.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    <% } %>

                                    <div class="<%= ismulty ? 'col-12 col-sm-4 col-md-2 col-lg-2' : 'col-12 col-sm-6 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtServiceTypePageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_service_type_table" class="table display server-side-dt" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th><%= language.Service_Type %></th>
                                                <th style="width: 130px;"><%= language.Service_Type_ID %></th>
                                                <th class="<%= ismulty ? '' : 'd-none' %>"><%= language.Store_Name %></th>
                                                <th style="width: 110px;"><%= language.Status %></th>
                                                <th class="text-center" style="width: 110px;"><%= language.Action %></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <!--********** Content body end **********-->

        <!-- Modal update -->
        <div class="modal fade" id="service_type_update">
            <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Edit_Service_Type %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/coustomer/update/" id="updateservicetype_form" method="post"
                            class="need-validation">

                            <div class="row g-1 align-items-center">
                                <div class="form-group">
                                    <label><strong>
                                            <%= language.Service_Type_Name %>
                                        </strong><span class="text-danger">*</span></label>
                                    <input type="text" class="form-control " name="service_name"
                                        id="servicetype_name_update" placeholder="Enter Service Type Name" required>
                                </div>

                                <div class="form-group">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="active_update" name="active"
                                            value="0">
                                        <label class="form-check-label" for="active_update">
                                            <%= language.Is_Active %> ?
                                        </label>
                                    </div>
                                </div>
                            </div>
                    </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="fa fa-times me-2"></i><%= language.Cancel %>
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save me-2"></i><%= language.Save %>
                                </button>
                            </div>
                        </form>



                </div>
            </div>
        </div>

        <!-- Modal add -->
        <div class="modal fade" id="service_types">
            <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down" role="document">
                <div class="modal-content">

                    <!-- Modal Header -->
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Add_Service_Type %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <!-- Form -->
                    <div class="modal-body">
                    <form action="/services/addtype" method="post" class="need-validation">

                            <div class="row g-1 align-items-center">

                                <!-- Service Type Name -->
                                <div class="form-group">
                                    <label><strong>
                                            <%= language.Service_Type_Name %>
                                        </strong><span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="service_name" id="service_name"
                                        placeholder="Enter Service Type Name" required>
                                </div>

                                <!-- Store List (only if ismulty is true) -->
                                <div class="col-md-12 mb-1 <%= ismulty ? '' : 'd-none' %>">

                                    <label class="form-label"><strong>
                                            <%= language.Store_List %>
                                        </strong><span class="text-danger">*</span></label>

                                    <!-- class="default-select"   Add for Design -->
                                    <select class="form-control mb-3 " name="storeid" id="coupon_storlist" <%=ismulty
                                        ? 'required' : '' %>>
                                        <option value="" selected disabled>Select Store</option>
                                        <% storeList.forEach(function(x) { %>
                                            <option value="<%= x.id %>">
                                                <%= x.name %>
                                            </option>
                                            <% }); %>
                                    </select>

                                </div>

                                <!-- Is Active Switch -->
                                <div class="form-group">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="active" name="active"
                                            value="0">
                                        <label class="form-check-label" for="active">
                                            <%= language.Is_Active %> ?
                                        </label>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Modal Footer -->
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel %>
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save me-2"></i><%= language.Save %>
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>

        <!-- Modal delete confirm -->
        <div class="modal fade" id="deleteServiceTypeModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                <div class="modal-content text-center p-3" style="border-radius: 16px;">
                    <div class="modal-body pt-4">
                        <div class="mb-3">
                            <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
                                <i class="fa fa-trash-alt"></i>
                            </div>
                        </div>
                        <h4 class="mb-2 fw-bold text-dark"><%= language.Delete_Service_Type || language.Delete || 'Delete Service Type' %></h4>
                        <p class="text-muted mb-1"><%= language.Are_you_sure_delete || 'Are you sure you want to delete this service type?' %></p>
                        <p class="fw-bold text-danger fs-5 mb-3" id="deleteServiceTypeModalTitle"></p>
                        <p class="text-xs text-muted mb-4"><%= language.Action_cannot_be_undone || 'This action cannot be undone.' %></p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                            </button>
                            <a href="#" id="deleteServiceTypeConfirmBtn" class="btn btn-danger">
                                <i class="fa fa-trash me-2"></i><%= language.Delete || 'Yes, Delete' %>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

            <!--**********************************
            Footer end
        ***********************************-->

            </div>

            <!--********** Main wrapper end **********-->
            <%- include('templet/script')-%>
                <script>
                    function escapeHtml(str) {
                        if (!str) return '';
                        return String(str)
                          .replace(/&/g, '&amp;')
                          .replace(/</g, '&lt;')
                          .replace(/>/g, '&gt;')
                          .replace(/"/g, '&quot;')
                          .replace(/'/g, '&#039;');
                    }

                    $(document).ready(function() {
                        const isMultistore = <%= ismulty ? 'true' : 'false' %>;

                        const columns = [
                            {
                                data: null,
                                orderable: false,
                                searchable: false,
                                render: function(data, type, row, meta) {
                                    return meta.settings._iDisplayStart + meta.row + 1;
                                }
                            },
                            {
                                data: 'services_type',
                                render: function(data) {
                                    return `<div class="fw-bold text-dark">${escapeHtml(data)}</div>`;
                                }
                            },
                            {
                                data: 'id',
                                render: function(data) {
                                    return `<span class="badge bg-light text-dark px-2 py-1 fw-semibold">#${escapeHtml(data)}</span>`;
                                }
                            }
                        ];

                        if (isMultistore) {
                            columns.push({
                                data: 'store',
                                render: function(data) {
                                    return `<span class="badge bg-light text-dark px-2 py-1">${escapeHtml(data) || '—'}</span>`;
                                }
                            });
                        }

                        columns.push({
                            data: 'status',
                            render: function(data) {
                                if (data === 0) {
                                    return '<span class="badge-status-pill badge-pill-completed"><i class="fa fa-check-circle"></i> <%= language.Active || "Active" %></span>';
                                }
                                return '<span class="badge-status-pill badge-pill-pending"><i class="fa fa-times-circle"></i> <%= language.Deactive || "Deactive" %></span>';
                            }
                        });

                        columns.push({
                            data: null,
                            orderable: false,
                            searchable: false,
                            className: 'text-center',
                            render: function(data, type, row) {
                                let html = '<div class="tbl-action-group justify-content-center">';
                                if (row.canEdit) {
                                    html += `
                                        <a href="#" class="btn-dt-action btn-edit" id="serviceType" data-bs-toggle="modal"
                                           data-bs-target="#service_type_update" data-id="${row.id}"
                                           data-servicetype="${escapeHtml(row.services_type)}" data-status="${row.status}"
                                           title="<%= language.Edit || 'Edit' %>">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                    `;
                                }
                                if (row.canDelete) {
                                    html += `
                                        <button type="button" class="btn-dt-action btn-delete btn-delete-servicetype" 
                                           data-bs-toggle="modal"
                                           data-bs-target="#deleteServiceTypeModal"
                                           data-id="${row.id}"
                                           data-name="${escapeHtml(row.services_type || '')}"
                                           title="<%= language.Delete || 'Delete' %>">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    `;
                                }
                                html += '</div>';
                                return html;
                            }
                        });

                        window.serviceTypeTable = window.initServerDataTable('#server_service_type_table', {
                            ajaxUrl: '/services/type/data',
                            columns: columns,
                            order: [[0, 'desc']],
                            searchInput: '#dtServiceTypeSearch',
                            pageLengthSelect: '#dtServiceTypePageLength',
                            filterElements: {
                                status_filter: '#dtServiceTypeStatus',
                                store_filter: '#dtServiceTypeStore'
                            }
                        });

                        // Populate Delete Modal
                        $(document).on('click', '.btn-delete-servicetype', function () {
                            const id = $(this).attr('data-id');
                            const cleanId = String(id).replace(/['"]/g, '').trim();
                            const name = $(this).attr('data-name') || '';

                            $('#deleteServiceTypeModalTitle').text(name || ('#' + cleanId));
                            $('#deleteServiceTypeConfirmBtn').attr('href', '/services/deletservicestype/' + cleanId);
                        });
                    });

                    $('#service_types').on('shown.bs.modal', function () {
                        setTimeout(() => {
                            $('#coupon_storlist').select2({
                                dropdownParent: $('#service_types'),
                                placeholder: 'Select Store',
                                width: '100%'
                            });
                        }, 1);
                    });
                </script>
</body>



</html>