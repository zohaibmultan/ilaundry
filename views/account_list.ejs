<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>


        <!--********** Content body start **********-->

        <div class="content-body">
            <div class="container-fluid" style="min-height: 100vh;">
                <%
                    const isMasterUser = (accessdata?.logas === 'master' || (accessdata?.roll && accessdata.roll.rollType === 'master'));
                    const isStaffUser = accessdata?.topbardata?.is_staff != 0;
                    const accountPermissions = (accessdata?.roll?.account || '');

                    // Master user: ALWAYS show edit and delete
                    // Staff user: ONLY show edit and delete if staff has permission
                    // Store user: has store manager access
                    const finalCanEdit = isMasterUser || (isStaffUser ? accountPermissions.includes('edit') : (typeof canEdit !== 'undefined' ? canEdit : true));
                    const finalCanDelete = isMasterUser || (isStaffUser ? accountPermissions.includes('delete') : (typeof canDelete !== 'undefined' ? canDelete : true));
                    const finalCanWrite = isMasterUser || (isStaffUser ? accountPermissions.includes('write') : (typeof canWrite !== 'undefined' ? canWrite : true));
                %>
                <div class="row">
                    <div class="d-none">
                        <input type="hiden" name="sym" value="<%= accessdata?.symbol %>">
                        <input type="hiden" name="pls" value="<%= accessdata?.plac %>">
                        <input type="hiden" name="thousands_separator" value="<%= accessdata?.thousands_separator %>">
                    </div>
                    <div class="col-12">
  <div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="card-body p-4 position-relative">

      <!-- Payment Button -->
      <% if ((accessdata.mutibranch == false && due.toFixed(2) > 0) || (accessdata?.roll?.rollType === 'store' && accessdata?.roll?.account?.includes('write') && due.toFixed(2) > 0)) { %>
        <!-- For large screens (top-right corner) -->
        <div class="d-none d-md-block position-absolute top-50 end-0 me-5 translate-middle-y">
          <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#payment">
            <i class="fa fa-credit-card me-2"></i><%= language.Payment %>
          </a>
        </div>

        <!-- For smaller screens (centered) -->
        <div class="d-md-none text-center mb-3">
          <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#payment">
            <i class="fa fa-credit-card me-2"></i><%= language.Payment %>
          </a>
        </div>
      <% } %>

      <!-- Summary Cards -->
      <div class="row g-2 justify-content-md-start justify-content-center align-items-center text-center">
        <div class="col-12 col-sm-6 col-md-4 col-xl-4 mb-2">
          <h3><span class="symbol"><%= comission %></span></h3>
          <h5><%= language.Total_commission_Amount %></h5>
          <a href="/account/viewcomission/commission">
            <button class="btn btn-primary text-nowrap">
              <i class="fa fa-eye me-2"></i><%= language.View_Comission %>
            </button>
          </a>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-xl-4 mb-2">
          <h3><span class="symbol"><%= paidcomission %></span></h3>
          <h5><%= language.Total_Paid_Amount %></h5>
          <a href="/account/viewcomission/paidcommission">
            <button class="btn btn-primary text-nowrap">
              <i class="fa fa-eye me-2"></i><%= language.View_Paid_Comission %>
            </button>
          </a>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-xl-4 mb-2">
          <h3><span class="symbol" id="due"><%= due.toFixed(2) %></span></h3>
          <h5><%= language.Total_Due_Amount %></h5>
        </div>
      </div>

    </div>
  </div>
                    </div>
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                        <i class="fa fa-wallet text-primary me-2"></i><%= language.Account_List %>
                                    </h3>
                                    <small class="text-muted"><%= language.Account_List_Subtitle || 'Manage financial store accounts, balances, and payment methods' %></small>
                                </div>
                                <% if (finalCanWrite) { %>
                                <div>
                                    <button   
                                        class="btn btn-sm btn-primary"
                                        data-bs-toggle="modal" data-bs-target="#account_add">
                                        <i class="fa fa-plus me-2"></i><%= language.Add_New_Account %>
                                    </button>
                                </div>
                                <% } %>
                            </div>

                            <div class="card-body p-4">
                                <div class="table-responsive">
                                    <table
                                        class="table table-bordered table-striped verticle-middle table-responsive-sm">
                                        <thead>
                                            <tr>
                                                <th scope="col">#</th>
                                                <th scope="col">
                                                    <%= language.Account_Info %>
                                                </th>
                                                <th scope="col">
                                                    <%= language.Balance_Info %>
                                                </th>
                                                <% if (finalCanEdit || finalCanDelete) { %>
                                                <th scope="col" class="text-center">
                                                    <%= language.Action %>
                                                </th>
                                                <% } %>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% account_list.forEach(function(data, i){ %>
                                                <tr>
                                                    <td>
                                                        <%= i + 1%>
                                                    </td>
                                                    <td>
                                                        <div> <b>
                                                                <%= data.ac_name %>
                                                            </b> </div>
                                                        <div> <b>
                                                                <%= data.ac_number %>
                                                            </b> </div>
                                                        <div> <b>
                                                                <%= data.store_name %>
                                                            </b> </div>
                                                        <div class="text-nowrap">
                                                            <%= data.ac_decrip %>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex text-nowrap">
                                                            <%= language.Balance %> : <b>
                                                                <span class="symbol">
                                                                    <%= (Number(data.balance) || 0).toFixed(2) %> 
                                                                </span>
                                                            </b>   
                                                        </div>
                                                        <div class="d-flex text-nowrap">
                                                            <%= language.Total_in %> : <b>
                                                                <span class="symbol">
                                                                    <%= (Number(data.credit) || 0).toFixed(2) %> 
                                                                </span>
                                                            </b>
                                                        </div>
                                                        <div class="d-flex text-nowrap">
                                                            <%= language.Total_out %> : <b>
                                                                <span class="symbol">
                                                                    <%= (Number(data.debit) || 0).toFixed(2) %>   
                                                                </span>
                                                            </b>
                                                        </div>
                                                    </td>
                                                    <% if (finalCanEdit || finalCanDelete) { %>
                                                    <td class="text-center">
                                                        <div class="tbl-action-group">
                                                            <% if (finalCanEdit) { %>
                                                            <a href="#"
                                                                class="btn-tbl-action btn-tbl-edit update_Account"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#account_update" data-id="<%= data.id %>"
                                                                data-titel="<%= data.ac_name %>"
                                                                data-number="<%= data.ac_number %>"
                                                                data-descrip="<%= data.ac_decrip %>"
                                                                title="<%= language.Edit || 'Edit' %>">
                                                                <i class="fas fa-pencil-alt"></i></a>
                                                            <% } %>

                                                            <% if (finalCanDelete) { %>
                                                            <button type="button"
                                                                class="btn-tbl-action btn-tbl-delete btn-delete-account"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#deleteAccountModal"
                                                                data-id="<%= data.id %>"
                                                                data-name="<%= data.ac_name %>"
                                                                data-number="<%= data.ac_number %>"
                                                                title="<%= language.Delete || 'Delete' %>">
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                            <% } %>
                                                        </div>   
                                                    </td>
                                                    <% } %>
                                                </tr>



                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--********** Content body end **********-->
        
        <!-- Modal payment -->
        <div class="modal fade" id="payment">
            <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Payment %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/account/comission" method="post" class="need-validation" id="paymentForm">

                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Total_Due_Amount %>
                                            </strong></label>
                                        <input type="number" class="form-control " name="due_amount"
                                            value="<%=due.toFixed(2) %>" id="due_amount" readonly>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong><%= language.Pay_Amount %></strong></label>
                                        <input type="number" class="form-control " name="pay_amount" id="pay_amount"
                                               placeholder="Enter Amount" step="0.01"   required>
                                        <span class="text-danger d-none" style="font-size: 14px !important;" id="isValidamount"><%= language.Please_enter_valid_amount %></span>
                                    </div> 
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <label class="form-label"><strong>
                                                <%= language.Select_To_Account %>
                                            </strong></label>
                                        <select class="form-control wide mb-3" name="to_account"
                                            id="to_account" required>
                                            <option value selected disabled>Select Account</option>
                                            <% toaccount.forEach(function(data){ %>
                                                <option value="<%= data.id %>">
                                                    <%= data.ac_name %>
                                                </option>
                                                <% }) %>

                                        </select>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label class="form-label"><strong>
                                                <%= language.Select_From_Account %>
                                            </strong></label>
                                        <select class="form-control wide mb-3" name="from_account"
                                            id="from_account" required>
                                            <option value selected disabled>Select Account</option>
                                            <% fromaccount.forEach(function(data){ %>
                                                <option value="<%= data.id %>">
                                                    <%= data.ac_name %> (<span class="symbol"><%= data.balance %></span>)
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Date %>
                                            </strong></label>
                                        <input type="date" class="form-control " name="date" id="date" required>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Description %>
                                            </strong></label>
                                        <input type="text" class="form-control " name="description"
                                            id="description_update" placeholder="Enter Description">
                                    </div>
                                </div>
                            </div>
                    </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="fa fa-times me-2"></i><%= language.Cancel %>
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save me-2"></i><%= language.Save %>
                                </button>
                            </div>
                        </form>



                </div>
            </div>
        </div>
        <!-- Modal update -->
        <% if (finalCanEdit) { %>
        <div class="modal fade" id="account_update">
            <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Edit_Account_Details %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="" id="account_form" method="post" class="need-validation">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label"><strong>
                                        <%= language.Account_title %>
                                    </strong><span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="ac_name" id="ac_name_update"
                                    placeholder="Enter Account Name" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label"><strong>
                                        <%= language.Account_Number %>
                                    </strong><span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="ac_number" id="ac_number_update"
                                    placeholder="Enter Account Number" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label"><strong>
                                        <%= language.Description %>
                                    </strong></label>
                                <input type="text" class="form-control" name="ac_decrip" id="ac_description_update"
                                    placeholder="Enter Description">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel %>
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save me-2"></i><%= language.Save %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <% } %>
        <!-- Modal add -->
        <% if (finalCanWrite) { %>
        <div class="modal fade" id="account_add">
            <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Add_New_Account %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form action="/account/addaccount" method="post" class="need-validation">
                        <div class="modal-body">
                            <% if (typeof ismulty !== 'undefined' && ismulty) { %>
                                <div class="mb-3">
                                    <label class="form-label"><strong><%= language.Store_List || 'Store' %></strong><span class="text-danger">*</span></label>
                                    <select class="form-control wide" name="storeid" id="account_store_id" required>
                                        <option value="" disabled selected><%= language.Select_Store || 'Select Store' %></option>
                                        <option value="master"><%= language.Master || 'Master / Main Store' %></option>
                                        <% (storeList || []).forEach(function(store){ %>
                                            <option value="<%= store.id %>"><%= store.name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                            <% } else { %>
                                <input type="hidden" name="storeid" value="<%= typeof assigned_store_id !== 'undefined' ? assigned_store_id : '' %>">
                            <% } %>

                            <div class="mb-3">
                                <label class="form-label"><strong>
                                        <%= language.Account_title %>
                                    </strong><span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="ac_name" id="ac_name"
                                    placeholder="Enter Account Name" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label"><strong>
                                        <%= language.Account_Number %>
                                    </strong><span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="ac_number" id="ac_number"
                                    placeholder="Enter Account Number" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label"><strong>
                                        <%= language.Balance %>
                                    </strong><span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="balance" id="balance" min="0" step="0.01"
                                    placeholder="Initial Balance" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label"><strong>
                                        <%= language.Description %>
                                    </strong></label>
                                <input type="text" class="form-control" name="description" id="description"
                                    placeholder="Enter Description">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel %>
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save me-2"></i><%= language.Save %>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Modal delete confirm -->
        <% if (finalCanDelete) { %>
        <div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                <div class="modal-content text-center p-3" style="border-radius: 16px;">
                    <div class="modal-body pt-4">
                        <div class="mb-3">
                            <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
                                <i class="fa fa-trash-alt"></i>
                            </div>
                        </div>
                        <h4 class="mb-2 fw-bold text-dark"><%= language.Delete_Account || language.Delete || 'Delete Account' %></h4>
                        <p class="text-muted mb-1"><%= language.Are_you_sure_delete || 'Are you sure you want to delete this account?' %></p>
                        <p class="fw-bold text-danger fs-5 mb-3" id="deleteAccountModalTitle"></p>
                        <p class="text-xs text-muted mb-4"><%= language.Action_cannot_be_undone || 'This action cannot be undone.' %></p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                            </button>
                            <a href="#" id="deleteAccountConfirmBtn" class="btn btn-danger">
                                <i class="fa fa-trash me-2"></i><%= language.Delete || 'Yes, Delete' %>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
        <!--********************************** Footer start***********************************-->
        <%- include('templet/footer')-%>

            <!--**********************************Footer end***********************************-->
            </div>
            <!--********** Main wrapper end **********-->
            <%- include('templet/script')-%>
<script>
  $('#payment').on('shown.bs.modal', function () {
    $('#to_account').select2({
      dropdownParent: $('#payment'),
      placeholder: 'Select Account(a)',
      width: '100%',
      allowClear: true
    });
    $('#from_account').select2({
      dropdownParent: $('#payment'),
      placeholder: 'Select Account(a)',
      width: '100%',
      allowClear: true
    });
  });

  $('#account_add').on('shown.bs.modal', function () {
    if ($('#account_store_id').length) {
      $('#account_store_id').select2({
        dropdownParent: $('#account_add'),
        placeholder: '<%= (language && language.Select_Store) ? language.Select_Store : "Select Store" %>',
        width: '100%',
        allowClear: false
      });
    }
  });
</script>
<script>
    let isValidamount = true
  $('#pay_amount').on('input', function () {
    let dueamount = parseFloat($('#due_amount').val()) || 0;
    let payamount = parseFloat($('#pay_amount').val()) || 0;

    if (payamount > dueamount) {
      $('#isValidamount').removeClass('d-none'); 
     isValidamount = false

    } else {
      $('#isValidamount').addClass('d-none'); 
     isValidamount = true

    }
      $('#paymentForm').on('submit', function (e) {
    if (!isValidamount) {
      e.preventDefault(); 
    }
  });
  });

  // Populate Delete Modal
  $(document).on('click', '.btn-delete-account', function () {
    const id = $(this).attr('data-id');
    const name = $(this).attr('data-name') || '';
    const number = $(this).attr('data-number') || '';
    const displayTitle = name + (number ? ' (' + number + ')' : '');

    $('#deleteAccountModalTitle').text(displayTitle || ('#' + id));
    $('#deleteAccountConfirmBtn').attr('href', '/account/deletaccount/' + id);
  });
</script>
</body>


</html>