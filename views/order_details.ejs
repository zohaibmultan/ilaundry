  <%- include('templet/script')-%>
  <script>
    $('#addpaymentmodel').on('shown.bs.modal', function() {

      $('#payment').select2({
        dropdownParent: $('#addpaymentmodel'),
        placeholder: 'Select account(a)',
        width: '100%',
        allowClear: true
      });
    });

    // Dispatch & Route Status Interactive Toggles
    $('#details_pickup_toggle').on('change', function() {
      const $sw = $(this);
      const isChecked = this.checked;
      const newStatus = isChecked ? '1' : '0';
      $sw.prop('disabled', true);

      $.ajax({
        url: '/order/calendar/toggle-status',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
          order_id: '<%= order.id %>',
          field: 'pickup',
          status: newStatus
        }),
        success: function(res) {
          $sw.prop('disabled', false);
          if (res.success) {
            const pickedUp = (res.is_picked_up === '1');
            if (pickedUp) {
              $('#details_pickup_badge').removeClass('bg-secondary bg-warning text-dark').addClass('bg-success text-white').html('<i class="fa fa-check-circle me-1"></i> Picked Up');
              $('#details_pickup_time').text(res.picked_up_at ? ('Picked up on ' + res.picked_up_at) : 'Picked Up');
            } else {
              $('#details_pickup_badge').removeClass('bg-success text-white').addClass('bg-warning text-dark').html('<i class="fa fa-clock me-1"></i> Pending Pick-up');
              $('#details_pickup_time').text('Pending Route Pick-up');
            }

            <% if (isRouteRoute) { %>
            if (!pickedUp) {
              $('#details_delivery_toggle').prop('checked', false).prop('disabled', true);
              $('#details_delivery_badge').removeClass('bg-success text-white').addClass('bg-secondary text-white').html('<i class="fa fa-lock me-1"></i> Locked');
              $('#details_delivery_time').text('Awaiting customer pick-up');
              $('#details_delivery_gated_note').removeClass('d-none');
              updateTimelineDelivery(false, null);
            } else {
              $('#details_delivery_toggle').prop('disabled', false);
              $('#details_delivery_gated_note').addClass('d-none');
              if (!$('#details_delivery_toggle').is(':checked')) {
                $('#details_delivery_badge').removeClass('bg-success text-white bg-secondary').addClass('bg-primary text-white').html('<i class="fa fa-clock me-1"></i> Pending Delivery');
                $('#details_delivery_time').text('Pending Route Delivery');
              }
            }
            <% } %>

            updateTimelinePickup(pickedUp, res.picked_up_at);
            if (typeof toastr !== 'undefined') toastr.success(res.message);
          } else {
            $sw.prop('checked', !isChecked);
            if (typeof toastr !== 'undefined') toastr.error(res.message);
          }
        },
        error: function(xhr) {
          $sw.prop('disabled', false);
          $sw.prop('checked', !isChecked);
          const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Error updating pick-up status.';
          if (typeof toastr !== 'undefined') toastr.error(msg);
        }
      });
    });

    $('#details_delivery_toggle').on('change', function() {
      const $sw = $(this);
      const isChecked = this.checked;
      const newStatus = isChecked ? '1' : '0';
      $sw.prop('disabled', true);

      $.ajax({
        url: '/order/calendar/toggle-status',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
          order_id: '<%= order.id %>',
          field: 'delivery',
          status: newStatus
        }),
        success: function(res) {
          $sw.prop('disabled', false);
          if (res.success) {
            const delivered = (res.is_delivered === '1');
            if (delivered) {
              $('#details_delivery_badge').removeClass('bg-secondary bg-primary text-white').addClass('bg-success text-white').html('<i class="fa fa-check-circle me-1"></i> Delivered');
              $('#details_delivery_time').text(res.delivered_at ? ('Delivered on ' + res.delivered_at) : 'Delivered');
            } else {
              $('#details_delivery_badge').removeClass('bg-success text-white bg-secondary').addClass('bg-primary text-white').html('<i class="fa fa-clock me-1"></i> Pending Delivery');
              $('#details_delivery_time').text('Pending Route Delivery');
            }

            updateTimelineDelivery(delivered, res.delivered_at);
            if (typeof toastr !== 'undefined') toastr.success(res.message);
          } else {
            $sw.prop('checked', !isChecked);
            if (typeof toastr !== 'undefined') toastr.error(res.message);
          }
        },
        error: function(xhr) {
          $sw.prop('disabled', false);
          $sw.prop('checked', !isChecked);
          const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Error updating delivery status.';
          if (typeof toastr !== 'undefined') toastr.error(msg);
        }
      });
    });

    function updateTimelinePickup(isPicked, timestamp) {
      const $badge = $('#timeline_pickup_badge');
      const $time = $('#timeline_pickup_time');
      const $title = $('#timeline_pickup_title');
      const $desc = $('#timeline_pickup_desc');

      if (isPicked) {
        $badge.removeClass('warning dark').addClass('success');
        $time.text(timestamp || 'Picked Up');
        $title.removeClass('text-warning text-muted').addClass('text-success')
          .html('<i class="fa fa-check-circle me-1"></i> <%= language.Picked_Up || "Picked Up from Customer" %>');
        $desc.text('Garments collected from customer on route.');
      } else {
        $badge.removeClass('success dark').addClass('warning');
        $time.text('Scheduled: <%= formatNiceDateTime(order.pickup_date) %>');
        $title.removeClass('text-success text-muted').addClass('text-warning')
          .html('<i class="fa fa-clock me-1"></i> <%= language.Pending_Pickup || "Awaiting Route Pick-up" %>');
        $desc.text('Awaiting driver collection on customer route.');
      }
    }

    function updateTimelineDelivery(isDeliv, timestamp) {
      const $badge = $('#timeline_delivery_badge');
      const $time = $('#timeline_delivery_time');
      const $title = $('#timeline_delivery_title');
      const $desc = $('#timeline_delivery_desc');

      if (isDeliv) {
        $badge.removeClass('primary dark warning').addClass('success');
        $time.text(timestamp || 'Delivered');
        $title.removeClass('text-primary text-muted').addClass('text-success')
          .html('<i class="fa fa-check-circle me-1"></i> <%= language.Delivered || "Delivered to Customer" %>');
        $desc.text('Clean garments delivered to customer.');
      } else {
        <% if (isRouteRoute) { %>
        const isPicked = $('#details_pickup_toggle').is(':checked');
        if (!isPicked) {
          $badge.removeClass('success primary warning').addClass('dark');
          $time.text('Scheduled: <%= formatNiceDateTime(order.delivery_date) %>');
          $title.removeClass('text-success text-primary').addClass('text-muted')
            .html('<i class="fa fa-lock me-1"></i> Delivery Gated');
          $desc.text('Awaiting route pick-up first.');
          return;
        }
        <% } %>
        $badge.removeClass('success dark warning').addClass('primary');
        $time.text('Scheduled: <%= formatNiceDateTime(order.delivery_date) %>');
        $title.removeClass('text-success text-muted').addClass('text-primary')
          .html('<i class="fa fa-truck me-1"></i> <%= language.Delivery_Scheduled || "Route Delivery Scheduled" %>');
        $desc.text('Ready for route delivery dispatch.');
      }
    }

    // Real-Time SSE Listener
    if (window.EventSource) {
      const sse = new EventSource('/order/calendar/stream');
      sse.onmessage = function(e) {
        try {
          const data = JSON.parse(e.data);
          if (data.type === 'connected') return;
          if (data.order_id && String(data.order_id) === '<%= order.id %>' && data.action === 'status_changed') {
            if (data.field === 'pickup') {
              const picked = (data.status === '1');
              $('#details_pickup_toggle').prop('checked', picked);
              if (picked) {
                $('#details_pickup_badge').removeClass('bg-secondary bg-warning text-dark').addClass('bg-success text-white').html('<i class="fa fa-check-circle me-1"></i> Picked Up');
                $('#details_pickup_time').text('Picked Up');
              } else {
                $('#details_pickup_badge').removeClass('bg-success text-white').addClass('bg-warning text-dark').html('<i class="fa fa-clock me-1"></i> Pending Pick-up');
                $('#details_pickup_time').text('Pending Route Pick-up');
              }
              <% if (isRouteRoute) { %>
              if (!picked) {
                $('#details_delivery_toggle').prop('checked', false).prop('disabled', true);
                $('#details_delivery_badge').removeClass('bg-success text-white').addClass('bg-secondary text-white').html('<i class="fa fa-lock me-1"></i> Locked');
                $('#details_delivery_time').text('Awaiting customer pick-up');
                $('#details_delivery_gated_note').removeClass('d-none');
                updateTimelineDelivery(false, null);
              } else {
                $('#details_delivery_toggle').prop('disabled', false);
                $('#details_delivery_gated_note').addClass('d-none');
              }
              <% } %>
              updateTimelinePickup(picked, null);
            } else if (data.field === 'delivery') {
              const delivered = (data.status === '1');
              $('#details_delivery_toggle').prop('checked', delivered);
              if (delivered) {
                $('#details_delivery_badge').removeClass('bg-secondary bg-primary text-white').addClass('bg-success text-white').html('<i class="fa fa-check-circle me-1"></i> Delivered');
                $('#details_delivery_time').text('Delivered');
              } else {
                $('#details_delivery_badge').removeClass('bg-success text-white bg-secondary').addClass('bg-primary text-white').html('<i class="fa fa-clock me-1"></i> Pending Delivery');
                $('#details_delivery_time').text('Pending Route Delivery');
              }
              updateTimelineDelivery(delivered, null);
            }
          }
        } catch (err) {
          console.error('SSE sync error:', err);
        }
      };
    }

    // Order Transfer Workflow
    var selectedTargetStoreId = null;
    var selectedTargetStoreName = '';

    function openTransferStoreModal() {
      var transferModalEl = document.getElementById('transferStoreModal');
      if (transferModalEl) {
        var modal = bootstrap.Modal.getOrCreateInstance(transferModalEl);
        modal.show();
      }
    }

    function proceedToTransferConfirm() {
      var checkedRadio = document.querySelector('input[name="target_store_radio"]:checked');
      if (!checkedRadio) {
        if (typeof toastr !== 'undefined') {
          toastr.warning('Please select a destination store');
        } else {
          alert('Please select a destination store');
        }
        return;
      }

      selectedTargetStoreId = checkedRadio.value;
      selectedTargetStoreName = checkedRadio.getAttribute('data-store-name') || ('Store #' + selectedTargetStoreId);

      // Set target name in confirm modal
      var nameEl = document.getElementById('confirmTargetStoreName');
      if (nameEl) {
        nameEl.textContent = selectedTargetStoreName;
      }

      // Hide selection modal and show confirm modal
      var transferModalEl = document.getElementById('transferStoreModal');
      var confirmModalEl = document.getElementById('confirmTransferModal');

      var transferModal = bootstrap.Modal.getInstance(transferModalEl);
      if (transferModal) {
        transferModal.hide();
      }

      setTimeout(function() {
        var confirmModal = bootstrap.Modal.getOrCreateInstance(confirmModalEl);
        confirmModal.show();
      }, 300);
    }

    function executeOrderTransfer() {
      if (!selectedTargetStoreId) {
        if (typeof toastr !== 'undefined') {
          toastr.error('Invalid destination store selected');
        }
        return;
      }

      var btnConfirm = document.getElementById('btnExecuteTransfer');
      if (btnConfirm) {
        btnConfirm.disabled = true;
        btnConfirm.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Transferring...';
      }

      $.ajax({
        type: 'POST',
        url: '/order/transfer_store',
        data: {
          order_id: '<%= order.id %>',
          target_store_id: selectedTargetStoreId
        },
        dataType: 'json',
        success: function(res) {
          if (res.status === 'success') {
            if (typeof toastr !== 'undefined') {
              toastr.success(res.message || 'Order successfully transferred');
            }
            setTimeout(function() {
              window.location.href = res.redirectUrl || '/order/list';
            }, 1200);
          } else {
            if (btnConfirm) {
              btnConfirm.disabled = false;
              btnConfirm.innerHTML = '<i class="fas fa-check me-1"></i> Confirm Transfer';
            }
            if (typeof toastr !== 'undefined') {
              toastr.error(res.message || 'Failed to transfer order');
            } else {
              alert(res.message || 'Failed to transfer order');
            }
          }
        },
        error: function(xhr) {
          if (btnConfirm) {
            btnConfirm.disabled = false;
            btnConfirm.innerHTML = '<i class="fas fa-check me-1"></i> Confirm Transfer';
          }
          var errorMsg = 'An error occurred while transferring the order';
          if (xhr.responseJSON && xhr.responseJSON.message) {
            errorMsg = xhr.responseJSON.message;
          }
          if (typeof toastr !== 'undefined') {
            toastr.error(errorMsg);
          } else {
            alert(errorMsg);
          }
        }
      });
    }

    // ==========================================
    // MULTI-RACK SELECTION MODAL FOR 'READY TO DELIVER'
    // ==========================================
    var pendingRackStatusId = null;
    var cachedOrderRacks = <%- JSON.stringify((typeof storeRacks !== 'undefined' && Array.isArray(storeRacks)) ? storeRacks : []) %>;
    var selectedOrderRackIds = new Set(
      <%- JSON.stringify(((typeof assignedRacks !== 'undefined' && Array.isArray(assignedRacks)) ? assignedRacks : []).map(r => String(r.id))) %>
    );

    function escapeRackHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function handleOrderDetailStatusClick(statusId, statusName, orderId) {
      var sIdNum = parseInt(statusId, 10);
      var sNameLower = String(statusName || '').toLowerCase();
      // When user selects 'Ready To deliver' (id=3 or label contains 'ready'), open multi-rack selection modal
      if (sIdNum === 3 || sNameLower.includes('ready')) {
        openOrderRacksModal(sIdNum);
      } else {
        changeOrderStatus(statusId, orderId);
      }
    }

    function updateSelectedRacksCounter() {
      var countEl = document.getElementById('modal_selected_racks_count');
      if (countEl) {
        countEl.textContent = selectedOrderRackIds.size + ' Selected';
      }
    }

    function renderOrderRacksChecklist(filterQuery) {
      var listEl = document.getElementById('modal_racks_checklist');
      if (!listEl) return;

      var q = String(filterQuery || '').trim().toLowerCase();
      var filtered = cachedOrderRacks.filter(function(r) {
        if (!q) return true;
        return String(r.rack_name || '').toLowerCase().includes(q);
      });

      if (filtered.length === 0) {
        listEl.innerHTML =
          '<div class="text-center py-4 text-muted border rounded bg-light-subtle">' +
          '<i class="fa fa-layer-group fa-2x mb-2 d-block opacity-50"></i>' +
          '<div class="fw-semibold">No racks found</div>' +
          '<div class="small">Use the "+ Quick add rack name" box above to create a rack now.</div>' +
          '</div>';
        updateSelectedRacksCounter();
        return;
      }

      var html = '';
      filtered.forEach(function(r) {
        var rIdStr = String(r.id);
        var isChecked = selectedOrderRackIds.has(rIdStr);
        var items = parseInt(r.itemCount || 0, 10);
        var orders = parseInt(r.orderCount || 0, 10);
        var loadBadge = orders > 0
          ? '<span class="badge bg-success-subtle text-success border"><i class="fa fa-tshirt me-1"></i>' + items + ' ' + (items === 1 ? 'Item' : 'Items') + ' (' + orders + ' ' + (orders === 1 ? 'Order' : 'Orders') + ')</span>'
          : '<span class="badge bg-light-subtle text-muted border">0 Items (Empty)</span>';

        html +=
          '<label class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border rounded cursor-pointer mb-0 ' + (isChecked ? 'border-primary bg-primary-subtle' : '') + '">' +
            '<div class="d-flex align-items-center justify-content-between gap-3">' +
              '<div class="d-flex align-items-center gap-3">' +
                '<input class="form-check-input flex-shrink-0 m-0 order-rack-checkbox" type="checkbox" value="' + escapeRackHtml(rIdStr) + '" ' + (isChecked ? 'checked' : '') + '>' +
                '<div>' +
                  '<div class="fw-bold text-dark"><i class="fa fa-layer-group text-primary me-1"></i>' + escapeRackHtml(r.rack_name) + '</div>' +
                '</div>' +
              '</div>' +
              loadBadge +
            '</div>' +
          '</label>';
      });

      listEl.innerHTML = html;
      updateSelectedRacksCounter();
    }

    $(document).on('change', '.order-rack-checkbox', function() {
      var val = String($(this).val());
      var $label = $(this).closest('label');
      if (this.checked) {
        selectedOrderRackIds.add(val);
        $label.addClass('border-primary bg-primary-subtle');
      } else {
        selectedOrderRackIds.delete(val);
        $label.removeClass('border-primary bg-primary-subtle');
      }
      updateSelectedRacksCounter();
    });

    $(document).on('input', '#modal_rack_search_input', function() {
      renderOrderRacksChecklist($(this).val());
    });

    function openOrderRacksModal(statusId) {
      pendingRackStatusId = statusId ? parseInt(statusId, 10) : null;
      var btnEl = document.getElementById('btn_confirm_order_racks');
      if (btnEl) {
        btnEl.disabled = false;
        btnEl.innerHTML = pendingRackStatusId
          ? '<i class="fa fa-check me-1"></i><span>Confirm & Mark Ready to Deliver</span>'
          : '<i class="fa fa-save me-1"></i><span>Save Assigned Racks</span>';
      }

      $('#modal_rack_search_input').val('');
      $('#order_rack_collision_alert').addClass('d-none');
      isRackCollisionConfirmed = false;
      renderOrderRacksChecklist('');

      var modalEl = document.getElementById('assignOrderRacksModal');
      if (modalEl) {
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
      }

      // Refresh live rack item counts from server
      $.ajax({
        type: 'GET',
        url: '/order/racks/for-order/<%= order.id %>',
        dataType: 'json',
        success: function(res) {
          if (res && res.success && Array.isArray(res.racks)) {
            cachedOrderRacks = res.racks;
            if (Array.isArray(res.selectedRackIds) && res.selectedRackIds.length > 0 && selectedOrderRackIds.size === 0) {
              res.selectedRackIds.forEach(function(id) {
                selectedOrderRackIds.add(String(id));
              });
            }
            renderOrderRacksChecklist($('#modal_rack_search_input').val());
          }
        }
      });
    }

    function quickAddRackFromModal() {
      var $input = $('#quick_add_rack_name');
      var name = String($input.val() || '').trim();
      if (!name) {
        if (typeof toastr !== 'undefined') toastr.warning('Please enter a rack name');
        $input.focus();
        return;
      }

      var $btn = $('#btn_quick_add_rack');
      $btn.prop('disabled', true);

      $.ajax({
        type: 'POST',
        url: '/order/racks/add',
        data: {
          rack_name: name,
          store_id: '<%= order.store_id %>',
          ajax: '1'
        },
        dataType: 'json',
        success: function(res) {
          $btn.prop('disabled', false);
          if (res && res.success && res.rack) {
            $input.val('');
            cachedOrderRacks.push(res.rack);
            cachedOrderRacks.sort(function(a, b) {
              return String(a.rack_name || '').localeCompare(String(b.rack_name || ''));
            });
            selectedOrderRackIds.add(String(res.rack.id));
            renderOrderRacksChecklist($('#modal_rack_search_input').val());
            if (typeof toastr !== 'undefined') toastr.success(res.message || 'Rack added and selected');
          } else {
            if (typeof toastr !== 'undefined') toastr.error((res && res.message) || 'Failed to add rack');
          }
        },
        error: function(xhr) {
          $btn.prop('disabled', false);
          var msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Failed to add rack';
          if (typeof toastr !== 'undefined') toastr.error(msg);
        }
      });
    }

    $('#quick_add_rack_name').on('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        quickAddRackFromModal();
      }
    });

    $(document).on('click', '#btn_edit_order_racks', function() {
      openOrderRacksModal(null);
    });

    var isRackCollisionConfirmed = false;

    $(document).on('click', '#btn_confirm_shared_rack_inline', function() {
      submitOrderRacksSelection(true);
    });

    $(document).on('click', '#btn_confirm_rack_collision_proceed', function() {
      isRackCollisionConfirmed = true;
      var confirmModal = bootstrap.Modal.getInstance(document.getElementById('confirmRackCollisionModal'));
      if (confirmModal) {
        confirmModal.hide();
      }
      submitOrderRacksSelection(true);
    });

    $('#confirmRackCollisionModal').on('hidden.bs.modal', function() {
      if (!isRackCollisionConfirmed) {
        setTimeout(function() {
          var assignModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('assignOrderRacksModal'));
          assignModal.show();
        }, 200);
      }
    });

    function submitOrderRacksSelection(forceConfirm) {
      var rackIds = Array.from(selectedOrderRackIds);
      if (rackIds.length === 0) {
        if (typeof toastr !== 'undefined') {
          toastr.warning('Please select at least one rack for this order');
        } else {
          alert('Please select at least one rack for this order');
        }
        return;
      }

      var btnEl = document.getElementById('btn_confirm_order_racks');
      if (btnEl) {
        btnEl.disabled = true;
        btnEl.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i><span>Saving...</span>';
      }

      $.ajax({
        type: 'POST',
        url: '/order/assign-racks',
        contentType: 'application/json',
        data: JSON.stringify({
          order_id: '<%= order.id %>',
          rack_ids: rackIds,
          status_id: pendingRackStatusId,
          force_confirm: forceConfirm ? true : false
        }),
        dataType: 'json',
        success: function(res) {
          if (res && res.status === 'warning' && res.requires_confirmation) {
            if (btnEl) {
              btnEl.disabled = false;
              btnEl.innerHTML = '<i class="fa fa-check me-1"></i><span>Confirm Selection</span>';
            }
            if (typeof toastr !== 'undefined') {
              toastr.warning(res.message, 'Rack Collision Warning', { timeOut: 7000, closeButton: true });
            }

            isRackCollisionConfirmed = false;
            $('#confirm_rack_collision_modal_msg').text(res.message);
            $('#order_rack_collision_msg').text(res.message);
            $('#order_rack_collision_alert').removeClass('d-none');

            var assignModal = bootstrap.Modal.getInstance(document.getElementById('assignOrderRacksModal'));
            if (assignModal) {
              assignModal.hide();
            }

            setTimeout(function() {
              var confirmModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmRackCollisionModal'));
              confirmModal.show();
            }, 250);
            return;
          }

          if (res && res.status === 'success') {
            if (typeof toastr !== 'undefined') {
              toastr.success(res.message || 'Order racks saved successfully');
            }
            setTimeout(function() {
              location.reload();
            }, 700);
          } else {
            if (btnEl) {
              btnEl.disabled = false;
              btnEl.innerHTML = '<i class="fa fa-check me-1"></i><span>Confirm Selection</span>';
            }
            if (typeof toastr !== 'undefined') {
              toastr.error((res && res.message) || 'Failed to save racks');
            }
          }
        },
        error: function(xhr) {
          if (btnEl) {
            btnEl.disabled = false;
            btnEl.innerHTML = '<i class="fa fa-check me-1"></i><span>Confirm Selection</span>';
          }
          var msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Error saving rack assignment';
          if (typeof toastr !== 'undefined') toastr.error(msg);
        }
      });
    }
    // ==========================================
    // MANUAL INVOICE DISPATCH (EMAIL, SMS, WHATSAPP)
    // ==========================================
    var currentSendChannel = 'email';
    var currentWaPayload = null;
    var orderCustomerEmail = "<%= (customer && customer.email) ? customer.email : '' %>";
    var orderCustomerPhone = "<%= (customer && (customer.number || customer.mobile_no || customer.phone)) ? (customer.number || customer.mobile_no || customer.phone) : '' %>";

    function openSendInvoiceModal(channel) {
      currentSendChannel = channel;
      var iconEl = document.getElementById('send_invoice_modal_icon');
      var titleEl = document.getElementById('send_invoice_modal_title');
      var noticeText = document.getElementById('send_invoice_notice_text');
      var labelEl = document.getElementById('send_invoice_recipient_label');
      var inputEl = document.getElementById('send_invoice_recipient_input');
      var waGroup = document.getElementById('send_invoice_wa_preview_group');
      var waPreview = document.getElementById('send_invoice_message_preview');
      var confirmBtn = document.getElementById('btn_confirm_send_invoice');
      var confirmIcon = document.getElementById('send_invoice_confirm_icon');
      var confirmText = document.getElementById('send_invoice_confirm_text');
      var statusAlert = document.getElementById('send_invoice_status_alert');

      if (statusAlert) {
        statusAlert.classList.add('d-none');
        statusAlert.textContent = '';
      }

      if (channel === 'email') {
        iconEl.className = 'fa fa-envelope text-primary me-2';
        titleEl.textContent = 'Email Invoice';
        noticeText.textContent = 'Send invoice email to customer immediately, even if automated notifications are disabled in settings.';
        labelEl.textContent = 'Customer Email Address:';
        inputEl.type = 'email';
        inputEl.value = orderCustomerEmail;
        inputEl.placeholder = 'e.g. customer@example.com';
        waGroup.classList.add('d-none');
        confirmBtn.className = 'btn btn-primary';
        confirmIcon.className = 'fa fa-paper-plane me-2';
        confirmText.textContent = 'Send Email';
      } else if (channel === 'sms') {
        iconEl.className = 'fa fa-sms text-info me-2';
        titleEl.textContent = 'SMS Invoice';
        noticeText.textContent = 'Send invoice SMS notification to customer immediately, even if automated notifications are disabled in settings.';
        labelEl.textContent = 'Customer Mobile Number:';
        inputEl.type = 'tel';
        inputEl.value = orderCustomerPhone;
        inputEl.placeholder = 'e.g. +1 555-123-4567';
        waGroup.classList.add('d-none');
        confirmBtn.className = 'btn btn-info text-white';
        confirmIcon.className = 'fa fa-paper-plane me-2';
        confirmText.textContent = 'Send SMS';
      } else if (channel === 'whatsapp') {
        iconEl.className = 'fab fa-whatsapp text-success me-2';
        titleEl.textContent = 'WhatsApp Invoice';
        noticeText.textContent = 'Review recipient phone number and itemized message, then click to open WhatsApp chat with pre-filled invoice message.';
        labelEl.textContent = 'Customer WhatsApp Phone Number:';
        inputEl.type = 'tel';
        inputEl.value = orderCustomerPhone;
        inputEl.placeholder = 'e.g. 15551234567';
        waGroup.classList.remove('d-none');
        confirmBtn.className = 'btn btn-success text-white';
        confirmIcon.className = 'fab fa-whatsapp me-2';
        confirmText.textContent = 'Open in WhatsApp';

        // Load preview payload from backend
        confirmBtn.disabled = true;
        confirmText.textContent = 'Loading preview...';
        $.ajax({
          type: 'GET',
          url: '/order/whatsapp-invoice-payload/<%= order.id %>',
          dataType: 'json',
          success: function(data) {
            if (data && data.success) {
              currentWaPayload = data;
              if (data.phone && !inputEl.value) {
                inputEl.value = data.phone;
              }
              if (waPreview) {
                waPreview.value = data.message || '';
              }
            }
          },
          error: function(err) {
            console.warn('Could not load WhatsApp invoice preview:', err);
          },
          complete: function() {
            confirmBtn.disabled = false;
            confirmText.textContent = 'Open in WhatsApp';
          }
        });
      }

      var modalEl = document.getElementById('sendInvoiceModal');
      if (modalEl) {
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
      }
      setTimeout(function() { inputEl.focus(); }, 300);
    }

    function executeSendInvoice() {
      var inputEl = document.getElementById('send_invoice_recipient_input');
      var statusAlert = document.getElementById('send_invoice_status_alert');
      var confirmBtn = document.getElementById('btn_confirm_send_invoice');
      var confirmIcon = document.getElementById('send_invoice_confirm_icon');
      var confirmText = document.getElementById('send_invoice_confirm_text');
      var updateCheck = document.getElementById('send_invoice_update_profile_check');
      var waPreview = document.getElementById('send_invoice_message_preview');

      var recipient = (inputEl ? inputEl.value : '').trim();
      if (!recipient) {
        if (statusAlert) {
          statusAlert.textContent = currentSendChannel === 'email' ? 'Please enter a valid email address.' : 'Please enter a valid phone number.';
          statusAlert.classList.remove('d-none');
        }
        if (inputEl) inputEl.focus();
        return;
      }

      if (currentSendChannel === 'whatsapp') {
        var cleanDigits = recipient.replace(/\D/g, '');
        if (cleanDigits.length === 10) {
          cleanDigits = '1' + cleanDigits;
        }
        if (!cleanDigits) {
          if (statusAlert) {
            statusAlert.textContent = 'Please enter a valid phone number with digits.';
            statusAlert.classList.remove('d-none');
          }
          return;
        }

        var msg = (waPreview ? waPreview.value : (currentWaPayload ? currentWaPayload.message : 'Invoice details'));
        var waUrl = 'https://wa.me/' + cleanDigits + '?text=' + encodeURIComponent(msg);

        // Record WhatsApp dispatch in background
        $.ajax({
          type: 'POST',
          url: '/order/send-manual-invoice',
          contentType: 'application/json',
          data: JSON.stringify({
            order_id: '<%= order.id %>',
            channel: 'whatsapp',
            recipient: recipient,
            update_customer: updateCheck ? updateCheck.checked : false
          })
        });

        var modalEl = document.getElementById('sendInvoiceModal');
        if (modalEl) {
          bootstrap.Modal.getOrCreateInstance(modalEl).hide();
        }
        window.open(waUrl, '_blank');
        if (typeof toastr !== 'undefined') {
          toastr.success('WhatsApp chat opened for ' + recipient, 'WhatsApp Ready');
        }
        return;
      }

      // Email / SMS send
      var origIcon = confirmIcon.className;
      var origText = confirmText.textContent;
      confirmBtn.disabled = true;
      confirmIcon.className = 'fa fa-spinner fa-spin me-2';
      confirmText.textContent = 'Sending...';
      if (statusAlert) statusAlert.classList.add('d-none');

      $.ajax({
        type: 'POST',
        url: '/order/send-manual-invoice',
        contentType: 'application/json',
        data: JSON.stringify({
          order_id: '<%= order.id %>',
          channel: currentSendChannel,
          recipient: recipient,
          update_customer: updateCheck ? updateCheck.checked : false
        }),
        dataType: 'json',
        success: function(res) {
          if (res && res.success) {
            var modalEl = document.getElementById('sendInvoiceModal');
            if (modalEl) {
              bootstrap.Modal.getOrCreateInstance(modalEl).hide();
            }
            if (typeof toastr !== 'undefined') {
              toastr.success(res.message || 'Invoice dispatched successfully', 'Sent');
            }
          } else {
            var errMessage = (res && res.message) || ('Failed to send invoice via ' + currentSendChannel);
            if (statusAlert) {
              statusAlert.textContent = errMessage;
              statusAlert.classList.remove('d-none');
            }
            if (typeof toastr !== 'undefined') {
              toastr.error(errMessage);
            }
          }
        },
        error: function(xhr) {
          var errMessage = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : ('Error dispatching invoice via ' + currentSendChannel);
          if (statusAlert) {
            statusAlert.textContent = errMessage;
            statusAlert.classList.remove('d-none');
          }
          if (typeof toastr !== 'undefined') {
            toastr.error(errMessage);
          }
        },
        complete: function() {
          confirmBtn.disabled = false;
          confirmIcon.className = origIcon;
          confirmText.textContent = origText;
        }
      });
    }
  </script>
</body>


</html>
