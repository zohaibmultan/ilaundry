<!DOCTYPE html>
<html lang="en" class="h-100">


<head>
  <!-- meta and links start -->
  <%- include('templet/meta')-%>

</head>

<body>
  <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name })-%>

    <!--********** Content body start **********-->

    <div class="content-body">
      <div class="container-fluid" style="min-height: 100vh;">
        <div class="row">
          <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
              <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                  <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                    <i class="fa fa-users text-primary me-2"></i><%= language.Customer_List %>
                  </h3>
                  <small class="text-muted"><%= language.Customer_List_Subtitle || 'View, search, and manage registered customer profiles and accounts' %></small>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <button class="btn btn-sm btn-primary <%= login == 'customer' ||
                    !accessdata?.roll?.customers?.includes('write') ? 'd-none' : '' %>" data-bs-toggle="modal"
                    data-bs-target="#addcoustomer">
                    <i class="fa fa-plus me-2"></i><%= language.Add_Customer %>
                  </button>
                </div>
              </div>
              <div class="card-body p-4">
                <!-- Server-side DataTable Toolbar -->

                <div class="row g-2 mb-3">
                  <div class="<%= (ismulty && login==='master') ? 'col-12 col-md-3 col-lg-3' : 'col-12 col-md-4 col-lg-4' %>">
                    <div class="input-group">
                      <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                      <input class="form-control" type="search" id="dtCustomerSearch"
                        placeholder="Search customers by name, username, phone, email, address...">
                    </div>
                  </div>
                  <div class="<%= (ismulty && login==='master') ? 'col-6 col-sm-3 col-md-3 col-lg-3' : 'col-6 col-sm-4 col-md-3 col-lg-3' %>">
                    <select class="form-select" id="dtCustomerType">
                      <option value="all"><%= language.All_Customer_Types || 'All Customer Types' %></option>
                      <% if (typeof customer_types !== 'undefined' && customer_types && customer_types.length > 0) { %>
                        <% customer_types.forEach(function(ct) { %>
                          <option value="<%= ct.name %>"><%= ct.code ? '[' + ct.code + '] ' : '' %><%= ct.name %></option>
                        <% }) %>
                      <% } %>
                    </select>
                  </div>
                  <div class="<%= (ismulty && login==='master') ? 'col-6 col-sm-3 col-md-2 col-lg-2' : 'col-6 col-sm-4 col-md-3 col-lg-3' %>">
                    <select class="form-select" id="dtCustomerStatus">
                      <option value="all"><%= language.All_Status || 'All Status' %></option>
                      <option value="1"><%= language.Approved || 'Approved' %></option>
                      <option value="0"><%= language.Pending || 'Pending' %></option>
                    </select>
                  </div>

                  <% if (ismulty && login==="master" ) { %>
                    <div class="col-6 col-sm-3 col-md-2 col-lg-2">
                      <select class="form-select" id="dtCustomerStore">
                        <option value="all"><%= language.All_Store || 'All Stores' %></option>
                        <% storeList.forEach(function(st) { %>
                          <option value="<%= st.id %>"><%= st.name %></option>
                        <% }) %>
                      </select>
                    </div>
                  <% } %>

                  <div class="<%= (ismulty && login==='master') ? 'col-6 col-sm-3 col-md-2 col-lg-2' : 'col-12 col-sm-4 col-md-2 col-lg-2' %>">
                    <select class="form-select" id="dtCustomerPageLength">
                      <option value="10">10 <%= language.Entries || 'entries' %></option>
                      <option value="25">25 <%= language.Entries || 'entries' %></option>
                      <option value="50">50 <%= language.Entries || 'entries' %></option>
                      <option value="100">100 <%= language.Entries || 'entries' %></option>
                    </select>
                  </div>
                </div>


                <div class="table-responsive">
                  <table id="server_customer_table" class="table display server-side-dt" style="width: 100%;">
                    <thead>
                      <tr>
                        <th style="width: 50px;">#</th>
                        <th>
                          <%= language.Customer_Name %>
                        </th>
                        <th>
                          <%= language.Customer_Type || 'Customer Type' %>
                        </th>
                        <th>
                          <%= language.Contect %>
                        </th>
                        <th>
                          <%= language.Address %>
                        </th>
                        <th class="<%= ismulty && login == 'master' ? '' : 'd-none' %>">
                          <%= language.Store_Name %>
                        </th>
                        <th style="width: 110px;">
                          <%= language.Status %>
                        </th>
                        <th class="text-center" style="width: 165px;">
                          <%= language.Action %>
                        </th>
                      </tr>
                    </thead>
                    <tbody></tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Modal update -->
      <div class="modal fade" id="coustomer" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-sm-down" role="document">
          <form action="/coustomer/update/" id="coustomer_form" method="post" class="modal-content need-validation">
            <div class="modal-header">
              <h5 class="modal-title">
                <%= language.Customer_Detail %>
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.Last_Name || 'Last Name' %> <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="last_name" id="last_name" placeholder="Enter last name" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.First_Name || 'First Name' %> <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="first_name" id="first_name" placeholder="Enter first name" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.Phone_Number %> <span class="text-danger">*</span>
                    </label>
                    <input type="number" class="form-control" name="number" id="number" placeholder="Enter phone number" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.Email %> <span class="text-danger">*</span>
                    </label>
                    <input type="email" class="form-control" name="email" id="email" placeholder="Enter email address" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.Customer_Type || 'Customer Type' %>
                    </label>
                    <select class="form-control form-select" name="customer_type" id="edit_customer_type">
                      <% if (typeof customer_types !== 'undefined' && customer_types && customer_types.length > 0) { %>
                        <% customer_types.forEach(function(ct){ %>
                          <option value="<%= ct.name %>"><%= ct.name %><% if (ct.description) { %> - <%= ct.description %><% } %></option>
                        <% }); %>
                      <% } else { %>
                        <option value="Counter • Counter">Counter • Counter - Customer will drop-off and customer will pickup</option>
                        <option value="Counter • Route">Counter • Route - Customer will drop-off and store will deliver</option>
                        <option value="Route • Route">Route • Route - Store will pickup and store will deliver</option>
                        <option value="Route • Counter">Route • Counter - Store will pickup and customer will pickup</option>
                      <% } %>
                    </select>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      Date of Birth <span class="text-muted fw-normal fs-12">(Optional)</span>
                    </label>
                    <input type="date" class="form-control" name="dob" id="edit_dob" placeholder="YYYY-MM-DD">
                  </div>

                  <div class="col-md-6" style="display: none;">
                    <label class="form-label fw-bold">
                      <%= language.Tax_Number %>
                    </label>
                    <input type="text" class="form-control" name="tax" id="tax" placeholder="Enter tax number">
                  </div>

                  <div class="col-12">
                    <label class="form-label fw-bold">
                      <%= language.Address || 'Address' %> <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="address" id="address" placeholder="Enter street address" required>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label fw-bold">
                      <%= language.City || 'City' %> <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="city" id="city" placeholder="Enter city" required>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label fw-bold">
                      <%= language.State || 'State' %> <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="state" id="state" placeholder="Enter state" required>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label fw-bold">
                      <%= language.Zip_Code || 'Zip Code' %>
                    </label>
                    <input type="text" class="form-control" name="zipcode" id="zipcode" placeholder="Enter zip code">
                  </div>

                  <div class="col-12">
                    <label class="form-label fw-bold">
                      <%= language.Customer_Memo || 'Customer Memo / Note' %>
                    </label>
                    <textarea class="form-control" name="memo" id="memo" rows="2" placeholder="Special instructions, preferences, laundry notes..."></textarea>
                  </div>

                  <div class="col-12 <%= login == 'customer' ? 'd-none' : '' %>">
                    <div class="form-check form-switch pt-1">
                      <input class="form-check-input" type="checkbox" id="Approved" name="approved" value="1">
                      <label class="form-check-label fw-bold" for="Approved">
                        <%= language.Is_Approved %> ?
                      </label>
                    </div>
                  </div>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                  <i class="fa fa-times me-2"></i><%= language.Cancel %>
                </button>
                <button type="submit" class="btn btn-primary">
                  <i class="fa fa-save me-2"></i><%= language.Save %>
                </button>
              </div>
            </form>
        </div>
      </div>

      <!-- Modal add -->
      <div class="modal fade" id="addcoustomer" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-sm-down" role="document">
          <form action="/coustomer/register" method="post" class="modal-content need-validation">
            <div class="modal-header">
              <h5 class="modal-title">
                <%= language.Add_Customer || language.Customer_Detail %>
              </h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="storeid" value="<%= (typeof assigned_store_id !== 'undefined' && assigned_store_id) ? assigned_store_id : (typeof staff_store_id !== 'undefined' && staff_store_id ? staff_store_id : ((typeof storeList !== 'undefined' && storeList.length > 0) ? storeList[0].id : '')) %>">

                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.Last_Name || 'Last Name' %> <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="last_name" placeholder="Enter last name" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.First_Name || 'First Name' %> <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="first_name" placeholder="Enter first name" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.Phone_Number %> <span class="text-danger">*</span>
                    </label>
                    <input type="number" class="form-control" name="number" id="add_cust_number" placeholder="Enter phone number" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.Email %> <span class="text-danger">*</span>
                    </label>
                    <input type="email" class="form-control" name="email" placeholder="Enter email address" required>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.Customer_Type || 'Customer Type' %>
                    </label>
                    <select class="form-control form-select" name="customer_type">
                      <% if (typeof customer_types !== 'undefined' && customer_types && customer_types.length > 0) { %>
                        <% customer_types.forEach(function(ct, idx){ %>
                          <option value="<%= ct.name %>" <%= idx === 0 ? 'selected' : '' %>>
                            <%= ct.name %><% if (ct.description) { %> - <%= ct.description %><% } %>
                          </option>
                        <% }); %>
                      <% } else { %>
                        <option value="Counter • Counter" selected>Counter • Counter - Customer will drop-off and customer will pickup</option>
                        <option value="Counter • Route">Counter • Route - Customer will drop-off and store will deliver</option>
                        <option value="Route • Route">Route • Route - Store will pickup and store will deliver</option>
                        <option value="Route • Counter">Route • Counter - Store will pickup and customer will pickup</option>
                      <% } %>
                    </select>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      Date of Birth <span class="text-muted fw-normal fs-12">(Optional)</span>
                    </label>
                    <input type="date" class="form-control" name="dob" id="add_dob" placeholder="YYYY-MM-DD">
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.Username %>
                    </label>
                    <input type="text" class="form-control" name="username" id="add_cust_username" placeholder="Defaults to phone number">
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold">
                      <%= language.Password %>
                    </label>
                    <input type="password" class="form-control" name="password" id="add_cust_password" placeholder="Defaults to phone number">
                  </div>

                  <div class="col-12">
                    <label class="form-label fw-bold">
                      <%= language.Address || 'Address' %> <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="address" placeholder="Enter street address" required>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label fw-bold">
                      <%= language.City || 'City' %> <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="city" placeholder="Enter city" required>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label fw-bold">
                      <%= language.State || 'State' %> <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" name="state" placeholder="Enter state" required>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label fw-bold">
                      <%= language.Zip_Code || 'Zip Code' %>
                    </label>
                    <input type="text" class="form-control" name="zipcode" placeholder="Enter zip code">
                  </div>

                  <div class="col-12">
                    <label class="form-label fw-bold">
                      <%= language.Customer_Memo || 'Customer Memo / Note' %>
                    </label>
                    <textarea class="form-control" name="memo" rows="2" placeholder="Special instructions, preferences, laundry notes..."></textarea>
                  </div>
                </div>
              </div>

              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                  <i class="fa fa-times me-2"></i><%= language.Cancel %>
                </button>
                <button type="submit" class="btn btn-primary">
                  <i class="fa fa-save me-2"></i><%= language.Save %>
                </button>
              </div>
            </form>
        </div>
      </div>
    </div>

    <!-- Delete Customer Confirmation Modal -->
    <div class="modal fade" id="deleteCustomerModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content text-center p-3" style="border-radius: 16px;">
          <div class="modal-body pt-4">
            <div class="mb-3">
              <div
                style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
                <i class="fa fa-user-times"></i>
              </div>
            </div>
            <h4 class="mb-2 fw-bold text-dark">
              <%= language.Delete_Customer || 'Delete Customer' %>
            </h4>
            <p class="text-muted mb-1">
              <%= language.Are_you_sure_delete || 'Are you sure you want to delete this customer?' %>
            </p>
            <p class="fw-bold text-danger fs-5 mb-3" id="deleteCustomerModalName"></p>
            <p class="text-xs text-muted mb-4">
              <%= language.Action_cannot_be_undone || 'This action cannot be undone.' %>
            </p>
            <div class="d-flex gap-2 justify-content-center">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
              </button>
              <a href="#" id="deleteCustomerConfirmBtn" class="btn btn-danger">
                <i class="fa fa-trash me-2"></i><%= language.Delete || 'Yes, Delete' %>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Customer Credentials Update Modal -->
    <div class="modal fade" id="customerCredentialsModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <form id="customer_credentials_form" action="/coustomer/update-credentials/" method="post" class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
              <i class="fa fa-key text-primary"></i>
              <span><%= language.Update_Credentials || 'Update Username & Password' %></span>
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="p-2 px-3 mb-3 rounded-3 border bg-light-subtle d-flex align-items-center gap-2">
              <i class="fa fa-user-circle text-primary fs-5"></i>
              <div>
                <small class="text-muted d-block"><%= language.Customer_Name || 'Customer' %></small>
                <span class="fw-bold text-dark-emphasis" id="credCustomerName"></span>
              </div>
            </div>

            <div class="alert alert-danger py-2 px-3 d-none" id="credErrorAlert" role="alert"></div>

            <div class="mb-3">
              <label class="form-label fw-bold" for="cred_username">
                <%= language.Username || 'Username' %> <span class="text-danger">*</span>
              </label>
              <div class="input-group">
                <span class="input-group-text"><i class="fa fa-at text-muted"></i></span>
                <input type="text" class="form-control" id="cred_username" name="username" placeholder="Enter login username" required autocomplete="off">
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold" for="cred_new_password">
                <%= language.New_Password || 'New Password' %>
                <span class="text-muted fw-normal fs-12">(<%= language.Optional || 'Optional' %>)</span>
              </label>
              <div class="input-group">
                <span class="input-group-text"><i class="fa fa-lock text-muted"></i></span>
                <input type="password" class="form-control" id="cred_new_password" name="new_password" minlength="6" placeholder="Leave blank to keep current password" autocomplete="new-password">
                <button type="button" class="btn btn-outline-secondary btn-toggle-cred-pw" data-target="cred_new_password" title="Show/Hide Password">
                  <i class="fa fa-eye"></i>
                </button>
              </div>
              <small class="text-muted">Minimum 6 characters when changing password. Leave blank to update username only.</small>
            </div>

            <div class="mb-1">
              <label class="form-label fw-bold" for="cred_confirm_password">
                <%= language.Confirm_Password || 'Confirm New Password' %>
              </label>
              <div class="input-group">
                <span class="input-group-text"><i class="fa fa-check-double text-muted"></i></span>
                <input type="password" class="form-control" id="cred_confirm_password" name="confirm_password" minlength="6" placeholder="Re-enter new password" autocomplete="new-password">
                <button type="button" class="btn btn-outline-secondary btn-toggle-cred-pw" data-target="cred_confirm_password" title="Show/Hide Password">
                  <i class="fa fa-eye"></i>
                </button>
              </div>
              <div class="mt-1 small" id="credMatchFeedback"></div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
            </button>
            <button type="submit" class="btn btn-primary" id="btnSaveCredentials">
              <i class="fa fa-save me-2"></i><%= language.Save || 'Save Changes' %>
            </button>
          </div>
        </form>
      </div>
    </div>

    <%- include('templet/footer')-%>
</div>

<!--********** Main wrapper end **********-->
<%- include('templet/script')-%>
<script>
  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  $(document).ready(function () {
    const isMasterMultistore = <%= (ismulty && login === 'master') ? 'true' : 'false' %>;

    const dtColumns = [
      {
        data: null,
        orderable: false,
        searchable: false,
        render: function (data, type, row, meta) {
          return meta.settings._iDisplayStart + meta.row + 1;
        }
      },
      {
        data: 'name',
        render: function (data, type, row) {
                  const displayName = (row.last_name && row.first_name)
                    ? `${escapeHtml(row.last_name)}, ${escapeHtml(row.first_name)}`
                    : escapeHtml(data || row.first_name || row.last_name || '');
                  const usernameHtml = row.username
                    ? `<div class="text-xs text-muted fw-normal"><i class="fa fa-at me-1 opacity-75"></i>${escapeHtml(row.username)}</div>`
                    : '';
                  return `<div class="fw-bold text-dark">${displayName}</div>${usernameHtml}`;
        }
      },
      {
        data: 'customer_type',
        render: function (data, type, row) {
          const typeName = escapeHtml(row.customer_type || data || 'Counter • Counter');
          const code = escapeHtml(row.customer_type_code || 'C • C');
          const desc = escapeHtml(row.customer_type_description || '');

          return `
            <div class="d-flex flex-column gap-1">
              <div class="d-flex align-items-center gap-1 flex-wrap">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold px-2 py-1">${code}</span>
                <span class="fw-semibold text-dark">${typeName}</span>
              </div>
              ${desc ? `<div class="text-xs text-muted text-truncate" style="max-width: 220px;" title="${desc}">${desc}</div>` : ''}
            </div>
          `;
        }
      },
      {
        data: 'number',
        render: function (data, type, row) {
          return `
    <div class="fw-semibold text-dark"><i class="fa fa-phone-alt text-success me-1"></i>${escapeHtml(row.number || '')}</div>
    ${row.email ? `<div class="text-xs text-muted"><i class="fa fa-envelope text-info me-1"></i>${escapeHtml(row.email)}</div>` : ''}
  `;
        }
      },
      {
        data: 'address',
        render: function (data, type, row) {
          const parts = [row.address, row.city, row.state, row.zipcode].filter(Boolean);
          const fullAddr = parts.length > 0 ? parts.join(', ') : (data || '—');
          return `<span class="text-sm text-secondary">${escapeHtml(fullAddr)}</span>`;
        }
      },
      {
        data: 'store',
        visible: isMasterMultistore,
        render: function (data) {
          return `<span class="badge bg-light text-dark px-2 py-1">${escapeHtml(data) || '—'}</span>`;
        }
      },
      {
        data: 'approved',
        render: function (data) {
          if (data === 1) {
            return '<span class="badge-status-pill badge-pill-completed"><i class="fa fa-check-circle"></i> <%= language.Approved || "Approved" %></span>';
          }
          return '<span class="badge-status-pill badge-pill-pending"><i class="fa fa-clock"></i> <%= language.Pending || "Pending" %></span>';
        }
      }
    ];

    dtColumns.push({
      data: null,
      orderable: false,
      searchable: false,
      className: 'text-center',
      render: function (data, type, row) {
        const custDisplayName = (row.last_name && row.first_name)
          ? `${row.last_name}, ${row.first_name}`
          : (row.name || row.first_name || row.last_name || '');
        let html = '<div class="tbl-action-group justify-content-center">';
        if (row.canEdit) {
          html += `
    <a href="#" class="btn-dt-action btn-edit btn-edit-customer"
        data-bs-toggle="modal" data-bs-target="#coustomer"
        data-id="${row.id}"
        data-name="${escapeHtml(row.name)}"
               data-first-name="${escapeHtml(row.first_name || '')}"
               data-last-name="${escapeHtml(row.last_name || '')}"
        data-number="${escapeHtml(row.number)}"
        data-email="${escapeHtml(row.email)}"
        data-address="${escapeHtml(row.address || '')}"
        data-city="${escapeHtml(row.city || '')}"
        data-state="${escapeHtml(row.state || '')}"
        data-zipcode="${escapeHtml(row.zipcode || '')}"
        data-addresh="${escapeHtml(row.address || '')}"
        data-memo="${escapeHtml(row.memo || '')}"
        data-dob="${escapeHtml(row.dob || '')}"
        data-customer-type="${escapeHtml(row.customer_type || 'Counter • Counter')}"
        data-tax="${escapeHtml(row.taxnumber)}"
        data-approved="${row.approved}"
        data-active="${row.delet_flage}"
        data-roll="${row.roll_id}"
        title="<%= language.Edit || 'Edit' %>">
      <i class="fas fa-pencil-alt"></i>
    </a>`;
        }
        if (row.canResetCredentials) {
          html += `
    <button type="button" class="btn-dt-action btn-credentials btn-credentials-customer"
            data-bs-toggle="modal" data-bs-target="#customerCredentialsModal"
            data-id="${row.id}"
            data-name="${escapeHtml(custDisplayName)}"
            data-username="${escapeHtml(row.username || '')}"
            title="<%= language.Update_Credentials || 'Update Username & Password' %>">
      <i class="fa fa-key"></i>
    </button>`;
        }
        if (row.transiction > 0) {
          html += `
    <a href="/coustomer/ledger/${row.id}" class="btn-dt-action btn-info" title="<%= language.Ledger || 'Customer Ledger' %>">
      <i class="fas fa-book-open"></i>
    </a>`;
        }
        if (row.canDelete) {
          html += `
    <button type="button" class="btn-dt-action btn-delete btn-delete-customer"
            data-bs-toggle="modal" data-bs-target="#deleteCustomerModal"
                    data-id="${row.id}"
                    data-name="${escapeHtml(custDisplayName)}"
                    data-first-name="${escapeHtml(row.first_name || '')}"
                    data-last-name="${escapeHtml(row.last_name || '')}"
            title="<%= language.Delete || 'Delete' %>">
      <i class="fa fa-trash"></i>
    </button>`;
        }
        html += '</div>';
        return html;
      }
    });

    window.customerTable = window.initServerDataTable('#server_customer_table', {
      ajaxUrl: '/coustomer/list/data',
      columns: dtColumns,
      order: [[0, 'desc']],
      searchInput: '#dtCustomerSearch',
      pageLengthSelect: '#dtCustomerPageLength',
      filterElements: {
        customer_type: '#dtCustomerType',
        status_filter: '#dtCustomerStatus',
        store_filter: '#dtCustomerStore'
      }
    });
  });

  $('#addcoustomer').on('shown.bs.modal', function () {
    if ($('#Customer_add').length) {
      $('#Customer_add').select2({
        dropdownParent: $('#addcoustomer'),
        placeholder: 'Select Store(s)',
        width: '100%',
        allowClear: true
      });
    }
  });

  // Automatically set phone number as default username and password
  $('#add_cust_number').on('input', function () {
    const phoneVal = $(this).val();
    const $username = $('#add_cust_username');
    const $password = $('#add_cust_password');
    if (!$username.data('manual-edit') || $username.val() === '') {
      $username.val(phoneVal);
    }
    if (!$password.data('manual-edit') || $password.val() === '') {
      $password.val(phoneVal);
    }
  });

  $('#add_cust_username').on('input', function () {
    $(this).data('manual-edit', true);
  });

  $('#add_cust_password').on('input', function () {
    $(this).data('manual-edit', true);
  });

  $('#addcoustomer').on('show.bs.modal', function () {
    $('#add_cust_username').removeData('manual-edit');
    $('#add_cust_password').removeData('manual-edit');
  });

  $(document).on('click', '.btn-edit-customer', function () {
    var id = $(this).attr('data-id');
    var act = "/coustomer/update/" + id;
    var approved = $(this).attr('data-approved');
    var active = $(this).attr('data-active');
            var firstName = $(this).attr('data-first-name') || '';
            var lastName = $(this).attr('data-last-name') || '';
            if (!firstName && !lastName) {
              var rawName = $(this).attr('data-name') || '';
              if (rawName.includes(',')) {
                var parts = rawName.split(',');
                lastName = parts[0].trim();
                firstName = parts.slice(1).join(',').trim();
              } else {
                var parts = rawName.trim().split(/\s+/);
                if (parts.length > 1) {
                  firstName = parts[0];
                  lastName = parts.slice(1).join(' ');
                } else {
                  firstName = rawName;
                  lastName = '';
                }
              }
            }
            $('#first_name').val(firstName);
            $('#last_name').val(lastName);
    $('#number').val($(this).attr('data-number'));
    $('#email').val($(this).attr('data-email'));
    $('#address').val($(this).attr('data-address') || $(this).attr('data-addresh') || '');
    $('#city').val($(this).attr('data-city') || '');
    $('#state').val($(this).attr('data-state') || '');
    $('#zipcode').val($(this).attr('data-zipcode') || '');
    $('#memo').val($(this).attr('data-memo') || '');
    $('#edit_dob').val($(this).attr('data-dob') || '');
    $('#edit_customer_type').val($(this).attr('data-customer-type') || 'Counter • Counter');
    $('#tax').val($(this).attr('data-tax'));
    $("#coustomer_form").attr('action', act);
    if (approved == 1) {
      $('#Approved').prop('checked', true);
    } else {
      $('#Approved').prop('checked', false);
    }
    if (active == 0) {
      $('#active').prop('checked', true);
    } else {
      $('#active').prop('checked', false);
    }
    $('#customroll').val($(this).attr('data-roll'));
  });

  $('#coustomer_form').on('submit', function (e) {
    const action = $(this).attr('action');
    if (!action || action === '' || action.endsWith('/') || action.includes('undefined')) {
      e.preventDefault();
      alert('Invalid destination: please re-open the dialog and try again.');
      return false;
    }
  });

  $(document).on('click', '.btn-delete-customer', function () {
    const custId = $(this).attr('data-id');
            const firstName = $(this).attr('data-first-name') || '';
            const lastName = $(this).attr('data-last-name') || '';
            const custName = (lastName && firstName)
              ? `${lastName}, ${firstName}`
              : ($(this).attr('data-name') || '');
    $('#deleteCustomerModalName').text(custName || '');
    $('#deleteCustomerConfirmBtn').attr('href', '/coustomer/delete/' + custId);
  });

  function populateCustomerCredentialsModal(triggerEl) {
    const $btn = $(triggerEl).closest('.btn-credentials-customer, [data-bs-target="#customerCredentialsModal"], button, a');
    const custId = $btn.attr('data-id') || '';
    const custName = $btn.attr('data-name') || '';
    const custUsername = $btn.attr('data-username') || '';

    $('#credCustomerName').text(custName || ('#' + custId));
    $('#cred_username').val(custUsername);
    $('#cred_new_password').val('').attr('type', 'password');
    $('#cred_confirm_password').val('').attr('type', 'password');
    $('.btn-toggle-cred-pw i').removeClass('fa-eye-slash').addClass('fa-eye');
    $('#credMatchFeedback').html('');
    $('#credErrorAlert').addClass('d-none').text('');
    $('#customer_credentials_form').attr('action', custId ? ('/coustomer/update-credentials/' + custId) : '/coustomer/update-credentials/');
  }

  $(document).on('click', '.btn-credentials-customer', function () {
    populateCustomerCredentialsModal(this);
  });

  $('#customerCredentialsModal').on('show.bs.modal', function (e) {
    if (e.relatedTarget) {
      populateCustomerCredentialsModal(e.relatedTarget);
    }
  });

  $(document).on('click', '.btn-toggle-cred-pw', function () {
    const targetId = $(this).attr('data-target');
    const $input = $('#' + targetId);
    const $icon = $(this).find('i');
    if (!$input.length) return;
    if ($input.attr('type') === 'password') {
      $input.attr('type', 'text');
      $icon.removeClass('fa-eye').addClass('fa-eye-slash');
    } else {
      $input.attr('type', 'password');
      $icon.removeClass('fa-eye-slash').addClass('fa-eye');
    }
  });

  function updateCredPasswordMatch() {
    const p1 = $('#cred_new_password').val() || '';
    const p2 = $('#cred_confirm_password').val() || '';
    const $fb = $('#credMatchFeedback');
    if (!p1 && !p2) {
      $fb.html('');
      return;
    }
    if (p1.length > 0 && p1.length < 6) {
      $fb.html('<span class="text-warning"><i class="fa fa-exclamation-triangle me-1"></i>Minimum 6 characters required.</span>');
      return;
    }
    if (p2.length === 0) {
      $fb.html('');
      return;
    }
    if (p1 === p2) {
      $fb.html('<span class="text-success"><i class="fa fa-check-circle me-1"></i>Passwords match.</span>');
    } else {
      $fb.html('<span class="text-danger"><i class="fa fa-times-circle me-1"></i>Passwords do not match.</span>');
    }
  }

  $('#cred_new_password, #cred_confirm_password').on('input', updateCredPasswordMatch);

  $('#customer_credentials_form').on('submit', function (e) {
    e.preventDefault();

    const $form = $(this);
    const action = $form.attr('action');
    const $err = $('#credErrorAlert');
    const $saveBtn = $('#btnSaveCredentials');

    $err.addClass('d-none').text('');

    if (!action || action === '' || action.endsWith('/') || action.includes('undefined')) {
      $err.text('Invalid destination: please close and re-open this dialog.').removeClass('d-none');
      return false;
    }

    const username = ($('#cred_username').val() || '').trim();
    const newPassword = $('#cred_new_password').val() || '';
    const confirmPassword = $('#cred_confirm_password').val() || '';

    if (!username) {
      $err.text('Username is required and cannot be blank.').removeClass('d-none');
      $('#cred_username').focus();
      return false;
    }

    if (newPassword.length > 0 || confirmPassword.length > 0) {
      if (newPassword.length < 6) {
        $err.text('New password must be at least 6 characters long.').removeClass('d-none');
        $('#cred_new_password').focus();
        return false;
      }
      if (newPassword !== confirmPassword) {
        $err.text('New password and confirm password do not match.').removeClass('d-none');
        $('#cred_confirm_password').focus();
        return false;
      }
    }

    const originalBtnHtml = $saveBtn.html();
    $saveBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-2"></i>Saving...');

    $.ajax({
      type: 'POST',
      url: action,
      data: {
        username: username,
        new_password: newPassword,
        confirm_password: confirmPassword
      },
      dataType: 'json',
      success: function (res) {
        if (res && res.success) {
          const modalEl = document.getElementById('customerCredentialsModal');
          if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            bootstrap.Modal.getOrCreateInstance(modalEl).hide();
          } else {
            $('#customerCredentialsModal').modal('hide');
          }
          if (typeof toastr !== 'undefined') {
            toastr.success(res.message || 'Customer credentials updated successfully.');
          }
          if (window.customerTable && typeof window.customerTable.ajax === 'object') {
            window.customerTable.ajax.reload(null, false);
          }
        } else {
          $err.text((res && res.message) || 'Failed to update credentials.').removeClass('d-none');
        }
      },
      error: function (xhr) {
        const msg = (xhr.responseJSON && xhr.responseJSON.message)
          ? xhr.responseJSON.message
          : 'Unable to update credentials. Please check your input and try again.';
        $err.text(msg).removeClass('d-none');
      },
      complete: function () {
        $saveBtn.prop('disabled', false).html(originalBtnHtml);
      }
    });
  });
</script>
</body>


</html>
