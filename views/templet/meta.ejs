<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="author" content="laundry">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>
    (function () {
        function getCookie(name) {
            var match = document.cookie.match(new RegExp('(^|;\\s*)' + name + '=([^;]+)'));
            return match ? decodeURIComponent(match[2]) : null;
        }
        function setCookie(name, value, days) {
            var expires = "";
            if (days) {
                var d = new Date();
                d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + d.toUTCString();
            }
            document.cookie = name + "=" + encodeURIComponent(value || "") + expires + "; path=/; SameSite=Lax";
        }
        window.getThemePreference = function () {
            try {
                var c = getCookie('version');
                if (c) return c;
                var ls = localStorage.getItem('theme_version');
                if (ls) return ls;
            } catch (e) {}
            return 'light';
        };
        window.applyAppTheme = function (theme) {
            var t = (theme === 'dark') ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme-version', t);
            if (document.body) {
                document.body.setAttribute('data-theme-version', t);
                if (t === 'dark') {
                    document.body.classList.add('dark-only');
                } else {
                    document.body.classList.remove('dark-only');
                }
            }
            if (t === 'dark') {
                document.documentElement.classList.add('dark-only');
            } else {
                document.documentElement.classList.remove('dark-only');
            }
            var lightIcons = document.querySelectorAll('.lighticon');
            var darkIcons = document.querySelectorAll('.darkicon');
            lightIcons.forEach(function (el) { el.style.display = (t === 'dark') ? 'none' : 'inline-block'; });
            darkIcons.forEach(function (el) { el.style.display = (t === 'dark') ? 'inline-block' : 'none'; });

            var modeContainers = document.querySelectorAll('.mode');
            modeContainers.forEach(function (m) {
                if (t === 'dark') {
                    m.classList.add('dark');
                    m.setAttribute('data-id', 'light');
                } else {
                    m.classList.remove('dark');
                    m.setAttribute('data-id', 'dark');
                }
            });

            if (typeof dezSettings === 'function' && typeof dezSettingsOptions !== 'undefined') {
                dezSettingsOptions.version = t;
                new dezSettings(dezSettingsOptions);
            }
        };
        window.toggleAppTheme = function (e) {
            if (e && e.preventDefault) e.preventDefault();
            var current = document.documentElement.getAttribute('data-theme-version') || window.getThemePreference();
            var next = (current === 'dark') ? 'light' : 'dark';
            window.applyAppTheme(next);
            try {
                localStorage.setItem('theme_version', next);
            } catch (err) {}
            setCookie('version', next, 365);
            return false;
        };

        var initial = window.getThemePreference();
        window.applyAppTheme(initial);

        document.addEventListener('DOMContentLoaded', function () {
            window.applyAppTheme(window.getThemePreference());
        });
    })();
</script>
