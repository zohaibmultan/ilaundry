<% if (accessdata?.masterstore?.onesignal_app_id && accessdata.masterstore.onesignal_app_id !== '*****' && accessdata.masterstore.onesignal_app_id.includes('-')) { %>
<script src="https://cdn.onesignal.com/sdks/OneSignalSDK.js" defer></script>
<script>
    window.OneSignal = window.OneSignal || [];
    OneSignal.push(function () {
        try {
            OneSignal.init({
                appId: '<%= accessdata?.masterstore?.onesignal_app_id %>',
            });
            OneSignal.on('subscriptionChange', function (isSubscribed) {
                if (isSubscribed === true) {
                    console.log('The user subscription state is now:', isSubscribed);
                    var pathArray = window.location.pathname.split('/');
                    OneSignal.sendTags({
                        "Login_ID": '<%= accessdata?.topbardata?.id %>',
                        "subscription_user_Type": '<%= accessdata?.logas %>',
                    }).then(function (tagsSent) {
                        console.log("tagsSent", tagsSent);
                    }).catch(function (err) {
                        console.warn("OneSignal tags error:", err);
                    });
                }
            });
        } catch (e) {
            console.warn("OneSignal error:", e);
        }
    });
</script>
<% } %>

<%# Live Reload for Local Development (CSS hot reload & EJS auto refresh) %>
<script>
  (function () {
    if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
      var isReconnecting = false;
      function startLiveReload() {
        if (!window.EventSource) return;
        var es = new EventSource('/dev-reload-stream');
        
        es.onmessage = function (e) {
          if (e.data === 'reload-css') {
            console.log('⚡ [LiveReload] CSS updated, reloading stylesheets in-place...');
            var links = document.querySelectorAll('link[rel="stylesheet"]');
            links.forEach(function (link) {
              var href = link.getAttribute('href');
              if (href && !href.startsWith('http://') && !href.startsWith('https://')) {
                var cleanHref = href.split('?')[0];
                link.setAttribute('href', cleanHref + '?v=' + Date.now());
              }
            });
          } else if (e.data === 'reload-page') {
            console.log('⚡ [LiveReload] Template updated, refreshing page...');
            window.location.reload();
          }
        };

        es.onerror = function () {
          es.close();
          if (!isReconnecting) {
            isReconnecting = true;
            console.log('⚡ [LiveReload] Server rebooting, waiting to reconnect...');
            var poll = setInterval(function () {
              fetch('/dev-reload-stream', { method: 'HEAD', cache: 'no-store' })
                .then(function (res) {
                  if (res.ok) {
                    clearInterval(poll);
                    console.log('⚡ [LiveReload] Server reconnected, refreshing...');
                    window.location.reload();
                  }
                })
                .catch(function () {});
            }, 700);
          }
        };
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startLiveReload);
      } else {
        startLiveReload();
      }
    }
  })();
</script>