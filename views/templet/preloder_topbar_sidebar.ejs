            <li><a href="/tool/staff">
                <%= language.Role_staff_management %>
              </a></li>
            <% } %>
          </ul>
        </li>
        <% } %>

        <li><a href="/profile" class="has-arrow ai-icon" aria-expanded="false">
            <i class="fa fa-user-circle"></i>
            <span class="nav-text">
              <%= language.Profile %>
            </span>
