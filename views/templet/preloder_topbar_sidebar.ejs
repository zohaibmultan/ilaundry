<!--********** Preloader start **********-->

<div id="preloader">
  <div class="sk-three-bounce">
    <div class="sk-child sk-bounce1"></div>
    <div class="sk-child sk-bounce2"></div>
    <div class="sk-child sk-bounce3"></div>
  </div>
</div>

<!--********** Preloader end **********-->

<!--********** Main wrapper start **********-->

<div id="main-wrapper">

  <!--********** Logo section start ***********-->

  <div class="nav-header">
    <% 
      let effectiveBrandLogo = accessdata?.masterstore?.app_logo || '';
      const isMasterAccount = (accessdata?.logas === 'master' || (accessdata?.topbardata?.is_staff == 0 && (!accessdata?.topbardata?.store_ID || accessdata?.topbardata?.store_ID == '0' || accessdata?.topbardata?.store_ID == '')));
      if (!isMasterAccount && accessdata?.topbardata?.store_logo) {
        effectiveBrandLogo = accessdata.topbardata.store_logo;
      }
    %>
    <a href="/index" class="brand-logo d-flex align-items-center justify-content-center">
      <img src="/uploads/<%= effectiveBrandLogo %>" alt="Brand Logo" style="max-height: 50px; width: auto; max-width: 100%; object-fit: contain;">
    </a>
    <div class="nav-control">
      <div class="hamburger">
        <span class="line"></span><span class="line"></span><span class="line"></span>
      </div>
    </div>
  </div>
  <!--********* Logo section end ***********-->

  <!--************ Topbar start **********-->

  <div class="header">
    <div class="header-content">
      <nav class="navbar navbar-expand">
        <div class="collapse navbar-collapse justify-content-between">
          <div class="header-left d-flex align-items-center">
            <div class="dashboard_bar text-truncate d-flex align-items-center gap-2" style="max-width: min(50vw, 320px);">
              <span class="d-inline-block rounded-circle bg-primary" style="width: 8px; height: 8px; box-shadow: 0 0 6px rgba(0, 129, 238, 0.6);"></span>
              <span><%= titel %></span>
            </div>
            <% if (accessdata?.topbardata?.is_staff != 0 && (accessdata?.topbardata?.store_name || accessdata?.topbardata?.store)) { %>
              <div class="header-store-badge ms-2">
                <span class="header-store-dot"></span>
                <i class="fas fa-store fs-11"></i>
                <span><%= accessdata?.topbardata?.store_name || accessdata?.topbardata?.store %></span>
              </div>
            <% } %>
          </div>

          <ul class="navbar-nav header-right align-items-center">
            <!-- Quick Action: POS / New Order Button -->
            <% if ((accessdata?.logas == 'custmor' && accessdata?.roll?.pos?.includes('read')) || (accessdata?.roll?.pos && accessdata.roll.pos.includes('read'))) { %>
              <li class="nav-item me-2 d-flex align-items-center">
                <a href="/admin/pos" class="header-pos-btn" title="Point of Sale / New Order">
                  <i class="fa fa-shopping-bag"></i>
                  <span class="d-none d-sm-inline">+ <%= language.POS || 'New Order / POS' %></span>
                </a>
              </li>
            <% } %>

            <!-- Theme Switcher -->
            <li class="nav-item dropdown notification_dropdown me-2">
              <a class="header-icon-btn" id="header_theme_toggle" href="javascript:void(0);"
                onclick="window.toggleAppTheme(event)" role="button" title="Toggle Dark/Light Mode"
                style="cursor: pointer;">
                <div class="mode" data-id="dark">
                  <svg class="lighticon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                      d="M18.1377 13.7902C19.2217 14.8742 16.3477 21.0542 10.6517 21.0542C6.39771 21.0542 2.94971 17.6062 2.94971 13.3532C2.94971 8.05317 8.17871 4.66317 9.67771 6.16217C10.5407 7.02517 9.56871 11.0862 11.1167 12.6352C12.6647 14.1842 17.0537 12.7062 18.1377 13.7902Z"
                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <svg class="darkicon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"></circle>
                    <path
                      d="M12 2V4M12 20V22M4 12H2M22 12H20M19.07 4.93L17.66 6.34M6.34 17.66L4.93 19.07M19.07 19.07L17.66 17.66M6.34 6.34L4.93 4.93"
                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                  </svg>
                </div>
              </a>
            </li>

            <!-- Language Switcher -->
            <li class="nav-item dropdown notification_dropdown me-2">
              <a class="header-icon-btn" href="#" role="button" data-bs-toggle="dropdown" title="Select Language">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              </a>

              <div class="dropdown-menu dropdown-menu-end lang-glass-menu shadow-lg">
                <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                  <span class="fs-12 fw-bold text-uppercase text-secondary"><%= language.Select_Language || 'Select Language' %></span>
                  <i class="fa fa-globe text-primary fs-12"></i>
                </div>
                <div class="lang-grid more_lang active">
                  <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'en') ? 'active' : '' %>" id="en" data-lang="ltr" data-value="en">
                    <i class="flag-icon flag-icon-us rounded-1"></i>
                    <span class="lang-txt flex-grow-1">English</span>
                    <% if (typeof language_name !== 'undefined' && language_name === 'en') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                  </div>
                  <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'in') ? 'active' : '' %>" id="in" data-lang="ltr" data-value="in">
                    <i class="flag-icon flag-icon-in rounded-1"></i>
                    <span class="lang-txt flex-grow-1">Hindi</span>
                    <% if (typeof language_name !== 'undefined' && language_name === 'in') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                  </div>
                  <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'pt') ? 'active' : '' %>" id="pt" data-lang="ltr" data-value="pt">
                    <i class="flag-icon flag-icon-pt rounded-1"></i>
                    <span class="lang-txt flex-grow-1">Português</span>
                    <% if (typeof language_name !== 'undefined' && language_name === 'pt') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                  </div>
                  <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'es') ? 'active' : '' %>" id="es" data-lang="ltr" data-value="es">
                    <i class="flag-icon flag-icon-es rounded-1"></i>
                    <span class="lang-txt flex-grow-1">Español</span>
                    <% if (typeof language_name !== 'undefined' && language_name === 'es') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                  </div>
                  <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'fr') ? 'active' : '' %>" id="fr" data-lang="ltr" data-value="fr">
                    <i class="flag-icon flag-icon-fr rounded-1"></i>
                    <span class="lang-txt flex-grow-1">Français</span>
                    <% if (typeof language_name !== 'undefined' && language_name === 'fr') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                  </div>
                  <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'cn') ? 'active' : '' %>" id="cn" data-lang="ltr" data-value="cn">
                    <i class="flag-icon flag-icon-cn rounded-1"></i>
                    <span class="lang-txt flex-grow-1">中文</span>
                    <% if (typeof language_name !== 'undefined' && language_name === 'cn') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                  </div>
                  <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'ae') ? 'active' : '' %>" id="ae" data-lang="rtl" data-value="ae">
                    <i class="flag-icon flag-icon-ae rounded-1"></i>
                    <span class="lang-txt flex-grow-1">العربية</span>
                    <% if (typeof language_name !== 'undefined' && language_name === 'ae') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                  </div>
                  <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'id') ? 'active' : '' %>" id="id" data-lang="ltr" data-value="id">
                    <i class="flag-icon flag-icon-id rounded-1"></i>
                    <span class="lang-txt flex-grow-1">Bahasa</span>
                    <% if (typeof language_name !== 'undefined' && language_name === 'id') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                  </div>
                  <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'ph') ? 'active' : '' %>" id="ph" data-lang="ltr" data-value="ph">
                    <i class="flag-icon flag-icon-ph rounded-1"></i>
                    <span class="lang-txt flex-grow-1">Filipino</span>
                    <% if (typeof language_name !== 'undefined' && language_name === 'ph') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                  </div>
                  <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'uk') ? 'active' : '' %>" id="uk" data-lang="ltr" data-value="uk">
                    <i class="flag-icon flag-icon-uk rounded-1"></i>
                    <span class="lang-txt flex-grow-1">Ukrainian</span>
                    <% if (typeof language_name !== 'undefined' && language_name === 'uk') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                  </div>
                </div>
              </div>
              <input type="hidden" id="hidden_lang" value="<%= typeof language_name !== 'undefined' ? language_name : 'en' %>">
            </li>

            <!-- Notifications Dropdown -->
            <li class="nav-item dropdown notification_dropdown me-2">
              <a class="header-icon-btn" href="#" role="button" data-bs-toggle="dropdown" title="<%= language.Notifications || 'Notifications' %>">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <% if(accessdata?.notification_data?.length > 0){ %>
                  <span class="header-badge-dot"></span>
                <% } %>
              </a>
              <div class="dropdown-menu dropdown-menu-end notification-glass-menu shadow-lg">
                <div class="notif-header">
                  <div class="d-flex align-items-center gap-2">
                    <h6 class="mb-0 fw-bold"><%= language.Notifications || 'Notifications' %></h6>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 fs-11">
                      <%= accessdata?.notification_data ? accessdata.notification_data.length : 0 %>
                    </span>
                  </div>
                  <a href="/admin/notification" class="fs-12 text-primary text-decoration-none fw-medium"><%= language.View_All || 'View All' %></a>
                </div>
                <div class="widget-media dz-scroll" style="max-height: 340px; overflow-y: auto; overflow-x: hidden;">
                  <% if(accessdata?.notification_data?.length > 0){ %>
                    <% accessdata.notification_data.forEach((data) => { %>
                      <a href="/admin/notification" class="notif-item">
                        <div class="bg-primary-subtle text-primary rounded-circle notif-item-icon">
                          <i class="fa fa-bell fs-12"></i>
                        </div>
                        <div class="notif-item-body">
                          <div class="notif-item-text"><%= data.notification %></div>
                          <div class="notif-item-time">
                            <i class="fa fa-clock fs-10"></i>
                            <span><%= data.date %></span>
                          </div>
                        </div>
                      </a>
                    <% }) %>
                  <% } else { %>
                    <div class="text-center py-4 text-muted">
                      <i class="fa fa-bell-slash fs-2 mb-2 d-block text-secondary opacity-50"></i>
                      <span class="fs-12"><%= language.No_Notifications_Found || 'No notifications found' %></span>
                    </div>
                  <% } %>
                </div>
                <div class="notif-footer">
                  <a href="/admin/notification" class="d-flex align-items-center justify-content-center gap-1">
                    <span><%= language.Check_All_Notification || 'Check All Notifications' %></span>
                    <i class="fas fa-chevron-right fs-10"></i>
                  </a>
                </div>
              </div>
            </li>

            <!-- User Profile Dropdown -->
            <li class="nav-item dropdown header-profile">
              <% 
                let userDisplayName = accessdata?.topbardata?.name || 'Administrator';
                let userRoleName = accessdata?.roll?.roll || '';
                let defaultAvatar = accessdata?.logas === 'custmor' ? '/images/profile-default.png' : '/images/default.png';
                let userAvatarImg = (accessdata?.topbardata?.img && accessdata.topbardata.img.trim() !== '' && accessdata.topbardata.img !== 'default.png')
                  ? ('/uploads/' + accessdata.topbardata.img)
                  : defaultAvatar;

                if (accessdata?.logas === 'custmor') {
                  userRoleName = userRoleName || 'Customer';
                } else if (accessdata?.topbardata?.is_staff != 0) {
                  userRoleName = userRoleName || 'Staff';
                } else if (accessdata?.isstore === true || accessdata?.logas === 'store') {
                  userRoleName = userRoleName || 'Store Manager';
                } else {
                  userRoleName = userRoleName || 'Master Admin';
                }
              %>
              <a class="nav-link p-0" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <img class="img-fluid rounded-circle" style="width: 40px; height: 40px; object-fit: cover; border: 2px solid rgba(0, 129, 238, 0.25);" src="<%= userAvatarImg %>"
                  onerror="this.onerror=null;this.src='<%= defaultAvatar %>';" alt="avatar">
              </a>
              <div class="dropdown-menu dropdown-menu-end profile-glass-menu shadow-lg">
                  <!-- Profile Header -->
                  <div class="profile-card-header">
                    <div class="profile-header-avatar">
                      <img src="<%= userAvatarImg %>" onerror="this.onerror=null;this.src='<%= defaultAvatar %>';"
                        alt="avatar">
                    </div>
                    <div class="profile-header-meta">
                      <h6 class="profile-user-name mb-0">
                        <%= userDisplayName %>
                      </h6>
                      <span class="profile-role-badge">
                        <%= userRoleName %>
                      </span>
                    </div>
                  </div>

                  <div class="profile-menu-divider"></div>

                  <!-- Profile Menu Links -->
                  <div class="profile-menu-items">
                    <a href="/profile" class="profile-menu-link">
                      <div class="profile-menu-icon profile-icon-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                          <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                      </div>
                      <span class="profile-menu-text">
                        <%= language.Profile || 'My Profile' %>
                      </span>
                      <i class="fas fa-chevron-right profile-chevron"></i>
                    </a>

                    <a href="/logout" class="profile-menu-link profile-menu-logout">
                      <div class="profile-menu-icon profile-icon-danger">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                          <polyline points="16 17 21 12 16 7"></polyline>
                          <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                      </div>
                      <span class="profile-menu-text">
                        <%= language.Logout || 'Logout' %>
                      </span>
                      <i class="fas fa-sign-out-alt profile-chevron"></i>
                    </a>
                  </div>
              </div>
            </li>
          </ul>
        </div>
      </nav>
    </div>
  </div>

  <!--********** Topbar end  **********-->

  <!--**********  Sidebar start **********-->

