   $(document).on('click', '#expcataction', function () {
      var baseUrl = window.location.origin;
      var storeid = $(this).attr('data-storeid');
      var cattypeid = $(this).attr('data-exp_cat_type_id');
      var id = $(this).attr('data-id');
      var catname = $(this).attr('data-catname') || '';

      if (id) {
         var cleanId = String(id).replace(/['"]/g, '').trim();
         var act = "/expense/updateexpcat/" + cleanId;
         $("#updateexpcat_form").attr('action', act);
         $('#name').val(catname).attr('value', catname);

         if (storeid && storeid !== 'undefined' && storeid !== 'null') {
            $.ajax({
               type: 'get',
               url: baseUrl + "/expense/cattypelist/" + storeid,
               dataType: 'json',
               success: function (res) {
                  $('#cttyid').html('');
                  if (res && res.data && res.data.length > 0) {
                     $.each(res.data, function (index, value) {
                        $('#cttyid').append('<option value="' + value.id + '">' + value.type_name + '</option>');
                     });
                  }
                  $('#cttyid').val(cattypeid).trigger('change');
                  if ($.fn.selectpicker) {
                     $('.default-select').selectpicker('refresh');
                  }
               }
            });
         } else if (cattypeid) {
            $('#cttyid').val(cattypeid).trigger('change');
            if ($.fn.selectpicker) {
               $('.default-select').selectpicker('refresh');
            }
         }
      }
   })


   $('body').on("change", "#expense_add_admin", function () {
      var baseUrl = window.location.origin;
      var id = this.value;
      if (!id) return;
      $.ajax({
         type: 'get',
         url: baseUrl + "/expense/expcatlist/" + id,
         dataType: 'json',
         success: function (res) {
            $('#exp_add_category').prop('disabled', false).html('<option value="" selected disabled>Select Category</option>');
            if (res.data && res.data.length > 0) {
               $.each(res.data, function (index, value) {
                  $('#exp_add_category').append('<option value="' + value.id + '">' + value.cat_name + '</option>');
               });
            } else {
               $('#exp_add_category').html('<option value="" selected disabled>No categories available for this store</option>');
            }
            $('#exp_add_category').trigger('change');

            $('#exp_add_payment').prop('disabled', false).html('<option value="" selected disabled>Select Payment</option>');
            if (res.acountlist && res.acountlist.length > 0) {
               $.each(res.acountlist, function (index, value) {
                  $('#exp_add_payment').append('<option value="' + value.id + '">' + value.ac_name + '</option>');
               });
            } else {
               $('#exp_add_payment').html('<option value="" selected disabled>No payment methods available for this store</option>');
            }
            $('#exp_add_payment').trigger('change');

            if ($.fn.selectpicker) {
               $('.default-select').selectpicker('refresh');
            }
         }
      });
   });

   $('#myexpen input[type=radio]').click(function () {
      if (this.value == "no") {
         $('#tex_perce').addClass('d-none');
         $('#tex_perce').prop('required', false);
      } else {
         $('#tex_perce').removeClass('d-none');
         $('#tex_perce').prop('required', true);
      }
   });

   $(document).on('click', '#expaction', function () {
      var baseUrl = window.location.origin;
      var storeid = $(this).attr('data-storeid');
      var cat = $(this).attr('data-category');
      var payment = $(this).attr('data-payment');
      var id = $(this).attr('data-id');
      if (!id) return;

      var cleanId = String(id).replace(/['"]/g, '').trim();
      var act = "/expense/updateexp/" + cleanId;
      $("#expupdat_form").attr('action', act);

      var tax = $(this).attr('data-tex');
      var amount = Number($(this).attr('data-amount')) || 0;
      var date = $(this).attr('data-date');
      var notes = $(this).attr('data-toward') || '';
      var taxpercent = Number($(this).attr('data-texpercent')) || 0;

      $('#amount_update').val(amount);
      $('#notes_update').val(notes).attr('value', notes);
      if (date) {
         $('#date_update').val(new Date(date).toLocaleDateString('en-CA'));
      }

      if (tax == "yes") {
         $('#yes_tax_included_update').prop('checked', true);
         $('#tex_perce_update').removeClass('d-none').prop('required', true).val(taxpercent);
      } else {
         $('#no_tax_included_update').prop('checked', true);
         $('#tex_perce_update').addClass('d-none').prop('required', false).val(0);
      }

      // Dynamically load categories and accounts for this specific store
      if (storeid && storeid !== 'undefined' && storeid !== 'null') {
         $.ajax({
            type: 'get',
            url: baseUrl + "/expense/expcatlist/" + storeid + "?include_cat_id=" + (cat || '') + "&include_account_id=" + (payment || ''),
            dataType: 'json',
            success: function (res) {
               $('#category_update').html('');
               if (res.data && res.data.length > 0) {
                  $.each(res.data, function (index, value) {
                     $('#category_update').append('<option value="' + value.id + '">' + value.cat_name + '</option>');
                  });
               }
               $('#category_update').val(cat).trigger('change');

               $('#payment_update').html('');
               if (res.acountlist && res.acountlist.length > 0) {
                  $.each(res.acountlist, function (index, value) {
                     $('#payment_update').append('<option value="' + value.id + '">' + value.ac_name + '</option>');
                  });
               }
               $('#payment_update').val(payment).trigger('change');

               if ($.fn.selectpicker) {
                  $('.default-select').selectpicker('refresh');
               }
            }
         });
      } else {
         if (cat) $('#category_update').val(cat).trigger('change');
         if (payment) $('#payment_update').val(payment).trigger('change');
      }
   });


   $('#expupdat_form input[type=radio]').click(function () {

      if (this.value == "no") {
         $('#tex_perce_update').addClass('d-none')
         $('#tex_perce_update').prop('required', false)
         $('#tex_perce_update').val(Number(0))
      } else {
         $('#tex_perce_update').removeClass('d-none')
         $('#tex_perce_update').prop('required', true)

      }
   })




