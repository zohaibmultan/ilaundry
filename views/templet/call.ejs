   // ==========================================
   // POS Ready Schedule Automated Engine
   // ==========================================
   window.isPosDeliveryScheduleManual = false;

   function calculateClientReadySchedule(intakeStr, schedule) {
      const sched = schedule || window.POS_READY_SCHEDULE || {
         leadDays: 2,
         cutoffTime: "13:00",
         readyTime: "16:00",
         workingDays: [1, 2, 3, 4, 5, 6]
      };

      let intakeDate = new Date();
      if (intakeStr) {
         const parts = intakeStr.split('-');
         if (parts.length === 3) {
            const now = new Date();
            intakeDate = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10), now.getHours(), now.getMinutes(), now.getSeconds());
         }
      }

      const cutoffParts = (sched.cutoffTime || "13:00").split(':');
      const cHour = parseInt(cutoffParts[0], 10) || 13;
      const cMin = parseInt(cutoffParts[1], 10) || 0;
      const intakeMinutes = intakeDate.getHours() * 60 + intakeDate.getMinutes();
      const cutoffMinutes = cHour * 60 + cMin;
      const isAfterCutoff = intakeMinutes >= cutoffMinutes;

      let requiredDays = isAfterCutoff ? (parseInt(sched.leadDays) + 1) : parseInt(sched.leadDays);
      if (isNaN(requiredDays) || requiredDays < 0) requiredDays = 2;

      let workingDays = [1, 2, 3, 4, 5, 6];
      if (Array.isArray(sched.workingDays) && sched.workingDays.length > 0) {
         workingDays = sched.workingDays.map(Number);
      } else if (typeof sched.workingDaysRaw === 'string') {
         workingDays = sched.workingDaysRaw.split(',').map(s => parseInt(s.trim(), 10)).filter(n => !isNaN(n));
      }

      let cur = new Date(intakeDate.getFullYear(), intakeDate.getMonth(), intakeDate.getDate(), 12, 0, 0);
      while (!workingDays.includes(cur.getDay())) {
         cur.setDate(cur.getDate() + 1);
      }
      while (requiredDays > 0) {
         cur.setDate(cur.getDate() + 1);
         if (workingDays.includes(cur.getDay())) {
            requiredDays--;
         }
      }

      const yyyy = cur.getFullYear();
      const mm = String(cur.getMonth() + 1).padStart(2, '0');
      const dd = String(cur.getDate()).padStart(2, '0');
      const readyDate = `${yyyy}-${mm}-${dd}`;
      const readyTime = (sched.readyTime && sched.readyTime.length >= 4) ? sched.readyTime : "16:00";

      return { readyDate, readyTime, isAfterCutoff };
   }

   function updatePosReadyScheduleUI(targetDateInput, targetTimeInput, autoBtn, orderDateVal, isManualReset) {
      if (window.isPosDeliveryScheduleManual && !isManualReset) {
         return;
      }

      let storeId = $('#pos_store_id').val() || '';
      let baseUrl = window.location.origin;

      // 1. Instantaneous local calculation for 0ms visual feedback
      let localCalc = calculateClientReadySchedule(orderDateVal, window.POS_READY_SCHEDULE);
      $(targetDateInput).val(localCalc.readyDate);
      $(targetTimeInput).val(localCalc.readyTime);
      $('input[name=deliverydate]').val(localCalc.readyDate);
      $('input[name=deliverytime]').val(localCalc.readyTime);
      $('#deliverydate_hidden').val(localCalc.readyDate);

      // 2. Fetch authoritative calculation from backend
      $.ajax({
         type: 'GET',
         url: baseUrl + "/admin/calculate_ready_schedule",
         data: { store_id: storeId, order_date: orderDateVal },
         dataType: 'json',
         success: function (res) {
            if (res && res.success && res.result) {
               if (res.schedule) window.POS_READY_SCHEDULE = res.schedule;
               $(targetDateInput).val(res.result.readyDate);
               $(targetTimeInput).val(res.result.readyTime);
               $('input[name=deliverydate]').val(res.result.readyDate);
               $('input[name=deliverytime]').val(res.result.readyTime);
               $('#deliverydate_hidden').val(res.result.readyDate);
            }
         }
      });
   }

