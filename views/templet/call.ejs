   function renderOrderRowHtml(data, accessdata, language, isStaff, login) {
      accessdata = accessdata || {};
      language = language || {};

      const formatDate = (rawDate) => {
         if (!rawDate) return '';
         const date = new Date(rawDate);
         if (isNaN(date.getTime())) return '';
         const dd = String(date.getDate()).padStart(2, '0');
         const mm = String(date.getMonth() + 1).padStart(2, '0');
         const yyyy = date.getFullYear();
         return `${yyyy}-${mm}-${dd}`;
      };

      const orderDateStr = formatDate(data.order_date);
      const deliveryDateStr = formatDate(data.delivery_date);

      const statusMap = {
         1: 'dark',
         2: 'warning',
         3: 'secondary',
         4: 'info',
         5: 'danger',
         6: 'danger'
      };
      const statusClass = statusMap[data.order_status] || 'dark';
      const statusBtn = `<button type="button" class="btn btn-${statusClass} btn-xxs text-nowrap" disabled>${data.orderStatus || ''}</button>`;

      let paymentBtn = '';
      if (Number(data.balance_amount) > 0) {
         if (accessdata.logas === 'custmor') {
            paymentBtn = `<button type="button" class="btn light btn-info btn-xxs mb-2" disabled>${language.Pending || 'Pending'}</button>`;
         } else {
            const canEdit = (!accessdata.roll?.orders || accessdata.roll.orders.includes('edit')) ? '' : 'disabled';
            paymentBtn = `<button onclick="open_patment_model('${data.id}')" type="button" class="btn light btn-success btn-xxs mb-2" ${canEdit}>${language.Add_Payment || 'Add Payment'}</button>`;
         }
      } else {
         paymentBtn = `<button type="button" class="btn light btn-dark btn-xxs mb-2" disabled>${language.Fully_Paid || 'Fully Paid'}</button>`;
      }

      const editBtn = (data.order_status != 6)
         ? `<a href="/admin/edit/${data.id}" class="btn-tbl-action btn-tbl-edit" title="${language.Edit || 'Edit'}"><i class="fas fa-pencil-alt"></i></a>`
         : '';

      const canDeleteOrder = (accessdata.logas !== 'custmor') && (accessdata.topbardata?.is_staff == 0 || (accessdata.roll?.orders && accessdata.roll.orders.includes('delete')));
      const deleteBtn = canDeleteOrder
         ? `<button type="button" class="btn-tbl-action btn-tbl-delete" data-bs-toggle="modal" data-bs-target="#deleteOrderModal" data-id="${data.id}" data-orderid="${data.order_id}" title="${language.Delete || 'Delete'}"><i class="fa fa-trash"></i></button>`
         : '';

      const hideStore = (isStaff || login !== 'master');
      const storeCol = hideStore
         ? `<td class="d-none"></td>`
         : `<td><p class="text-sm mb-0 text-uppercase">${data.storeName || ''}</p></td>`;

      return `
        <tr class="load_data">
          <td>
            <p class="text-sm mb-0 text-nowrap"><span class="me-1">${language.Order_ID || 'Order ID'} :</span><span>${data.order_id || ''}</span></p>
            <p class="text-sm mb-0 text-nowrap"><span class="me-1">${language.Order_Date || 'Order Date'} :</span><span>${orderDateStr}</span></p>
            <p class="text-sm mb-0 text-nowrap"><span class="me-1">${language.Delivery_Date || 'Delivery Date'} :</span><span>${deliveryDateStr}</span></p>
          </td>
          <td>
            <p class="text-sm px-2 mb-0 text-nowrap">${data.name || ''}</p>
            <p class="text-sm px-2 mb-0">${data.number || ''}</p>
          </td>
          <td>
            <p class="text-sm px-2 mb-0 text-nowrap symbol">${data.gross_total || '0'}</p>
          </td>
          <td>${statusBtn}</td>
          <td>
            <p class="text-sm mb-0 text-nowrap"><span class="me-2">${language.Total_Amount || 'Total Amount'} :</span><span class="symbol">${data.gross_total || '0'}</span></p>
            <p class="text-sm mb-1 text-nowrap"><span class="me-2">${language.Paid_Amount || 'Paid Amount'} :</span><span class="symbol">${data.paid_amount || '0'}</span></p>
            ${paymentBtn}
          </td>
          ${storeCol}
          <td class="text-center">
            <div class="tbl-action-group">
              ${editBtn}
              <a href="/order/view/${data.id}" class="btn-tbl-action btn-tbl-view" title="${language.View || 'View'}">
                <i class="fa fa-eye"></i>
              </a>
              <button type="button" class="btn-tbl-action btn-tbl-print" id="print_barcode" data-bs-toggle="modal" data-bs-target="#exampleModalLong" data-id="${data.id}" title="${language.Print || 'Print'}">
                <i class="fa fa-print"></i>
              </button>
              ${deleteBtn}
            </div>
          </td>
        </tr>
      `;
   }

   function fetchFilteredOrders(resetOffset) {
      if (resetOffset) {
         orderListOffset = 0;
      }
      const status = $("#orders_list_status").val() || "";
      const search = ($("#order_list_serach").val() || "").trim();

      $.ajax({
         type: 'GET',
         url: `/order/liststattus/${encodeURIComponent(status)}`,
         data: { search: search },
         success: function (res) {
            const list = res.orderlist || res.orderlists || [];
            const accessdata = res.accessdata || {};
            const language = res.language || {};
            const login = res.login;
            const isStaff = res.isStaff;

            let html = "";
            if (!list || list.length === 0) {
               html = `
                  <tr>
                     <td colspan="7" class="text-center text-danger py-4">
                        ${language.No_Order_List_Found || 'No Order List Found'}
                     </td>
                  </tr>
               `;
               $('#loadMoreorder').addClass("d-none");
            } else {
               list.forEach(function (order) {
                  html += renderOrderRowHtml(order, accessdata, language, isStaff, login);
               });

               if (list.length < 10) {
                  $('#loadMoreorder').addClass("d-none");
               } else {
                  $('#loadMoreorder').removeClass("d-none");
               }
            }

            $("#order_list_tbl").html(html);
            orderListOffset = list.length;

            setTimeout(() => {
               if (typeof forcurrency === 'function') forcurrency();
               if (typeof pagetablecurrency === 'function') pagetablecurrency();
            }, 0);
         },
         error: function (err) {
            console.error("Error fetching filtered orders:", err);
         }
      });
   }

   $(document).ready(function () {
      if ($("#order_list_tbl").length > 0) {
         orderListOffset = $("#order_list_tbl .load_data").length;
         if (orderListOffset < 10) {
            $("#loadMoreorder").addClass("d-none");
         } else {
            $("#loadMoreorder").removeClass("d-none");
         }
      }

      // Search input with debounce & instant Enter key
      $(document).on("input keyup", "#order_list_serach", function (e) {
         if (e.which === 13) {
            e.preventDefault();
            clearTimeout(orderSearchTimer);
            fetchFilteredOrders(true);
            return;
         }
         clearTimeout(orderSearchTimer);
         orderSearchTimer = setTimeout(function () {
            fetchFilteredOrders(true);
         }, 350);
      });

      // Status dropdown change
      $(document).on("change", "#orders_list_status", function () {
         clearTimeout(orderSearchTimer);
         fetchFilteredOrders(true);
      });

      // Load more button
      $(document).on("click", "#loadMoreorder", function (e) {
         e.preventDefault();
         const $btn = $(this);
         const originalText = $btn.html();
         $btn.addClass("disabled").html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Loading...');

         const status = $("#orders_list_status").val() || "";
         const search = ($("#order_list_serach").val() || "").trim();

         $.ajax({
            type: 'POST',
            url: '/order/getmore',
            data: {
               from: orderListOffset,
               orderstatus: status,
               search: search
            },
            success: function (res) {
               $btn.removeClass("disabled").html(originalText);
               const list = res.orderlists || res.orderlist || [];
               const accessdata = res.accessdata || {};
               const language = res.language || {};
               const login = res.login;
               const isStaff = res.isStaff;

               if (list && list.length > 0) {
                  let html = "";
                  list.forEach(function (order) {
                     html += renderOrderRowHtml(order, accessdata, language, isStaff, login);
                  });
                  $("#order_list_tbl").append(html);
                  orderListOffset += list.length;

                  if (list.length < 10) {
                     $("#loadMoreorder").addClass("d-none");
                  }
               } else {
                  $("#loadMoreorder").addClass("d-none");
               }

               setTimeout(() => {
                  if (typeof forcurrency === 'function') forcurrency();
                  if (typeof pagetablecurrency === 'function') pagetablecurrency();
               }, 0);
            },
            error: function (err) {
               $btn.removeClass("disabled").html(originalText);
               console.error("Error loading more orders:", err);
            }
         });
      });
   });


