    $(document).on('input', '#POS_extra_discount_order', function () {
       var discType = $('input[name=discount_type]:checked').val() || 'fixed';
       var rawVal = parseFloat($(this).val()) || 0;
       var sub_total = Number($('#POS_subtotal_order').val()) || Number($('input[name=sub]').val()) || 0;
       var gross = Number($('#POS_gross_order').val()) || 0;
       var paid = Number($('input[name=paid_amount]').val()) || 0;

       if (rawVal < 0) {
          rawVal = 0;
          $(this).val(0);
       }

       var disc = 0;
       if (discType === 'percent') {
          if (rawVal > 100) {
             rawVal = 100;
             $(this).val(100);
          }
          disc = (sub_total * rawVal) / 100;
          disc = Math.round(disc * 100) / 100;
          if (rawVal > 0) {
             $('#payment_extradiscount_percent_info').text('(' + rawVal + '%)');
          } else {
             $('#payment_extradiscount_percent_info').text('');
          }
       } else {
          disc = rawVal;
          $('#payment_extradiscount_percent_info').text('');
       }

       $('input[name=extradiscount]').val(disc);
       $('#payment_extradiscount').html(disc.toFixed(2));

       var newGross = Math.max(0, gross - disc);
