   $(document).on("click", ".pos-service-item, .services, #POS_service, [data-bs-target='#service_type_model']", function (e) {
      let $item = $(this).closest('.pos-service-item, .services, [data-id]');
      let id = $item.attr('data-id') || $(this).attr('data-id');
      if (!id) return;

      var isEdit = $('#edit_service_pos_cart_submit').length > 0 || $('#pos_order_id[name="order_id"]').length > 0;
      var storeEl = $('#pos_store_id');
      if (!isEdit && storeEl.length > 0) {
         var storeVal = storeEl.val() || $('#pos_staff_store_id').val();
         if (!storeVal || storeVal === '0') {
            toastr.warning('Please Select Store First');
            e.preventDefault();
            e.stopPropagation();
            return false;
         }
      }

      var baseUrl = window.location.origin;
      $('#pos_servicetypeselect').html(
         '<div class="text-center py-4">' +
         '<div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>' +
         '<span class="text-muted">Loading service types...</span>' +
         '</div>'
      );

      $.ajax({
         type: 'get',
         url: baseUrl + "/admin/getservicetype/" + id,
         dataType: 'json',
         success: function (res) {
            $('#pos_servicetypeselect').html('');
            $('#POS_serviceid1').attr('value', res.serviceid).val(res.serviceid);

            if (!res.data || res.data.length === 0) {
               $('#pos_servicetypeselect').html(
                  '<div class="text-center py-4 text-muted">' +
                  '<i class="fa fa-info-circle text-secondary mb-2" style="font-size:24px; display:block;"></i>' +
                  'No service types configured for this service.' +
                  '</div>'
               );
               return;
            }

            var symbol = (res.accessdata && res.accessdata.symbol) ? res.accessdata.symbol : '$';
            var plac = (res.accessdata && typeof res.accessdata.plac !== 'undefined') ? res.accessdata.plac : 0;

            $.each(res.data, function (index, value) {
               var isFirst = (index === 0) ? 'checked' : '';
               var formattedPrice = (plac == 0)
                  ? (symbol + ' ' + value.price)
                  : (value.price + ' ' + symbol);

               var itemsCount = parseInt(value.items) || 1;
               var itemsText = itemsCount + (itemsCount === 1 ? ' item' : ' items');

               var mins = parseInt(value.ready_time) || 0;
               var readyTimeText = '';
               if (mins >= 1440) {
                  var days = Math.round((mins / 1440) * 10) / 10;
                  readyTimeText = days + (days === 1 ? ' day' : ' days');
               } else if (mins >= 60) {
                  var hours = Math.round((mins / 60) * 10) / 10;
                  readyTimeText = hours + (hours === 1 ? ' hr' : ' hrs');
               } else {
                  readyTimeText = mins + ' min';
               }

               var itemHtml =
                  '<div class="pos-service-type-row mb-2 p-2 border rounded d-flex align-items-center justify-content-between" style="cursor: pointer; background: #fafafa; transition: background 0.15s ease;">' +
                  '<div class="form-check mb-0 d-flex align-items-center flex-grow-1" style="cursor: pointer;">' +
                  '<input class="form-check-input me-3" type="radio" name="servicetype" id="st_radio_' + value.id + '" value="' + value.id + ',' + value.price + ',' + value.servicetype + '" ' + isFirst + ' required style="cursor: pointer; min-width: 18px; min-height: 18px;">' +
                  '<label class="form-check-label flex-grow-1 d-flex justify-content-between align-items-center mb-0 cursor-pointer flex-wrap gap-2" for="st_radio_' + value.id + '" style="cursor: pointer; font-size: 14px; font-weight: 500;">' +
                  '<div class="d-flex align-items-center flex-wrap gap-2">' +
                  '<span class="text-dark fw-bold">' + value.servicetype + '</span>' +
                  '<span class="badge bg-light text-secondary border"><i class="fas fa-layer-group me-1"></i>' + itemsText + '</span>' +
                  '<span class="badge bg-light text-secondary border"><i class="fas fa-clock me-1"></i>' + readyTimeText + '</span>' +
                  '</div>' +
                  '<span class="badge bg-primary text-white font-weight-bold px-2 py-1" style="font-size: 13px;">' + formattedPrice + '</span>' +
                  '</label>' +
                  '</div>' +
                  '</div>';

               $('#pos_servicetypeselect').append(itemHtml);
            });
         },
         error: function (xhr, status, err) {
            console.error('Error fetching service types:', err);
            $('#pos_servicetypeselect').html(
               '<div class="text-center py-4 text-danger">' +
               '<i class="fa fa-exclamation-triangle mb-2" style="font-size:24px; display:block;"></i>' +
               'Failed to load service types. Please try again.' +
               '</div>'
            );
         }
      });
   });

