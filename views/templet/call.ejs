    $(document).on('input', '#edit_POS_extra_discount_order', function () {
       var discType = $('input[name=edit_discount_type]:checked').val() || 'fixed';
       var rawVal = parseFloat($(this).val()) || 0;
       var hidden_disc = Number($('#edit_POS_extra_discount_order_hidden').val()) || 0;
       var sub_total = Number($('#POS_subtotal_order').val()) || Number($('input[name=sub]').val()) || 0;
       var gross = Number($('#POS_gross_order').val()) || 0;
       var paid = Number($('input[name=paid_amount]').val()) || 0;

       if (rawVal < 0) {
          rawVal = 0;
          $(this).val(0);
       }

       var disc = 0;
       if (discType === 'percent') {
          if (rawVal > 100) {
             rawVal = 100;
             $(this).val(100);
          }
          disc = (sub_total * rawVal) / 100;
          disc = Math.round(disc * 100) / 100;
          if (rawVal > 0) {
             $('#edit_payment_extradiscount_percent_info').text('(' + rawVal + '%)');
          } else {
             $('#edit_payment_extradiscount_percent_info').text('');
          }
       } else {
