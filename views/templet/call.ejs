   $(document).on("click", ".pos-stepper-btn", function (e) {
      e.preventDefault();
      var $btn = $(this);
      var $stepper = $btn.closest(".pos-stepper");
      if ($stepper.hasClass("is-readonly") || $btn.is(":disabled")) {
         return;
      }
      var $input = $stepper.find("input[type=number]");
      if (!$input.length || $input.prop("readonly") || $input.prop("disabled")) {
         return;
      }

      var el = $input[0];
      var isPlus = $btn.hasClass("pos-stepper-btn-plus");
      var min = el.hasAttribute("min") ? parseFloat(el.getAttribute("min")) : -Infinity;
      var max = el.hasAttribute("max") ? parseFloat(el.getAttribute("max")) : Infinity;
      var currentVal = parseFloat(el.value);
      if (isNaN(currentVal)) {
         currentVal = (min !== -Infinity && !isNaN(min)) ? min : 0;
      }

      var stepAttr = el.getAttribute("step");
      var step = (stepAttr && stepAttr !== "any" && !isNaN(parseFloat(stepAttr))) ? parseFloat(stepAttr) : 1;
      var newVal;
      if (isPlus) {
         newVal = Math.round((currentVal + step) * 1000) / 1000;
         if (max !== Infinity && newVal > max) newVal = max;
      } else {
         newVal = Math.round((currentVal - step) * 1000) / 1000;
         if (min !== -Infinity && newVal < min) newVal = min;
      }

      if (newVal === currentVal) {
         return;
      }

      if (step < 1) {
         el.value = newVal.toFixed(2);
      } else if (Number.isInteger(newVal)) {
         el.value = newVal;
      } else {
         el.value = parseFloat(newVal.toFixed(2));
      }

      $input.trigger("change");
   });

