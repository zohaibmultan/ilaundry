          $('#edit_payment_extradiscount_percent_info').text('');
       }

       $('input[name=extradiscount]').val(disc);
       $('#payment_extradiscount').html(disc.toFixed(2));

       var newGross = Math.max(0, gross - disc + hidden_disc);
       $('#payment_grosstotal').html(newGross.toFixed(2));
