<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>POS Receipt - <%= (order && order.order_id) ? order.order_id : '' %></title>
  <script src="/JsBarcode.all.min.js"></script>
  <style>
    @page {
      size: 80mm auto;
      margin: 0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #eef1f5;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 11px;
      line-height: 1.25;
      color: #000;
      padding: 0 0 20px 0;
    }

    /* Sticky Action Toolbar (Excluded from print) */
    .pos-action-toolbar {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid #cbd5e1;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.07);
      padding: 10px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
    }

    .toolbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .toolbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .server-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid #e2e8f0;
      background: #f8fafc;
      color: #334155;
    }

    .status-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }

    .status-dot.online {
      background-color: #10b981;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
    }

    .status-dot.offline {
      background-color: #ef4444;
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.25);
    }

    .status-dot.checking {
      background-color: #f59e0b;
      animation: pulseDot 1.2s infinite ease-in-out;
    }

    @keyframes pulseDot {
      0% {
        transform: scale(0.9);
        opacity: 0.6;
      }

      50% {
        transform: scale(1.15);
        opacity: 1;
      }

      100% {
        transform: scale(0.9);
        opacity: 0.6;
      }
    }

    .printer-device-info {
      font-size: 11.5px;
      color: #64748b;
    }

    .printer-device-info b {
      color: #1e293b;
    }

    .toolbar-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 12.5px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.15s ease-in-out;
      text-decoration: none;
      line-height: 1.2;
    }

    .toolbar-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .btn-primary-print {
      background: #0284c7;
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(2, 132, 199, 0.35);
    }

    .btn-primary-print:hover:not(:disabled) {
      background: #0369a1;
      transform: translateY(-1px);
    }

    .btn-invoice {
      background: #10b981;
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(16, 185, 129, 0.35);
    }

    .btn-invoice:hover:not(:disabled) {
      background: #059669;
      transform: translateY(-1px);
    }

    .btn-tag {
      background: #6366f1;
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(99, 102, 241, 0.35);
    }

    .btn-tag:hover:not(:disabled) {
      background: #4f46e5;
      transform: translateY(-1px);
    }

    .btn-cancel {
      background: #ffffff;
      color: #475569;
      border: 1px solid #cbd5e1;
    }

    .btn-cancel:hover:not(:disabled) {
      background: #f1f5f9;
      color: #1e293b;
      border-color: #94a3b8;
    }

    /* Print Mode Selector Segmented Pills */
    .print-mode-selector {
      display: inline-flex;
      align-items: center;
      background: #e2e8f0;
      padding: 3px;
      border-radius: 20px;
      gap: 3px;
    }

    .mode-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 16px;
      font-size: 13px;
      font-weight: 600;
      border: none;
      background: transparent;
      color: #475569;
      cursor: pointer;
      transition: all 0.2s ease-in-out;
      line-height: 1.2;
    }

    .mode-pill:hover {
      color: #0f172a;
    }

    .mode-pill.active {
      background: #ffffff;
      color: #0284c7;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .print-alert-banner {
      width: 76mm;
      max-width: 90%;
      margin: 0 auto 12px;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 11.5px;
      font-weight: 600;
      text-align: center;
      display: none;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
      animation: fadeInAlert 0.2s ease-out;
    }

    @keyframes fadeInAlert {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .alert-success-soft {
      background-color: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }

    .alert-info-soft {
      background-color: #f0f9ff;
      color: #0369a1;
      border: 1px solid #bae6fd;
    }

    .alert-warning-soft {
      background-color: #fffbeb;
      color: #92400e;
      border: 1px solid #fde68a;
    }

    .alert-danger-soft,
    .alert-error-soft {
      background-color: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }

    /* Receipt Canvas (Standard POS 80mm Roll with 72mm Printable Area) */
    .receipt-container {
      width: 72mm;
      max-width: 72mm;
      margin: 0 auto;
      background: #fff;
      padding: 3mm 2.5mm;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      border-radius: 4px;
      word-wrap: break-word;
      overflow-wrap: break-word;
      overflow: hidden;
    }

    /* Cutter Guide Dividers (Screen Preview Only) */
    .preview-cut-guide {
      width: 72mm;
      margin: 14px auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: #dc2626;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .preview-cut-guide::before,
    .preview-cut-guide::after {
      content: "";
      flex: 1;
      border-top: 2px dashed #ef4444;
    }

    .preview-tag-cut-guide {
      width: 72mm;
      margin: 10px auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #b91c1c;
      font-size: 10px;
      font-weight: 600;
    }

    .preview-tag-cut-guide::before,
    .preview-tag-cut-guide::after {
      content: "";
      flex: 1;
      border-top: 1.5px dashed #f87171;
    }

    /* Cloth Garment Tag Container & Card Styles */
    .cloth-tag-container {
      width: 72mm;
      max-width: 72mm;
      margin: 0 auto;
      overflow: hidden;
    }

    .cloth-tag {
      background: #ffffff;
      border: 1px dashed #000;
      padding: 3mm 2mm;
      margin-bottom: 3mm;
      text-align: center;
      page-break-inside: avoid;
      break-inside: avoid;
      color: #000;
      border-radius: 4px;
      word-wrap: break-word;
      overflow-wrap: break-word;
      box-sizing: border-box;
    }

    .cloth-tag .tag-store-name {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      line-height: 1.2;
      margin-bottom: 2px;
    }

    .cloth-tag .tag-order-row {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      font-weight: 700;
      border-top: 1px solid #000;
      border-bottom: 1px solid #000;
      padding: 2px 0;
      margin-bottom: 3px;
    }

    .cloth-tag .tag-item-name {
      font-size: 10.5px;
      font-weight: 800;
      text-transform: uppercase;
      margin-bottom: 2px;
      line-height: 1.2;
      word-break: break-word;
    }

    .cloth-tag .tag-cust-row {
      font-size: 9.5px;
      color: #222;
      margin-bottom: 2px;
      word-break: break-word;
    }

    .cloth-tag .tag-date-row {
      font-size: 9.5px;
      font-weight: 700;
      margin-bottom: 3px;
    }

    .cloth-tag .tag-barcode-wrap {
      margin: 2px auto 0;
      text-align: center;
    }

    .cloth-tag .tag-barcode-svg {
      max-width: 90% !important;
      height: 36px !important;
      margin: 0 auto;
      display: block;
    }

    /* Screen Preview Display Control */
    body.view-mode-all .receipt-container {
      display: block;
    }
    body.view-mode-all .preview-cut-guide {
      display: flex;
    }
    body.view-mode-all .cloth-tag-container {
      display: block;
    }

    body.view-mode-invoice .receipt-container {
      display: block;
    }
    body.view-mode-invoice .preview-cut-guide {
      display: none !important;
    }
    body.view-mode-invoice .cloth-tag-container {
      display: none !important;
    }

    body.view-mode-tags .receipt-container {
      display: none !important;
    }
    body.view-mode-tags .preview-cut-guide {
      display: none !important;
    }
    body.view-mode-tags .cloth-tag-container {
      display: block;
    }

    @media print {
      body {
        background: transparent !important;
        padding: 0 !important;
      }

      .no-print {
        display: none !important;
      }

      /* Mode ALL: Print Invoice, Cut, then print each Tag and Cut */
      body.view-mode-all .receipt-container {
        width: 100% !important;
        max-width: 72mm !important;
        margin: 0 auto !important;
        padding: 2mm 2.5mm !important;
        box-shadow: none !important;
        display: block !important;
        page-break-after: always !important;
        break-after: page !important;
        box-sizing: border-box !important;
      }

      body.view-mode-all .cloth-tag-container {
        display: block !important;
        width: 100% !important;
        max-width: 72mm !important;
        margin: 0 auto !important;
        padding: 0 !important;
        box-shadow: none !important;
        box-sizing: border-box !important;
      }

      body.view-mode-all .cloth-tag {
        display: block !important;
        width: 100% !important;
        max-width: 72mm !important;
        margin: 0 auto 2mm auto !important;
        padding: 2.5mm 2mm !important;
        box-shadow: none !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        page-break-after: always !important;
        break-after: page !important;
        box-sizing: border-box !important;
      }

      /* Mode INVOICE: Print only invoice */
      body.view-mode-invoice .receipt-container {
        width: 100% !important;
        max-width: 72mm !important;
        margin: 0 auto !important;
        padding: 2mm 2.5mm !important;
        box-shadow: none !important;
        display: block !important;
        box-sizing: border-box !important;
      }

      body.view-mode-invoice .cloth-tag-container {
        display: none !important;
      }

      /* Mode TAGS: Print only cloth tags */
      body.view-mode-tags .receipt-container {
        display: none !important;
      }

      body.view-mode-tags .cloth-tag-container {
        display: block !important;
        width: 100% !important;
        max-width: 72mm !important;
        margin: 0 auto !important;
        padding: 0 !important;
        box-shadow: none !important;
        box-sizing: border-box !important;
      }

      body.view-mode-tags .cloth-tag {
        display: block !important;
        width: 100% !important;
        max-width: 72mm !important;
        margin: 0 auto 2mm auto !important;
        padding: 2.5mm 2mm !important;
        box-shadow: none !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        page-break-after: always !important;
        break-after: page !important;
        box-sizing: border-box !important;
      }
    }

    .text-center {
      text-align: center;
    }

    .text-start {
      text-align: left;
    }

    .text-end {
      text-align: right;
    }

    .fw-bold {
      font-weight: 700;
    }

    .text-muted {
      color: #555;
    }

    /* Dividers */
    .border-dashed {
      border: none;
      border-top: 1px dashed #000;
      margin: 3px 0;
    }

    .border-solid {
      border: none;
      border-top: 1px solid #000;
      margin: 3px 0;
    }

    /* Store Header */
    .store-header {
      text-align: center;
      margin-bottom: 4px;
      word-wrap: break-word;
    }

    .store-logo {
      max-height: 32px;
      max-width: 70%;
      margin: 0 auto 4px;
      display: block;
      object-fit: contain;
    }

    .store-name {
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      line-height: 1.15;
      word-wrap: break-word;
    }

    .store-info {
      font-size: 10px;
      font-weight: 500;
      line-height: 1.25;
      color: #222;
      margin-top: 2px;
      word-wrap: break-word;
    }

    /* Invoice Title Banner (Crisp Outline, Zero Solid Black) */
    .invoice-badge {
      text-align: center;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      padding: 2px 0;
      border-top: 1px solid #000;
      border-bottom: 1px solid #000;
      margin: 3px 0;
    }

    /* Metadata Grid */
    .meta-table {
      width: 100%;
      font-size: 10.5px;
      font-weight: 500;
      margin-bottom: 2px;
      table-layout: fixed;
    }

    .meta-table td {
      padding: 1px 0;
      vertical-align: top;
      word-wrap: break-word;
    }

    /* Items Table */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 10.5px;
      font-weight: 500;
      margin-top: 2px;
      table-layout: fixed;
    }

    .items-table th {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 2px 1px;
      border-bottom: 1px dashed #000;
      letter-spacing: 0.2px;
    }

    .items-table td {
      padding: 2px 1px;
      vertical-align: top;
      word-wrap: break-word;
    }

    .item-name {
      font-weight: 700;
      font-size: 10.5px;
      line-height: 1.15;
      word-break: break-word;
    }

    .item-subtext {
      font-size: 9.5px;
      font-weight: 500;
      color: #333;
      display: block;
    }

    /* Financial Summary */
    .summary-table {
      width: 100%;
      font-size: 10.5px;
      font-weight: 600;
      margin-top: 2px;
      table-layout: fixed;
    }

    .summary-table td {
      padding: 1px 0;
      word-wrap: break-word;
    }

    .grand-total-row td {
      font-size: 12px;
      font-weight: 800;
      padding: 2px 0;
    }

    /* Footer */
    .receipt-footer {
      text-align: center;
      font-size: 10px;
      font-weight: 500;
      margin-top: 4px;
      line-height: 1.2;
      word-wrap: break-word;
    }

    /* Invoice Receipt Barcode */
    .receipt-barcode-wrap {
      margin: 6px auto 4px auto;
      text-align: center;
      padding: 0 4px;
    }

    .receipt-barcode-svg {
      max-width: 90% !important;
      height: 36px !important;
      margin: 0 auto;
      display: block;
    }
  </style>
</head>

<body>

  <!-- Sticky Action Toolbar (Hidden during actual print) -->
  <div class="pos-action-toolbar no-print">
    <div class="toolbar-left">
      <div class="server-status-pill" id="serverStatusPill">
        <span class="status-dot checking" id="serverStatusDot"></span>
        <span id="serverStatusText">Checking Printing Server...</span>
      </div>
      <span class="printer-device-info">
        Invoice: <b>
          <%= (master && master.invoice_printer_name) ? master.invoice_printer_name : 'Default Printer' %>
        </b>
        &bull; Tag: <b>
          <%= (master && master.tag_printer_name) ? master.tag_printer_name : 'Default Printer' %>
        </b>
      </span>
    </div>

    <!-- Segmented Print Mode Selector -->
    <div class="print-mode-selector no-print" role="tablist">
      <button type="button" class="mode-pill active" id="mode_btn_all" onclick="switchPrintMode('all')"
        title="Print Invoice and Cloth Tags together on the same printer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
        All (Invoice + Tags)
      </button>

      <button type="button" class="mode-pill" id="mode_btn_invoice" onclick="switchPrintMode('invoice')"
        title="Print Customer Invoice Receipt only">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        Invoice Only
      </button>

      <button type="button" class="mode-pill" id="mode_btn_tags" onclick="switchPrintMode('tags')"
        title="Print Garment Cloth Tags only">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
        Cloth Tags Only
      </button>
    </div>

    <div class="toolbar-right">
      <button type="button" class="toolbar-btn btn-primary-print" id="btn_primary_print" onclick="executeCurrentPrint()"
        title="Print with selected option">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        <span id="btn_print_text">Print All (Invoice + Tags)</span>
      </button>

      <button type="button" class="toolbar-btn btn-cancel" id="btn_cancel" onclick="cancelAndBack()"
        title="Return to Previous Screen">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        Cancel
      </button>
    </div>
  </div>

  <!-- In-Page Print Notification Banner -->
  <div id="printNotification" class="print-alert-banner no-print"></div>

  <div class="receipt-container">
    <!-- Store Header -->
    <div class="store-header">
      <% 
        let displayLogo = (typeof invoice_logo_base64 !== 'undefined' && invoice_logo_base64) ? invoice_logo_base64 : '';
        if (!displayLogo) {
          let invoiceLogo = '';
          if (shope && shope.logo && shope.logo.trim() !== '') {
            invoiceLogo = shope.logo.trim();
          } else if (accessdata && accessdata.masterstore && accessdata.masterstore.app_logo) {
            invoiceLogo = accessdata.masterstore.app_logo;
          } else if (accessdata && accessdata.masterstore && accessdata.masterstore.app_favicon) {
            invoiceLogo = accessdata.masterstore.app_favicon;
          }
          if (invoiceLogo) {
            displayLogo = '/uploads/' + invoiceLogo;
          }
        }
      %>
      <% if (displayLogo) { %>
        <img src="<%= displayLogo %>" class="store-logo" alt="Store Logo" />
      <% } %>
          <div class="store-name">
            <%= (shope && shope.name) ? shope.name : (accessdata && accessdata.masterstore ?
              accessdata.masterstore.app_name : '' ) %>
          </div>
          <div class="store-info">
            <% if (shope && shope.address) { %>
              <%= shope.address %>
                <% if (shope.city) { %>, <%= shope.city %>
                    <% } %><br />
                      <% } %>
                        <% if (shope && shope.mobile_number) { %>
                          Tel: <%= shope.mobile_number %>
                            <% if (shope.store_email) { %> <br />Email: <%= shope.store_email %>
                                <% } %>
                                  <% } %>
          </div>
    </div>

    <!-- Invoice Banner (Crisp outline, saves 100% black ink) -->
    <div class="invoice-badge">POS Order Receipt</div>

    <!-- Order & Customer Meta (Tight 2-column key-value) -->
    <table class="meta-table">
      <tr>
        <td class="text-start"><b>Order #:</b>
          <%= order.order_id %>
        </td>
        <td class="text-end"><b>Status:</b>
          <%= (order.order_status_name || 'Confirmed' ) %>
        </td>
      </tr>
      <tr>
        <td class="text-start"><b>Date:</b>
          <%= oate %>
        </td>
        <td class="text-end"><b>Ready:</b>
          <%= ddate %>
        </td>
      </tr>
      <% let custObj=(Array.isArray(customer) && customer.length> 0) ? customer[0] : (customer || {});
        let custName = custObj.name || '';
        let custNumber = custObj.number || '';
        %>
        <% if (custName) { %>
          <tr>
            <td class="text-start" colspan="2">
              <b>Customer:</b>
              <%= custName %>
                <% if (custNumber) { %> &bull; <%= custNumber %>
                    <% } %>
            </td>
          </tr>
          <% } %>
    </table>

    <hr class="border-dashed" />

    <!-- Items Table -->
    <table class="items-table">
      <thead>
        <tr>
          <th class="text-start" style="width: 45%;">Item</th>
          <th class="text-end" style="width: 20%;">Rate</th>
          <th class="text-end" style="width: 15%;">Qty</th>
          <th class="text-end" style="width: 20%;">Total</th>
        </tr>
      </thead>
      <tbody>
        <% if (cartservice && cartservice.length> 0) { %>
          <% cartservice.forEach(function(item) { %>
            <tr>
              <td class="text-start">
                <span class="item-name">
                  <%= item.service_name %><% if (item.no_of_items && parseInt(item.no_of_items) > 1) { %> (<%= item.no_of_items %> Pcs)<% } %>
                </span>
                <% if (item.service_type_name) { %>
                  <span class="item-subtext">[<%= item.service_type_name %>]</span>
                  <% } %>
              </td>
              <td class="text-end">
                <% if (accessdata.plac=="1" ) { %>
                  <%= parseFloat(item.service_type_price).toFixed(2) %>
                    <%= accessdata.symbol %>
                      <% } else { %>
                        
                          <%= parseFloat(item.service_type_price).toFixed(2) %>
                            <% } %>
              </td>
              <td class="text-end">
                <%= item.service_quntity %>
              </td>
              <td class="text-end fw-bold">
                <% let lineTotal=(parseFloat(item.service_type_price) * parseFloat(item.service_quntity)).toFixed(2); %>
                  <% if (accessdata.plac=="1" ) { %>
                    <%= lineTotal %>
                      <%= accessdata.symbol %>
                        <% } else { %>
                          
                            <%= lineTotal %>
                              <% } %>
              </td>
            </tr>
            <% }) %>
              <% } %>

                <% if (addonslist && addonslist.length> 0) { %>
                  <% addonslist.forEach(function(addon) { %>
                    <tr>
                      <td class="text-start" colspan="2">
                        <span class="item-name">+ <%= addon.name %></span>
                        <span class="item-subtext">[Addon]</span>
                      </td>
                      <td class="text-center">1</td>
                      <td class="text-end fw-bold">
                        <% if (accessdata.plac=="1" ) { %>
                          <%= parseFloat(addon.price).toFixed(2) %>
                            <%= accessdata.symbol %>
                              <% } else { %>
                                <%= accessdata.symbol %>
                                  <%= parseFloat(addon.price).toFixed(2) %>
                                    <% } %>
                      </td>
                    </tr>
                    <% }) %>
                      <% } %>
      </tbody>
    </table>

    <hr class="border-dashed" />

    <!-- Financial Summary (Skip 0-value rows to save paper) -->
    <%
      let totalOrderQty = 0;
      let totalGarmentPcs = 0;
      if (cartservice && cartservice.length > 0) {
        cartservice.forEach(function(item) {
          const q = parseInt(item.service_quntity, 10) || 0;
          const p = parseInt(item.no_of_items, 10) || 1;
          totalOrderQty += q;
          totalGarmentPcs += (q * p);
        });
      }
    %>
    <table class="summary-table">
      <% if (totalOrderQty > 0) { %>
      <tr>
        <td class="text-start">Total Qty:</td>
        <td class="text-end fw-bold">
          Items: <%= totalOrderQty %><% if (totalGarmentPcs > totalOrderQty) { %> , Pieces: <%= totalGarmentPcs %>  <% } %>
        </td>
      </tr>
      <% } %>
      <tr>
        <td class="text-start">Sub Total:</td>
        <td class="text-end fw-bold">
          <% if (accessdata.plac=="1" ) { %>
            <%= parseFloat(order.sub_total).toFixed(2) %>
              <%= accessdata.symbol %>
                <% } else { %>
                  <%= accessdata.symbol %>
                    <%= parseFloat(order.sub_total).toFixed(2) %>
                      <% } %>
        </td>
      </tr>

      <% if (Number(order.addon_price)> 0) { %>
        <tr>
          <td class="text-start">Addon Total:</td>
          <td class="text-end">
            <% if (accessdata.plac=="1" ) { %>
              <%= parseFloat(order.addon_price).toFixed(2) %>
                <%= accessdata.symbol %>
                  <% } else { %>
                    <%= accessdata.symbol %>
                      <%= parseFloat(order.addon_price).toFixed(2) %>
                        <% } %>
          </td>
        </tr>
        <% } %>

          <% if (Number(order.extra_discount)> 0) { %>
            <tr>
              <td class="text-start">Discount:</td>
              <td class="text-end">
                - <% if (accessdata.plac=="1" ) { %>
                  <%= parseFloat(order.extra_discount).toFixed(2) %>
                    <%= accessdata.symbol %>
                      <% } else { %>
                        <%= accessdata.symbol %>
                          <%= parseFloat(order.extra_discount).toFixed(2) %>
                            <% } %>
              </td>
            </tr>
            <% } %>

              <% if (Number(order.coupon_discount)> 0) { %>
                <tr>
                  <td class="text-start">Coupon Discount:</td>
                  <td class="text-end">
                    - <% if (accessdata.plac=="1" ) { %>
                      <%= parseFloat(order.coupon_discount).toFixed(2) %>
                        <%= accessdata.symbol %>
                          <% } else { %>
                            <%= accessdata.symbol %>
                              <%= parseFloat(order.coupon_discount).toFixed(2) %>
                                <% } %>
                  </td>
                </tr>
                <% } %>

                  <% if (Number(order.tax_amount)> 0) { %>
                    <tr>
                      <td class="text-start">Tax (<%= parseFloat(order.tax).toFixed(0) %>%):</td>
                      <td class="text-end">
                        <% if (accessdata.plac=="1" ) { %>
                          <%= parseFloat(order.tax_amount).toFixed(2) %>
                            <%= accessdata.symbol %>
                              <% } else { %>
                                <%= accessdata.symbol %>
                                  <%= parseFloat(order.tax_amount).toFixed(2) %>
                                    <% } %>
                      </td>
                    </tr>
                    <% } %>

                      <tr class="grand-total-row">
                        <td class="text-start" style="border-top: 1px solid #000; padding-top: 2px;">Gross Total:</td>
                        <td class="text-end" style="border-top: 1px solid #000; padding-top: 2px;">
                          <% if (accessdata.plac=="1" ) { %>
                            <%= parseFloat(order.gross_total).toFixed(2) %>
                              <%= accessdata.symbol %>
                                <% } else { %>
                                  <%= accessdata.symbol %>
                                    <%= parseFloat(order.gross_total).toFixed(2) %>
                                      <% } %>
                        </td>
                      </tr>

                      <tr>
                        <td class="text-start">Paid Amount:</td>
                        <td class="text-end fw-bold">
                          <% if (accessdata.plac=="1" ) { %>
                            <%= parseFloat(order.paid_amount).toFixed(2) %>
                              <%= accessdata.symbol %>
                                <% } else { %>
                                  <%= accessdata.symbol %>
                                    <%= parseFloat(order.paid_amount).toFixed(2) %>
                                      <% } %>
                        </td>
                      </tr>

                      <% if (Number(order.balance_amount) !=0) { %>
                        <tr>
                          <td class="text-start"><b>Due / Balance:</b></td>
                          <td class="text-end fw-bold">
                            <% if (accessdata.plac=="1" ) { %>
                              <%= parseFloat(order.balance_amount).toFixed(2) %>
                                <%= accessdata.symbol %>
                                  <% } else { %>
                                    <%= accessdata.symbol %>
                                      <%= parseFloat(order.balance_amount).toFixed(2) %>
                                        <% } %>
                          </td>
                        </tr>
                        <% } %>

                          <% if (order.reference_number && order.reference_number.trim()) { %>
                            <tr>
                              <td class="text-start">Ref / Txn No:</td>
                              <td class="text-end fw-bold">
                                <%= order.reference_number %>
                              </td>
                            </tr>
                            <% } %>
    </table>

    <hr class="border-dashed" />

    <!-- Notes & Footer -->
    <% if (order.note && order.note.trim()) { %>
      <div style="font-size: 10px; font-style: italic; margin: 2px 0;">
        <b>Note:</b>
        <%= order.note %>
      </div>
      <% } %>

    <% 
      const isInvoiceBarcodeActive = (shope && shope.invoice_barcode_enabled !== undefined && shope.invoice_barcode_enabled !== null) 
        ? (shope.invoice_barcode_enabled != 0) 
        : ((master && master.invoice_barcode_enabled !== undefined && master.invoice_barcode_enabled !== null) ? (master.invoice_barcode_enabled != 0) : true);
    %>
    <% if (isInvoiceBarcodeActive) { %>
      <div class="receipt-barcode-wrap" id="invoiceBarcodeWrap">
        <svg id="invoice_barcode_svg" class="receipt-barcode-svg"></svg>
      </div>
    <% } %>

    <div class="receipt-footer">
      <div>*** Thank You For Your Business! ***</div>
      <div>Powered By <b>
          <%= (master && master.app_name) ? master.app_name : '' %>
        </b></div>
    </div>
  </div>

  <!-- Cutter divider guide in preview between invoice and tags -->
  <div class="preview-cut-guide no-print" id="previewCutGuide">
    <span>✂</span>
    <span>AUTO CUTTER CUTS HERE</span>
    <span>✂</span>
  </div>

  <!-- Cloth Tag Container (Populated by JsBarcode, used for tag print) -->
  <div class="cloth-tag-container" id="clothTagContainer"></div>

  <script src="/js/pos-print-client.js"></script>
  <script type="text/javascript">
    "use strict";

    const serverUrl = "<%= (shope && shope.printing_server_url) ? shope.printing_server_url : ((master && master.printing_server_url) ? master.printing_server_url : 'http://127.0.0.1:4321') %>";
    const silentEnabled = <%= ((shope && shope.silent_print_enabled !== undefined && shope.silent_print_enabled !== null) ? (shope.silent_print_enabled != 0) : ((master && master.silent_print_enabled === 0) ? false : true)) ? 'true' : 'false' %>;
    const invoicePrinter = "<%= (shope && shope.invoice_printer_name) ? shope.invoice_printer_name : ((master && master.invoice_printer_name) ? master.invoice_printer_name : '') %>";
    const invoiceFormat = <%= (shope && shope.invoice_printer_format !== undefined && shope.invoice_printer_format !== null) ? shope.invoice_printer_format : ((master && master.invoice_printer_format !== undefined) ? master.invoice_printer_format : 1) %>;
    const invoiceWidthMm = invoiceFormat === 2 ? 58 : (invoiceFormat === 0 ? null : 80);
    const tagPrinter = "<%= (shope && shope.tag_printer_name) ? shope.tag_printer_name : ((master && master.tag_printer_name) ? master.tag_printer_name : '') %>";
    const tagFormat = <%= (shope && shope.tag_printer_format !== undefined && shope.tag_printer_format !== null) ? shope.tag_printer_format : ((master && master.tag_printer_format !== undefined) ? master.tag_printer_format : 1) %>;
    const tagWidthMm = tagFormat === 0 ? 50 : (tagFormat === 1 ? 75 : 80);
    const autoCut = <%= ((shope && shope.printer_auto_cut !== undefined && shope.printer_auto_cut !== null) ? (shope.printer_auto_cut != 0) : ((master && master.printer_auto_cut === 0) ? false : true)) ? 'true' : 'false' %>;
    const openDrawer = <%= ((shope && shope.printer_open_cash_drawer !== undefined && shope.printer_open_cash_drawer !== null) ? (shope.printer_open_cash_drawer == 1) : ((master && master.printer_open_cash_drawer == 1) ? true : false)) ? 'true' : 'false' %>;
    const copies = <%= (shope && shope.printer_copies) ? shope.printer_copies : ((master && master.printer_copies) ? master.printer_copies : 1) %>;
    const invoiceBarcodeEnabled = <%= ((shope && shope.invoice_barcode_enabled !== undefined && shope.invoice_barcode_enabled !== null) ? (shope.invoice_barcode_enabled != 0) : ((master && master.invoice_barcode_enabled !== undefined && master.invoice_barcode_enabled !== null) ? (master.invoice_barcode_enabled != 0) : true)) ? 'true' : 'false' %>;
    const tagBarcodeEnabled = <%= ((shope && shope.tag_barcode_enabled !== undefined && shope.tag_barcode_enabled !== null) ? (shope.tag_barcode_enabled != 0) : ((master && master.tag_barcode_enabled !== undefined && master.tag_barcode_enabled !== null) ? (master.tag_barcode_enabled != 0) : true)) ? 'true' : 'false' %>;

    const cartServices = <%- JSON.stringify(cartservice || []) %>;
    const orderData = <%- JSON.stringify(order || {}) %>;
    const customerData = <%- JSON.stringify((Array.isArray(customer) && customer.length > 0) ? customer[0] : (customer || {})) %>;
    const storeName = "<%= (shope && shope.name) ? shope.name : (accessdata && accessdata.masterstore ? accessdata.masterstore.app_name : '') %>";
    const deliveryDate = "<%= ddate %>";

    const posClient = new POSPrintClient({ baseUrl: serverUrl, timeout: 4000 });
    let isServerOnline = false;
    let serverVersion = "";

    function showNotification(message, type) {
      const el = document.getElementById("printNotification");
      if (!el) return;
      let typeClass = "alert-info-soft";
      if (type === "danger" || type === "error") {
        typeClass = "alert-danger-soft";
      } else if (type === "success") {
        typeClass = "alert-success-soft";
      } else if (type === "warning") {
        typeClass = "alert-warning-soft";
      }
      el.className = `print-alert-banner ${typeClass} no-print`;
      el.innerHTML = message;
      el.style.display = "block";
      clearTimeout(window.__printNotificationTimer);
      window.__printNotificationTimer = setTimeout(() => {
        el.style.display = "none";
      }, 7000);
    }

    async function updateServerStatus(silent) {
      const dot = document.getElementById("serverStatusDot");
      const text = document.getElementById("serverStatusText");
      const pill = document.getElementById("serverStatusPill");

      if (!silent) {
        if (dot) dot.className = "status-dot checking";
        if (text) text.textContent = "Checking Server...";
      }

      try {
        isServerOnline = await posClient.isAvailable();
        if (isServerOnline) {
          try {
            const health = await posClient.request("/health");
            serverVersion = (health && health.version) ? ` (v${health.version})` : "";
          } catch (_) { }
          if (dot) dot.className = "status-dot online";
          if (text) text.textContent = `Printing Server: Online${serverVersion}`;
          if (pill) pill.title = `Connected to ${serverUrl}`;
        } else {
          if (dot) dot.className = "status-dot offline";
          if (text) text.textContent = "Printing Server: Offline (Native Fallback)";
          if (pill) pill.title = `Cannot reach ${serverUrl}. Native browser print will be used.`;
        }
      } catch (err) {
        isServerOnline = false;
        if (dot) dot.className = "status-dot offline";
        if (text) text.textContent = "Printing Server: Offline (Native Fallback)";
      }
    }

    let currentPrintMode = "all"; // "all" | "invoice" | "tags"

    function switchPrintMode(mode) {
      currentPrintMode = mode;
      document.body.classList.remove("view-mode-all", "view-mode-invoice", "view-mode-tags", "printing-tags");
      document.body.classList.add(`view-mode-${mode}`);

      // Update toggle buttons active state
      document.querySelectorAll(".mode-pill").forEach(p => p.classList.remove("active"));
      const activeBtn = document.getElementById(`mode_btn_${mode}`);
      if (activeBtn) activeBtn.classList.add("active");

      // Update primary print button label
      const btnText = document.getElementById("btn_print_text");
      if (btnText) {
        if (mode === "all") {
          btnText.textContent = "Print All (Invoice + Tags)";
        } else if (mode === "invoice") {
          btnText.textContent = "Print Invoice Only";
        } else if (mode === "tags") {
          btnText.textContent = "Print Cloth Tags Only";
        }
      }
    }

    function executeCurrentPrint() {
      if (currentPrintMode === "all") {
        printAllCombined();
      } else if (currentPrintMode === "invoice") {
        printInvoice();
      } else if (currentPrintMode === "tags") {
        printClothTags();
      }
    }

    function renderClothTagsDOM() {
      const container = document.getElementById("clothTagContainer");
      if (!container) return;

      let totalPieces = 0;
      cartServices.forEach(item => {
        const qty = parseInt(item.service_quntity, 10) || 1;
        const pieces = parseInt(item.no_of_items, 10) || 1;
        totalPieces += (qty * pieces);
      });

      if (totalPieces === 0) {
        container.innerHTML = '<div class="cloth-tag"><p style="padding:10px;text-align:center;">No garment items found for cloth tags.</p></div>';
        return;
      }

      let pieceIndex = 0;
      let html = "";
      const barcodeCalls = [];

      cartServices.forEach(item => {
        const qty = parseInt(item.service_quntity, 10) || 1;
        const pieces = parseInt(item.no_of_items, 10) || 1;
        for (let i = 1; i <= qty; i++) {
          for (let p = 1; p <= pieces; p++) {
            pieceIndex++;
            const svgId = `tag_barcode_svg_${pieceIndex}`;
            const piecePart = pieces > 1 ? ` (Part ${p}/${pieces})` : "";
            const itemTitle = item.service_name + (item.service_type_name ? ` [${item.service_type_name}]` : "") + piecePart;
            const custName = customerData.name || "Customer";
            const custPhone = customerData.number ? ` &bull; ${customerData.number}` : "";

            // Visual cut divider between cloth tags in screen preview
            if (pieceIndex > 1) {
              html += `
                <div class="preview-tag-cut-guide no-print">
                  <span>✂ Auto Cutter Cuts Between Tag #${pieceIndex - 1} & Tag #${pieceIndex} ✂</span>
                </div>
              `;
            }

            const barcodeSvgMarkup = tagBarcodeEnabled ? `
              <div class="tag-barcode-wrap">
                <svg id="${svgId}" class="tag-barcode-svg"></svg>
              </div>
            ` : '';

            html += `
              <div class="cloth-tag" id="cloth_tag_${pieceIndex}" data-tag-index="${pieceIndex}">
                <div class="tag-store-name">${storeName}</div>
                <div class="tag-order-row">
                  <span>ORD: <b>${orderData.order_id || ''}</b></span>
                  <span>Piece <b>${pieceIndex}/${totalPieces}</b></span>
                </div>
                <div class="tag-item-name">${itemTitle}</div>
                <div class="tag-cust-row">${custName}${custPhone}</div>
                <div class="tag-date-row">Delivery: <b>${deliveryDate}</b></div>
                ${barcodeSvgMarkup}
              </div>
            `;

            if (tagBarcodeEnabled) {
              barcodeCalls.push({
                id: `#${svgId}`,
                value: String(orderData.order_id || "0000"),
                label: `${orderData.order_id || ''}-${pieceIndex}/${totalPieces}`
              });
            }
          }
        }
      });

      container.innerHTML = html;

      // Render barcodes with JsBarcode
      if (tagBarcodeEnabled && typeof JsBarcode === "function") {
        barcodeCalls.forEach(bc => {
          try {
            JsBarcode(bc.id, bc.value, {
              format: "CODE128",
              width: 1.4,
              height: 34,
              displayValue: true,
              fontSize: 10,
              text: bc.label,
              margin: 2
            });
          } catch (e) {
            console.warn("JsBarcode rendering error for " + bc.id, e);
          }
        });
      }
    }

    function renderInvoiceBarcodeDOM() {
      if (!invoiceBarcodeEnabled) return;
      const svgEl = document.getElementById("invoice_barcode_svg");
      if (!svgEl) return;

      if (typeof JsBarcode === "function") {
        try {
          JsBarcode("#invoice_barcode_svg", String(orderData.order_id || "0000"), {
            format: "CODE128",
            width: 1.5,
            height: 36,
            displayValue: true,
            fontSize: 11,
            text: String(orderData.order_id || ""),
            margin: 2
          });
        } catch (e) {
          console.warn("JsBarcode invoice barcode rendering error:", e);
        }
      }
    }

    function getCleanReceiptHtml() {
      const receiptEl = document.querySelector(".receipt-container");
      if (!receiptEl) return "";
      const clone = receiptEl.cloneNode(true);
      // Guarantee any images with relative paths are converted to absolute URLs
      clone.querySelectorAll("img").forEach(img => {
        const src = img.getAttribute("src");
        if (src && !src.startsWith("data:") && !src.startsWith("http://") && !src.startsWith("https://")) {
          img.setAttribute("src", window.location.origin + (src.startsWith("/") ? "" : "/") + src);
        }
      });
      return clone.outerHTML;
    }

    /**
     * Combined Print: Prints Invoice and all Cloth Tags.
     * When silentEnabled:
     *   - Sends invoice to invoicePrinter (at invoiceWidthMm).
     *   - Sends cloth tags to tagPrinter (or invoicePrinter if tagPrinter is empty) at tagWidthMm.
     *   - Provides live spinner and notification progress.
     *   - Strictly SUPPRESSES native browser print window.
     * When !silentEnabled:
     *   - Strictly triggers browser native window.print().
     */
    async function printAllCombined() {
      // 1. If silent printing is disabled, strictly open native browser print dialog
      if (!silentEnabled) {
        switchPrintMode("all");
        window.print();
        return;
      }

      // 2. Silent Printing is Enabled: strictly suppress native window.print()
      const btn = document.getElementById("btn_primary_print");
      const btnText = document.getElementById("btn_print_text");
      const originalText = btnText ? btnText.textContent : "Print All (Invoice + Tags)";

      if (btn) btn.disabled = true;
      if (btnText) btnText.innerHTML = '<i class="fas fa-circle-notch fa-spin me-1"></i> Printing...';

      try {
        const container = document.getElementById("clothTagContainer");
        if (!container || !container.children.length) {
          renderClothTagsDOM();
        }

        // Verify printing server connectivity
        let online = false;
        try {
          online = await posClient.isAvailable();
          isServerOnline = online;
        } catch (_) {
          online = false;
        }

        if (!online) {
          showNotification(
            `<b>Silent Printing Error:</b> Cannot connect to local printing server on <b>${serverUrl}</b>. Ensure the POS Printing Server app is running.`,
            "danger"
          );
          return;
        }

        const receiptEl = document.querySelector(".receipt-container");
        const styleEl = document.querySelector("style");
        const baseCss = styleEl ? styleEl.innerHTML : "";

        // Determine destination printers (can be same or different)
        const targetInvoicePrinter = invoicePrinter || null;
        const targetInvoiceWidth = invoiceWidthMm || 80;
        const targetTagPrinter = tagPrinter || invoicePrinter || null;
        const targetTagWidth = tagWidthMm || 75;

        // Step 1: Send Customer Invoice Receipt
        if (receiptEl) {
          showNotification(`Sending invoice to <b>${targetInvoicePrinter || 'Default Thermal Printer'}</b>...`, "info");
          const receiptMarkup = getCleanReceiptHtml();
          const invoiceHtml = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>${baseCss}.receipt-container{width:100% !important;max-width:72mm !important;margin:0 auto !important;padding:2mm 2.5mm !important;box-shadow:none !important;border-radius:0 !important;box-sizing:border-box !important;}</style></head><body>${receiptMarkup}</body></html>`;
          
          await posClient.printHTML(invoiceHtml, {
            printerId: targetInvoicePrinter,
            widthMm: targetInvoiceWidth,
            options: {
              copies: copies,
              cut: true, // Cut after invoice
              openCashDrawer: openDrawer
            }
          });
        }

        // Step 2: Send Garment Cloth Tags sequentially
        const tags = container.querySelectorAll(".cloth-tag");
        for (let i = 0; i < tags.length; i++) {
          showNotification(`Sending garment tag <b>${i + 1} of ${tags.length}</b> to <b>${targetTagPrinter || 'Tag Printer'}</b>...`, "info");
          const tagHtml = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>${baseCss}.cloth-tag{width:100% !important;max-width:72mm !important;margin:0 auto !important;padding:2.5mm 2mm !important;box-shadow:none !important;border:1px dashed #000 !important;border-radius:0 !important;box-sizing:border-box !important;}</style></head><body>${tags[i].outerHTML}</body></html>`;
          
          await posClient.printHTML(tagHtml, {
            printerId: targetTagPrinter,
            widthMm: targetTagWidth,
            options: {
              copies: 1,
              cut: autoCut // Cut after each individual garment tag
            }
          });
        }

        // Step 3: Success Confirmation
        if (targetTagPrinter && targetInvoicePrinter && targetTagPrinter !== targetInvoicePrinter) {
          showNotification(`<b>All Printed:</b> Invoice dispatched to <b>${targetInvoicePrinter}</b>, and ${tags.length} garment tag(s) dispatched to <b>${targetTagPrinter}</b>.`, "success");
        } else {
          showNotification(`<b>All Printed:</b> Invoice & ${tags.length} garment tag(s) printed with cutter separations on <b>${targetInvoicePrinter || 'Thermal Printer'}</b>.`, "success");
        }
      } catch (err) {
        console.error("Silent combined print error:", err);
        showNotification(`<b>Silent Print Error:</b> ${err.message || 'Failed to dispatch print jobs to printer.'}`, "danger");
      } finally {
        if (btn) btn.disabled = false;
        if (btnText) btnText.textContent = originalText;
      }
    }

    async function printInvoice() {
      // 1. If silent printing is disabled, strictly open native browser print dialog
      if (!silentEnabled) {
        const prevMode = currentPrintMode;
        switchPrintMode("invoice");
        const restore = () => {
          switchPrintMode(prevMode);
          window.removeEventListener("afterprint", restore);
        };
        window.addEventListener("afterprint", restore);
        setTimeout(restore, 2500);
        window.print();
        return;
      }

      // 2. Silent Printing is Enabled: strictly suppress native window.print()
      const btn = document.getElementById("btn_primary_print");
      const btnText = document.getElementById("btn_print_text");
      const originalText = btnText ? btnText.textContent : "Print Invoice Only";

      if (btn) btn.disabled = true;
      if (btnText) btnText.innerHTML = '<i class="fas fa-circle-notch fa-spin me-1"></i> Printing Invoice...';

      try {
        let online = false;
        try {
          online = await posClient.isAvailable();
          isServerOnline = online;
        } catch (_) {
          online = false;
        }

        if (!online) {
          showNotification(
            `<b>Silent Printing Error:</b> Cannot connect to local printing server on <b>${serverUrl}</b>. Ensure the POS Printing Server app is running.`,
            "danger"
          );
          return;
        }

        const receiptEl = document.querySelector(".receipt-container");
        const styleEl = document.querySelector("style");
        if (receiptEl) {
          showNotification(`Sending invoice to <b>${invoicePrinter || 'Default Thermal Printer'}</b>...`, "info");
          const receiptMarkup = getCleanReceiptHtml();
          const fullHtml = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>${styleEl ? styleEl.innerHTML : ''}.receipt-container{width:100% !important;max-width:72mm !important;margin:0 auto !important;padding:2mm 2.5mm !important;box-shadow:none !important;border-radius:0 !important;box-sizing:border-box !important;}</style></head><body>${receiptMarkup}</body></html>`;
          const res = await posClient.printHTML(fullHtml, {
            printerId: invoicePrinter || null,
            widthMm: invoiceWidthMm || 80,
            options: {
              copies: copies,
              cut: autoCut,
              openCashDrawer: openDrawer
            }
          });

          if (res && res.success) {
            showNotification(`<b>Invoice Sent:</b> Receipt dispatched to <b>${invoicePrinter || 'Default Printer'}</b> (Job #${res.jobId || 'OK'})`, "success");
          } else {
            throw new Error((res && res.error) || 'Failed to dispatch invoice.');
          }
        }
      } catch (err) {
        console.error("Silent invoice print error:", err);
        showNotification(`<b>Silent Print Error:</b> ${err.message || 'Failed to dispatch invoice.'}`, "danger");
      } finally {
        if (btn) btn.disabled = false;
        if (btnText) btnText.textContent = originalText;
      }
    }

    async function printClothTags() {
      // 1. If silent printing is disabled, strictly open native browser print dialog
      if (!silentEnabled) {
        const prevMode = currentPrintMode;
        switchPrintMode("tags");
        const restore = () => {
          switchPrintMode(prevMode);
          window.removeEventListener("afterprint", restore);
        };
        window.addEventListener("afterprint", restore);
        setTimeout(restore, 2500);
        window.print();
        return;
      }

      // 2. Silent Printing is Enabled: strictly suppress native window.print()
      const btn = document.getElementById("btn_primary_print");
      const btnText = document.getElementById("btn_print_text");
      const originalText = btnText ? btnText.textContent : "Print Cloth Tags Only";

      if (btn) btn.disabled = true;
      if (btnText) btnText.innerHTML = '<i class="fas fa-circle-notch fa-spin me-1"></i> Printing Tags...';

      try {
        const container = document.getElementById("clothTagContainer");
        if (!container || !container.children.length) {
          renderClothTagsDOM();
        }

        let online = false;
        try {
          online = await posClient.isAvailable();
          isServerOnline = online;
        } catch (_) {
          online = false;
        }

        if (!online) {
          showNotification(
            `<b>Silent Printing Error:</b> Cannot connect to local printing server on <b>${serverUrl}</b>. Ensure the POS Printing Server app is running.`,
            "danger"
          );
          return;
        }

        const styleEl = document.querySelector("style");
        const baseCss = styleEl ? styleEl.innerHTML : "";
        const targetPrinter = tagPrinter || invoicePrinter || null;
        const targetWidth = tagWidthMm || 75;

        const tags = container.querySelectorAll(".cloth-tag");
        for (let i = 0; i < tags.length; i++) {
          showNotification(`Sending garment tag <b>${i + 1} of ${tags.length}</b> to <b>${targetPrinter || 'Tag Printer'}</b>...`, "info");
          const tagHtml = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>${baseCss}.cloth-tag{width:100% !important;max-width:72mm !important;margin:0 auto !important;padding:2.5mm 2mm !important;box-shadow:none !important;border:1px dashed #000 !important;border-radius:0 !important;box-sizing:border-box !important;}</style></head><body>${tags[i].outerHTML}</body></html>`;
          await posClient.printHTML(tagHtml, {
            printerId: targetPrinter,
            widthMm: targetWidth,
            options: {
              copies: 1,
              cut: autoCut
            }
          });
        }

        showNotification(`<b>Cloth Tags Sent:</b> ${tags.length} garment wash tag(s) dispatched to <b>${targetPrinter || 'Tag Printer'}</b>.`, "success");
      } catch (err) {
        console.error("Silent cloth tag print error:", err);
        showNotification(`<b>Silent Print Error:</b> ${err.message || 'Failed to dispatch cloth tags.'}`, "danger");
      } finally {
        if (btn) btn.disabled = false;
        if (btnText) btnText.textContent = originalText;
      }
    }

    function cancelAndBack() {
      if (document.referrer && (document.referrer.indexOf("/admin/") !== -1 || document.referrer.indexOf("/order/") !== -1)) {
        window.location.href = document.referrer;
      } else if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = "/admin/pos";
      }
    }

    window.onload = function () {
      // 1. Initialize Print Mode from URL query parameter (defaults to "all")
      const urlParams = new URLSearchParams(window.location.search);
      const requestedMode = (urlParams.get("mode") || "").toLowerCase().trim();
      const initialMode = (requestedMode === "invoice" || requestedMode === "tags") ? requestedMode : "all";
      switchPrintMode(initialMode);

      // 2. Pre-render invoice barcode if enabled
      renderInvoiceBarcodeDOM();

      // 3. Pre-render cloth tags so barcodes and cut guides are visible in preview
      renderClothTagsDOM();

      // 4. Check printing server connectivity (does NOT trigger print window)
      updateServerStatus(false);

      // 5. Keep status monitored in background
      setInterval(() => updateServerStatus(true), 25000);
    };
  </script>
</body>

