                <script>
                    function escapeHtml(str) {
                        if (!str) return '';
                        return String(str)
                          .replace(/&/g, '&amp;')
                          .replace(/</g, '&lt;')
                          .replace(/>/g, '&gt;')
                          .replace(/"/g, '&quot;')
                          .replace(/'/g, '&#039;');
                    }

                    function changeStaffStatus(id, currentApproved, checkboxElem) {
                        let newStatus = 'active';
                        if (checkboxElem) {
                            newStatus = checkboxElem.checked ? 'active' : 'deactive';
                        } else {
                            const isCurrentlyActive = (String(currentApproved) === '1');
                            newStatus = isCurrentlyActive ? 'deactive' : 'active';
                        }

                        if (checkboxElem) {
                            $(checkboxElem).prop('disabled', true);
                        }

                        $.ajax({
                            type: 'POST',
                            url: `/tool/staffroll/${id}`,
                            data: { status: newStatus },
                            success: function (res) {
                                if (checkboxElem) {
                                    $(checkboxElem).prop('disabled', false);
                                }
                                if (window.staffTable) {
                                    window.staffTable.ajax.reload(null, false);
                                }
                            },
                            error: function(err) {
                                console.error('Failed to change staff status', err);
                                if (checkboxElem) {
                                    $(checkboxElem).prop('disabled', false);
                                    checkboxElem.checked = !checkboxElem.checked;
                                }
                                alert('Failed to update staff status in database. Please try again.');
                            }
                        });
                    }

                    $(document).ready(function() {
                        window.staffTable = window.initServerDataTable('#server_staff_table', {
                            ajaxUrl: '/tool/staff/data',
                            columns: [
                                {
                                    data: null,
                                    orderable: false,
                                    searchable: false,
                                    render: function(data, type, row, meta) {
                                        return meta.settings._iDisplayStart + meta.row + 1;
                                    }
                                },
                                {
                                    data: 'name',
                                    render: function(data) {
                                        return `<div class="fw-bold text-dark">${escapeHtml(data)}</div>`;
                                    }
                                },
                                {
                                    data: 'number',
                                    render: function(data, type, row) {
                                        return `
                                            <div class="fw-semibold text-dark"><i class="fa fa-phone-alt text-success me-1"></i>${escapeHtml(data || '')}</div>
                                            ${row.email ? `<div class="text-xs text-muted"><i class="fa fa-envelope text-info me-1"></i>${escapeHtml(row.email)}</div>` : ''}
                                        `;
                                    }
                                },
                                {
                                    data: 'store',
                                    render: function(data) {
                                        return `<span class="badge bg-light text-dark px-2 py-1">${escapeHtml(data || 'Not Assigned')}</span>`;
                                    }
                                },
                                {
                                    data: 'approved',
                                    render: function(data, type, row) {
                                        const isChecked = (String(data) === '1') ? 'checked' : '';
                                        return `
                                            <div class="form-check form-switch d-inline-block">
                                                <input class="form-check-input" type="checkbox" id="active${row.id}" ${isChecked} onchange="changeStaffStatus('${row.id}', '${data}', this)">
                                            </div>
                                        `;
                                    }
                                },
                                {
                                    data: null,
                                    orderable: false,
                                    searchable: false,
                                    className: 'text-center',
                                    render: function(data, type, row) {
                                        let html = '<div class="tbl-action-group justify-content-center">';
                                        if (row.canEdit) {
                                            html += `<a href="#" class="btn-dt-action btn-edit btn-staff-edit" data-bs-toggle="modal" data-bs-target="#staff_update" 
                                                        data-id="${row.id}" data-name="${escapeHtml(row.name)}" data-number="${escapeHtml(row.number)}" 
                                                        data-roll_id="${row.roll_id}" data-email="${escapeHtml(row.email)}" data-username="${escapeHtml(row.username)}" 
                                                        data-password="${escapeHtml(row.password)}" data-store-id="${row.store_ID}" data-approved="${row.approved}" 
                                                        title="<%= language.Edit || 'Edit' %>"><i class="fas fa-pencil-alt"></i></a>`;
                                        }
                                        if (row.canDelete) {
                                            html += `<button type="button" class="btn-dt-action btn-delete btn-delete-staff" 
                                                        data-bs-toggle="modal" data-bs-target="#deleteStaffModal" 
                                                        data-id="${row.id}" data-name="${escapeHtml(row.name || '')}" 
                                                        title="<%= language.Delete || 'Delete' %>">
                                                        <i class="fa fa-trash"></i>
                                                    </button>`;
                                        }
                                        if (row.canEdit) {
                                            html += `<a href="#" class="btn-dt-action btn-info btn-manage-role" 
                                                        data-bs-toggle="modal" data-bs-target="#roll_list_update_${row.rollType}" 
                                                        data-roll-id="${row.roll_id}" data-rollup-id="${row.roll_id}" 
                                                        data-roll-type="${row.rollType}" data-staff-name="${escapeHtml(row.name || '')}" 
                                                        id="rollmanege${row.rollType}" title="<%= language.Role || 'Manage Role' %>">
                                                        <i class="fas fa-tasks"></i>
                                                    </a>`;
                                        }
                                        html += '</div>';
                                        return html;
                                    }
                                }
                            ],
                            order: [[0, 'desc']],
                            searchInput: '#dtStaffSearch',
                            pageLengthSelect: '#dtStaffPageLength',
                            filterElements: {
                                status_filter: '#dtStaffStatus',
                                store_filter: '#dtStaffStore'
                            }
                        });
                    });

                    function populateStaffUpdateModal(button) {
                        const $btn = $(button);
                        const id = $btn.attr('data-id');
                        const name = $btn.attr('data-name') || '';
                        const number = $btn.attr('data-number') || '';
                        const email = $btn.attr('data-email') || '';
                        const username = $btn.attr('data-username') || '';
                        const rollId = $btn.attr('data-roll_id') || '';
                        const storeId = $btn.attr('data-store-id') || '';
                        const approved = $btn.attr('data-approved');

                        if (id) {
                            $('#update_staff_form').attr('action', '/tool/updatestaff/' + id);
                        }

                        $('#name_update').val(name);
                        $('#number_update').val(number);
                        $('#email_update').val(email);
                        $('#username_update').val(username);
                        $('#password_update').val('');
                        $('#roll_list_update').val(rollId);

                        if (storeId) {
                            $('#store_update').val(storeId);
                        }

                        $('#active_update').prop('checked', String(approved) === '1');
                    }

                    $(document).on('click', '.btn-staff-edit, #update_staff', function () {
                        populateStaffUpdateModal(this);
                    });

                    $('#staff_update').on('show.bs.modal', function (e) {
                        if (e.relatedTarget) {
                            populateStaffUpdateModal(e.relatedTarget);
                        }
                    });

                    $('#update_staff_form').on('submit', function (e) {
                        const action = $(this).attr('action');
                        if (!action || action === '' || action === '/tool/updatestaff/' || action.includes('undefined')) {
                            e.preventDefault();
                            alert('Invalid destination: please re-open the edit dialog and try again.');
                            return false;
                        }
                    });

                    $(document).on('click', '.btn-delete-staff', function () {
                        const staffId = $(this).attr('data-id');
                        const cleanId = String(staffId).replace(/['"]/g, '').trim();
                        const staffName = $(this).attr('data-name') || '';

                        $('#deleteStaffModalName').text(staffName ? ('"' + staffName + '"') : ('#' + cleanId));
                        $('#deleteStaffConfirmBtn').attr('href', '/tool/deletstaff/' + cleanId);
                    });

                    // Manage Role Modal: Setup & Dynamic Population
                    $('[id^="roll_list_update_"]').on('show.bs.modal', function (e) {
                        const button = $(e.relatedTarget);
                        const rollId = button.attr('data-roll-id') || button.attr('data-rollup-id') || button.data('roll-id') || button.data('rollup-id');
                        const rollType = button.attr('data-roll-type') || button.data('roll-type') || 'store';
                        const staffName = button.attr('data-staff-name') || button.data('staff-name') || '';

                        if (staffName) {
                            $('#roleModalStaffName').text(`- ${staffName}`);
                        } else {
                            $('#roleModalStaffName').text('');
                        }

                        if (rollId) {
                            const cleanRollId = String(rollId).replace(/['"]/g, '').trim();
                            const targetAction = `/tool/rollUp/${cleanRollId}`;
                            
                            // Set action on both form ID variations to avoid blank page
                            $('#updateroll_form_' + rollType).attr('action', targetAction);
                            $('#updateroll_' + rollType + '_form').attr('action', targetAction);
                            $('#updateroll_form_store').attr('action', targetAction);
                            $('#updateroll_store_form').attr('action', targetAction);

                            debugger
                            // Load existing permissions via AJAX
                            $.ajax({
                                type: 'GET',
                                url: `/tool/rolldetailstaff/${cleanRollId}`,
                                success: function (res) {
                                    debugger
                                    const rd = (res && res.rolldata) ? res.rolldata : {};

                                    function checkPerm(selector, permVal, action) {
                                        const checked = Boolean(permVal && typeof permVal === 'string' && permVal.includes(action));
                                        $(selector).prop('checked', checked);
                                    }

                                    // POS
                                    checkPerm('#updatestore_pos_read', rd.pos, 'read');
                                    checkPerm('#updatestore_pos_write', rd.pos, 'write');

                                    // Orders
                                    checkPerm('#updatestore_orders_read', rd.orders, 'read');
                                    checkPerm('#updatestore_orders_write', rd.orders, 'write');
                                    checkPerm('#updatestore_orders_edit', rd.orders, 'edit');
                                    checkPerm('#updatestore_orders_delete', rd.orders, 'delete');

                                    // Customers
                                    checkPerm('#updatestore_customers_read', rd.customers, 'read');
                                    checkPerm('#updatestore_customers_write', rd.customers, 'write');
                                    checkPerm('#updatestore_customers_edit', rd.customers, 'edit');
                                    checkPerm('#updatestore_customers_delete', rd.customers, 'delete');

                                    // Expense
                                    checkPerm('#updatestore_expense_read', rd.expense, 'read');
                                    checkPerm('#updatestore_expense_write', rd.expense, 'write');
                                    checkPerm('#updatestore_expense_edit', rd.expense, 'edit');
                                    checkPerm('#updatestore_expense_delete', rd.expense, 'delete');

                                    // Service
                                    checkPerm('#updatestore_service_read', rd.service, 'read');
                                    checkPerm('#updatestore_service_write', rd.service, 'write');
                                    checkPerm('#updatestore_service_edit', rd.service, 'edit');
                                    checkPerm('#updatestore_service_delete', rd.service, 'delete');

                                    // Account
                                    checkPerm('#updatestore_account_read', rd.account, 'read');
                                    checkPerm('#updatestore_account_write', rd.account, 'write');
                                    checkPerm('#updatestore_account_edit', rd.account, 'edit');
                                    checkPerm('#updatestore_account_delete', rd.account, 'delete');

                                    // Reports
                                    checkPerm('#updatestore_reports_read', rd.reports, 'read');

                                    // Roles
                                    checkPerm('#updatestore_roll_read', rd.rollaccess, 'read');
                                    checkPerm('#updatestore_roll_write', rd.rollaccess, 'write');
                                    checkPerm('#updatestore_roll_edit', rd.rollaccess, 'edit');

                                    // Mail
                                    checkPerm('#updatestore_mail_read', rd.mail, 'read');
                                    checkPerm('#updatestore_mail_write', rd.mail, 'write');
                                    checkPerm('#updatestore_mail_edit', rd.mail, 'edit');
                                    checkPerm('#updatestore_mail_delete', rd.mail, 'delete');

                                    // Master / Store Settings
                                    checkPerm('#updatestore_master_read', rd.master, 'read');
                                    checkPerm('#updatestore_master_edit', rd.master, 'edit');

                                    // Staff
                                    checkPerm('#updatestore_staff_read', rd.staff, 'read');
                                    checkPerm('#updatestore_staff_write', rd.staff, 'write');
                                    checkPerm('#updatestore_staff_edit', rd.staff, 'edit');
                                    checkPerm('#updatestore_staff_delete', rd.staff, 'delete');

                                    // SMS
                                    checkPerm('#updatestore_sms_read', rd.sms, 'read');
                                    checkPerm('#updatestore_sms_write', rd.sms, 'write');
                                    checkPerm('#updatestore_sms_edit', rd.sms, 'edit');
                                    checkPerm('#updatestore_sms_delete', rd.sms, 'delete');

                                    // Active toggle
                                    $('#rollactive').prop('checked', rd.active !== 0 && rd.active !== '0');

                                    // Update module switches state
                                    syncModuleSwitches();
                                }
                            });
                        }
                    });

                    // Sync module switch state with checkboxes
                    function syncModuleSwitches() {
                        $('#roll_list_update_store .card').each(function () {
                            const card = $(this);
                            const chks = card.find('.perm-chk');
                            const sw = card.find('.module-toggle-switch');
                            if (chks.length > 0 && sw.length > 0) {
                                const allChecked = chks.filter(':checked').length === chks.length;
                                sw.prop('checked', allChecked);
                            }
                        });
                    }

                    // Per-Module Toggle Switch
                    $(document).on('change', '.module-toggle-switch', function () {
                        const isChecked = $(this).is(':checked');
                        const card = $(this).closest('.card');
                        card.find('.perm-chk').prop('checked', isChecked);
                    });

                    // Update switch when child permission checkbox changes
                    $(document).on('change', '.perm-chk', function () {
                        syncModuleSwitches();
                    });

                    // Global Select All / Deselect All
                    $(document).on('click', '#btnSelectAllPerms', function () {
                        $('#roll_list_update_store .perm-chk').prop('checked', true);
                        $('#roll_list_update_store .module-toggle-switch').prop('checked', true);
                    });

                    $(document).on('click', '#btnDeselectAllPerms', function () {
                        $('#roll_list_update_store .perm-chk').prop('checked', false);
                        $('#roll_list_update_store .module-toggle-switch').prop('checked', false);
                    });

                    // Form Submission Safety Guard: Prevent submitting to invalid or default route
                    $(document).on('submit', '#updateroll_form_store, #updateroll_store_form', function (e) {
                        const action = $(this).attr('action');
                        if (!action || action === '/coustomer/update/' || action.includes('undefined')) {
                            e.preventDefault();
                            alert('Invalid destination: please re-open the role dialog and try again.');
                            return false;
                        }
                    });

                    function toggleStaffPassword(inputId, btn) {
                        const input = document.getElementById(inputId);
                        if (!input) return;
                        const icon = btn.querySelector('i');
                        if (input.type === 'password') {
                            input.type = 'text';
                            if (icon) {
                                icon.classList.remove('fa-eye');
                                icon.classList.add('fa-eye-slash');
                            }
                        } else {
                            input.type = 'password';
                            if (icon) {
                                icon.classList.remove('fa-eye-slash');
                                icon.classList.add('fa-eye');
                            }
                        }
                    }
                </script>
</body>


