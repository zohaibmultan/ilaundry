<!DOCTYPE html>
<html lang="en" class="h-100">


<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>

    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                        <i class="fa fa-user-tie text-primary me-2"></i><%= language.Staff %>
                                    </h3>
                                    <small class="text-muted"><%= language.Staff_Subtitle || 'Manage staff accounts, store assignments, and operational access' %></small>
                                </div>
                                <div>
                                    <button
                                        class="btn btn-sm btn-primary <%= accessdata.roll.staff.includes('write') ?'':'d-none' %>"
                                        data-bs-toggle="modal" data-bs-target="#staff_add">
                                        <i class="fa fa-plus me-2"></i><%= language.Add_New_Staff %>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="row g-2 mb-3">
                                    <div class="<%= ismulty ? 'col-12 col-md-4 col-lg-4' : 'col-12 col-md-6 col-lg-6' %>">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                            <input class="form-control" type="search" id="dtStaffSearch" placeholder="<%= language.Search || 'Search staff by name, phone, email, username...' %>">
                                        </div>
                                    </div>
                                    <div class="<%= ismulty ? 'col-6 col-sm-4 col-md-3 col-lg-3' : 'col-6 col-sm-6 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtStaffStatus">
                                            <option value="all"><%= language.All_Status || 'All Status' %></option>
                                            <option value="1"><%= language.Approved || 'Approved' %></option>
                                            <option value="0"><%= language.Pending || 'Pending' %></option>
                                        </select>
                                    </div>

                                    <% if (ismulty) { %>
                                        <div class="col-6 col-sm-4 col-md-3 col-lg-3">
                                            <select class="form-select" id="dtStaffStore">
                                                <option value="all"><%= language.All_Store || 'All Stores' %></option>
                                                <% storeList.forEach(function(st) { %>
                                                    <option value="<%= st.id %>"><%= st.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    <% } %>

                                    <div class="<%= ismulty ? 'col-12 col-sm-4 col-md-2 col-lg-2' : 'col-12 col-sm-6 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtStaffPageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_staff_table" class="table display server-side-dt" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th><%= language.Staff_Name %></th>
                                                <th><%= language.Contact %></th>
                                                <th><%= language.Shop_Name || language.Store || 'Assigned Store' %></th>
                                                <th style="width: 110px;"><%= language.Status %></th>
                                                <th class="text-center" style="width: 130px;"><%= language.Action %></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <!--********** Content body end **********-->

        <!-- Modal update -->
        <div class="modal fade" id="staff_update" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
                <div class="modal-content border-0 shadow rounded-3">
                    <div class="modal-header py-3 px-4 border-bottom bg-light-subtle d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 bg-primary-subtle text-primary rounded-3 d-inline-flex align-items-center justify-content-center">
                                <i class="fa fa-user-edit fs-5"></i>
                            </div>
                            <div>
                                <h5 class="modal-title fw-bold text-dark mb-0">
                                    <%= language.Edit_Staff_Details || 'Edit Staff Member' %>
                                </h5>
                                <small class="text-muted fs-12">Update employee profile, login credentials, and branch assignment</small>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="" id="update_staff_form" method="post" class="need-validation" novalidate>
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <!-- Staff Name -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="name_update">
                                        <%= language.Staff_Name || 'Staff Full Name' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-user"></i></span>
                                        <input type="text" class="form-control" name="name_update" id="name_update"
                                            placeholder="Enter Staff Name" required>
                                    </div>
                                    <div class="invalid-feedback">Staff name is required.</div>
                                </div>

                                <!-- Phone Number -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="number_update">
                                        <%= language.Phone_Number || 'Contact Phone Number' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-phone"></i></span>
                                        <input type="tel" class="form-control" name="number_update" id="number_update"
                                            placeholder="Enter Phone Number" required>
                                    </div>
                                    <div class="invalid-feedback">Valid phone number is required.</div>
                                </div>

                                <!-- Email Address -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="email_update">
                                        <%= language.Email || 'Email Address' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-envelope"></i></span>
                                        <input type="email" class="form-control" name="email_update" id="email_update"
                                            placeholder="e.g. staff@icleaners.com" required>
                                    </div>
                                    <div class="invalid-feedback">Valid email is required.</div>
                                </div>

                                <!-- Username -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="username_update">
                                        <%= language.Username || 'Login Username' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-user-tag"></i></span>
                                        <input type="text" class="form-control" name="username_update" id="username_update"
                                            placeholder="Enter User Name" required autocomplete="off">
                                    </div>
                                    <div class="invalid-feedback">Username is required.</div>
                                </div>

                                <!-- Password (Optional on update) -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="password_update">
                                        <%= language.Password || 'Update Password' %>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-lock"></i></span>
                                        <input type="password" class="form-control" name="password_update" id="password_update"
                                            placeholder="Leave blank to keep current" autocomplete="new-password">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleStaffPassword('password_update', this)" title="Toggle password visibility">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                    </div>
                                    <small class="text-muted fs-11">Leave blank unless you wish to change credentials.</small>
                                </div>

                                <!-- Assigned Store -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="store_update">
                                        <%= language.Store || language.Shop_Name || 'Assigned Store' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-store"></i></span>
                                        <select class="form-select" name="store_update" id="store_update" required>
                                            <option value="" disabled selected>Select Assigned Store</option>
                                            <% if (typeof storeList !== 'undefined' && storeList.length > 0) { %>
                                                <% storeList.forEach(function(s){ %>
                                                    <option value="<%= s.id %>"><%= s.name %></option>
                                                <% }) %>
                                            <% } %>
                                        </select>
                                    </div>
                                    <div class="invalid-feedback">Please select an assigned store.</div>
                                </div>

                                <input type="hidden" name="roll_list_update" id="roll_list_update" value="">

                                <!-- Active Status Card -->
                                <div class="col-12">
                                    <div class="p-3 bg-light-subtle rounded-3 border d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa fa-shield-alt text-primary fs-5"></i>
                                            <div>
                                                <div class="fw-bold text-dark fs-13"><%= language.Is_Active || 'Active Authorization' %></div>
                                                <small class="text-muted fs-11">Allow this staff member to log in and access system functions</small>
                                            </div>
                                        </div>
                                        <div class="form-check form-switch m-0 fs-5">
                                            <input class="form-check-input" type="checkbox" role="switch" id="active_update"
                                                name="active_update" value="1">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer py-3 px-4 border-top bg-light-subtle d-flex justify-content-between align-items-center">
                            <small class="text-muted"><i class="fa fa-info-circle me-1"></i> Required fields are marked with <span class="text-danger">*</span></small>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-outline-secondary px-3 py-2 fw-semibold" data-bs-dismiss="modal">
                                    <i class="fa fa-times me-1"></i><%= language.Cancel || 'Cancel' %>
                                </button>
                                <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                                    <i class="fa fa-save"></i><%= language.Save || 'Save Changes' %>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal add -->
        <div class="modal fade" id="staff_add" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
                <div class="modal-content border-0 shadow rounded-3">
                    <div class="modal-header py-3 px-4 border-bottom bg-light-subtle d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <div class="p-2 bg-primary-subtle text-primary rounded-3 d-inline-flex align-items-center justify-content-center">
                                <i class="fa fa-user-plus fs-5"></i>
                            </div>
                            <div>
                                <h5 class="modal-title fw-bold text-dark mb-0">
                                    <%= language.Add_New_Staff || 'Add New Staff Member' %>
                                </h5>
                                <small class="text-muted fs-12">Create a new employee profile and assign branch access</small>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/tool/addstaff" method="post" class="need-validation" novalidate>
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <!-- Staff Name -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="name">
                                        <%= language.Staff_Name || 'Staff Full Name' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-user"></i></span>
                                        <input type="text" class="form-control" name="name" id="name"
                                            placeholder="Enter Staff Name" required>
                                    </div>
                                    <div class="invalid-feedback">Staff name is required.</div>
                                </div>

                                <!-- Phone Number -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="number">
                                        <%= language.Phone_Number || 'Contact Phone Number' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-phone"></i></span>
                                        <input type="tel" class="form-control" name="number" id="number"
                                            placeholder="Enter Phone Number" required>
                                    </div>
                                    <div class="invalid-feedback">Valid phone number is required.</div>
                                </div>

                                <!-- Email Address -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="email">
                                        <%= language.Email || 'Email Address' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-envelope"></i></span>
                                        <input type="email" class="form-control" name="email" id="email"
                                            placeholder="e.g. staff@icleaners.com" required>
                                    </div>
                                    <div class="invalid-feedback">Valid email is required.</div>
                                </div>

                                <!-- Username -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="username">
                                        <%= language.Username || 'Login Username' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-user-tag"></i></span>
                                        <input type="text" class="form-control" name="username" id="username"
                                            placeholder="Enter User Name" required autocomplete="off">
                                    </div>
                                    <div class="invalid-feedback">Username is required.</div>
                                </div>

                                <!-- Password -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="password">
                                        <%= language.Password || 'Login Password' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-lock"></i></span>
                                        <input type="password" class="form-control" name="password" id="password"
                                            placeholder="Enter Password" required autocomplete="new-password">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleStaffPassword('password', this)" title="Toggle password visibility">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                    </div>
                                    <div class="invalid-feedback">Password is required.</div>
                                </div>

                                <!-- Assigned Store -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold" for="store_id">
                                        <%= language.Store || language.Shop_Name || 'Assigned Store' %> <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted"><i class="fa fa-store"></i></span>
                                        <select class="form-select" name="store_id" id="store_id" required>
                                            <option value="" disabled selected>Select Assigned Store</option>
                                            <% if (typeof storeList !== 'undefined' && storeList.length > 0) { %>
                                                <% storeList.forEach(function(s){ %>
                                                    <option value="<%= s.id %>"><%= s.name %></option>
                                                <% }) %>
                                            <% } %>
                                        </select>
                                    </div>
                                    <div class="invalid-feedback">Please select an assigned store.</div>
                                </div>

                                <input type="hidden" name="roll_list" value="<%= rolldata[0]?.id %>">

                                <!-- Active Status Card -->
                                <div class="col-12">
                                    <div class="p-3 bg-light-subtle rounded-3 border d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa fa-shield-alt text-success fs-5"></i>
                                            <div>
                                                <div class="fw-bold text-dark fs-13"><%= language.Is_Active || 'Active Authorization' %></div>
                                                <small class="text-muted fs-11">Authorize this staff member immediately upon creation</small>
                                            </div>
                                        </div>
                                        <div class="form-check form-switch m-0 fs-5">
                                            <input class="form-check-input" type="checkbox" role="switch" id="active" name="active" value="1" checked>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer py-3 px-4 border-top bg-light-subtle d-flex justify-content-between align-items-center">
                            <small class="text-muted"><i class="fa fa-info-circle me-1"></i> Required fields are marked with <span class="text-danger">*</span></small>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-outline-secondary px-3 py-2 fw-semibold" data-bs-dismiss="modal">
                                    <i class="fa fa-times me-1"></i><%= language.Cancel || 'Cancel' %>
                                </button>
                                <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                                    <i class="fa fa-save"></i><%= language.Save || 'Create Staff' %>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal delete confirm -->
        <div class="modal fade" id="deleteStaffModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content text-center p-3 border-0 shadow rounded-4">
                    <div class="modal-body pt-4">
                        <div class="mb-3">
                            <div class="p-3 bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                <i class="fa fa-trash-alt fs-3"></i>
                            </div>
                        </div>
                        <h4 class="mb-2 fw-bold text-dark"><%= language.Delete_Staff || language.Delete || 'Delete Staff Member' %></h4>
                        <p class="text-muted mb-2"><%= language.Are_you_sure_delete || 'Are you sure you want to delete this staff member?' %></p>
                        <p class="fw-bold text-danger fs-5 mb-2" id="deleteStaffModalName"></p>
                        <div class="alert alert-danger py-2 px-3 mb-3 text-start small border-0 bg-danger-subtle text-danger-emphasis rounded-3">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            <strong><%= language.Warning || 'Warning' %>:</strong>
                            <%= language.Delete_staff_warning || 'This will permanently remove this staff member and revoke their system login access.' %>
                        </div>
                        <p class="text-muted mb-4 small"><%= language.Action_cannot_be_undone || 'This action cannot be undone.' %></p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-outline-secondary px-3 py-2 fw-semibold" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                            </button>
                            <a href="#" id="deleteStaffConfirmBtn" class="btn btn-danger px-4 py-2 fw-semibold d-inline-flex align-items-center">
                                <i class="fa fa-trash me-2"></i><%= language.Delete || 'Yes, Delete' %>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- user roll -->


        <div class="modal fade" id="roll_list_update_master">
            <div class="modal-dialog  modal-dialog-scrollable" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Edit_Role_List %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/tool/rollUp/" id="updateroll_form_master" method="post" class="need-validation">

                            <div class="row g-1 align-items-center">

                                <div class="form-group d-none">
                                    <input type="hidden" value="master" name="rollType">
                                </div>

                                <div class="form-group">
                                    <div class="d-flex align-items-center ">
                                        <label class="form-label col-2"><strong>
                                                <%= language.POS %>
                                            </strong></label>
                                        <% if(rolldata[0]?.pos?.includes('read')){ %>
                                            <div class="form-check col-2 ms-4">
                                                <input class="form-check-input" type="checkbox" id="update_pos_read"
                                                    name="pos" value="read">
                                                <label class="form-check-label" for="update_pos_read">
                                                    <%= language.Read %>
                                                </label>
                                            </div>
                                            <%}%>
                                                <% if(rolldata[0]?.pos?.includes('write')){ %>
                                                    <div class="form-check col-2 ms-3">
                                                        <input class="form-check-input" type="checkbox"
                                                            id="update_pos_write" name="pos" value="write">
                                                        <label class="form-check-label" for="update_pos_write">
                                                            <%= language.Write %>
                                                        </label>
                                                    </div>
                                                    <%}%>
                                                        <% if(rolldata[0]?.pos?.includes('edit')){ %>
                                                            <div class="form-check col-2 ms-3 invisible">
                                                                <input class="form-check-input" type="checkbox"
                                                                    id="update_pos_edit" name="pos" value="edit">
                                                                <label class="form-check-label" for="update_pos_edit">
                                                                    <%= language.Edit %>
                                                                </label>
                                                            </div>
                                                            <%}%>
                                                                <% if(rolldata[0]?.pos?.includes('delete')){ %>
                                                                    <div class="form-check col-2 ms-3 invisible">
                                                                        <input class="form-check-input" type="checkbox"
                                                                            id="update_pos_delete" name="pos"
                                                                            value="delete">
                                                                        <label class="form-check-label"
                                                                            for="update_pos_delete">
                                                                            <%= language.Delete %>
                                                                        </label>
                                                                    </div>
                                                                    <%}%>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="d-flex align-items-center ">
                                        <label class="form-label col-2"><strong>
                                                <%= language.Orders %>
                                            </strong></label>

                                        <% if(rolldata[0]?.orders?.includes('read')){ %>

                                            <div class="form-check col-2 ms-4">
                                                <input class="form-check-input" type="checkbox" id="update_orders_read"
                                                    name="orders" value="read">
                                                <label class="form-check-label" for="update_orders_read">
                                                    <%= language.Read %>
                                                </label>
                                            </div>
                                            <%}%>

                                                <% if(rolldata[0]?.orders?.includes('write')){ %>

                                                    <div class="form-check col-2 ms-3">
                                                        <input class="form-check-input" type="checkbox"
                                                            id="update_orders_write" name="orders" value="write">
                                                        <label class="form-check-label" for="update_orders_write">
                                                            <%= language.Write %>
                                                        </label>
                                                    </div>
                                                    <%}%>

                                                        <% if(rolldata[0]?.orders?.includes('edit')){ %>

                                                            <div class="form-check col-2 ms-3">
                                                                <input class="form-check-input" type="checkbox"
                                                                    id="update_orders_edit" name="orders" value="edit">
                                                                <label class="form-check-label"
                                                                    for="update_orders_edit">
                                                                    <%= language.Edit %>
                                                                </label>
