<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>
</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>

    <!--********** Content body start **********-->
    <div class="content-body">
        <div class="container-fluid" style="min-height: 100vh;">
            
            <% storedata.forEach(function(data){ %>

            <!-- Page Header Card -->
            <div class="row mb-2">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div>
                                <h3 class="mb-1 fw-bold text-dark d-flex align-items-center">
                                    <i class="fa fa-cogs text-primary me-2"></i><%= language.Store_Setting || 'Store Settings' %>
                                </h3>
                                <p class="text-muted mb-0 fs-13">
                                    <%= language.Store_Setting_Subtitle || 'Manage your store profile, tax credentials, receipt branding, and preferences' %>: <strong class="text-primary"><%= data.name %></strong>
                                </p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <a href="/index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
                                    <i class="fa fa-arrow-left me-1"></i> <%= language.Back_to_Dashboard || 'Back to Dashboard' %>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- View-Only Alert if no edit permissions -->
            <% if (!update) { %>
                <div class="alert alert-info py-2 px-3 mb-4 d-flex align-items-center rounded-3">
                    <i class="fas fa-info-circle me-2 fs-5"></i>
                    <span><%= language.Store_View_Only || 'You are viewing details of your assigned store: ' %><strong><%= data.name %></strong> (<%= language.View_Only || 'View Only' %>).</span>
                </div>
            <% } %>

            <!-- Form Container -->
            <form action="/tool/updatesetting/<%= data.id %>" method="POST" enctype="multipart/form-data" class="need-validation" novalidate>
                <input type="hidden" name="adminid" value="<%= data.admin_id %>">

                <div class="row g-4">
                    <!-- Left Column: Core Form Details (8 Columns) -->
                    <div class="col-lg-8">
                        
                        <!-- Section 1: General & Manager Credentials -->
                        <div class="card border-0 shadow-sm rounded-3 mb-4" style="height: auto;">
                            <div class="card-header border-bottom py-3 px-4">
                                <h5 class="card-title mb-0 fw-bold d-flex align-items-center text-dark">
                                    <i class="fa fa-id-card text-primary me-2"></i><%= language.APPLICATION_DETAILS || 'Store & Manager Credentials' %>
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    <!-- Store Name -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            <%= language.Application_Name || 'Store Name' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-store"></i></span>
                                            <input type="text" class="form-control" name="name" value="<%= data.name %>" placeholder="Enter Store Name" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                    </div>

                                    <!-- Phone Number -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            <%= language.Phone_Number || 'Contact Phone Number' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-phone"></i></span>
                                            <input type="tel" class="form-control" name="number" value="<%= data.mobile_number %>" placeholder="Enter Phone Number" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                    </div>

                                    <!-- Username -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            <%= language.Username || 'Manager Username' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-user"></i></span>
                                            <input type="text" class="form-control" name="username" value="<%= data.username %>" placeholder="Enter Username" <%= update ? 'required' : 'readonly' %> autocomplete="off">
                                        </div>
                                    </div>

                                    <!-- Password with Toggle -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            <%= language.Password || 'Update Password' %>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-lock"></i></span>
                                            <input type="password" class="form-control" id="store_password" name="password" value="" placeholder="<%= update ? 'Leave blank to keep current password' : '••••••••' %>" <%= update ? '' : 'disabled' %> autocomplete="new-password">
                                            <% if (update) { %>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="togglePasswordVisibility('store_password', this)" title="Toggle visibility">
                                                <i class="fa fa-eye"></i>
                                            </button>
                                            <% } %>
                                        </div>
                                        <% if (update) { %>
                                        <small class="text-muted fs-12">Leave blank unless you wish to change the store manager's password.</small>
                                        <% } %>
                                    </div>

                                    <!-- Default Walk-in Customer -->
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">
                                            <%= language.Walk_In_Customer || 'Default Walk-In Customer Label' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-walking"></i></span>
                                            <input type="text" class="form-control" name="walkincustome" value="<%= data.customer_name %>" placeholder="Enter Walk in Customer name" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                        <small class="text-muted fs-12">Default walk-in customer account automatically loaded for rapid POS counter orders.</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 2: Physical Location & Address -->
                        <div class="card border-0 shadow-sm rounded-3 mb-4" style="height: auto;">
                            <div class="card-header border-bottom py-3 px-4">
                                <h5 class="card-title mb-0 fw-bold d-flex align-items-center text-dark">
                                    <i class="fa fa-map-marked-alt text-info me-2"></i><%= language.FIRM_ADDRESS || 'Location & Tax Information' %>
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    <!-- Store Email -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            <%= language.Store_Email || 'Store Official Email' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-envelope"></i></span>
                                            <input type="email" class="form-control" name="store_email" value="<%= data.store_email %>" placeholder="e.g. branch@icleaners.com" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                    </div>

                                    <!-- Store Tax / VAT Number -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            <%= language.Store_Tax_Number || 'Tax / VAT Registration No.' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-receipt"></i></span>
                                            <input type="text" class="form-control" name="tax_number" value="<%= data.store_tax_number %>" placeholder="e.g. TAX-90210-4" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                    </div>

                                    <!-- Country -->
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">
                                            <%= language.Country || 'Country' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-globe"></i></span>
                                            <input type="text" class="form-control" name="country" value="<%= data.country %>" placeholder="Enter Country Name" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                    </div>

                                    <!-- State / Province -->
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">
                                            <%= language.State || 'State / Province' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-map"></i></span>
                                            <input type="text" class="form-control" name="state" value="<%= data.state %>" placeholder="Enter State Name" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                    </div>

                                    <!-- City -->
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">
                                            <%= language.City || 'City' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-city"></i></span>
                                            <input type="text" class="form-control" name="city" value="<%= data.city %>" placeholder="Enter City Name" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                    </div>

                                    <!-- District / Area -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            <%= language.District || 'District / Neighborhood' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-compass"></i></span>
                                            <input type="text" class="form-control" name="district" value="<%= data.district %>" placeholder="Enter District Name" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                    </div>

                                    <!-- Zip Code -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            <%= language.Zip_Code || 'Postal / Zip Code' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-mail-bulk"></i></span>
                                            <input type="text" class="form-control" name="zip_code" value="<%= data.zipcode %>" placeholder="Enter Zip Code" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                    </div>

                                    <!-- Street Address -->
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">
                                            <%= language.Address || 'Complete Physical Address' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-map-pin"></i></span>
                                            <input type="text" class="form-control" name="address" value="<%= data.address %>" placeholder="Enter Complete Physical Address" <%= update ? 'required' : 'readonly' %>>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section 3: Financial & Commission Rules -->
                        <div class="card border-0 shadow-sm rounded-3 mb-4" style="height: auto;">
                            <div class="card-header border-bottom py-3 px-4">
                                <h5 class="card-title mb-0 fw-bold d-flex align-items-center text-dark">
                                    <i class="fa fa-percentage text-success me-2"></i><%= language.FINANCE_SETTINGS || 'Financial & Tax Parameters' %>
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    <!-- Commission (Read-only for Store Managers) -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            <%= language.Shop_Commission || 'Shop Franchise Commission' %>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-hand-holding-usd"></i></span>
                                            <input type="number" step="0.01" class="form-control bg-light" name="commission" value="<%= data.shop_commission %>" readonly>
                                            <span class="input-group-text bg-light fw-bold">%</span>
                                        </div>
                                        <small class="text-muted fs-12">Franchise royalty rate configured and maintained by Master Administration.</small>
                                    </div>

                                    <!-- Tax Rate -->
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">
                                            <%= language.Tax_Percentage || 'Local Sales Tax / VAT' %> <span class="text-danger">*</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-muted"><i class="fa fa-file-invoice-dollar"></i></span>
                                            <input type="number" step="0.01" class="form-control" name="taxpercent" value="<%= data.tax_percent %>" placeholder="e.g. 9.50" <%= update ? 'required' : 'readonly' %>>
                                            <span class="input-group-text bg-light fw-bold">%</span>
                                        </div>
                                        <small class="text-muted fs-12">Applicable sales tax / VAT applied to POS receipts and customer invoices.</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Right Column: Branding & Publishing Actions (4 Columns) -->
                    <div class="col-lg-4">

                        <!-- Section 4: Store Logo Upload & Preview -->
                        <div class="card border-0 shadow-sm rounded-3 mb-4" style="height: auto;">
                            <div class="card-header border-bottom py-3 px-4">
                                <h5 class="card-title mb-0 fw-bold d-flex align-items-center text-dark">
                                    <i class="fa fa-image text-warning me-2"></i><%= language.Store_Logo || 'Store Branding' %>
                                </h5>
                            </div>
                            <div class="card-body p-4 text-center">
                                
                                <!-- Logo Preview Box -->
                                <div class="p-3 mb-3 border border-2 border-dashed rounded-3 d-flex flex-column align-items-center justify-content-center" style="min-height: 190px;">
                                    <% if (data.logo && data.logo !== 'default.png') { %>
                                        <div id="placeholder-box" class="d-none py-3 text-center">
                                            <div class="d-inline-flex p-3 rounded-circle bg-white shadow-sm mb-2">
                                                <i class="fa fa-store fa-2x text-primary opacity-75"></i>
                                            </div>
                                            <div class="fw-semibold text-dark fs-14">No Logo Selected</div>
                                        </div>
                                        <img id="file-preview" class="rounded-3 shadow-sm border mw-100" style="max-height: 160px; object-fit: contain;" src="/uploads/<%= data.logo %>" alt="Current Store Logo">
                                    <% } else { %>
                                        <div id="placeholder-box" class="py-3 text-center">
                                            <div class="d-inline-flex p-3 rounded-circle bg-white shadow-sm mb-2">
                                                <i class="fa fa-store fa-2x text-primary opacity-75"></i>
                                            </div>
                                            <div class="fw-semibold text-dark fs-14">Default Store Logo</div>
                                            <div class="text-muted fs-12">Upload a custom logo to replace default</div>
                                        </div>
                                        <img id="file-preview" class="d-none rounded-3 shadow-sm border mw-100" style="max-height: 160px; object-fit: contain;" alt="Store Logo Preview">
                                    <% } %>
                                </div>

                                <!-- Hidden Native Input (Optional on Edit) -->
                                <input class="d-none" type="file" id="file-1" name="logo" accept="image/*" onchange="showPreview(event)" <%= update ? '' : 'disabled' %>>

                                <!-- Button Trigger -->
                                <% if (update) { %>
                                <div class="d-grid gap-2">
                                    <label class="btn btn-outline-primary fw-semibold py-2" for="file-1">
                                        <i class="fa fa-cloud-upload-alt me-1"></i> <%= language.Upload_App_Logo || 'Change Logo File' %>
                                    </label>
                                    <button type="button" id="btn-reset-preview" class="btn btn-outline-danger btn-sm d-none" onclick="resetPreview()">
                                        <i class="fa fa-undo me-1"></i> Revert to Current Logo
                                    </button>
                                </div>
                                <div class="text-muted mt-3 fs-12 text-center">
                                    Supported: <span class="fw-semibold">PNG, JPG, WEBP</span><br>
                                    Leave unchanged to keep current store logo
                                </div>
                                <% } else { %>
                                <div class="text-muted fs-12 text-center">
                                    Store branding is locked in view-only mode.
                                </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Section 5: Store Overview & Save Actions -->
                        <div class="card border-0 shadow-sm rounded-3 mb-4" style="height: auto;">
                            <div class="card-header border-bottom py-3 px-4">
                                <h5 class="card-title mb-0 fw-bold d-flex align-items-center text-dark">
                                    <i class="fa fa-info-circle text-primary me-2"></i><%= language.Store_Summary || 'Store Overview' %>
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                
                                <div class="d-flex align-items-center justify-content-between p-3 border rounded-3 mb-3">
                                    <div>
                                        <span class="text-muted small d-block">Store Identifier</span>
                                        <strong class="text-dark">Store #<%= data.id %></strong>
                                    </div>
                                    <div>
                                        <% if (data.status == 1) { %>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                                                <i class="fa fa-check-circle me-1"></i> <%= language.Active_Store || 'Active' %>
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold">
                                                <i class="fa fa-ban me-1"></i> <%= language.Inactive || 'Inactive' %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="small text-muted mb-4">
                                    <i class="fa fa-shield-alt text-primary me-1"></i>
                                    <span>Changes saved here take effect immediately across your store POS, thermal receipts, and wash tags.</span>
                                </div>

                                <hr class="my-3">

                                <!-- Submit & Action Buttons -->
                                <div class="d-grid gap-2">
                                    <% if (update) { %>
                                    <button type="submit" class="btn btn-primary py-2 fw-semibold shadow-sm" id="btn_save_store">
                                        <i class="fa fa-save me-2"></i><%= language.Save_Data || 'Save Store Settings' %>
                                    </button>
                                    <% } %>
                                    <a href="/index" class="btn btn-outline-secondary py-2">
                                        <i class="fa fa-arrow-left me-1"></i> <%= language.Back_to_Dashboard || 'Back to Dashboard' %>
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </form>

            <% }) %>

        </div>
    </div>
    <!--********** Content body end **********-->

    <!--**********************************
        Footer start
    ***********************************-->
    <%- include('templet/footer')-%>
    <!--**********************************
        Footer end
    ***********************************-->

    </div>
    <!--********** Main wrapper end **********-->

    <%- include('templet/script')-%>

    <script>
        // Password visibility toggle helper
        function togglePasswordVisibility(fieldId, btn) {
            const input = document.getElementById(fieldId);
            const icon = btn.querySelector('i');
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        // Live image preview
        const initialLogoSrc = "<%= (storedata && storedata.length > 0 && storedata[0].logo && storedata[0].logo !== 'default.png') ? ('/uploads/' + storedata[0].logo) : '' %>";

        function showPreview(event) {
            const file = event.target.files && event.target.files[0];
            if (file) {
                const preview = document.getElementById('file-preview');
                const placeholder = document.getElementById('placeholder-box');
                const resetBtn = document.getElementById('btn-reset-preview');

                preview.src = URL.createObjectURL(file);
                preview.classList.remove('d-none');
                if (placeholder) placeholder.classList.add('d-none');
                if (resetBtn) resetBtn.classList.remove('d-none');
            }
        }

        // Reset image preview back to current logo
        function resetPreview() {
            const preview = document.getElementById('file-preview');
            const placeholder = document.getElementById('placeholder-box');
            const resetBtn = document.getElementById('btn-reset-preview');
            const fileInput = document.getElementById('file-1');

            if (fileInput) fileInput.value = '';

            if (initialLogoSrc) {
                preview.src = initialLogoSrc;
                preview.classList.remove('d-none');
                if (placeholder) placeholder.classList.add('d-none');
            } else {
                preview.src = '';
                preview.classList.add('d-none');
                if (placeholder) placeholder.classList.remove('d-none');
            }

            if (resetBtn) resetBtn.classList.add('d-none');
        }
    </script>
</body>

</html>