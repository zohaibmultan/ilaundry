<!DOCTYPE html>
<html lang="en" class="h-100">


<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>



</head>

<body>
        <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-body p-4">

                                <!----- shop form ----->

                                <div class="shop_form">
                                    <% storedata.forEach(function(data){ %>
                                        <% if (!update) { %>
                                            <div class="alert alert-info py-2 px-3 mb-4 d-flex align-items-center">
                                                <i class="fas fa-info-circle me-2"></i>
                                                <span>You are viewing details of your assigned store: <strong><%= data.name %></strong> (View Only).</span>
                                            </div>
                                        <% } %>
                                        <form class="row g-4 align-items-center"
                                            action="/tool/updatesetting/<%=data.id %>" method="post"
                                            enctype="multipart/form-data">
                                            <div>
                                                <%= language.APPLICATION_DETAILS %>
                                            </div>

                                            <hr>
                                            <div class="row">

                                                <div class="col-xl-9">
                                                    <div class="row mt-3">
                                                        <div class="col-md-6">
                                                            <label class="form-label">
                                                                <%= language.Application_Name %> <span
                                                                        class="text-danger">*</span>
                                                            </label>
                                                            <input type="text" placeholder="Enter Application Name"
                                                                class="form-control" name="name"
                                                                value="<%=data.name %>" <%= update ? '' : 'readonly' %>>
                                                            <input type="hidden" name="adminid"
                                                                value="<%=data.admin_id %>">
                                                        </div>

                                                        <div class="col-md-6">
                                                            <label class="form-label">
                                                                <%= language.Phone_Number %> <span
                                                                        class="text-danger">*</span>
                                                            </label>
                                                            <input type="text" class="form-control"
                                                                placeholder="Enter Phone Number" name="number"
                                                                value="<%=data.mobile_number %>" <%= update ? '' : 'readonly' %>>
                                                        </div>
                                                    </div>

                                                    <div class="row mt-4">
                                                        <div class="col-md-6">
                                                            <label class="form-label">
                                                                <%= language.Username %> <span
                                                                        class="text-danger">*</span>
                                                            </label>
                                                            <input type="text" class="form-control"
                                                                placeholder="Enter Username" name="username"
                                                                value="<%= data.username %>" <%= update ? '' : 'readonly' %>>
                                                        </div>

                                                        <% if (update) { %>
                                                        <div class="col-md-6">
                                                            <label class="form-label">
                                                                <%= language.Password %> <span
                                                                        class="text-danger">*</span>
                                                            </label>
                                                            <input type="text" class="form-control"
                                                                placeholder="Update Password" name="password"
                                                                value="">
                                                        </div>
                                                        <% } %>
                                                    </div>

                                                    <div class="row mt-4">
                                                        <div class="col-md-6">
                                                            <label class="form-label">
                                                                Walk in Customer
                                                                <span class="text-danger">*</span>
                                                            </label>
                                                            <input type="text" class="form-control"
                                                                placeholder="Enter  Walk in Customer"
                                                                name="walkincustome" value="<%= data.customer_name %>" <%= update ? '' : 'readonly' %>>
                                                        </div>
                                                    </div>


                                                </div>

                                                <div class="col-xl-3">
                                                    <div class="center">
                                                        <div class="form-input">
                                                            <div class="preview m-3 mt-0">
                                                                <img id="file-preview" width="180"
                                                                    src="../uploads/<%=data.logo %>" alt="image">
                                                            </div>

                                                            <% if (update) { %>
                                                            <input class="d-none" type="file" id="file-1" name="logo"
                                                                accept="image/*" onchange="showPreview(event);">

                                                            <label class="btn btn-primary w-100" for="file-1">
                                                                <%= language.Upload_App_Logo %>
                                                            </label>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </div>




                                            </div>

                                            <hr>

                                            <div>
                                                <%= language.FINANCE_SETTINGS %>
                                            </div>

                                            <hr>

                                            <div class="col-6 col-md-4">
                                                <label class="form-label">
                                                    <%= language.Shop_Commission %>
                                                </label>
                                                <input type="number" class="form-control" placeholder="Shop Commission"
                                                    name="commission" value="<%=data.shop_commission %>" step="0.01"
                                                    readonly>
                                            </div>

                                            <div class="col-6 col-md-4">
                                                <label class="form-label">
                                                    <%= language.Tax_Percentage %>
                                                </label>
                                                <input type="text" class="form-control" name="taxpercent"
                                                    value="<%=data.tax_percent %>" <%= update ? '' : 'readonly' %>>
                                            </div>

                                            <hr>

                                            <div>
                                                <%= language.FIRM_ADDRESS %>
                                            </div>

                                            <hr>

                                            <div class="col-6 col-md-3">
                                                <label class="form-label">
                                                    <%= language.Country %>
                                                </label>
                                                <input type="text" class="form-control" placeholder="Enter Country Name"
                                                    name="country" value="<%=data.country %>" <%= update ? '' : 'readonly' %>>
                                            </div>

                                            <div class="col-6 col-md-3">
                                                <label class="form-label">
                                                    <%= language.State %>
                                                </label>
                                                <input type="text" class="form-control" placeholder="Enter State Name"
                                                    name="state" value="<%=data.state %>" <%= update ? '' : 'readonly' %>>
                                            </div>

                                            <div class="col-6 col-md-3">
                                                <label class="form-label">
                                                    <%= language.City %>
                                                </label>
                                                <input type="text" class="form-control" placeholder="Enter City Name"
                                                    name="city" value="<%=data.city %>" <%= update ? '' : 'readonly' %>>
                                            </div>

                                            <div class="col-6 col-md-3">
                                                <label class="form-label">
                                                    <%= language.District %>
                                                </label>
                                                <input type="text" class="form-control"
                                                    placeholder="Enter District Name" name="district"
                                                    value="<%=data.district %>" <%= update ? '' : 'readonly' %>>
                                            </div>

                                            <div class="col-6 col-md-3">
                                                <label class="form-label">
                                                    <%= language.Zip_Code %>
                                                </label>
                                                <input type="text" class="form-control" placeholder="Enter Zip Code"
                                                    name="zip_code" value="<%=data.zipcode %>" <%= update ? '' : 'readonly' %>>
                                            </div>

                                            <div class="col-6 col-md-3">
                                                <label class="form-label">
                                                    <%= language.Store_Email %>
                                                </label>
                                                <input type="email" class="form-control" placeholder="Enter Store Email"
                                                    name="store_email" value="<%=data.store_email %>" <%= update ? '' : 'readonly' %>>
                                            </div>

                                            <div class="col-6 col-md-3">
                                                <label class="form-label">
                                                    <%= language.Store_Tax_Number %>
                                                </label>
                                                <input type="text" class="form-control"
                                                    placeholder="Enter Store Tax Number" name="tax_number"
                                                    value="<%=data.store_tax_number %>" <%= update ? '' : 'readonly' %>>
                                            </div>

                                            <div class="col-12 mb-3">
                                                <label for="inputAddress" class="form-label">
                                                    <%= language.Address %>
                                                </label>
                                                <input type="text" class="form-control" placeholder="Enter Address"
                                                    name="address" value="<%=data.address %>" <%= update ? '' : 'readonly' %>>
                                            </div>

                                            <hr>






                                            <button type="submit"
                                                class="btn btn-primary mt-5 <%= update ? '': 'd-none' %>">
                                                <i class="fa fa-save me-2"></i><%= language.Save_Data %>
                                            </button>

                                        </form>
                                        <% }) %>

                                </div>

                                <!----- end shop form ----->
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <!--********** Content body end **********-->

        </div>
        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

            <!--**********************************
            Footer end
        ***********************************-->

            </div>

            <!--********** Main wrapper end **********-->
            <%- include('templet/script')-%>

</body>


</html>