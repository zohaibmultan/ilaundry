<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Receipt - <%= order.order_id %>
  </title>
  <style>
    @page {
      size: 80mm auto;
      margin: 0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: #eef1f5;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 11px;
      line-height: 1.25;
      color: #000;
      padding: 10px 0;
    }

    .receipt-container {
      width: 76mm;
      margin: 0 auto;
      background: #fff;
      padding: 4mm 3mm;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    @media print {
      body {
        background: transparent;
        padding: 0;
      }

      .receipt-container {
        width: 100%;
        margin: 0;
        padding: 2mm 1mm;
        box-shadow: none;
      }

      .no-print {
        display: none !important;
      }
    }

    .text-center {
      text-align: center;
    }

    .text-start {
      text-align: left;
    }

    .text-end {
      text-align: right;
    }

    .fw-bold {
      font-weight: 700;
    }

    .text-muted {
      color: #555;
    }

    /* Dividers */
    .border-dashed {
      border: none;
      border-top: 1px dashed #000;
      margin: 3px 0;
    }

    .border-solid {
      border: none;
      border-top: 1px solid #000;
      margin: 3px 0;
    }

    .border-double {
      border: none;
      border-top: 2px solid #000;
      margin: 3px 0;
    }

    /* Store Header */
    .store-header {
      text-align: center;
      margin-bottom: 4px;
    }

    .store-logo {
      max-height: 32px;
      max-width: 70%;
      margin: 0 auto 2px;
      display: block;
      object-fit: contain;
    }

    .store-name {
      font-size: 14px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      line-height: 1.15;
    }

    .store-info {
      font-size: 10px;
      line-height: 1.2;
      color: #222;
      margin-top: 2px;
    }

    /* Invoice Title Banner (Crisp Outline, Zero Solid Black) */
    .invoice-badge {
      text-align: center;
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 2px 0;
      border-top: 1px solid #000;
      border-bottom: 1px solid #000;
      margin: 3px 0;
    }

    /* Metadata Grid */
    .meta-table {
      width: 100%;
      font-size: 10.5px;
      margin-bottom: 2px;
    }

    .meta-table td {
      padding: 1px 0;
      vertical-align: top;
    }

    /* Items Table */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11px;
      margin-top: 2px;
    }

    .items-table th {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 2px 0;
      border-bottom: 1px dashed #000;
      letter-spacing: 0.3px;
    }

    .items-table td {
      padding: 2px 0;
      vertical-align: top;
    }

    .item-name {
      font-weight: 700;
      font-size: 11px;
      line-height: 1.15;
    }

    .item-subtext {
      font-size: 9.5px;
      color: #333;
      display: block;
    }

    /* Financial Summary */
    .summary-table {
      width: 100%;
      font-size: 10.5px;
      margin-top: 2px;
    }

    .summary-table td {
      padding: 1px 0;
    }

    .grand-total-row td {
      font-size: 12.5px;
      font-weight: 800;
      padding: 2px 0;
    }

    /* Footer */
    .receipt-footer {
      text-align: center;
      font-size: 9.5px;
      margin-top: 4px;
      line-height: 1.2;
    }

    /* Invoice Receipt Barcode */
    .receipt-barcode-wrap {
      margin: 6px auto 4px auto;
      text-align: center;
      padding: 0 4px;
    }

    .receipt-barcode-svg {
      max-width: 90% !important;
      height: 38px !important;
      margin: 0 auto;
      display: block;
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
</head>

<body>

  <div class="receipt-container">
    <!-- Store Header -->
    <div class="store-header">
      <% 
        let invoiceLogo = '';
        if (shope && shope.logo && shope.logo.trim() !== '') {
          invoiceLogo = shope.logo.trim();
        } else if (accessdata && accessdata.masterstore && accessdata.masterstore.app_logo) {
          invoiceLogo = accessdata.masterstore.app_logo;
        } else if (accessdata && accessdata.masterstore && accessdata.masterstore.app_favicon) {
          invoiceLogo = accessdata.masterstore.app_favicon;
        }
      %>
      <% if (invoiceLogo) { %>
        <img src="/uploads/<%= invoiceLogo %>" class="store-logo" alt="Store Logo" />
      <% } %>
          <div class="store-name">
            <%= (shope && shope.name) ? shope.name : (accessdata && accessdata.masterstore ?
              accessdata.masterstore.app_name : '' ) %>
          </div>
          <div class="store-info">
            <% if (shope && shope.address) { %>
              <%= shope.address %>
                <% if (shope.city) { %>, <%= shope.city %>
                    <% } %><br />
                      <% } %>
                        <% if (shope && shope.mobile_number) { %>
                          Tel: <%= shope.mobile_number %>
                            <% if (shope.store_email) { %> | <%= shope.store_email %>
                                <% } %>
                                  <% } %>
          </div>
    </div>

    <!-- Invoice Banner (Crisp outline, saves 100% black ink) -->
    <div class="invoice-badge">Order Receipt</div>

    <!-- Order & Customer Meta (Tight 2-column key-value) -->
    <table class="meta-table">
      <tr>
        <td class="text-start"><b>Order #:</b>
          <%= order.order_id %>
        </td>
        <td class="text-end"><b>Date:</b>
          <%= oate %>
        </td>
      </tr>
      <tr>
        <td class="text-start"><b>Delivery:</b>
          <%= ddate %>
        </td>
        <td class="text-end"><b>Status:</b>
          <%= order.order_status_name %>
        </td>
      </tr>
      <% let custObj=(Array.isArray(customer) && customer.length> 0) ? customer[0] : (customer || {});
        let custName = custObj.name || '';
        let custNumber = custObj.number || '';
        %>
        <% if (custName) { %>
          <tr>
            <td class="text-start" colspan="2">
              <b>Customer:</b>
              <%= custName %>
                <% if (custNumber) { %> &bull; <%= custNumber %>
                    <% } %>
            </td>
          </tr>
          <% } %>
    </table>

    <hr class="border-dashed" />

    <!-- Items Table -->
    <table class="items-table">
      <thead>
        <tr>
          <th class="text-start" style="width: 48%;">Item</th>
          <th class="text-end" style="width: 18%;">Rate</th>
          <th class="text-center" style="width: 12%;">Qty</th>
          <th class="text-end" style="width: 22%;">Total</th>
        </tr>
      </thead>
      <tbody>
        <% if (cartservice && cartservice.length> 0) { %>
          <% cartservice.forEach(function(item) { %>
            <tr>
              <td class="text-start">
                <span class="item-name">
                  <%= item.service_name %><% if (item.no_of_items && parseInt(item.no_of_items) > 1) { %> (<%= item.no_of_items %> Pcs)<% } %>
                </span>
                <% if (item.service_type_name) { %>
                  <span class="item-subtext">[<%= item.service_type_name %>]</span>
                  <% } %>
              </td>
              <td class="text-end">
                <% if (accessdata.plac=="1" ) { %>
                  <%= parseFloat(item.service_type_price).toFixed(2) %>
                    <%= accessdata.symbol %>
                      <% } else { %>
                        <%= accessdata.symbol %>
                          <%= parseFloat(item.service_type_price).toFixed(2) %>
                            <% } %>
              </td>
              <td class="text-center">
                <%= item.service_quntity %>
              </td>
              <td class="text-end fw-bold">
                <% let lineTotal=(parseFloat(item.service_type_price) * parseFloat(item.service_quntity)).toFixed(2); %>
                  <% if (accessdata.plac=="1" ) { %>
                    <%= lineTotal %>
                      <%= accessdata.symbol %>
                        <% } else { %>
                          <%= accessdata.symbol %>
                            <%= lineTotal %>
                              <% } %>
              </td>
            </tr>
            <% }) %>
              <% } %>

                <% if (addonslist && addonslist.length> 0) { %>
                  <% addonslist.forEach(function(addon) { %>
                    <tr>
                      <td class="text-start" colspan="2">
                        <span class="item-name">+ <%= addon.name %></span>
                        <span class="item-subtext">[Addon]</span>
                      </td>
                      <td class="text-center">1</td>
                      <td class="text-end fw-bold">
                        <% if (accessdata.plac=="1" ) { %>
                          <%= parseFloat(addon.price).toFixed(2) %>
                            <%= accessdata.symbol %>
                              <% } else { %>
                                <%= accessdata.symbol %>
                                  <%= parseFloat(addon.price).toFixed(2) %>
                                    <% } %>
                      </td>
                    </tr>
                    <% }) %>
                      <% } %>
      </tbody>
    </table>

    <hr class="border-dashed" />

    <!-- Financial Summary (Skip 0-value rows to save paper) -->
    <%
      let totalOrderQty = 0;
      let totalGarmentPcs = 0;
      if (cartservice && cartservice.length > 0) {
        cartservice.forEach(function(item) {
          const q = parseInt(item.service_quntity, 10) || 0;
          const p = parseInt(item.no_of_items, 10) || 1;
          totalOrderQty += q;
          totalGarmentPcs += (q * p);
        });
      }
    %>
    <table class="summary-table">
      <% if (totalOrderQty > 0) { %>
      <tr>
        <td class="text-start">Total Qty:</td>
        <td class="text-end fw-bold">
          <%= totalOrderQty %><% if (totalGarmentPcs > totalOrderQty) { %> (<%= totalGarmentPcs %> Pcs)<% } %>
        </td>
      </tr>
      <% } %>
      <tr>
        <td class="text-start">Sub Total:</td>
        <td class="text-end fw-bold">
          <% if (accessdata.plac=="1" ) { %>
            <%= parseFloat(order.sub_total).toFixed(2) %>
              <%= accessdata.symbol %>
                <% } else { %>
                  <%= accessdata.symbol %>
                    <%= parseFloat(order.sub_total).toFixed(2) %>
                      <% } %>
        </td>
      </tr>

      <% if (Number(order.addon_price)> 0) { %>
        <tr>
          <td class="text-start">Addon Total:</td>
          <td class="text-end">
            <% if (accessdata.plac=="1" ) { %>
              <%= parseFloat(order.addon_price).toFixed(2) %>
                <%= accessdata.symbol %>
                  <% } else { %>
                    <%= accessdata.symbol %>
                      <%= parseFloat(order.addon_price).toFixed(2) %>
                        <% } %>
          </td>
        </tr>
        <% } %>

          <% if (Number(order.extra_discount)> 0) { %>
            <tr>
              <td class="text-start">Discount:</td>
              <td class="text-end">
                - <% if (accessdata.plac=="1" ) { %>
                  <%= parseFloat(order.extra_discount).toFixed(2) %>
                    <%= accessdata.symbol %>
                      <% } else { %>
                        <%= accessdata.symbol %>
                          <%= parseFloat(order.extra_discount).toFixed(2) %>
                            <% } %>
              </td>
            </tr>
            <% } %>

              <% if (Number(order.coupon_discount)> 0) { %>
                <tr>
                  <td class="text-start">Coupon Discount:</td>
                  <td class="text-end">
                    - <% if (accessdata.plac=="1" ) { %>
                      <%= parseFloat(order.coupon_discount).toFixed(2) %>
                        <%= accessdata.symbol %>
                          <% } else { %>
                            <%= accessdata.symbol %>
                              <%= parseFloat(order.coupon_discount).toFixed(2) %>
                                <% } %>
                  </td>
                </tr>
                <% } %>

                  <% if (Number(order.tax_amount)> 0) { %>
                    <tr>
                      <td class="text-start">Tax (<%= parseFloat(order.tax).toFixed(0) %>%):</td>
                      <td class="text-end">
                        <% if (accessdata.plac=="1" ) { %>
                          <%= parseFloat(order.tax_amount).toFixed(2) %>
                            <%= accessdata.symbol %>
                              <% } else { %>
                                <%= accessdata.symbol %>
                                  <%= parseFloat(order.tax_amount).toFixed(2) %>
                                    <% } %>
                      </td>
                    </tr>
                    <% } %>

                      <tr class="grand-total-row">
                        <td class="text-start" style="border-top: 1px solid #000; padding-top: 2px;">Gross Total:</td>
                        <td class="text-end" style="border-top: 1px solid #000; padding-top: 2px;">
                          <% if (accessdata.plac=="1" ) { %>
                            <%= parseFloat(order.gross_total).toFixed(2) %>
                              <%= accessdata.symbol %>
                                <% } else { %>
                                  <%= accessdata.symbol %>
                                    <%= parseFloat(order.gross_total).toFixed(2) %>
                                      <% } %>
                        </td>
                      </tr>

                      <tr>
                        <td class="text-start">Paid Amount:</td>
                        <td class="text-end fw-bold">
                          <% if (accessdata.plac=="1" ) { %>
                            <%= parseFloat(order.paid_amount).toFixed(2) %>
                              <%= accessdata.symbol %>
                                <% } else { %>
                                  <%= accessdata.symbol %>
                                    <%= parseFloat(order.paid_amount).toFixed(2) %>
                                      <% } %>
                        </td>
                      </tr>

                      <% if (Number(order.balance_amount) !=0) { %>
                        <tr>
                          <td class="text-start"><b>Due / Balance:</b></td>
                          <td class="text-end fw-bold">
                            <% if (accessdata.plac=="1" ) { %>
                              <%= parseFloat(order.balance_amount).toFixed(2) %>
                                <%= accessdata.symbol %>
                                  <% } else { %>
                                    <%= accessdata.symbol %>
                                      <%= parseFloat(order.balance_amount).toFixed(2) %>
                                        <% } %>
                          </td>
                        </tr>
                        <% } %>

                          <% if (order.reference_number && order.reference_number.trim()) { %>
                            <tr>
                              <td class="text-start">Ref / Txn No:</td>
                              <td class="text-end fw-bold">
                                <%= order.reference_number %>
                              </td>
                            </tr>
                            <% } %>
    </table>

    <hr class="border-dashed" />

    <!-- Notes & Footer -->
    <% if (order.note && order.note.trim()) { %>
      <div style="font-size: 10px; font-style: italic; margin: 2px 0;">
        <b>Note:</b>
        <%= order.note %>
      </div>
      <% } %>

    <% 
      const isInvoiceBarcodeActive = (shope && shope.invoice_barcode_enabled !== undefined && shope.invoice_barcode_enabled !== null) 
        ? (shope.invoice_barcode_enabled != 0) 
        : ((master && master.invoice_barcode_enabled !== undefined && master.invoice_barcode_enabled !== null) ? (master.invoice_barcode_enabled != 0) : true);
    %>
    <% if (isInvoiceBarcodeActive) { %>
      <div class="receipt-barcode-wrap" id="invoiceBarcodeWrap">
        <svg id="invoice_barcode_svg" class="receipt-barcode-svg"></svg>
      </div>
    <% } %>

    <div class="receipt-footer">
      <div>*** Thank You For Your Business! ***</div>
      <div>Powered By <b>
          <%= (master && master.app_name) ? master.app_name : '' %>
        </b></div>
    </div>
  </div>

  <script src="/js/pos-print-client.js"></script>
  <script type="text/javascript">
    "use strict";
    window.onload = async function () {
      const isBarcodeActive = <%= isInvoiceBarcodeActive ? 'true' : 'false' %>;
      if (isBarcodeActive && typeof JsBarcode === "function") {
        try {
          JsBarcode("#invoice_barcode_svg", "<%= order.order_id || '0000' %>", {
            format: "CODE128",
            width: 1.5,
            height: 36,
            displayValue: true,
            fontSize: 11,
            text: "<%= order.order_id || '' %>",
            margin: 2
          });
        } catch (e) {
          console.warn("JsBarcode rendering error:", e);
        }
      }

      const serverUrl = "<%= (shope && shope.printing_server_url) ? shope.printing_server_url : ((master && master.printing_server_url) ? master.printing_server_url : 'http://127.0.0.1:4321') %>";
      const silentEnabled = <%= ((shope && shope.silent_print_enabled !== undefined && shope.silent_print_enabled !== null) ? (shope.silent_print_enabled != 0) : ((master && master.silent_print_enabled === 0) ? false : true)) ? 'true' : 'false' %>;
      const targetPrinter = "<%= (shope && shope.invoice_printer_name) ? shope.invoice_printer_name : ((master && master.invoice_printer_name) ? master.invoice_printer_name : '') %>";
      const format = <%= (shope && shope.invoice_printer_format !== undefined && shope.invoice_printer_format !== null) ? shope.invoice_printer_format : ((master && master.invoice_printer_format !== undefined) ? master.invoice_printer_format : 1) %>;
      const widthMm = format === 2 ? 58 : (format === 0 ? null : 80);
      const autoCut = <%= ((shope && shope.printer_auto_cut !== undefined && shope.printer_auto_cut !== null) ? (shope.printer_auto_cut != 0) : ((master && master.printer_auto_cut === 0) ? false : true)) ? 'true' : 'false' %>;
      const openDrawer = <%= ((shope && shope.printer_open_cash_drawer !== undefined && shope.printer_open_cash_drawer !== null) ? (shope.printer_open_cash_drawer == 1) : ((master && master.printer_open_cash_drawer == 1) ? true : false)) ? 'true' : 'false' %>;
      const copies = <%= (shope && shope.printer_copies) ? shope.printer_copies : ((master && master.printer_copies) ? master.printer_copies : 1) %>;

      function fallbackNativePrint() {
        window.onafterprint = function () {
          if (window.history.length > 1) {
            window.history.back();
          } else {
            window.location.href = '/order/list';
          }
        };
        window.print();
      }

      if (silentEnabled) {
        try {
          const client = new POSPrintClient({ baseUrl: serverUrl, timeout: 5000 });
          const isOnline = await client.isAvailable();
          if (isOnline) {
            const receiptEl = document.querySelector('.receipt-container');
            const styleEl = document.querySelector('style');
            if (receiptEl) {
              const fullHtml = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>${styleEl ? styleEl.innerHTML : ''}</style></head><body>${receiptEl.outerHTML}</body></html>`;
              const res = await client.printHTML(fullHtml, {
                printerId: targetPrinter || null,
                widthMm: widthMm || 80,
                options: {
                  copies: copies,
                  cut: autoCut,
                  openCashDrawer: openDrawer
                }
              });
              if (res && res.success) {
                // Printed silently! Return to order view
                if (window.history.length > 1) {
                  window.history.back();
                } else {
                  window.location.href = '/order/list';
                }
                return;
              }
              console.warn("Silent print returned error:", res);
            }
          } else {
            console.warn("POS Printing Server not online at " + serverUrl + ". Using native browser print dialog.");
          }
        } catch (err) {
          console.warn("Silent print exception, falling back to native browser print:", err);
        }
      }

      // Automatic fallback to native print window
      fallbackNativePrint();
    };
  </script>
</body>

</html>