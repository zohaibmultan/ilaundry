<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>
    <style>
        /* KPI Cards & Stacking */
        .daily-kpi-card {
            border-radius: 12px;
            transition: all 0.2s ease;
            position: relative;
            overflow: hidden;
        }
        .daily-kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
        }
        [data-theme-version="dark"] .daily-kpi-card {
            background: rgba(18, 26, 44, 0.78) !important;
            border-color: rgba(255, 255, 255, 0.08) !important;
        }
        [data-theme-version="dark"] .daily-val-text {
            color: #f8fafc !important;
        }
        [data-theme-version="dark"] .daily-sub-text {
            color: #94a3b8 !important;
        }

        /* Metric Icon Avatars */
        .daily-metric-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-size: 16px;
            flex-shrink: 0;
            transition: all 0.2s ease;
        }
        .daily-metric-icon.icon-revenue {
            background-color: rgba(0, 129, 238, 0.12) !important;
            color: #0081EE !important;
            border: 1px solid rgba(0, 129, 238, 0.25) !important;
        }
        .daily-metric-icon.icon-profit {
            background-color: rgba(16, 185, 129, 0.12) !important;
            color: #10b981 !important;
            border: 1px solid rgba(16, 185, 129, 0.25) !important;
        }
        .daily-metric-icon.icon-expense {
            background-color: rgba(239, 68, 68, 0.12) !important;
            color: #ef4444 !important;
            border: 1px solid rgba(239, 68, 68, 0.25) !important;
        }

        /* Dark Mode Metric Icons */
        [data-theme-version="dark"] .daily-metric-icon.icon-revenue {
            background-color: rgba(56, 189, 248, 0.2) !important;
            color: #38bdf8 !important;
            border-color: rgba(56, 189, 248, 0.4) !important;
        }
        [data-theme-version="dark"] .daily-metric-icon.icon-profit {
            background-color: rgba(52, 211, 153, 0.2) !important;
            color: #34d399 !important;
            border-color: rgba(52, 211, 153, 0.4) !important;
        }
        [data-theme-version="dark"] .daily-metric-icon.icon-expense {
            background-color: rgba(248, 113, 113, 0.2) !important;
            color: #f87171 !important;
            border-color: rgba(248, 113, 113, 0.4) !important;
        }

        /* Status & Metric Badges */
        .daily-badge {
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
        }
        .daily-badge.badge-revenue {
            background: rgba(0, 129, 238, 0.1);
            color: #0081ee;
            border: 1px solid rgba(0, 129, 238, 0.25);
        }
        .daily-badge.badge-profit {
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.25);
        }
        .daily-badge.badge-expense {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.25);
        }
        [data-theme-version="dark"] .daily-badge.badge-revenue {
            background: rgba(56, 189, 248, 0.18) !important;
            color: #38bdf8 !important;
            border-color: rgba(56, 189, 248, 0.35) !important;
        }
        [data-theme-version="dark"] .daily-badge.badge-profit {
            background: rgba(52, 211, 153, 0.18) !important;
            color: #34d399 !important;
            border-color: rgba(52, 211, 153, 0.35) !important;
        }
        [data-theme-version="dark"] .daily-badge.badge-expense {
            background: rgba(248, 113, 113, 0.18) !important;
            color: #f87171 !important;
            border-color: rgba(248, 113, 113, 0.35) !important;
        }

        /* Store Index Pill */
        .tax-index-badge {
            font-family: var(--bs-font-monospace, monospace);
            font-weight: 600;
            font-size: 11px;
            padding: 2px 7px;
            background: rgba(0, 0, 0, 0.05);
            color: #475569;
            border-radius: 999px;
            border: 1px solid rgba(0, 0, 0, 0.08);
            display: inline-block;
        }
        [data-theme-version="dark"] .tax-index-badge {
            background: rgba(255, 255, 255, 0.06);
            color: #94a3b8;
            border-color: rgba(255, 255, 255, 0.1);
        }

        /* Store Table Typography & Alignment */
        #payout_store_table th:nth-child(1), #payout_store_table td:nth-child(1) {
            text-align: center !important;
        }
        #payout_store_table th:nth-child(3), #payout_store_table td:nth-child(3),
        #payout_store_table th:nth-child(4), #payout_store_table td:nth-child(4),
        #payout_store_table th:nth-child(5), #payout_store_table td:nth-child(5) {
            text-align: right !important;
            font-family: var(--bs-font-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace) !important;
        }
        #payout_store_table th:nth-child(5), #payout_store_table td:nth-child(5) {
            font-weight: 700 !important;
        }
        #payout_store_table th:nth-child(6), #payout_store_table td:nth-child(6),
        #payout_store_table th:nth-child(7), #payout_store_table td:nth-child(7) {
            text-align: center !important;
        }

        /* Dark Mode Table Styling */
        [data-theme-version="dark"] #payout_store_table thead.table-light,
        [data-theme-version="dark"] #payout_store_table thead.table-light th {
            background-color: rgba(255, 255, 255, 0.04) !important;
            color: #94a3b8 !important;
            border-bottom-color: rgba(255, 255, 255, 0.08) !important;
        }
        [data-theme-version="dark"] #payout_store_table tbody tr {
            border-bottom-color: rgba(255, 255, 255, 0.05) !important;
        }
        [data-theme-version="dark"] #payout_store_table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.03) !important;
        }
    </style>
</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
    <!--********** Content body start **********-->
    <div class="content-body">
        <div class="container-fluid" style="min-height: 100vh;">
            
            <!-- Hidden currency inputs -->
            <div class="d-none">
                <input type="hidden" name="sym" value="<%= accessdata?.symbol || '$' %>">
                <input type="hidden" name="pls" value="<%= accessdata?.plac || 1 %>">
                <input type="hidden" name="thousands_separator" value="<%= accessdata?.thousands_separator || ',' %>">
            </div>

            <!-- Page Title Bar -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3 daily-kpi-card" style="height: auto;">
                        <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                    <i class="fa fa-hand-holding-usd text-primary me-2"></i><%= language.Payout || 'Payout & Commission Hub' %>
                                </h3>
                                <small class="text-muted"><%= language.Payout_Subtitle || 'Track partner payouts, accrued commissions, and settlement balances across branches' %></small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <a href="/account/list" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1">
                                    <i class="fa fa-wallet me-1"></i><%= language.Account_Management || 'Account Management' %>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top 3 Executive Summary KPI Cards -->
            <div class="row g-3 mb-4 kpi-row">
                <!-- 1. Total Commission Accrued / Payable -->
                <div class="col-12 col-md-4">
                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="daily-sub-text small fw-medium text-truncate"><%= language.Total_Pay_Out_Amount || 'Total Commission Accrued' %></span>
                                    <span class="daily-badge badge-revenue">Accrued</span>
                                </div>
                                <div class="d-flex align-items-baseline justify-content-between mt-2">
                                    <h3 class="mb-0 fw-bold daily-val-text font-monospace text-primary symbol"><%= comission %></h3>
                                    <div class="daily-metric-icon icon-revenue">
                                        <i class="fa fa-coins"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="pt-3 mt-3 border-top">
                                <a href="/account/viewcomission/commission" class="btn btn-sm btn-outline-primary w-100 rounded-pill d-flex align-items-center justify-content-center gap-1">
                                    <i class="fa fa-eye me-1"></i><%= language.View_Comission || 'View Commission Details' %>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Total Received / Settled Amount -->
                <div class="col-12 col-md-4">
                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="daily-sub-text small fw-medium text-truncate"><%= language.Total_Received_Amount || 'Total Settled Amount' %></span>
                                    <span class="daily-badge badge-profit">Settled</span>
                                </div>
                                <div class="d-flex align-items-baseline justify-content-between mt-2">
                                    <h3 class="mb-0 fw-bold daily-val-text font-monospace text-success symbol"><%= paidcomission %></h3>
                                    <div class="daily-metric-icon icon-profit">
                                        <i class="fa fa-check-circle"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="pt-3 mt-3 border-top">
                                <a href="/account/viewcomission/paidcommission" class="btn btn-sm btn-outline-success w-100 rounded-pill d-flex align-items-center justify-content-center gap-1">
                                    <i class="fa fa-eye me-1"></i><%= language.View_Paid_Comission || 'View Paid Commission' %>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Total Due / Outstanding Balance -->
                <div class="col-12 col-md-4">
                    <div class="card h-100 border shadow-none rounded-3 mb-0 daily-kpi-card">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="daily-sub-text small fw-medium text-truncate"><%= language.Total_Due_Amount || 'Outstanding Due Balance' %></span>
                                    <span class="daily-badge <%= Number(due) > 0 ? 'badge-expense' : 'badge-profit' %>">
                                        <%= Number(due) > 0 ? 'Pending' : 'Cleared' %>
                                    </span>
                                </div>
                                <div class="d-flex align-items-baseline justify-content-between mt-2">
                                    <h3 class="mb-0 fw-bold daily-val-text font-monospace <%= Number(due) > 0 ? 'text-danger' : 'text-success' %> symbol"><%= Number(due || 0).toFixed(2) %></h3>
                                    <div class="daily-metric-icon <%= Number(due) > 0 ? 'icon-expense' : 'icon-profit' %>">
                                        <i class="fa <%= Number(due) > 0 ? 'fa-hourglass-half' : 'fa-check-double' %>"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="pt-3 mt-3 border-top">
                                <a href="/account/viewcomission/duecommission" class="btn btn-sm btn-outline-<%= Number(due) > 0 ? 'danger' : 'secondary' %> w-100 rounded-pill d-flex align-items-center justify-content-center gap-1">
                                    <i class="fa fa-eye me-1"></i><%= language.View_Due_Comission || 'View Due Balances' %>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Store Breakdown Table -->
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3 daily-kpi-card" style="height: auto;">
                        <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h4 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                    <i class="fa fa-store text-primary me-2"></i><%= language.Store_List || 'Store Payout Summaries' %>
                                </h4>
                                <small class="text-muted"><%= language.Payout_Store_List_Subtitle || 'Manage partner payouts, commission balances, and settlements by store' %></small>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border px-3 py-2 rounded-pill font-monospace">
                                <%= storeList ? storeList.length : 0 %> Stores Listed
                            </span>
                        </div>

                        <div class="card-body p-4">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="payout_store_table">
                                    <thead class="table-light text-secondary border-bottom">
                                        <tr>
                                            <th class="ps-3 py-3 text-center" style="width: 6%;">#</th>
                                            <th class="py-3" style="width: 26%;"><%= language.Store_Name || 'Store Name' %></th>
                                            <th class="py-3 text-end" style="width: 18%;"><%= language.Total_commission_due_from_store || 'Accrued Commission' %></th>
                                            <th class="py-3 text-end" style="width: 16%;"><%= language.Store_Paid_commission_amount || 'Paid / Settled' %></th>
                                            <th class="py-3 text-end" style="width: 16%;"><%= language.Due_commission_amount || 'Due Balance' %></th>
                                            <th class="py-3 text-center" style="width: 10%;">Status</th>
                                            <th class="pe-3 py-3 text-center" style="width: 8%;"><%= language.Action || 'Action' %></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (storeList && storeList.length > 0) { %>
                                            <% storeList.forEach(function(data, i){ %>
                                                <% let storeDue = Number(data.comiision || 0) - Number(data.pay || 0); %>
                                                <tr>
                                                    <td class="ps-3 py-3 text-center">
                                                        <span class="tax-index-badge"><%= i + 1 %></span>
                                                    </td>
                                                    <td class="py-3">
                                                        <div class="d-flex align-items-center">
                                                            <div class="bg-light rounded-circle p-1 me-2 d-inline-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                                                <i class="fa fa-store text-primary fs-12"></i>
                                                            </div>
                                                            <div>
                                                                <span class="fw-semibold daily-val-text"><%= data.name %></span>
                                                                <small class="d-block text-muted fs-11">Store ID: #<%= data.id %></small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="py-3 text-end font-monospace symbol">
                                                        <%= Number(data.comiision || 0).toFixed(2) %>
                                                    </td>
                                                    <td class="py-3 text-end font-monospace symbol text-success">
                                                        <%= Number(data.pay || 0).toFixed(2) %>
                                                    </td>
                                                    <td class="py-3 text-end font-monospace symbol fw-bold <%= storeDue > 0 ? 'text-danger' : 'text-success' %>">
                                                        <%= storeDue.toFixed(2) %>
                                                    </td>
                                                    <td class="py-3 text-center">
                                                        <% if (storeDue > 0) { %>
                                                            <span class="daily-badge badge-expense">Pending Due</span>
                                                        <% } else { %>
                                                            <span class="daily-badge badge-profit">Settled</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="pe-3 py-3 text-center">
                                                        <a href="/account/payoutdetails/<%= data.id %>" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" title="<%= language.View || 'View Payout Details' %>">
                                                            <i class="fa fa-eye"></i> View
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="7" class="text-center py-5 text-muted">
                                                    <i class="fa fa-inbox fs-2 mb-2 d-block text-secondary opacity-50"></i>
                                                    No stores found in payout records.
                                                </td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!--********** Content body end **********-->

    <!--********************************** Footer start ***********************************-->
    <%- include('templet/footer')-%>
    <!--********************************** Footer end ***********************************-->

    <!--********** Main wrapper end **********-->
    <%- include('templet/script')-%>
</body>

</html>