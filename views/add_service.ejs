<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>
    <style>
        .service-preview-box {
            border: 2px dashed rgba(148, 163, 184, 0.35);
            border-radius: 1rem;
            background: rgba(148, 163, 184, 0.05);
            transition: all 0.25s ease;
        }
        .service-preview-box:hover {
            border-color: var(--primary, #1d4ed8);
            background: rgba(148, 163, 184, 0.08);
        }
        .service-preview-thumb-wrap {
            width: 140px;
            height: 140px;
            border-radius: 0.85rem;
            background: rgba(148, 163, 184, 0.1);
            border: 1px solid rgba(148, 163, 184, 0.2);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .service-preview-thumb-wrap img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }
        #tblPage tr td {
            vertical-align: middle;
        }
        #tblPage #remove {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            color: #ef4444;
            background: rgba(239, 68, 68, 0.1);
            text-decoration: none;
            transition: all 0.2s ease;
        }
        #tblPage #remove:hover {
            color: #fff;
            background: #ef4444;
            transform: scale(1.05);
        }
        .invalid-select {
            border: 1px solid #ef4444 !important;
        }
    </style>
</head>

<body>

    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>

    <!--********** Content body start **********-->
    <div class="content-body">
        <div class="container-fluid" style="min-height: 100vh;">
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3">
                        <!-- Card Header -->
                        <div class="card-header border-bottom py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div>
                                <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                    <i class="fas fa-layer-group text-primary me-2"></i>
                                    <%= language.Add_Services_Details %>
                                </h3>
                                <small class="text-muted"><%= language.Configure_laundry_services || 'Configure laundry service name, media, and pricing tiers' %></small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <% if ((accessdata?.logas === 'master' || accessdata?.isstore === true) && accessdata?.topbardata?.is_staff == 0) { %>
                                <a href="/services/csv_file" class="btn btn-sm btn-info d-inline-flex align-items-center">
                                    <i class="fa fa-upload me-2"></i>
                                    <%= language.Bulk_Upload_Services %>
                                </a>
                                <% } %>
                                <button type="button" class="btn btn-sm btn-secondary d-inline-flex align-items-center" onclick="history.back()">
                                    <i class="fa fa-arrow-left me-2"></i>
                                    <%= language.Go_Back %>
                                </button>
                            </div>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-4">
                            <form action="/services/addservice" method="post" class="need-validation" enctype="multipart/form-data" onsubmit="return validateForm()">
                                <div class="row g-4">
                                    
                                    <!-- Left Section: Basic Information -->
                                    <div class="col-lg-8">
                                        <div class="p-3 border rounded overflow-visible position-relative">
                                            <h6 class="fw-bold mb-3 d-flex align-items-center">
                                                <i class="fas fa-info-circle text-primary me-2"></i>
                                                <%= language.Service_Information || 'Service Information' %>
                                            </h6>

                                            <% if (ismulty) { %>
                                            <div class="mb-3 store-select-group position-relative">
                                                <label class="form-label fw-bold">
                                                    <i class="fas fa-store text-primary me-1"></i>
                                                    <%= language.Store_List %> <span class="text-danger">*</span>
                                                </label>
                                                <select class="default-select form-control wide" name="storeid" id="add_servie_storelist" data-container="body" required>
                                                    <option value="" selected disabled> Select Store </option>
                                                    <% storeList.forEach(function(x){ %>
                                                        <option value="<%= x.id %>"><%= x.name %></option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                            <% } else { %>
                                            <input type="hidden" name="storeid" id="add_servie_storelist" value="<%= (typeof assigned_store_id !== 'undefined' && assigned_store_id) ? assigned_store_id : '1' %>">
                                            <% } %>

                                            <div class="row g-3 mb-3">
                                                <div class="col-md-5">
                                                    <label class="form-label fw-bold">
                                                        <i class="fas fa-tag text-primary me-1"></i>
                                                        <%= language.Service_Name %> <span class="text-danger">*</span>
                                                    </label>
                                                    <input type="text" placeholder="Enter Service Name (e.g. Dry Cleaning, Wash & Fold)" class="form-control" name="name" required>
                                                    <input type="hidden" id="servalid" value="0" min="1" required>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label fw-bold">
                                                        <i class="fas fa-layer-group text-primary me-1"></i>
                                                        Number of Items / Pieces <span class="text-danger">*</span>
                                                    </label>
                                                    <input type="number" placeholder="1" class="form-control" name="no_of_items" value="1" min="1" required>
                                                    <div class="form-text text-muted small">Items included per unit (e.g. 2 for 2-piece suit)</div>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label fw-bold">
                                                        <i class="fas fa-sort-numeric-down text-primary me-1"></i>
                                                        Sequence No <span class="text-danger">*</span>
                                                    </label>
                                                    <input type="number" placeholder="1" class="form-control" name="sequence_no" value="1" min="0" required>
                                                </div>
                                            </div>

                                            <div class="pt-2">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="active" name="active" value="0" checked>
                                                    <label class="form-check-label fw-bold" for="active">
                                                        <%= language.Is_Active %> ?
                                                    </label>
                                                </div>
                                                <small class="text-muted d-block mt-1">
                                                    Enable or disable this service across POS and online ordering
                                                </small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Right Section: Image Upload & Preview -->
                                    <div class="col-lg-4">
                                        <div class="service-preview-box p-3 text-center d-flex flex-column align-items-center justify-content-center h-100">
                                            <h6 class="fw-bold mb-3 d-flex align-items-center">
                                                <i class="fas fa-image text-primary me-2"></i>
                                                <%= language.Service_Image || 'Service Image' %> <span class="text-danger">*</span>
                                            </h6>

                                            <div class="service-preview-thumb-wrap mb-3 shadow-sm">
                                                <img id="file-preview" src="../images/one.png" alt="Service Preview">
                                            </div>

                                            <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                                                <label class="btn btn-primary mb-0 d-inline-flex align-items-center shadow-sm" for="file-1" id="Uploadfile-1">
                                                    <i class="fa fa-camera me-2"></i>
                                                    <%= language.Upload_Image %>
                                                </label>
                                                <button type="button" class="btn btn-danger d-inline-flex align-items-center" onclick="resetPreview()" title="<%= language.Reset || 'Reset' %>">
                                                    <i class="fa fa-undo me-2"></i>
                                                    <%= language.Reset || 'Reset' %>
                                                </button>
                                            </div>

                                            <input class="d-none" type="file" id="file-1" name="image" accept="image/*" onchange="showPreview(event)">

                                            <div class="text-danger small mt-1 fw-bold d-none" id="ImgRequired">
                                                <i class="fas fa-exclamation-triangle me-1"></i> <%= language.Image_is_required || 'Service image is required!' %>
                                            </div>
                                            <small class="text-muted mt-2">Recommended: PNG or JPG (Square, 400x400)</small>
                                        </div>
                                    </div>

                                    <!-- Bottom Section: Service Types & Pricing Table -->
                                    <div class="col-12 mt-2">
                                        <div class="card border mb-0" style="height: auto;">
                                            <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2 py-3">
                                                <div>
                                                    <h6 class="mb-0 fw-bold d-flex align-items-center">
                                                        <i class="fas fa-list-ol text-primary me-2"></i>
                                                        <%= language.Service_Type || 'Service Types & Pricing' %>
                                                    </h6>
                                                    <small class="text-muted"><%= language.Add_pricing_tiers || 'Add at least one service tier with pricing (e.g. Normal, Express, Urgent)' %></small>
                                                </div>
                                                <button type="button" class="btn btn-primary d-inline-flex align-items-center shadow-sm" id="add_service">
                                                    <i class="fa fa-plus me-2"></i>
                                                    <%= language.Add_Service_Type %>
                                                </button>
                                            </div>

                                            <div class="card-body p-0">
                                                <div class="table-responsive">
                                                    <table class="table table-hover align-middle mb-0">
                                                        <thead>
                                                            <tr>
                                                                <th class="ps-3 py-3" style="width: 120px;">
                                                                    Sequence No <span class="text-danger">*</span>
                                                                </th>
                                                                <th class="py-3" style="min-width: 200px;">
                                                                    <%= language.Service_Type %> <span class="text-danger">*</span>
                                                                </th>
                                                                <th class="py-3" style="min-width: 140px;">
                                                                    <%= language.Service_Price %> <span class="text-danger">*</span>
                                                                </th>
                                                                <th class="py-3" style="min-width: 130px;">
                                                                    No of Items <span class="text-danger">*</span>
                                                                </th>
                                                                <th class="py-3" style="min-width: 160px;">
                                                                    Ready Time (Mins) <span class="text-danger">*</span>
                                                                </th>
                                                                <th class="text-center py-3" style="width: 80px;">
                                                                    <%= language.Action %>
                                                                </th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="tblPage">
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Footer Form Actions -->
                                    <div class="col-12">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-3 border-top">
                                            <button type="button" class="btn btn-secondary d-inline-flex align-items-center" onclick="history.back()">
                                                <i class="fa fa-arrow-left me-2"></i>
                                                <%= language.Go_Back || 'Back' %>
                                            </button>
                                            <div class="d-flex align-items-center gap-2">
                                                <button type="button" class="btn btn-secondary d-inline-flex align-items-center" onclick="history.back()">
                                                    <i class="fa fa-times me-2"></i>
                                                    <%= language.Cancel %>
                                                </button>
                                                <button type="submit" id="add" class="btn btn-primary d-inline-flex align-items-center shadow-sm">
                                                    <i class="fa fa-save me-2"></i>
                                                    <%= language.Submit %>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--********** Content body end **********-->

    <!--**********************************Footer start***********************************-->
    <%- include('templet/footer')-%>
    <!--**********************************Footer end***********************************-->

    </div>
    <!--********** Main wrapper end **********-->
    
    <%- include('templet/script')-%>

    <script>
        function validateForm() {
            const fileInput = document.getElementById('file-1');
            const errorSpan = document.getElementById('ImgRequired');

            if (!fileInput.files.length) {
                errorSpan.classList.remove('d-none');
                if (typeof toastr !== 'undefined') {
                    toastr.error('Please upload a service image', {
                        timeOut: 3000,
                        closeButton: true,
                        progressBar: true
                    });
                }
                return false;
            } else {
                errorSpan.classList.add('d-none');
                return true;
            }
        }

        function showPreview(event) {
            const file = event.target.files[0];
            if (file) {
                const preview = document.getElementById('file-preview');
                preview.src = URL.createObjectURL(file);
                document.getElementById('ImgRequired').classList.add('d-none');
            }
        }

        function resetPreview() {
            document.getElementById('file-preview').src = '../images/one.png';
            const fileInput = document.getElementById('file-1');
            fileInput.value = '';
            document.getElementById('ImgRequired').classList.add('d-none');
        }
    </script>

</body>

</html>