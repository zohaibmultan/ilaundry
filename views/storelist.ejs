<!DOCTYPE html>
<html lang="en" class="h-100">


<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>



</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card ">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <%= language.Shop_List_Table %>
                                </h3>
                                <a href="/tool/addshop" class="btn btn-sm btn-rounded btn-primary">
                                        <i class="fa fa-plus me-2 color-info"></i>
                                    <%= language.Add_New_Store %>
                                </a>
                            </div>

                            <div class="card-body">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="row g-2 mb-3">
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                            <input class="form-control" type="search" id="dtStoreSearch" placeholder="<%= language.Search || 'Search stores by name, ID, phone...' %>">
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                                        <select class="form-select" id="dtStoreStatus">
                                            <option value="all"><%= language.All_Status || 'All Status' %></option>
                                            <option value="1"><%= language.Active || 'Active' %></option>
                                            <option value="0"><%= language.Deactive || 'Deactive' %></option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                                        <select class="form-select" id="dtStorePageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_store_table" class="table display server-side-dt" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th><%= language.Shop_Name %></th>
                                                <th style="width: 130px;"><%= language.Store_ID %></th>
                                                <th style="width: 120px;"><%= language.Status %></th>
                                                <th class="text-center" style="width: 100px;"><%= language.Action %></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!--********** Content body end **********-->

        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

        <!--**********************************
            Footer end
        ***********************************-->

        </div>

        <!--********** Main wrapper end **********-->
        <%- include('templet/script')-%>

        <script>
            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                  .replace(/&/g, '&amp;')
                  .replace(/</g, '&lt;')
                  .replace(/>/g, '&gt;')
                  .replace(/"/g, '&quot;')
                  .replace(/'/g, '&#039;');
            }

            function changeStatus(currentStatus, id) {
                const newStatus = currentStatus === 'active' ? 'deactive' : 'active';
                $.ajax({
                    type: 'post',
                    url: `/tool/storestatus/${id}`,
                    data: { status: newStatus },
                    success: function (res) {
                        if (window.storeTable) {
                            window.storeTable.ajax.reload(null, false);
                        }
                    },
                    error: function(err) {
                        console.error("Failed to update store status", err);
                    }
                });
            }

            $(document).ready(function() {
                window.storeTable = window.initServerDataTable('#server_store_table', {
                    ajaxUrl: '/tool/storelist/data',
                    columns: [
                        {
                            data: null,
                            orderable: false,
                            searchable: false,
                            render: function(data, type, row, meta) {
                                return meta.settings._iDisplayStart + meta.row + 1;
                            }
                        },
                        {
                            data: 'name',
                            render: function(data) {
                                return `<div class="fw-bold text-dark">${escapeHtml(data)}</div>`;
                            }
                        },
                        {
                            data: 'id',
                            render: function(data) {
                                return `<span class="badge bg-light text-dark px-2 py-1 fw-semibold">#${escapeHtml(data)}</span>`;
                            }
                        },
                        {
                            data: 'status',
                            render: function(data, type, row) {
                                const isChecked = data === 1 ? 'checked' : '';
                                const curStatus = data === 1 ? 'active' : 'deactive';
                                return `
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" id="active_${row.id}" ${isChecked} onchange="changeStatus('${curStatus}', '${row.id}')">
                                    </div>
                                `;
                            }
                        },
                        {
                            data: null,
                            orderable: false,
                            searchable: false,
                            className: 'text-center',
                            render: function(data, type, row) {
                                return `
                                    <div class="tbl-action-group justify-content-center">
                                        <a href="/tool/approvedshop/${row.id}" class="btn-dt-action btn-edit" title="<%= language.Edit || 'Edit' %>">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                    </div>
                                `;
                            }
                        }
                    ],
                    order: [[0, 'desc']],
                    searchInput: '#dtStoreSearch',
                    pageLengthSelect: '#dtStorePageLength',
                    filterElements: {
                        status_filter: '#dtStoreStatus'
                    }
                });
            });
        </script>
</body>


</html>     