<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>
</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>

    <!--********** Content body start **********-->
    <div class="content-body">
        <div class="container-fluid" style="min-height: 100vh; padding-bottom: 90px;">
            
            <!-- Page Banner Header -->
            <div class="settings-banner mb-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center">
                        <div class="settings-icon-badge badge-primary-glass">
                            <i class="fas fa-print"></i>
                        </div>
                        <div>
                            <h4 class="settings-card-title mb-1" style="font-size: 18px !important;">
                                <%= language.Printer_Settings || 'Store POS Hardware & Printer Settings' %>
                            </h4>
                            <p class="settings-card-subtitle mb-0">
                                Configure thermal receipt printer, garment tag printer, auto-cutter, cash drawer, and silent printing bridge for 
                                <strong class="text-primary"><%= storeData ? storeData.name : 'Store' %></strong>
                            </p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                            <i class="fas fa-store me-1"></i> <%= storeData ? storeData.name : 'Store POS' %>
                        </span>
                        <a href="/index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
                            <i class="fa fa-arrow-left me-1"></i> <%= language.Back_to_Dashboard || 'Back to Dashboard' %>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Master Admin Store Switcher (if Master Admin) -->
            <% if (isMaster && stores && stores.length > 0) { %>
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-3 bg-light-subtle rounded-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-layer-group text-primary fs-5"></i>
                            <div>
                                <span class="fw-bold text-dark d-block">Select Store Branch:</span>
                                <small class="text-muted">Master Admin can configure independent POS printers per store</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2" style="min-width: 280px;">
                            <select class="form-select form-select-sm" id="storeSelector" onchange="switchStorePrinter(this.value)">
                                <% stores.forEach(function(s) { %>
                                    <option value="<%= s.id %>" <%= String(s.id) === String(targetStoreId) ? 'selected' : '' %>>
                                        <%= s.name %> (<%= s.city || 'Store' %>)
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- View-Only Notice if user cannot update -->
            <% if (!canEdit) { %>
                <div class="alert alert-info py-2 px-3 mb-4 d-flex align-items-center rounded-3">
                    <i class="fas fa-info-circle me-2 fs-5"></i>
                    <span>You are viewing printer settings in <strong>View Only</strong> mode. Administrative edit privileges required to modify.</span>
                </div>
            <% } %>

            <!-- Main Form -->
            <form action="/tool/printersetting/<%= targetStoreId %>" method="POST" id="printer_setting_form" class="need-validation" novalidate>
                
                <div class="row g-4">
                    <!-- Left Column: Receipt & Tag Hardware Configuration -->
                    <div class="col-12 col-xl-7">
                        
                        <!-- 1. Customer Invoice Receipt Printer Card -->
                        <div class="settings-section-card mb-4">
                            <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center">
                                    <div class="settings-icon-badge badge-primary-glass">
                                        <i class="fas fa-receipt"></i>
                                    </div>
                                    <div>
                                        <h5 class="settings-card-title">Customer Invoice Receipt Printer</h5>
                                        <p class="settings-card-subtitle">Paper width format, target OS printer, and thermal copies</p>
                                    </div>
                                </div>
                                <span class="badge bg-primary-subtle text-primary">INVOICE PRINTER</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-scroll text-primary me-1"></i> Invoice Paper Format
                                    </label>
                                    <select class="form-select form-control" name="invoice_printer_format" id="invoice_printer_format" <%= !canEdit ? 'disabled' : '' %>>
                                        <option value="1" <%= printerSettings.invoice_printer_format == 1 ? 'selected' : '' %>>80mm Thermal POS (Standard - Recommended)</option>
                                        <option value="2" <%= printerSettings.invoice_printer_format == 2 ? 'selected' : '' %>>58mm Thermal POS (Compact Roll)</option>
                                        <option value="0" <%= printerSettings.invoice_printer_format == 0 ? 'selected' : '' %>>A4 Full Sheet (Standard Laser/Inkjet)</option>
                                    </select>
                                    <small class="text-muted d-block mt-1">Select the paper width used by your store invoice printer.</small>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-print text-primary me-1"></i> Invoice Printer Name
                                    </label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="invoice_printer_name" id="invoice_printer_name" 
                                            value="<%= printerSettings.invoice_printer_name %>" 
                                            placeholder="e.g. POS-80 or EPSON TM-T88VI" <%= !canEdit ? 'readonly' : '' %>>
                                        <select class="form-select d-none" id="invoice_printer_dropdown" style="max-width: 140px;">
                                            <option value="">Select Installed</option>
                                        </select>
                                    </div>
                                    <small class="text-muted d-block mt-1">Exact name as shown in Windows "Printers & Scanners" (leave blank for default).</small>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-copy text-primary me-1"></i> Default Receipt Copies
                                    </label>
                                    <input type="number" class="form-control" name="printer_copies" id="printer_copies" 
                                        min="1" max="5" value="<%= printerSettings.printer_copies || 1 %>" <%= !canEdit ? 'readonly' : '' %>>
                                    <small class="text-muted d-block mt-1">Number of customer invoice copies printed per completed checkout.</small>
                                </div>

                                <div class="col-12 col-md-6 d-flex align-items-end">
                                    <button type="button" class="btn btn-outline-primary btn-sm w-100 py-2" id="btnTestInvoicePrint" onclick="testPrintInvoice()">
                                        <i class="fas fa-vial me-1"></i> Test Invoice Print
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Garment Wash Tag Printer Card -->
                        <div class="settings-section-card mb-4">
                            <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center">
                                    <div class="settings-icon-badge badge-primary-glass">
                                        <i class="fas fa-tags"></i>
                                    </div>
                                    <div>
                                        <h5 class="settings-card-title">Garment Wash Tag Printer</h5>
                                        <p class="settings-card-subtitle">Dedicated cloth tag printer or shared thermal printer for garment tracking</p>
                                    </div>
                                </div>
                                <span class="badge bg-warning-subtle text-warning">GARMENT TAGS</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-barcode text-primary me-1"></i> Garment Tag Dimensions
                                    </label>
                                    <select class="form-select form-control" name="tag_printer_format" id="tag_printer_format" <%= !canEdit ? 'disabled' : '' %>>
                                        <option value="1" <%= printerSettings.tag_printer_format == 1 ? 'selected' : '' %>>75mm Wash Tag (Standard Barcode - Recommended)</option>
                                        <option value="0" <%= printerSettings.tag_printer_format == 0 ? 'selected' : '' %>>50mm Compact Tag</option>
                                        <option value="2" <%= printerSettings.tag_printer_format == 2 ? 'selected' : '' %>>80mm Thermal Tag</option>
                                    </select>
                                    <small class="text-muted d-block mt-1">Width format for Code128 barcode wash tag strip.</small>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-tag text-primary me-1"></i> Tag Printer Name
                                    </label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="tag_printer_name" id="tag_printer_name" 
                                            value="<%= printerSettings.tag_printer_name %>" 
                                            placeholder="Leave blank to use Invoice Printer" <%= !canEdit ? 'readonly' : '' %>>
                                        <select class="form-select d-none" id="tag_printer_dropdown" style="max-width: 140px;">
                                            <option value="">Select Installed</option>
                                        </select>
                                    </div>
                                    <small class="text-muted d-block mt-1">Leave empty if you use the SAME thermal printer for both invoice & tags.</small>
                                </div>

                                <div class="col-12 col-md-6">
                                    <div class="p-3 rounded-3 border">
                                        <div class="small fw-semibold text-dark mb-1">
                                            <i class="fas fa-cut text-danger me-1"></i> Multi-Piece Garment Tracking:
                                        </div>
                                        <div class="small text-muted">
                                            Each physical garment piece automatically receives an individual cloth wash tag with piece numbering (e.g. <code>Piece 1/2</code>, <code>Piece 2/2</code>).
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6 d-flex align-items-end">
                                    <button type="button" class="btn btn-outline-warning btn-sm w-100 py-2" id="btnTestTagPrint" onclick="testPrintTag()">
                                        <i class="fas fa-barcode me-1"></i> Test Wash Tag Print
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Right Column: Silent Printing Bridge & Hardware Actions -->
                    <div class="col-12 col-xl-5">

                        <!-- 3. Local Printing Bridge Card -->
                        <div class="settings-section-card mb-4">
                            <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center">
                                    <div class="settings-icon-badge badge-primary-glass">
                                        <i class="fas fa-server"></i>
                                    </div>
                                    <div>
                                        <h5 class="settings-card-title">Local Printing Bridge</h5>
                                        <p class="settings-card-subtitle">Zero-dialog background printing via local POS agent</p>
                                    </div>
                                </div>
                                <span class="badge" id="bridgeServerStatusBadge">CHECKING</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-network-wired text-primary me-1"></i> Local Server URL
                                    </label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" name="printing_server_url" id="printing_server_url" 
                                            value="<%= printerSettings.printing_server_url %>" 
                                            placeholder="http://127.0.0.1:4321" <%= !canEdit ? 'readonly' : '' %>>
                                        <button class="btn btn-outline-secondary" type="button" onclick="checkBridgeServerHealth(true)">
                                            <i class="fas fa-sync-alt" id="bridgePingIcon"></i> Check
                                        </button>
                                    </div>
                                    <small class="text-muted d-block mt-1">Default: <code>http://127.0.0.1:4321</code> running on the POS cashier PC.</small>
                                </div>

                                <div class="col-12">
                                    <div class="p-3 rounded-3 border bg-light-subtle d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fw-bold d-block text-dark">Silent Background Printing</span>
                                            <small class="text-muted">Bypass Chrome print popup and print directly to hardware</small>
                                        </div>
                                        <div class="form-check form-switch ms-3 m-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="silent_print_enabled" name="silent_print_enabled" value="1" 
                                                <%= (printerSettings.silent_print_enabled == 1 || printerSettings.silent_print_enabled === '1') ? 'checked' : '' %> <%= !canEdit ? 'disabled' : '' %>>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div id="bridgeStatusDetails" class="alert alert-secondary py-2 px-3 mb-0 small">
                                        <i class="fas fa-circle-notch fa-spin me-2"></i> Detecting local printing server...
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4. Hardware Actions & Cutter Card -->
                        <div class="settings-section-card mb-4">
                            <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center">
                                    <div class="settings-icon-badge badge-primary-glass">
                                        <i class="fas fa-cog"></i>
                                    </div>
                                    <div>
                                        <h5 class="settings-card-title">Hardware Peripherals</h5>
                                        <p class="settings-card-subtitle">Auto-cutter and cash drawer kick signals</p>
                                    </div>
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary">PERIPHERALS</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="p-3 rounded-3 border bg-light-subtle d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fw-bold d-block text-dark">
                                                <i class="fas fa-cut text-danger me-1"></i> Auto-Cut Paper After Print
                                            </span>
                                            <small class="text-muted">Send physical blade cut command after invoice and each tag</small>
                                        </div>
                                        <div class="form-check form-switch ms-3 m-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="printer_auto_cut" name="printer_auto_cut" value="1" 
                                                <%= (printerSettings.printer_auto_cut == 1 || printerSettings.printer_auto_cut === '1') ? 'checked' : '' %> <%= !canEdit ? 'disabled' : '' %>>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="p-3 rounded-3 border bg-light-subtle d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fw-bold d-block text-dark">
                                                <i class="fas fa-cash-register text-success me-1"></i> Open Cash Drawer on Checkout
                                            </span>
                                            <small class="text-muted">Sends standard 24V pulse (ESC/POS 27,112,0) through the printer RJ12 port</small>
                                        </div>
                                        <div class="form-check form-switch ms-3 m-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="printer_open_cash_drawer" name="printer_open_cash_drawer" value="1" 
                                                <%= (printerSettings.printer_open_cash_drawer == 1 || printerSettings.printer_open_cash_drawer === '1') ? 'checked' : '' %> <%= !canEdit ? 'disabled' : '' %>>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 5. Barcode Printing Preferences Card -->
                        <div class="settings-section-card mb-4">
                            <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center">
                                    <div class="settings-icon-badge badge-primary-glass">
                                        <i class="fas fa-barcode"></i>
                                    </div>
                                    <div>
                                        <h5 class="settings-card-title">Barcode Printing Options</h5>
                                        <p class="settings-card-subtitle">Control order barcode generation on customer invoices & garment tags</p>
                                    </div>
                                </div>
                                <span class="badge bg-primary-subtle text-primary">BARCODES</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="p-3 rounded-3 border bg-light-subtle d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fw-bold d-block text-dark">
                                                <i class="fas fa-file-invoice text-primary me-1"></i> Print Barcode on Invoice Receipt
                                            </span>
                                            <small class="text-muted">Render scannable Code128 barcode at the bottom of the customer invoice receipt</small>
                                        </div>
                                        <div class="form-check form-switch ms-3 m-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="invoice_barcode_enabled" name="invoice_barcode_enabled" value="1" 
                                                <%= (printerSettings.invoice_barcode_enabled == 1 || printerSettings.invoice_barcode_enabled === '1') ? 'checked' : '' %> <%= !canEdit ? 'disabled' : '' %>>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="p-3 rounded-3 border bg-light-subtle d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fw-bold d-block text-dark">
                                                <i class="fas fa-tags text-warning me-1"></i> Print Barcode on Garment Wash Tags
                                            </span>
                                            <small class="text-muted">Render individual piece barcode on each cloth wash tag for tracking through cleaning</small>
                                        </div>
                                        <div class="form-check form-switch ms-3 m-0">
                                            <input class="form-check-input" type="checkbox" role="switch" id="tag_barcode_enabled" name="tag_barcode_enabled" value="1" 
                                                <%= (printerSettings.tag_barcode_enabled == 1 || printerSettings.tag_barcode_enabled === '1') ? 'checked' : '' %> <%= !canEdit ? 'disabled' : '' %>>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Sticky Glass Save Footer Bar -->
                <div class="settings-sticky-footer">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge light badge-primary d-none d-md-inline-flex">
                            <i class="fas fa-store me-1"></i> Store: <%= storeData ? storeData.name : 'Store POS' %>
                        </span>
                        <small class="text-muted d-none d-sm-inline">Changes take effect immediately on this store's POS terminal.</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="reset" class="btn btn-secondary px-3">
                            <i class="fas fa-undo me-2"></i> <%= language.Reset || 'Reset' %>
                        </button>
                        <% if (canEdit) { %>
                        <button type="submit" id="btn_save_printer_settings" class="btn btn-primary px-4">
                            <i class="fas fa-save me-2"></i> <%= language.Save_Data || 'Save Printer Settings' %>
                        </button>
                        <% } %>
                    </div>
                </div>

            </form>

        </div>
    </div>
    <!--********** Content body end **********-->

    <!-- Footer -->
    <%- include('templet/footer')-%>

    <!-- Scripts -->
    <%- include('templet/script')-%>
    <script src="/js/pos-print-client.js"></script>

    <script>
        function switchStorePrinter(storeId) {
            if (storeId) {
                window.location.href = '/tool/printersetting?store_id=' + encodeURIComponent(storeId);
            }
        }

        async function checkBridgeServerHealth(manual) {
            const urlInput = document.getElementById('printing_server_url');
            const url = (urlInput ? urlInput.value.trim() : '') || 'http://127.0.0.1:4321';
            const badge = document.getElementById('bridgeServerStatusBadge');
            const details = document.getElementById('bridgeStatusDetails');
            const icon = document.getElementById('bridgePingIcon');

            if (icon) icon.classList.add('fa-spin');

            try {
                const client = new POSPrintClient({ baseUrl: url, timeout: 3000 });
                const res = await client.request('/health');
                if (res && res.status === 'running') {
                    if (badge) {
                        badge.className = 'badge bg-success-subtle text-success';
                        badge.textContent = 'ONLINE';
                    }
                    if (details) {
                        details.className = 'alert alert-success py-2 px-3 mb-0 small';
                        details.innerHTML = '<i class="fas fa-check-circle me-1"></i> Printing bridge is running online on <strong>' + url + '</strong>';
                    }

                    // Populate available printer dropdowns if available
                    fetchPrintersList(client);
                } else {
                    throw new Error('Server not responding');
                }
            } catch (err) {
                if (badge) {
                    badge.className = 'badge bg-danger-subtle text-danger';
                    badge.textContent = 'OFFLINE';
                }
                if (details) {
                    details.className = 'alert alert-warning py-2 px-3 mb-0 small';
                    details.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> Local bridge is not responding. POS will fall back to native Chrome print dialog.';
                }
            } finally {
                if (icon) icon.classList.remove('fa-spin');
            }
        }

        async function fetchPrintersList(client) {
            try {
                const res = await client.request('/printers');
                if (res && res.printers && Array.isArray(res.printers)) {
                    populateDropdown('invoice_printer_dropdown', 'invoice_printer_name', res.printers);
                    populateDropdown('tag_printer_dropdown', 'tag_printer_name', res.printers);
                }
            } catch (e) {
                console.log('Could not fetch printer list', e);
            }
        }

        function populateDropdown(dropdownId, inputId, printers) {
            const select = document.getElementById(dropdownId);
            const input = document.getElementById(inputId);
            if (!select || !input) return;

            select.innerHTML = '<option value="">Choose Installed...</option>';
            printers.forEach(function(p) {
                const opt = document.createElement('option');
                opt.value = p.name;
                opt.textContent = p.name + (p.isDefault ? ' (Default)' : '');
                select.appendChild(opt);
            });

            select.classList.remove('d-none');
            select.onchange = function() {
                if (this.value) {
                    input.value = this.value;
                }
            };
        }

        function testPrintInvoice() {
            const format = document.getElementById('invoice_printer_format').value;
            const printer = encodeURIComponent(document.getElementById('invoice_printer_name').value);
            const storeId = "<%= targetStoreId %>";
            const url = '/tool/test-print-invoice?format=' + format + '&printer=' + printer + '&store_id=' + storeId;
            window.open(url, '_blank', 'width=450,height=700');
        }

        function testPrintTag() {
            const format = document.getElementById('tag_printer_format').value;
            const printer = encodeURIComponent(document.getElementById('tag_printer_name').value);
            const storeId = "<%= targetStoreId %>";
            const url = '/tool/test-print-tag?format=' + format + '&printer=' + printer + '&store_id=' + storeId;
            window.open(url, '_blank', 'width=450,height=600');
        }

        document.addEventListener('DOMContentLoaded', function() {
            checkBridgeServerHealth(false);
        });
    </script>
</body>
</html>
