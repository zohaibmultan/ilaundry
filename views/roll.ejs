<!DOCTYPE html>
<html lang="en" class="h-100">


<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card ">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <%= language.Role_List %>
                                </h3>
                                <!-- <button
                                    class="btn btn-rounded btn-primary <%= accessdata.logas == 'master' || accessdata.roll.rollaccess.includes('write') ?'':'d-none' %>"
                                    data-bs-toggle="modal" data-bs-target="#roll_list"><span
                                        class="btn-icon-start text-primary"><i class="fa fa-plus color-info"></i></span>
                                    <%= language.Add_New_Role %>
                                </button> -->
                            </div>
                            <div class="card-body ">
                                <div class="table-responsive">
                                    <table id="example3" class="table display table-responsive-lg" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>
                                                    <%= language.Role_Name %>
                                                </th>
                                                <!-- <th class="<%= ismulty ? '': 'd-none' %>">
                                                    <%= language.Store_Name %>
                                                </th> -->
                                                <th>
                                                    <%= language.Role_Status %>
                                                </th>
                                                <th
                                                    class="text-center <%= accessdata.logas == 'master' || accessdata.roll.rollaccess.includes('edit') || accessdata.roll.rollaccess.includes('delete') ?'':'d-none' %>">
                                                    <%= language.Action %>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% rollList.forEach(function(data, i){ %>
                                                <tr>
                                                    <td>
                                                        <%= i + 1%>
                                                    </td>
                                                    <td>
                                                        <%= data.roll%>
                                                    </td>
                                                    <!-- <td class="<%= ismulty ? '': 'd-none' %>">
                                                        <%=data.store %>
                                                    </td> -->
                                                    <td>

                                                        <div class="form-group">
                                                            <div class="form-check form-switch">
                                                                <input class="form-check-input" type="checkbox"
                                                                    id="active<%= data.id %>" name="active"
                                                                    onclick="changeStatus('<%= data.id %>')"
                                                                    <%=data.roll_status==='active' ? 'checked' : '' %>>
                                                            </div>
                                                        </div>

                                                    </td>
                                                    <td class="text-center">
                                                        <div class="tbl-action-group">
                                                            <a href="#"
                                                                class="btn-tbl-action btn-tbl-edit <%= accessdata.logas == 'master' || accessdata.roll.rollaccess.includes('edit') ?'' : 'd-none' %>"
                                                                id="updateroll<%= data.rollType  %>" data-bs-toggle="modal"
                                                                data-bs-target="#roll_list_update_<%= data.rollType  %>"
                                                                data-id="<%= data.id%>"
                                                                title="<%= language.Edit || 'Edit' %>">
                                                                <i class="fas fa-pencil-alt"></i></a>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <!--********** Content body end **********-->

