<!DOCTYPE html>
<html lang="en" class="h-100">


<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                        <i class="fa fa-receipt text-primary me-2"></i><%= language.Expence_List %>
                                    </h3>
                                    <small class="text-muted"><%= language.Expence_List_Subtitle || 'Track operational store expenditures, overheads, and payment records' %></small>
                                </div>
                                <div>
                                    <button
                                        class="btn btn-sm btn-primary <%= accessdata.roll.expense.includes('write') ?'':'d-none' %>"
                                        data-bs-toggle="modal" data-bs-target="#expense_list">
                                        <i class="fa fa-plus me-2"></i><%= language.Add_Expence %>
                                    </button>
                                </div>
                            </div>
                            <div class="d-none">
                                <input type="hiden" name="sym" value="<%= accessdata.symbol %>">
                                <input type="hiden" name="pls" value="<%= accessdata.plac %>">
                                <input type="hiden" name="thousands_separator"
                                    value="<%= accessdata.thousands_separator %>">
                            </div>
                            <div class="card-body p-4">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="row g-2 mb-3">
                                    <div class="<%= ismulty ? 'col-12 col-md-4 col-lg-3' : 'col-12 col-md-4 col-lg-3' %>">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                            <input class="form-control" type="search" id="dtExpenseSearch" placeholder="<%= language.Search || 'Search expenses...' %>">
                                        </div>
                                    </div>
                                    <div class="<%= ismulty ? 'col-6 col-sm-4 col-md-2' : 'col-6 col-sm-4 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtExpenseCategory">
                                            <option value="all"><%= language.All_Categories || 'All Categories' %></option>
                                            <% (categ || []).forEach(function(c) { %>
                                                <option value="<%= c.id %>"><%= c.cat_name %></option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <div class="<%= ismulty ? 'col-6 col-sm-4 col-md-2' : 'col-6 col-sm-4 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtExpenseAccount">
                                            <option value="all"><%= language.All_Accounts || 'All Accounts' %></option>
                                            <% (acountlist || []).forEach(function(a) { %>
                                                <option value="<%= a.id %>"><%= a.ac_name %></option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <% if (ismulty) { %>
                                        <div class="col-6 col-sm-6 col-md-2 col-lg-3">
                                            <select class="form-select" id="dtExpenseStore">
                                                <option value="all"><%= language.All_Store || 'All Stores' %></option>
                                                <% (storeList || []).forEach(function(st) { %>
                                                    <option value="<%= st.id %>"><%= st.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    <% } %>

                                    <div class="<%= ismulty ? 'col-6 col-sm-6 col-md-2 col-lg-2' : 'col-6 col-sm-4 col-md-2 col-lg-3' %>">
                                        <select class="form-select" id="dtExpensePageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_expense_table" class="table display server-side-dt" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th style="width: 105px;"><%= language.Date %></th>
                                                <th><%= language.Amount %></th>
                                                <th><%= language.TOWARDS %></th>
                                                <th style="width: 100px;"><%= language.Tax_included %></th>
                                                <th><%= language.PAYMENT_MODE %></th>
                                                <th class="<%= ismulty ? '': 'd-none' %>"><%= language.Store_Name %></th>
                                                <th><%= language.Created_By %></th>
                                                <th class="text-center <%= (accessdata?.roll?.expense?.includes('edit') || accessdata?.roll?.expense?.includes('delete')) ? '' : 'd-none' %>" style="width: 110px;">
                                                    <%= language.Action || 'Action' %>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--********** Content body end **********-->

            <!-- Modal update -->
            <div class="modal fade" id="expense_edit">
                <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <%= language.Expence_Update_Detail %>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <form action="/expense/updateexp" method="post" class="need-validation" id="expupdat_form">
                                <div class="row g-2 align-items-center">
                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">
                                                <%= language.Date %> <span class="text-danger">*</span>
                                            </label>
                                            <input type="date" class="form-control" id="date_update" name="date_update" required>
                                        </div>
                                    </div>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">
                                                <%= language.Expence_Category %> <span class="text-danger">*</span>
                                            </label>
                                            <select class="form-control wide" name="expense_category" id="category_update" required>
                                                <% (categ || []).forEach(function(data){ %>
                                                    <option value="<%=data.id%>">
                                                        <%=data.cat_name%>
                                                    </option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">
                                                <%= language.EXPENCE_AMOUNT %> <span class="text-danger">*</span>
                                            </label>
                                            <input type="number" class="form-control" id="amount_update"
                                                name="amount_update" placeholder="Enter Amount" step="0.01" required>
                                        </div>
                                    </div>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">
                                                <%= language.PAYMENT_MODE %> <span class="text-danger">*</span>
                                            </label>
                                            <select class="form-control wide" name="payment_update" id="payment_update" required>
                                                <% (acountlist || []).forEach(function(data){ %>
                                                    <option value="<%= data.id %>">
                                                        <%= data.ac_name %>
                                                    </option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <label class="form-label fw-bold mb-0">
                                                    <%= language.Tax_included %> ?
                                                </label>
                                                <div class="form-check ms-3">
                                                    <input class="form-check-input" type="radio" id="no_tax_included_update"
                                                        name="tax" value="no" checked>
                                                    <label class="form-check-label" for="no_tax_included_update"> No</label>
                                                </div>
                                                <div class="form-check ms-2">
                                                    <input class="form-check-input" type="radio"
                                                        id="yes_tax_included_update" name="tax" value="yes">
                                                    <label class="form-check-label" for="yes_tax_included_update"> Yes</label>
                                                </div>
                                                <div class="col-4 form-group ms-2 justify-content-end">
                                                    <input type="number" class="form-control d-none" name="tax_percent"
                                                        placeholder="Tax Percent" id="tex_perce_update" value="0">
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">
                                                <%= language.Notes %>
                                            </label>
                                            <input type="text" class="form-control" name="notes_update" id="notes_update"
                                                placeholder="Enter Notes">
                                        </div>
                                    </div>
                                </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel %>
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save me-2"></i><%= language.Save %>
                            </button>
                        </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal add -->
            <div class="modal fade" id="expense_list">
                <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <%= language.Add_Expence %>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <form action="/expense/addexpense" method="post" class="need-validation" id="myexpen">
                                <div class="row g-2 align-items-center">
                                    <% if (ismulty) { %>
                                        <div class="col-12 mb-2">
                                            <div class="form-group">
                                                <label class="form-label fw-bold">
                                                    <%= language.Store_List %> <span class="text-danger">*</span>
                                                </label>
                                                <select class="form-control wide" name="storeid"
                                                    id="expense_add_admin" required>
                                                    <option value="" selected disabled><%= language.Select_Store || 'Select Store' %></option>
                                                    <% (storeList || []).forEach(function(x){ %>
                                                        <option value="<%= x.id %>">
                                                            <%= x.name %>
                                                        </option>
                                                    <% }) %>
                                                </select>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <input type="hidden" name="storeid" value="<%= (typeof assigned_store_id !== 'undefined' && assigned_store_id) ? assigned_store_id : '' %>">
                                    <% } %>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">
                                                <%= language.Date %> <span class="text-danger">*</span>
                                            </label>
                                            <input type="date" class="form-control" name="date" required>
                                        </div>
                                    </div>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">
                                                <%= language.Expence_Category %> <span class="text-danger">*</span>
                                            </label>
                                            <% if (ismulty) { %>
                                                <select class="form-control wide" name="category" id="exp_add_category" required disabled>
                                                    <option value="" selected disabled><%= language.Select_Store_First || 'Select a store first' %></option>
                                                </select>
                                            <% } else { %>
                                                <select class="form-control wide" name="category" id="exp_add_category" required>
                                                    <option value="" selected disabled><%= language.Select_Category || 'Select Category' %></option>
                                                    <% (categ || []).forEach(function(data){ %>
                                                        <option value="<%=data.id%>">
                                                            <%=data.cat_name%>
                                                        </option>
                                                    <% }) %>
                                                </select>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">
                                                <%= language.EXPENCE_AMOUNT %> <span class="text-danger">*</span>
                                            </label>
                                            <input type="number" class="form-control" name="amount"
                                                placeholder="Enter Amount" step="0.01" required>
                                        </div>
                                    </div>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">
                                                <%= language.PAYMENT_MODE %> <span class="text-danger">*</span>
                                            </label>
                                            <% if (ismulty) { %>
                                                <select class="form-control wide" name="payment" id="exp_add_payment" required disabled>
                                                    <option value="" selected disabled><%= language.Select_Store_First || 'Select a store first' %></option>
                                                </select>
                                            <% } else { %>
                                                <select class="form-control wide" name="payment" id="exp_add_payment" required>
                                                    <option value="" selected disabled><%= language.Select_Payment || 'Select Payment Method' %></option>
                                                    <% (acountlist || []).forEach(function(data){ %>
                                                        <option value="<%= data.id %>">
                                                            <%= data.ac_name %>
                                                        </option>
                                                    <% }) %>
                                                </select>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <label class="form-label fw-bold mb-0">
                                                    <%= language.Tax_included %> ?
                                                </label>
                                                <div class="form-check ms-3">
                                                    <input class="form-check-input" type="radio" id="no_tax_included"
                                                        name="tax" value="no" required checked>
                                                    <label class="form-check-label" for="no_tax_included"> No</label>
                                                </div>
                                                <div class="form-check ms-2">
                                                    <input class="form-check-input" type="radio" id="yes_tax_included"
                                                        name="tax" value="yes" required>
                                                    <label class="form-check-label" for="yes_tax_included"> Yes</label>
                                                </div>
                                                <div class="col-4 form-group ms-2 justify-content-end">
                                                    <input type="number" class="form-control d-none" name="tax_percent"
                                                        placeholder="Tax Percent" id="tex_perce" value="0">
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 mb-2">
                                        <div class="form-group">
                                            <label class="form-label fw-bold">
                                                <%= language.Notes %>
                                            </label>
                                            <textarea class="form-control" name="notes" id="notes" placeholder="Enter Notes" rows="2"></textarea>
                                        </div>
                                    </div>
                                </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel %>
                            </button>
                            <button type="submit" value="submit" class="btn btn-primary">
                                <i class="fa fa-save me-2"></i><%= language.Save %>
                            </button>
                        </div>
                        </form>
                    </div>
                </div>
            </div>

        <!-- Modal delete confirm -->
        <div class="modal fade" id="deleteExpenseModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                <div class="modal-content text-center p-3" style="border-radius: 16px;">
                    <div class="modal-body pt-4">
                        <div class="mb-3">
                            <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
                                <i class="fa fa-trash-alt"></i>
                            </div>
                        </div>
                        <h4 class="mb-2 fw-bold text-dark"><%= language.Delete_Expense || language.Delete || 'Delete Expense' %></h4>
                        <p class="text-muted mb-1"><%= language.Are_you_sure_delete || 'Are you sure you want to delete this expense?' %></p>
                        <p class="fw-bold text-danger fs-5 mb-3" id="deleteExpenseModalTitle"></p>
                        <p class="text-xs text-muted mb-4"><%= language.Action_cannot_be_undone || 'This action cannot be undone.' %></p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                            </button>
                            <a href="#" id="deleteExpenseConfirmBtn" class="btn btn-danger">
                                <i class="fa fa-trash me-2"></i><%= language.Delete || 'Yes, Delete' %>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

            <!--**********************************
            Footer end
        ***********************************-->



            <!--********** Main wrapper end **********-->
            <%- include('templet/script')-%>

                <script>
                    $('#expense_list').on('shown.bs.modal', function () {
                        if ($('#expense_add_admin').length) {
                            $('#expense_add_admin').select2({
                                dropdownParent: $('#expense_list'),
                                placeholder: 'Select Store',
                                width: '100%',
                                allowClear: true
                            });
                        }

                        if ($('#exp_add_category').length) {
                            $('#exp_add_category').select2({
                                dropdownParent: $('#expense_list'),
                                placeholder: 'Select Category',
                                width: '100%',
                                allowClear: true
                            });
                        }

                        if ($('#exp_add_payment').length) {
                            $('#exp_add_payment').select2({
                                dropdownParent: $('#expense_list'),
                                placeholder: 'Select Payment Method',
                                width: '100%',
                                allowClear: true
                            });
                        }
                    });

                    $('#expense_edit').on('shown.bs.modal', function () {
                        if ($('#category_update').length) {
                            $('#category_update').select2({
                                dropdownParent: $('#expense_edit'),
                                placeholder: 'Select Category',
                                width: '100%',
                                allowClear: true
                            });
                        }

                        if ($('#payment_update').length) {
                            $('#payment_update').select2({
                                dropdownParent: $('#expense_edit'),
                                placeholder: 'Select Payment Method',
                                width: '100%',
                                allowClear: true
                            });
                        }
                    });
                </script>
                <script>
                    function escapeHtml(str) {
                        if (!str) return '';
                        return String(str)
                          .replace(/&/g, '&amp;')
                          .replace(/</g, '&lt;')
                          .replace(/>/g, '&gt;')
                          .replace(/"/g, '&quot;')
                          .replace(/'/g, '&#039;');
                    }

                    function formatExpenseDate(dStr) {
                        if (!dStr) return '-';
                        try {
                            const d = new Date(dStr);
                            if (isNaN(d.getTime())) return dStr;
                            const day = (d.getDate() < 10 ? '0' : '') + d.getDate();
                            const month = ((d.getMonth() + 1) < 10 ? '0' : '') + (d.getMonth() + 1);
                            const year = d.getFullYear();
                            return `${year}-${month}-${day}`;
                        } catch(e) {
                            return dStr;
                        }
                    }

                    $(document).ready(function() {
                        const isMultistore = <%= ismulty ? 'true' : 'false' %>;

                        const columns = [
                            {
                                data: 'date',
                                render: function(data) {
                                    return `<span class="text-muted fw-medium">${formatExpenseDate(data)}</span>`;
                                }
                            },
                            {
                                data: 'amount',
                                render: function(data) {
                                    return `<span class="fw-bold text-dark">${window.formatDtCurrency(data)}</span>`;
                                }
                            },
                            {
                                data: 'towards',
                                render: function(data, type, row) {
                                    const catBadge = row.cat_name ? `<span class="badge light badge-primary me-1">${escapeHtml(row.cat_name)}</span>` : '';
                                    return `<div>${catBadge}<span class="text-dark">${escapeHtml(data || '')}</span></div>`;
                                }
                            },
                            {
                                data: 'taxInclud',
                                render: function(data) {
                                    if (String(data).toLowerCase() === 'yes') {
                                        return '<span class="badge light badge-success">Yes</span>';
                                    }
                                    return '<span class="badge light badge-secondary">No</span>';
                                }
                            },
                            {
                                data: 'ac_name',
                                render: function(data) {
                                    return `<span class="badge light badge-info">${escapeHtml(data || 'Cash')}</span>`;
                                }
                            },
                            {
                                data: 'store',
                                visible: isMultistore,
                                render: function(data) {
                                    return `<span class="badge light badge-light text-dark">${escapeHtml(data || 'All Stores')}</span>`;
                                }
                            },
                            {
                                data: 'created_by_name',
                                render: function(data) {
                                    return `<span class="text-muted">${escapeHtml(data || '-')}</span>`;
                                }
                            },
                            {
                                data: null,
                                orderable: false,
                                searchable: false,
                                className: 'text-center',
                                render: function(data, type, row) {
                                    const editBtn = row.canEdit ? `
                                        <a href="#" class="btn-tbl-action btn-tbl-edit" 
                                           id="expaction" data-bs-toggle="modal"
                                           data-bs-target="#expense_edit"
                                           data-date="${row.date}"
                                           data-amount="${row.amount}"
                                           data-toward="${escapeHtml(row.towards)}"
                                           data-tex="${row.taxInclud}"
                                           data-payment="${row.payment_mode}"
                                           data-category="${row.category}"
                                           data-id="${row.id}"
                                           data-storeid="${row.store_ID}"
                                           data-texpercent="${row.taxpercent}"
                                           title="<%= language.Edit || 'Edit' %>">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>` : '';

                                    const deleteBtn = row.canDelete ? `
                                        <button type="button" 
                                           class="btn-tbl-action btn-tbl-delete btn-delete-expense" 
                                           data-bs-toggle="modal"
                                           data-bs-target="#deleteExpenseModal"
                                           data-id="${row.id}"
                                           data-towards="${escapeHtml(row.towards || '')}"
                                           data-cat="${escapeHtml(row.cat_name || '')}"
                                           data-amount="${row.amount}"
                                           title="<%= language.Delete || 'Delete' %>">
                                            <i class="fa fa-trash"></i>
                                        </button>` : '';

                                    return `<div class="tbl-action-group">${editBtn}${deleteBtn}</div>`;
                                }
                            }
                        ];

                        window.initServerDataTable('#server_expense_table', {
                            ajaxUrl: '/expense/list/data',
                            columns: columns,
                            searchInput: '#dtExpenseSearch',
                            pageLengthSelect: '#dtExpensePageLength',
                            filterSelectors: {
                                category: '#dtExpenseCategory',
                                account: '#dtExpenseAccount',
                                store_id: '#dtExpenseStore'
                            },
                            order: [[0, 'desc']],
                            language: {
                                emptyTable: '<%= language.No_data_available_in_table || "No expenses found" %>'
                            }
                        });

                        // Populate Delete Modal
                        $(document).on('click', '.btn-delete-expense', function () {
                            const id = $(this).attr('data-id');
                            const cleanId = String(id).replace(/['"]/g, '').trim();
                            const towards = $(this).attr('data-towards') || '';
                            const cat = $(this).attr('data-cat') || '';
                            const amount = $(this).attr('data-amount') || '';

                            const formattedAmount = (window.formatDtCurrency && typeof window.formatDtCurrency === 'function') 
                                ? window.formatDtCurrency(amount) 
                                : amount;
                            const titleParts = [];
                            if (towards) titleParts.push(towards);
                            else if (cat) titleParts.push(cat);
                            if (formattedAmount) titleParts.push('(' + formattedAmount + ')');

                            const displayTitle = titleParts.join(' ') || ('#' + cleanId);

                            $('#deleteExpenseModalTitle').text(displayTitle);
                            $('#deleteExpenseConfirmBtn').attr('href', '/expense/deletexpe/' + cleanId);
                        });
                    });
                </script>
</body>

</html>