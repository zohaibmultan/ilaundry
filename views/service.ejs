<!DOCTYPE html>
<html lang="en" class="h-100">


<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card ">
                            <div class="card-header d-flex justify-content-between">
                                <div>
                                    <h3 class="card-title">
                                        <%= language.Services %>
                                    </h3>
                                </div>
                                <div class="text-end">
                                    <a href="/services/csv_file" class="btn btn-rounded btn-primary btn-sm mx-3 mb-2">
                                        <i class="fa fa-upload color-info me-2"></i></span>
                                        <%= language.Bulk_Upload_Services %>
                                    </a>

                                    <a href="/services/addservice"><button
                                            class="btn btn-sm btn-rounded btn-primary  <%= accessdata.roll.service.includes('write') ?'':'d-none' %> mb-2">
                                            <i class="fa fa-plus color-info me-2"></i></span>
                                            <%= language.Add_New_Services %>
                                        </button></a>
                                </div>
                            </div>
                            <div class="card-body">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="server-dt-toolbar">
                                    <div class="server-dt-search">
                                        <i class="fa fa-search"></i>
                                        <input type="search" id="dtServiceSearch" placeholder="<%= language.Search || 'Search services...' %>">
                                    </div>
                                    <div class="server-dt-filters">
                                        <select class="server-dt-select" id="dtServiceStatus">
                                            <option value="all"><%= language.All_Status || 'All Status' %></option>
                                            <option value="0"><%= language.Active || 'Active' %></option>
                                            <option value="1"><%= language.Deactive || 'Deactive' %></option>
                                        </select>

                                        <% if (ismulty) { %>
                                            <select class="server-dt-select" id="dtServiceStore">
                                                <option value="all"><%= language.All_Store || 'All Stores' %></option>
                                                <% (storeList || []).forEach(function(st) { %>
                                                    <option value="<%= st.id %>"><%= st.name %></option>
                                                <% }) %>
                                            </select>
                                        <% } %>

                                        <select class="server-dt-select" id="dtServicePageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_service_table" class="table display server-side-dt" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th><%= language.Service_Name %></th>
                                                <th class="text-center"><%= language.Service_Type %></th>
                                                <th class="<%= ismulty ? '' : 'd-none' %>"><%= language.Store_Name %></th>
                                                <th style="width: 110px;"><%= language.Status %></th>
                                                <th class="text-center" style="width: 110px;"><%= language.Action %></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!--********** Content body end **********-->

        </div>
        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

        <!--**********************************
            Footer end
        ***********************************-->

        </div>

        <!--********** Main wrapper end **********-->
        <%- include('templet/script')-%>

        <script>
            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                  .replace(/&/g, '&amp;')
                  .replace(/</g, '&lt;')
                  .replace(/>/g, '&gt;')
                  .replace(/"/g, '&quot;')
                  .replace(/'/g, '&#039;');
            }

            $(document).ready(function() {
                const isMultistore = <%= ismulty ? 'true' : 'false' %>;

                const columns = [
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function(data, type, row, meta) {
                            return meta.settings._iDisplayStart + meta.row + 1;
                        }
                    },
                    {
                        data: 'name',
                        render: function(data, type, row) {
                            const imgHtml = row.image 
                                ? `<img class="rounded-3 me-2 border" width="44" height="44" style="object-fit: cover;" src="../uploads/${escapeHtml(row.image)}" alt="" onerror="this.style.display='none'">` 
                                : '';
                            return `
                                <div class="d-flex align-items-center">
                                    ${imgHtml}
                                    <span class="fw-bold text-dark">${escapeHtml(data)}</span>
                                </div>
                            `;
                        }
                    },
                    {
                        data: 'serviceType',
                        className: 'text-center',
                        render: function(data) {
                            if (!data) return '<span class="text-muted">—</span>';
                            const types = String(data).split(',');
                            return types.map(t => `<span class="badge bg-light text-dark border m-1">${escapeHtml(t.trim())}</span>`).join('');
                        }
                    }
                ];

                if (isMultistore) {
                    columns.push({
                        data: 'store',
                        render: function(data) {
                            return `<span class="badge bg-light text-dark px-2 py-1">${escapeHtml(data) || '—'}</span>`;
                        }
                    });
                }

                columns.push({
                    data: 'status',
                    render: function(data) {
                        if (data === 0) {
                            return '<span class="badge-status-pill badge-pill-completed"><i class="fa fa-check-circle"></i> <%= language.Active || "Active" %></span>';
                        }
                        return '<span class="badge-status-pill badge-pill-pending"><i class="fa fa-times-circle"></i> <%= language.Deactive || "Deactive" %></span>';
                    }
                });

                columns.push({
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center',
                    render: function(data, type, row) {
                        let html = '<div class="tbl-action-group justify-content-center">';
                        if (row.canEdit) {
                            html += `
                                <a href="/services/updateService/${row.id}" class="btn-dt-action btn-edit" title="<%= language.Edit || 'Edit' %>">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                            `;
                        }
                        if (row.canDelete) {
                            html += `
                                <a href="/services/deletservices/${row.id}" class="btn-dt-action btn-delete" title="<%= language.Delete || 'Delete' %>" onclick="return confirm('<%= language.Are_you_sure_delete || 'Are you sure you want to delete this service?' %>');">
                                    <i class="fa fa-trash"></i>
                                </a>
                            `;
                        }
                        html += '</div>';
                        return html;
                    }
                });

                window.serviceTable = window.initServerDataTable('#server_service_table', {
                    ajaxUrl: '/services/list/data',
                    columns: columns,
                    order: [[0, 'desc']],
                    searchInput: '#dtServiceSearch',
                    pageLengthSelect: '#dtServicePageLength',
                    filterElements: {
                        status_filter: '#dtServiceStatus',
                        store_filter: '#dtServiceStore'
                    }
                });
            });
        </script>
</body>


</html>