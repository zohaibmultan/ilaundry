<!DOCTYPE html>
<html lang="en" class="h-100">


<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-3">
                            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                                        <i class="fa fa-layer-group text-primary me-2"></i><%= language.Services %>
                                    </h3>
                                    <small class="text-muted"><%= language.Services_Subtitle || 'Manage laundry service catalog, pricing, and category assignments' %></small>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <% if ((accessdata?.logas === 'master' || accessdata?.isstore === true) && accessdata?.topbardata?.is_staff == 0) { %>
                                    <a href="/services/csv_file" class="btn btn-sm btn-info">
                                        <i class="fa fa-upload me-2"></i><%= language.Bulk_Upload_Services %>
                                    </a>
                                    <% } %>

                                    <a href="/services/addservice" class="btn btn-sm btn-primary <%= accessdata.roll.service.includes('write') ?'':'d-none' %>">
                                        <i class="fa fa-plus me-2"></i><%= language.Add_New_Services %>
                                    </a>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="row g-2 mb-3">
                                    <div class="<%= ismulty ? 'col-12 col-md-4 col-lg-4' : 'col-12 col-md-6 col-lg-6' %>">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                            <input class="form-control" type="search" id="dtServiceSearch" placeholder="<%= language.Search || 'Search services...' %>">
                                        </div>
                                    </div>
                                    <div class="<%= ismulty ? 'col-6 col-sm-4 col-md-3 col-lg-3' : 'col-6 col-sm-6 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtServiceStatus">
                                            <option value="all"><%= language.All_Status || 'All Status' %></option>
                                            <option value="0"><%= language.Active || 'Active' %></option>
                                            <option value="1"><%= language.Deactive || 'Deactive' %></option>
                                        </select>
                                    </div>

                                    <% if (ismulty) { %>
                                        <div class="col-6 col-sm-4 col-md-3 col-lg-3">
                                            <select class="form-select" id="dtServiceStore">
                                                <option value="all"><%= language.All_Store || 'All Stores' %></option>
                                                <% (storeList || []).forEach(function(st) { %>
                                                    <option value="<%= st.id %>"><%= st.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    <% } %>

                                    <div class="<%= ismulty ? 'col-12 col-sm-4 col-md-2 col-lg-2' : 'col-12 col-sm-6 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtServicePageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_service_table" class="table display server-side-dt" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th><%= language.Service_Name %></th>
                                                <th class="text-center"><%= language.Service_Type %></th>
                                                <th class="<%= ismulty ? '' : 'd-none' %>"><%= language.Store_Name %></th>
                                                <th style="width: 110px;"><%= language.Status %></th>
                                                <th class="text-center" style="width: 110px;"><%= language.Action %></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!--********** Content body end **********-->

        <!-- Modal delete confirm -->
        <div class="modal fade" id="deleteServiceModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                <div class="modal-content text-center p-3" style="border-radius: 16px;">
                    <div class="modal-body pt-4">
                        <div class="mb-3">
                            <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
                                <i class="fa fa-trash-alt"></i>
                            </div>
                        </div>
                        <h4 class="mb-2 fw-bold text-dark"><%= language.Delete_Service || language.Delete || 'Delete Service' %></h4>
                        <p class="text-muted mb-1"><%= language.Are_you_sure_delete || 'Are you sure you want to delete this service?' %></p>
                        <p class="fw-bold text-danger fs-5 mb-3" id="deleteServiceModalTitle"></p>
                        <p class="text-xs text-muted mb-4"><%= language.Action_cannot_be_undone || 'This action cannot be undone.' %></p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                            </button>
                            <a href="#" id="deleteServiceConfirmBtn" class="btn btn-danger">
                                <i class="fa fa-trash me-2"></i><%= language.Delete || 'Yes, Delete' %>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

        <!--**********************************
            Footer end
        ***********************************-->

        </div>

        <!--********** Main wrapper end **********-->
        <%- include('templet/script')-%>

        <script>
            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                  .replace(/&/g, '&amp;')
                  .replace(/</g, '&lt;')
                  .replace(/>/g, '&gt;')
                  .replace(/"/g, '&quot;')
                  .replace(/'/g, '&#039;');
            }

            $(document).ready(function() {
                const isMultistore = <%= ismulty ? 'true' : 'false' %>;

                const columns = [
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function(data, type, row, meta) {
                            return meta.settings._iDisplayStart + meta.row + 1;
                        }
                    },
                    {
                        data: 'name',
                        render: function(data, type, row) {
                            const imgHtml = row.image 
                                ? `<img class="rounded-3 me-2 border" width="44" height="44" style="object-fit: cover;" src="../uploads/${escapeHtml(row.image)}" alt="" onerror="this.style.display='none'">` 
                                : '';
                            return `
                                <div class="d-flex align-items-center">
                                    ${imgHtml}
                                    <span class="fw-bold text-dark">${escapeHtml(data)}</span>
                                </div>
                            `;
                        }
                    },
                    {
                        data: 'serviceType',
                        className: 'text-center',
                        render: function(data) {
                            if (!data) return '<span class="text-muted">—</span>';
                            const types = String(data).split(',');
                            return types.map(t => `<span class="badge bg-light text-dark border m-1">${escapeHtml(t.trim())}</span>`).join('');
                        }
                    }
                ];

                if (isMultistore) {
                    columns.push({
                        data: 'store',
                        render: function(data) {
                            return `<span class="badge bg-light text-dark px-2 py-1">${escapeHtml(data) || '—'}</span>`;
                        }
                    });
                }

                columns.push({
                    data: 'status',
                    render: function(data) {
                        if (data === 0) {
                            return '<span class="badge-status-pill badge-pill-completed"><i class="fa fa-check-circle"></i> <%= language.Active || "Active" %></span>';
                        }
                        return '<span class="badge-status-pill badge-pill-pending"><i class="fa fa-times-circle"></i> <%= language.Deactive || "Deactive" %></span>';
                    }
                });

                columns.push({
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: 'text-center',
                    render: function(data, type, row) {
                        let html = '<div class="tbl-action-group justify-content-center">';
                        if (row.canEdit) {
                            html += `
                                <a href="/services/updateService/${row.id}" class="btn-dt-action btn-edit" title="<%= language.Edit || 'Edit' %>">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                            `;
                        }
                        if (row.canDelete) {
                            html += `
                                <button type="button" class="btn-dt-action btn-delete btn-delete-service" 
                                   data-bs-toggle="modal"
                                   data-bs-target="#deleteServiceModal"
                                   data-id="${row.id}"
                                   data-name="${escapeHtml(row.name || '')}"
                                   title="<%= language.Delete || 'Delete' %>">
                                    <i class="fa fa-trash"></i>
                                </button>
                            `;
                        }
                        html += '</div>';
                        return html;
                    }
                });

                window.serviceTable = window.initServerDataTable('#server_service_table', {
                    ajaxUrl: '/services/list/data',
                    columns: columns,
                    order: [[0, 'desc']],
                    searchInput: '#dtServiceSearch',
                    pageLengthSelect: '#dtServicePageLength',
                    filterElements: {
                        status_filter: '#dtServiceStatus',
                        store_filter: '#dtServiceStore'
                    }
                });

                // Populate Delete Modal
                $(document).on('click', '.btn-delete-service', function () {
                    const id = $(this).attr('data-id');
                    const cleanId = String(id).replace(/['"]/g, '').trim();
                    const name = $(this).attr('data-name') || '';

                    $('#deleteServiceModalTitle').text(name || ('#' + cleanId));
                    $('#deleteServiceConfirmBtn').attr('href', '/services/deletservices/' + cleanId);
                });
            });
        </script>
</body>


</html>