                  <div class="d-flex justify-content-between py-1.5 px-2 align-items-center bg-danger-subtle rounded border border-danger-subtle mt-1">
                    <span class="fw-bold text-danger"><%= language.Balance %>:</span>
                    <span class="fw-bold text-danger fs-5 paysymbol extsymbol pamtsymbol" id="POS_total_balance">0.00</span>
