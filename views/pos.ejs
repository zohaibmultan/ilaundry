<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
  <%- include('templet/meta') -%>
  <link rel="stylesheet" href="/css/pos-compact.css?v=6">
</head>

<body class="pos-screen-layout">
  <%
    const isEditMode = Boolean((typeof isEdit !== 'undefined' && isEdit) || (typeof cart !== 'undefined' && cart && cart.isEdit));

    // Defensive date & time formatting helpers using local timezone
    const formatLocalDate = (d) => {
      if (!d) return '';
      const dt = new Date(d);
      if (isNaN(dt.getTime())) return '';
      const y = dt.getFullYear();
      const m = String(dt.getMonth() + 1).padStart(2, '0');
      const day = String(dt.getDate()).padStart(2, '0');
      return `${y}-${m}-${day}`;
    };

    const formatLocalTime = (d, fallback = '16:00') => {
      if (!d) return fallback;
      const dt = new Date(d);
      if (isNaN(dt.getTime())) return fallback;
      const hh = String(dt.getHours()).padStart(2, '0');
      const mm = String(dt.getMinutes()).padStart(2, '0');
      return (hh !== '00' || mm !== '00') ? `${hh}:${mm}` : fallback;
    };

    const normalizeOrderTypeStr = (str) => {
      if (!str) return 'Counter • Counter';
      let s = String(str).trim();
      s = s.replace(/\b(Counter|Route)\s*[-]\s*(Counter|Route)\b/gi, (m, a, b) => a + ' • ' + b);
      s = s.replace(/\s*([•&–—]|\s-\s)\s*/g, ' • ');
      s = s.replace(/^([CR])\s*[-•&]\s*([CR])$/i, (m, a, b) => a.toUpperCase() + ' • ' + b.toUpperCase());
      return s;
    };
    const currentOrderType = cart.order_type || 'Counter • Counter';
    const normalizedOT = normalizeOrderTypeStr(currentOrderType);
    const isRoutePickup = /^(R • R|R • C|Route • Route|Route • Counter|Pick-up • Delivery|Pick-up • Counter|Store collection • Store delivery)/i.test(normalizedOT);
    const isRouteDelivery = /^(R • R|C • R|Route • Route|Counter • Route|Pick-up • Delivery|Counter • Delivery|Customer drop-off • Store delivery|Store collection • Store delivery)/i.test(normalizedOT);

    const fullDate = formatLocalDate(cart.order_date) || formatLocalDate(new Date());
    const ready_fullDate = formatLocalDate(cart.ready_date || cart.delivery_date || cart.order_date) || fullDate;
    const ready_time = formatLocalTime(cart.ready_date || cart.delivery_date, '16:00');

    const pick_fullDate = formatLocalDate(cart.pickup_date || cart.order_date) || fullDate;
    const pick_time = formatLocalTime(cart.pickup_date, '10:00');
    const pick_hour = (pick_time && pick_time.includes(':')) ? (pick_time.split(':')[0].padStart(2, '0') + ':00') : '10:00';

    const del_fullDate = formatLocalDate(cart.delivery_date || cart.ready_date || cart.order_date) || ready_fullDate;
    const del_time = formatLocalTime(cart.delivery_date, '16:00');
    const del_hour = (del_time && del_time.includes(':')) ? (del_time.split(':')[0].padStart(2, '0') + ':00') : '16:00';

    const hourSlots = [];
    for (let h = 0; h < 24; h++) {
      const val = String(h).padStart(2, '0') + ':00';
      const period = h >= 12 ? 'PM' : 'AM';
      const displayH = h % 12 === 0 ? 12 : h % 12;
      const label = `${String(displayH).padStart(2, '0')}:00 ${period}`;
      hourSlots.push({ value: val, label });
    }

    // Cart addon ids safe parsing
    const cartAddonIds = Array.isArray(cart?.addon_id)
      ? cart.addon_id.map(String)
      : String(cart?.addon_id || '').split(',').map(s => s.trim());

    const GARMENT_COLORS = [
      { name: 'Black', hex: '#000000' },
      { name: 'White', hex: '#FFFFFF', border: true },
      { name: 'Gray', hex: '#808080' },
      { name: 'Charcoal', hex: '#36454F' },
      { name: 'Navy', hex: '#000080' },
      { name: 'Blue', hex: '#2563EB' },
      { name: 'Light Blue', hex: '#93C5FD' },
      { name: 'Red', hex: '#DC2626' },
      { name: 'Burgundy', hex: '#800020' },
      { name: 'Pink', hex: '#F472B6' },
      { name: 'Purple', hex: '#800080' },
      { name: 'Lavender', hex: '#E6E6FA', border: true },
      { name: 'Green', hex: '#16A34A' },
      { name: 'Olive', hex: '#808000' },
      { name: 'Yellow', hex: '#EAB308' },
      { name: 'Orange', hex: '#F97316' },
      { name: 'Brown', hex: '#8B4513' },
      { name: 'Beige', hex: '#F5F5DC', border: true },
      { name: 'Cream', hex: '#FFFDD0', border: true },
      { name: 'Khaki', hex: '#C3B091' },
      { name: 'Multi-Color', hex: 'linear-gradient(135deg, #ef4444, #eab308, #22c55e, #3b82f6)', isGradient: true },
      { name: 'Other', hex: '#94A3B8' },
      { name: 'Unknown', hex: '#64748B' }
    ];

    const GARMENT_PATTERNS = [
      'Solid', 'Striped', 'Pinstripe', 'Plaid', 'Checkered',
      'Gingham', 'Houndstooth', 'Herringbone', 'Polka Dot', 'Floral',
      'Paisley', 'Geometric', 'Animal Print', 'Camouflage', 'Abstract / Graphic',
      'Embroidered', 'Printed', 'Textured', 'Color Block', 'Other', 'Unknown'
    ];

    const getColorHex = (name) => {
      if (!name) return '#000000';
      const c = GARMENT_COLORS.find(x => x.name.toLowerCase() === String(name).trim().toLowerCase());
      return c ? c.hex : (name.startsWith('#') ? name : '#000000');
    };
  %>

  <%- include('templet/preloder_topbar_sidebar', { titel: accessdata?.topbardata?.name }) -%>

  <!--********** Content body start **********-->
  <div class="content-body pos-content-body">
    <div class="container-fluid min-vh-100">

      <!-- Mobile / Tablet Segmented View Switcher (<992px) -->
      <div class="pos-responsive-segmented-bar d-lg-none">
        <button type="button" class="pos-segmented-btn active" id="posBtnShowCatalog" onclick="switchPosMobileTab('catalog')">
          <i class="fas fa-tshirt"></i>
          <span><%= language.Services || 'Services' %></span>
        </button>
        <button type="button" class="pos-segmented-btn" id="posBtnShowCart" onclick="switchPosMobileTab('cart')">
          <i class="fas fa-shopping-cart"></i>
          <span><%= language.Order_Cart || 'Cart & Checkout' %></span>
          <span class="badge bg-primary text-white ms-1 rounded-pill" id="posMobileCartBadge"><%= cart.order_item ? cart.order_item.length : 0 %></span>
        </button>
      </div>

      <div class="row pos-main-row">
        <!-- Configuration & Hidden Parameters -->
        <div class="d-none">
          <input type="hidden" name="sym" value="<%= accessdata?.symbol || '$' %>">
          <input type="hidden" name="pls" value="<%= accessdata?.plac || '1' %>">
          <input type="hidden" name="thousands_separator" value="<%= accessdata?.thousands_separator || ',' %>">
          <input type="hidden" id="pos_override_rate_percent" value="<%= (typeof overrideRatePercent !== 'undefined' && overrideRatePercent !== null) ? overrideRatePercent : 10 %>">
          <% if (isEditMode) { %>
          <input type="hidden" id="pos_mode" value="edit">
          <input type="hidden" id="order_id" name="order_id" value="<%= cart.id %>">
          <% } else { %>
          <input type="hidden" id="pos_mode" value="create">
          <% } %>
        </div>

        <!-- Left Column: Service Catalog & POS Top Nav -->
        <div class="col-lg-6 pos-tab-panel-catalog" id="posCatalogColumn">
          <!-- POS Top Compact Menu Bar -->
          <div class="card pos-menu-bar border-0 shadow-sm rounded-3 mb-2">
            <div class="card-body p-1.5 px-2 d-flex align-items-center justify-content-between">
              <!-- Left Section: Navigation & Store Identity -->
              <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm pos-menu-btn d-flex align-items-center justify-content-center" id="pos_sidebar_toggle" title="Toggle Sidebar">
                  <i class="fa fa-bars fs-14"></i>
                </button>

                <% if (typeof showStoreSelect !== 'undefined' && showStoreSelect) { %>
                  <select class="default-select fw-bold text-dark" name="store" id="pos_store_id" data-live-search="true" required>
                    <option value="0" <%= (!cart.store_id || cart.store_id == 0) ? 'selected' : '' %> disabled><%= language.Select_Store || 'Select Store' %></option>
                    <% storeList.forEach(function(x) { %>
                    <option value="<%= x.id %>" <%= (cart.store_id == x.id) ? 'selected' : '' %>><%= x.name %></option>
                    <% }) %>
                  </select>
                  <% } else { %>
                    <input type="hidden" name="store" id="pos_store_id" value="<%= typeof assignedStoreId !== 'undefined' ? assignedStoreId : '' %>">
                    <input type="hidden" id="pos_staff_store_id" value="<%= typeof assignedStoreId !== 'undefined' ? assignedStoreId : '' %>">
                    <strong class="text-dark fs-14"><%= assignedStoreName || 'Main Store' %></strong>
                <% } %>

              </div>

              <!-- Right Section: Printer Status, Theme, Notifications & Profile -->
              <div class="d-flex align-items-center gap-2">
                <!-- Printing Server Live Status Badge Dropdown -->
                <div class="dropdown pos-printer-dropdown">
                  <button class="btn btn-sm pos-printer-badge-btn dropdown-toggle d-flex align-items-center gap-1" type="button" id="posPrinterStatusBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Printing Server Status">
                    <span class="pos-printer-dot dot-checking" id="posPrinterStatusDot"></span>
                    <span class="pos-printer-label d-none d-md-inline" id="posPrinterStatusText">Checking Printer...</span>
                    <i class="fas fa-chevron-down ms-1" style="font-size: 8px; opacity: 0.7;"></i>
                  </button>
                  <div class="dropdown-menu dropdown-menu-end pos-printer-popover p-3 shadow-lg" aria-labelledby="posPrinterStatusBtn" style="min-width: 290px; border-radius: 12px; z-index: 1060;">
                    <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                      <strong class="fs-13"><i class="fas fa-print me-1 text-primary"></i> Silent Printing Service</strong>
                      <span class="badge" id="posPopoverStatusBadge">Checking</span>
                    </div>
                    <div class="small mb-2">
                      <div class="d-flex justify-content-between text-muted mb-1">
                        <span>Server URL:</span>
                        <span class="fw-semibold text-dark" id="posPopoverServerUrl">
                          <%= accessdata?.masterstore?.printing_server_url || 'http://127.0.0.1:4321' %>
                        </span>
                      </div>
                      <div class="d-flex justify-content-between text-muted mb-1">
                        <span>Active Printer:</span>
                        <span class="fw-semibold text-dark text-truncate" style="max-width: 150px;" id="posPopoverPrinterName">
                          <%= accessdata?.masterstore?.invoice_printer_name || 'System Default' %>
                        </span>
                      </div>
                      <div class="d-flex justify-content-between text-muted mb-1">
                        <span>Format:</span>
                        <span class="fw-semibold text-dark">
                          <%= accessdata?.masterstore?.invoice_printer_format == 2 ? '58mm Roll' : (accessdata?.masterstore?.invoice_printer_format == 0 ? 'A4 Sheet' : '80mm Thermal') %>
                        </span>
                      </div>
                      <div class="d-flex justify-content-between text-muted">
                        <span>Mode:</span>
                        <span class="fw-semibold" id="posPopoverModeText">Auto-detecting...</span>
                      </div>
                    </div>
                    <div class="d-grid gap-2 pt-2 border-top">
                      <button type="button" class="btn btn-outline-primary btn-xs w-100" onclick="pingPosPrintingServer(true)">
                        <i class="fas fa-sync-alt me-1"></i> Check Connection Now
                      </button>
                      <% if (login === 'master') { %>
                      <a href="/tool/setting" class="btn btn-light btn-xs text-center text-muted w-100">
                        <i class="fas fa-cog me-1"></i> Hardware Settings
                      </a>
                      <% } %>
                    </div>
                  </div>
                </div>

                <!-- Light/Dark Theme Switcher Button -->
                <button type="button" class="btn btn-sm pos-header-icon-btn pos-theme-toggle" id="pos_theme_toggle" onclick="window.toggleAppTheme(event)" title="Toggle Dark/Light Mode">
                  <div class="mode" data-id="dark">
                    <svg class="lighticon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M18.1377 13.7902C19.2217 14.8742 16.3477 21.0542 10.6517 21.0542C6.39771 21.0542 2.94971 17.6062 2.94971 13.3532C2.94971 8.05317 8.17871 4.66317 9.67771 6.16217C10.5407 7.02517 9.56871 11.0862 11.1167 12.6352C12.6647 14.1842 17.0537 12.7062 18.1377 13.7902Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    <svg class="darkicon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"></circle>
                      <path d="M12 2V4M12 20V22M4 12H2M22 12H20M19.07 4.93L17.66 6.34M6.34 17.66L4.93 19.07M19.07 19.07L17.66 17.66M6.34 6.34L4.93 4.93" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                    </svg>
                  </div>
                </button>

                <!-- Notifications Dropdown -->
                <% if (Boolean(accessdata?.logas === 'master' || (accessdata?.roll?.orders && accessdata.roll.orders.includes('read')))) { %>
                <div class="dropdown pos-notification-dropdown">
                  <button class="btn btn-sm pos-header-icon-btn position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="<%= language.Notifications || 'Notifications' %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                      <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <% if (accessdata?.notification_data?.length > 0) { %>
                    <span class="header-badge-dot"></span>
                    <% } %>
                  </button>
                  <div class="dropdown-menu dropdown-menu-end notification-glass-menu shadow-lg">
                    <div class="notif-header">
                      <div class="d-flex align-items-center gap-2">
                        <h6 class="mb-0 fw-bold"><%= language.Notifications || 'Notifications' %></h6>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 fs-11">
                          <%= accessdata?.notification_data ? accessdata.notification_data.length : 0 %>
                        </span>
                      </div>
                      <a href="/admin/notification" class="fs-12 text-primary text-decoration-none fw-medium"><%= language.View_All || 'View All' %></a>
                    </div>
                    <div class="widget-media dz-scroll" style="max-height: 320px; overflow-y: auto; overflow-x: hidden;">
                      <% if (accessdata?.notification_data?.length > 0) { %>
                      <% accessdata.notification_data.forEach((data) => { %>
                      <a href="/admin/notification" class="notif-item">
                        <div class="bg-primary-subtle text-primary rounded-circle notif-item-icon">
                          <i class="fa fa-bell fs-12"></i>
                        </div>
                        <div class="notif-item-body">
                          <div class="notif-item-text"><%= data.notification %></div>
                          <div class="notif-item-time">
                            <i class="fa fa-clock fs-10"></i>
                            <span><%= data.date %></span>
                          </div>
                        </div>
                      </a>
                      <% }) %>
                      <% } else { %>
                      <div class="text-center py-4 text-muted">
                        <i class="fa fa-bell-slash fs-2 mb-2 d-block text-secondary opacity-50"></i>
                        <span class="fs-12"><%= language.No_Notifications_Found || 'No notifications found' %></span>
                      </div>
                      <% } %>
                    </div>
                    <div class="notif-footer">
                      <a href="/admin/notification" class="d-flex align-items-center justify-content-center gap-1">
                        <span><%= language.Check_All_Notification || 'Check All Notifications' %></span>
                        <i class="fas fa-chevron-right fs-10"></i>
                      </a>
                    </div>
                  </div>
                </div>
                <% } %>

                <!-- User Profile Dropdown -->
                <%
                  let userDisplayName = accessdata?.topbardata?.name || 'Administrator';
                  let userRoleName = accessdata?.roll?.roll || '';
                  let defaultAvatar = accessdata?.logas === 'custmor' ? '/images/profile-default.png' : '/images/default.png';
                  let userAvatarImg = (accessdata?.topbardata?.img && accessdata.topbardata.img.trim() !== '' && accessdata.topbardata.img !== 'default.png')
                      ? ('/uploads/' + accessdata.topbardata.img)
                      : defaultAvatar;

                  if (accessdata?.logas === 'custmor') {
                      userRoleName = userRoleName || 'Customer';
                  } else if (accessdata?.topbardata?.is_staff != 0) {
                      userRoleName = userRoleName || 'Staff';
                  } else if (accessdata?.isstore === true || accessdata?.logas === 'store') {
                      userRoleName = userRoleName || 'Store Manager';
                  } else {
                      userRoleName = userRoleName || 'Master Admin';
                  }
                %>
                <div class="dropdown header-profile pos-profile-dropdown">
                  <a class="nav-link p-0 d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="<%= userDisplayName %>">
                    <img class="img-fluid rounded-circle" style="width: 32px; height: 32px; object-fit: cover; border: 2px solid rgba(0, 129, 238, 0.35);" src="<%= userAvatarImg %>" onerror="this.onerror=null;this.src='<%= defaultAvatar %>';" alt="avatar">
                  </a>
                  <div class="dropdown-menu dropdown-menu-end profile-glass-menu shadow-lg">
                    <div class="profile-card-header">
                      <div class="profile-header-avatar">
                        <img src="<%= userAvatarImg %>" onerror="this.onerror=null;this.src='<%= defaultAvatar %>';" alt="avatar">
                      </div>
                      <div class="profile-header-meta">
                        <h6 class="profile-user-name mb-0"><%= userDisplayName %></h6>
                        <span class="profile-role-badge"><%= userRoleName %></span>
                      </div>
                    </div>
                    <div class="profile-menu-divider"></div>
                    <div class="profile-menu-items">
                      <a href="/profile" class="profile-menu-link">
                        <div class="profile-menu-icon profile-icon-primary">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                          </svg>
                        </div>
                        <span class="profile-menu-text"><%= language.Profile || 'My Profile' %></span>
                        <i class="fas fa-chevron-right profile-chevron"></i>
                      </a>
                      <% if (login === 'master') { %>
                      <a href="/tool/master_setting" class="profile-menu-link">
                        <div class="profile-menu-icon profile-icon-info">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                          </svg>
                        </div>
                        <span class="profile-menu-text"><%= language.Master_Settings || 'Master Settings' %></span>
                        <i class="fas fa-chevron-right profile-chevron"></i>
                      </a>
                      <% } %>
                      <a href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal" class="profile-menu-link profile-menu-logout">
                        <div class="profile-menu-icon profile-icon-danger">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                          </svg>
                        </div>
                        <span class="profile-menu-text"><%= language.Logout || 'Logout' %></span>
                        <i class="fas fa-sign-out-alt profile-chevron"></i>
                      </a>
                    </div>
                  </div>
                </div>

                <!-- Direct Logout Button with Confirmation -->
                <button type="button" class="btn btn-sm pos-header-icon-btn header-logout-btn" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal" title="<%= language.Logout || 'Logout' %>">
                  <i class="fa fa-sign-out-alt text-danger fs-14"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Catalog Card: Search, Categories, Service Grid -->
          <div class="pos-card">
            <div class="pos-card-body">
              <div class="pos-search-box w-100 mb-2">
                <i class="fa fa-search pos-search-icon"></i>
                <input type="text" class="form-control pos-search-input" id="service_pos_search" placeholder="Search services..." autocomplete="off">
                <span class="pos-search-clear" id="pos_search_clear" style="display:none;" title="Clear search">
                  <i class="fa fa-times"></i>
                </span>
              </div>

              <!-- Category & Subcategory Filter Tabs -->
              <div class="pos-category-filter-container mb-2">
                <!-- Primary Category Pills -->
                <div class="d-flex align-items-center gap-1 overflow-auto pb-1" id="pos_category_pills" style="scrollbar-width: thin; -webkit-overflow-scrolling: touch;">
                  <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 pos-cat-pill active text-nowrap fw-semibold" data-cat-id="all">
                    <i class="fas fa-layer-group me-1"></i> All
                  </button>
                  <% if (typeof categoryList !== 'undefined' && categoryList && categoryList.length > 0) { %>
                  <% categoryList.forEach(function(cat) { %>
                  <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 pos-cat-pill text-nowrap" data-cat-id="<%= cat.id %>">
                    <%= cat.name %>
                  </button>
                  <% }) %>
                  <% } %>
                </div>

                <!-- Secondary Subcategory Pills -->
                <div class="d-flex align-items-center gap-1 overflow-auto pt-1 pb-1 d-none" id="pos_subcategory_pills" style="scrollbar-width: thin; -webkit-overflow-scrolling: touch;">
                  <button type="button" class="btn btn-xs btn-primary rounded-pill px-2 py-0 pos-subcat-pill active text-nowrap" data-subcat-id="all">
                    All Subcategories
                  </button>
                  <% if (typeof subcategoryList !== 'undefined' && subcategoryList && subcategoryList.length > 0) { %>
                  <% subcategoryList.forEach(function(sub) { %>
                  <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill px-2 py-0 pos-subcat-pill text-nowrap" data-subcat-id="<%= sub.id %>" data-parent-cat-id="<%= sub.category_id %>" style="display: none;">
                    <%= sub.name %>
                  </button>
                  <% }) %>
                  <% } %>
                </div>
              </div>

              <!-- Services Catalog Grid -->
              <div class="pos-services-grid mt-2" id="pos_service">
                <% if (service_list.length < 1 && login === 'master' && (!cart.store_id || cart.store_id == 0)) { %>
                <div class="p-3 text-center w-100">
                  <h5 class="text-muted"><%= language.Please_Select_Store || 'Please Select Store' %></h5>
                </div>
                <% } else if (service_list.length < 1) { %>
                <div class="p-3 text-center w-100">
                  <h5 class="text-center text-danger"><%= language.Not_listed_any_services_yet || 'No services found' %></h5>
                </div>
                <% } else { %>
                <% service_list.forEach(function(data) { %>
                <a href="javascript:void(0)" class="pos-service-item services text-decoration-none" data-name="<%= (data.name || '').toLowerCase() %>" data-category-id="<%= data.category_id || '' %>" data-subcategory-id="<%= data.subcategory_id || '' %>" data-bs-toggle="modal" data-bs-target="#service_type_model" data-id="<%= data.id %>">
                  <div class="card h-100 shadow-sm border rounded-3 text-center overflow-hidden pos-service-card position-relative">
                    <% if (data.no_of_items && parseInt(data.no_of_items) > 1) { %>
                    <span class="position-absolute top-0 end-0 badge bg-primary text-white m-1 rounded-pill shadow-sm" style="z-index: 2; font-size: 0.7rem;">
                      <%= data.no_of_items %> Pcs
                    </span>
                    <% } %>
                    <div class="ratio ratio-1x1 bg-light position-relative">
                      <img src="/uploads/<%= data.image %>" class="card-img-top w-100 h-100" style="object-fit: cover;" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none'); this.nextElementSibling.classList.add('d-flex');" alt="<%= data.name %>">
                      <div class="pos-service-fallback-icon position-absolute top-0 start-0 w-100 h-100 align-items-center justify-content-center text-primary fs-3 d-none">
                        <i class="fa fa-tshirt"></i>
                      </div>
                    </div>
                    <div class="card-body p-2 d-flex align-items-center justify-content-center">
                      <h6 class="card-title m-0 fw-bold fs-7 pos-service-name" title="<%= data.name %>">
                        <%= data.name %>
                      </h6>
                    </div>
                  </div>
                </a>
                <% }) %>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Cart, Scheduling, Intelligence, Totals -->
        <div class="col-lg-6 pos-tab-panel-cart pos-panel-hidden" id="posCartColumn">
          <div class="pos-card pos-cart-card">
            <div class="pos-card-body">
              <div class="row g-3">
                <!-- Order Number -->
                <div class="col-sm-3">
                  <label class="pos-field-label mb-0">
                    <%= language.Order_No || 'Order #' %> <span class="text-danger">*</span>
                  </label>
                  <input type="text" id="pos_order_id" class="form-control pos-input-sm w-100 fw-bold text-dark" value="<%= cart.order_id %>" readonly title="Order ID">
                </div>

                <!-- Order Date -->
                <div class="col-3">
                  <label class="pos-field-label mb-0">
                    <%= language.Order_Date || 'Order Date' %> <span class="text-danger">*</span>
                  </label>
                  <input type="date" class="form-control pos-input-sm w-100 fw-bold text-dark" id="<%= isEditMode ? 'edit_POS_order_date' : 'POS_order_date' %>" value="<%= fullDate %>" title="<%= language.Order_Date || 'Order Date' %>" <%= login === 'customer' ? 'readonly' : '' %>>
                </div>

                <!-- Ready Date Time -->
                <div class="col-6" id="<%= isEditMode ? 'edit_pos_ready_date_group' : 'pos_ready_date_group' %>">
                  <div class="d-flex align-items-center justify-content-between" style="margin-bottom: 5px">
                    <label class="pos-field-label">
                      <%= language.Ready_Schedule || 'Ready Schedule' %>
                    </label>
                    <button type="button" class="btn btn-outline-primary py-0 px-2 border-0 btn-auto-ready-sched fs-11 fw-bold" id="<%= isEditMode ? 'btn_auto_edit_ready_schedule' : 'btn_auto_ready_schedule' %>" title="Reset to automated ready schedule">
                      <i class="fas fa-magic me-1"></i>Auto
                    </button>
                  </div>
                  <div class="input-group input-group-sm">
                    <input type="date" class="form-control pos-input-sm fw-bold" id="<%= isEditMode ? 'edit_POS_ready_date' : 'POS_ready_date' %>" name="<%= isEditMode ? 'edit_pos_ready_date' : 'pos_ready_date' %>" value="<%= ready_fullDate %>" min="<%= fullDate %>" title="<%= language.Ready_Schedule || 'Ready Schedule Date' %>" <%= login === 'customer' ? 'readonly' : '' %>>
                    <input type="time" class="form-control pos-input-sm fw-bold" id="<%= isEditMode ? 'edit_POS_ready_time' : 'POS_ready_time' %>" name="<%= isEditMode ? 'edit_pos_ready_time' : 'pos_ready_time' %>" value="<%= ready_time %>" title="Ready Time" <%= login === 'customer' ? 'readonly' : '' %>>
                  </div>
                </div>

                <!-- Customer -->
                <div class="col-6">
                  <% if (isEditMode) { %>
                    <label class="pos-field-label mb-0"><%= language.Customer || 'Customer' %></label>
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-light-subtle border-end-0 py-0 px-2 text-primary">
                        <i class="fa fa-user"></i>
                      </span>
                      <input type="text" class="form-control pos-input-sm border-start-0 ps-1 fw-semibold text-dark" value="<%= (typeof order_date !== 'undefined' && order_date[0] && order_date[0].customer_name) ? order_date[0].customer_name : ((customerList.find(c => c.id == cart.customer_id) || {}).name || 'Customer') %>" readonly>
                    </div>
                    <input type="hidden" id="single-select" name="customer" value="<%= cart.customer_id %>">
                    <input type="hidden" id="customer_id" value="<%= cart.customer_id %>">
                    <input type="hidden" name="store" id="pos_store_id" value="<%= cart.store_id %>">
                    <input type="hidden" id="pos_staff_store_id" value="<%= cart.store_id %>">
                  <% } else if (login === 'customer') { %>
                    <label class="pos-field-label mb-0"><%= language.Customer || 'Customer' %></label>
                    <div class="input-group input-group-sm">
                      <span class="input-group-text bg-light-subtle border-end-0 py-0 px-2 text-primary">
                        <i class="fa fa-user"></i>
                      </span>
                      <input type="text" class="form-control pos-input-sm border-start-0 ps-1 fw-semibold text-dark" value="<%= (customerList && customerList[0] && customerList[0].name) ? customerList[0].name : 'Customer' %>" readonly>
                    </div>
                    <input type="hidden" name="store" id="pos_store_id" value="<%= typeof assignedStoreId !== 'undefined' ? assignedStoreId : '' %>">
                    <input type="hidden" id="pos_staff_store_id" value="<%= typeof assignedStoreId !== 'undefined' ? assignedStoreId : '' %>">
                    <input type="hidden" id="single-select" name="customer" value="<%= (customerList && customerList[0]) ? customerList[0].id : (cart.customer_id || 0) %>">
                  <% } else { %>
                    <%
                      let selectedCustomerObj = null;
                      customerList.forEach(function(x) {
                        let isWalkIn = (!x.username || (x.name && x.name.toLowerCase().includes('walkin')));
                        if (cart.customer_id == x.id || (!selectedCustomerObj && (typeof isDefaultCustomerEnabled === 'undefined' || isDefaultCustomerEnabled) && (typeof showStoreSelect !== 'undefined' && !showStoreSelect) && (!cart.customer_id || cart.customer_id == 0) && isWalkIn)) {
                          selectedCustomerObj = x;
                        }
                      });
                      let initialCustomerDisplayText = '';
                      if (selectedCustomerObj) {
                        let cName = (selectedCustomerObj.last_name && selectedCustomerObj.first_name)
                          ? (selectedCustomerObj.last_name + ', ' + selectedCustomerObj.first_name)
                          : (selectedCustomerObj.name || '');
                        let cPhone = selectedCustomerObj.number || '';
                        initialCustomerDisplayText = cPhone ? (cName + ' (' + cPhone + ')') : cName;
                      }
                      let isStoreUnselected = (typeof showStoreSelect !== 'undefined' && showStoreSelect && (!cart.store_id || cart.store_id == 0));
                    %>
                    <div class="d-flex align-items-center justify-content-between" style="margin-bottom: 5px">
                      <label class="pos-field-label mb-0">
                        <%= language.Select_Customer || 'Select Customer' %> <span class="text-danger">*</span>
                      </label>
                      <div class="d-flex align-items-center gap-1">
                        <a href="javascript:void(0)" class="btn btn-xs btn-primary-subtle text-primary border rounded-pill px-2 py-0 fw-semibold d-inline-flex align-items-center gap-1 fs-11" data-bs-toggle="modal" data-bs-target="#addcustomer">
                          <i class="fa fa-plus fs-10"></i> <%= language.Add || 'New Customer' %>
                        </a>
                      </div>
                    </div>
                    <div class="input-group input-group-sm pos-cust-selector-trigger" id="pos_customer_trigger_box" role="button" tabindex="0" title="Click to search and select customer">
                      <span class="input-group-text bg-light-subtle border-end-0 py-0 px-2 text-primary">
                        <i class="fa fa-user"></i>
                      </span>
                      <input type="text" id="pos_customer_display_input" class="form-control pos-input-sm border-start-0 border-end-0 ps-1 fw-bold text-dark" readonly placeholder="<%= isStoreUnselected ? (language.Select_Store_First || 'Select Store First') : (language.Select_Customer || 'Click to select customer...') %>" value="<%= initialCustomerDisplayText %>">
                      <span class="input-group-text bg-light-subtle border-start-0 py-0 px-2 text-primary">
                        <i class="fa fa-search fs-11"></i>
                      </span>
                    </div>
                    <select id="single-select" name="customer" class="d-none" required <%= isStoreUnselected ? 'disabled' : '' %>>
                      <option value="0" disabled <%= (!selectedCustomerObj) ? 'selected' : '' %>>
                        <%= isStoreUnselected ? (language.Select_Store_First || 'Select Store First') : (language.Select_Customer || 'Select Customer') %>
                      </option>
                      <% customerList.forEach(function(x) { %>
                      <%
                        let showExtra = "";
                        if ((!x.username) && (!x.email) && (!x.number)) {
                          if (accessdata.logas != 'store') { showExtra = x.store_name; }
                        } else {
                          showExtra = x.number;
                        }
                        let isSelected = (selectedCustomerObj && selectedCustomerObj.id == x.id) ? 'selected' : '';
                      %>
                      <option value="<%= x.id %>" data-customer-type="<%= x.customer_type || 'Counter • Counter' %>" data-address="<%= x.address || '' %>" data-city="<%= x.city || '' %>" data-state="<%= x.state || '' %>" data-zipcode="<%= x.zipcode || '' %>" <%= isSelected %>>
                        <%= x.name %><% if (showExtra) { %> (<%= showExtra %>)<% } %>
                      </option>
                      <% }); %>
                    </select>
                  <% } %>
                </div>

                <!-- Customer Type -->
                <div class="col-6">
                  <label class="pos-field-label mb-0" for="<%= isEditMode ? 'edit_pos_order_type' : 'pos_order_type' %>">
                    <%= language.Customer_Type || 'Customer Type' %> <span class="text-danger">*</span>
                  </label>
                  <select class="form-select w-100 fw-bold" id="<%= isEditMode ? 'edit_pos_order_type' : 'pos_order_type' %>" name="<%= isEditMode ? 'edit_pos_order_type' : 'order_type' %>" <%= login === 'customer' ? 'disabled' : '' %>>
                    <option value="" disabled <%= (!cart.order_type || cart.order_type === '') ? 'selected' : '' %>><%= language.Select_Customer_Type || 'Select Customer Type' %></option>
                    <% if (typeof customer_types !== 'undefined' && customer_types && customer_types.length > 0) { %>
                    <% customer_types.forEach(function(ct, idx) { %>
                    <option value="<%= ct.name %>" data-code="<%= ct.code || '' %>" title="<%= ct.name %><%= ct.description ? ' - ' + ct.description : '' %>" <%= (cart.order_type === ct.name || cart.order_type === ct.code || normalizedOT === ct.name || normalizedOT === ct.code || (!cart.order_type && (ct.name === 'Counter • Counter' || ct.code === 'C • C' || idx === 0))) ? 'selected' : '' %>><%= ct.name || ct.code %></option>
                    <% }); %>
                    <% } %>
                  </select>
                </div>

                <!-- Total Orders -->
                <div class="col-2 d-flex">
                  <button type="button" id="btn_pos_open_racks" class="me-2 btn btn-xs btn-outline-primary rounded-pill px-2 py-0 fw-bold d-inline-flex align-items-center gap-1 fs-11" title="View Customer Racks & Pickup (Active Invoices)" style="min-height: 22px;">
                    <span class="badge bg-primary text-white rounded-circle p-0 d-inline-flex align-items-center justify-content-center" style="width: 14px; height: 14px; font-size: 10px;">R</span>
                  </button>
                  <div class="pos-cust-stat-tile tile-total w-100" title="Total Lifetime Orders">
                    <div class="stat-meta">
                      <span class="stat-num" id="pos_cust_stat_total">0</span>
                      <span class="stat-lbl">Orders</span>
                    </div>
                  </div>
                </div>

                <!-- Unpaid Orders -->
                <div class="col-2">
                  <div class="pos-cust-stat-tile tile-unpaid" title="Orders Unpaid / Partially Paid">
                    <div class="stat-meta">
                      <span class="stat-num" id="pos_cust_stat_unpaid">0</span>
                      <span class="stat-lbl">Unpaid</span>
                    </div>
                  </div>
                </div>

                <!-- Total Due -->
                <div class="col-2">
                  <div class="pos-cust-stat-tile tile-balance" title="Total Outstanding Balance">
                    <div class="stat-meta">
                      <span class="stat-num" id="pos_cust_stat_balance"><%= accessdata?.symbol || '$' %> 0</span>
                      <span class="stat-lbl">Dues</span>
                    </div>
                  </div>
                </div>

                <!-- Customer Memo -->
                <div class="col-6">
                  <!-- Customer Memo Card with Quick-Edit -->
                  <div class="pos-cust-memo-card">
                    <!-- View Mode -->
                    <div class="memo-view-mode pt-1" id="pos_memo_view_container">
                      <p class="memo-text mb-0 text-muted" id="pos_cust_memo_text">
                        <em>Select a customer to view memo/notes.</em>
                      </p>
                    </div>

                    <!-- Quick Edit Mode (Hidden by default) -->
                    <div class="memo-edit-mode pt-1 d-none" id="pos_memo_edit_container">
                      <textarea class="form-control form-control-sm mb-1 pos-memo-textarea" id="pos_cust_memo_input" rows="2" placeholder="Add laundry preferences, allergies, or special notes..."></textarea>
                      <div class="d-flex align-items-center justify-content-end gap-1">
                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" id="btn_cancel_pos_memo">
                          Cancel
                        </button>
                        <button type="button" class="btn btn-xs btn-primary py-0 px-2" id="btn_save_pos_memo">
                          <i class="fa fa-check me-1"></i>Save Note
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Pick-up Date & Hour -->
                <div class="col-6" id="<%= isEditMode ? 'edit_pos_pickup_date_group' : 'pos_pickup_date_group' %>" style="<%= !isRoutePickup ? 'display: none;' : '' %>">
                  <label class="pos-field-label mb-0">
                    <%= language.Route_Pickup_Date || 'Route Pick-up Schedule' %>
                  </label>
                  <div class="input-group input-group-sm">
                    <input type="date" class="form-control pos-input-sm fw-bold" id="<%= isEditMode ? 'edit_POS_pickup_date' : 'POS_pickup_date' %>" name="<%= isEditMode ? 'edit_pos_pickup_date' : 'pos_pickup_date' %>" value="<%= pick_fullDate %>" min="<%= fullDate %>" title="<%= language.Route_Pickup_Date || 'Route Pick-up Date' %>" <%= login === 'customer' ? 'readonly' : '' %>>
                    <select class="form-select pos-input-sm fw-bold" id="<%= isEditMode ? 'edit_POS_pickup_time' : 'POS_pickup_time' %>" name="<%= isEditMode ? 'edit_pos_pickup_time' : 'pos_pickup_time' %>" style="max-width: 50%;" title="Pick-up Hour" <%= login === 'customer' ? 'disabled' : '' %>>
                      <% hourSlots.forEach(slot => { %>
                        <option value="<%= slot.value %>" <%= (pick_hour === slot.value) ? 'selected' : '' %>><%= slot.label %></option>
                      <% }); %>
                    </select>
                    <% if (login === 'customer') { %>
                      <input type="hidden" name="<%= isEditMode ? 'edit_pos_pickup_time' : 'pos_pickup_time' %>" value="<%= pick_hour %>">
                    <% } %>
                  </div>
                </div>

                <!-- Delivery Date & Hour -->
                <div class="col-6" id="<%= isEditMode ? 'edit_pos_delivery_date_group' : 'pos_delivery_date_group' %>" style="<%= !isRouteDelivery ? 'display: none;' : '' %>">
                  <label class="pos-field-label mb-0">
                    <%= language.Route_Delivery_Date || 'Route Delivery Schedule' %>
                  </label>
                  <div class="input-group input-group-sm">
                    <input type="date" class="form-control pos-input-sm fw-bold" id="<%= isEditMode ? 'edit_POS_delivery_date' : 'POS_delivery_date' %>" name="<%= isEditMode ? 'edit_pos_delivery_date' : 'pos_delivery_date' %>" value="<%= del_fullDate %>" min="<%= fullDate %>" title="<%= language.Route_Delivery_Date || 'Route Delivery Date' %>" <%=login==='customer' ? 'readonly' : '' %>>
                    <select class="form-select pos-input-sm fw-bold" id="<%= isEditMode ? 'edit_POS_delivery_time' : 'POS_delivery_time' %>" name="<%= isEditMode ? 'edit_pos_delivery_time' : 'pos_delivery_time' %>" style="max-width: 50%;" title="Delivery Hour" <%=login==='customer' ? 'disabled' : '' %>>
                      <% hourSlots.forEach(slot => { %>
                        <option value="<%= slot.value %>" <%= (del_hour === slot.value) ? 'selected' : '' %>><%= slot.label %></option>
                      <% }); %>
                    </select>
                    <% if (login === 'customer') { %>
                      <input type="hidden" name="<%= isEditMode ? 'edit_pos_delivery_time' : 'pos_delivery_time' %>" value="<%= del_hour %>">
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- Cart Line Items Table -->
              <div class="pos-table-scroll">
                <table class="pos-cart-table table-bordered verticle-middle text-center mb-0 <%= (cartservice && cartservice.length > 0) ? '' : 'd-none' %>" id="pos_cart_main_table">
                  <thead>
                    <tr style="border:unset">
                      <th class="text-start ps-2">
                        <%= language.Service %>
                      </th>
                      <th class="text-center" style="width: 88px;">
                        <%= language.Brand || 'Brand' %>
                      </th>
                      <th class="text-center" style="width: 150px;">
                        <%= language.Color || 'Color & Pattern' %>
                      </th>
                      <th class="text-center" style="width: 118px;">
                        <%= language.Value || 'Value' %>
                      </th>
                      <th class="text-center" style="width: 90px;">
                        <%= language.Rate %>
                      </th>
                      <th class="text-center" style="width: 78px;">
                        <%= language.Qty %>
                      </th>
                      <th class="text-center" style="width: 32px;"></th>
                    </tr>
                  </thead>
                  <tbody id="POS_service_added_list">
                    <% cartservice.forEach(function(x) { %>
                    <tr>
                      <td>
                        <div class="pos-cart-service-info">
                          <span class="pos-cart-item-title" title="<%= x.service_name %>">
                            <%= x.service_name %>
                            <% if (x.no_of_items && parseInt(x.no_of_items) > 1) { %>
                            <span class="badge bg-secondary text-white ms-1" style="font-size:0.75rem;"><%= x.no_of_items %> Pcs</span>
                            <% } %>
                          </span>
                          <span class="pos-cart-item-badge">[<%= x.service_type_name %>]</span>
                        </div>
                      </td>
                      <td class="text-center">
                        <button type="button" class="btn btn-xs <%= (x.brand_label && String(x.brand_label).trim()) ? 'btn-primary' : 'btn-outline-secondary' %> px-2 py-1 text-truncate pos-btn-brand" style="max-width: 85px; font-size: 11px;" data-id="<%= x.id %>" data-brand-id="<%= x.brand_id || 0 %>" data-brand-label="<%= x.brand_label || '' %>" data-primary-color="<%= x.primary_color || '' %>" data-secondary-color="<%= x.secondary_color || '' %>" data-pattern="<%= x.garment_pattern || 'Solid' %>" data-original-rate="<%= (x.original_rate && parseFloat(x.original_rate) > 0) ? x.original_rate : x.service_type_price %>" <%= isEditMode ? ('data-order_id="' + cart.id + '"') : '' %> title="<%= (x.brand_label && String(x.brand_label).trim()) ? (x.brand_label + ' (' + (x.brand_category || '') + ' +' + (x.brand_upcharge_percent || 0) + '% / ' + (x.brand_price_multiplier || 1) + 'x)') : 'Select Brand' %>" <%= (login !== 'customer') ? '' : 'disabled' %>>
                          <i class="fa fa-tag me-1"></i><%= (x.brand_label && String(x.brand_label).trim()) ? x.brand_label : (language.Brand || 'Brand') %>
                        </button>
                      </td>
                      <td class="text-center">
                        <%
                          const pColor = x.primary_color || '';
                          const sColor = x.secondary_color || '';
                          const pat = x.garment_pattern || 'Solid';
                          const colTitle = pColor ? (pColor + (sColor ? ' / ' + sColor : '') + (pat && pat !== 'Solid' ? ' • ' + pat : '')) : 'Select Color & Pattern';
                          const pHex = getColorHex(pColor) || (x.service_color || '#000000');
                          const sHex = getColorHex(sColor);
                        %>
                        <button type="button" class="btn btn-xs pos-btn-color <%= pColor ? 'has-color' : '' %> px-2 py-1 text-truncate d-inline-flex align-items-center" style="max-width: 145px; font-size: 11px;" data-id="<%= x.id %>" data-primary-color="<%= pColor %>" data-secondary-color="<%= sColor %>" data-pattern="<%= pat %>" data-brand-id="<%= x.brand_id || 0 %>" data-brand-label="<%= x.brand_label || '' %>" data-original-rate="<%= (x.original_rate && parseFloat(x.original_rate) > 0) ? x.original_rate : x.service_type_price %>" <%= isEditMode ? ('data-order_id="' + cart.id + '"') : '' %> title="<%= colTitle %>" <%= (login !== 'customer') ? '' : 'disabled' %>>
                          <% if (pColor) { %>
                            <span class="rounded-circle d-inline-block border flex-shrink-0" style="width: 12px; height: 12px; background: <%= pHex %>;"></span>
                            <% if (sColor && sHex) { %>
                              <span class="rounded-circle d-inline-block border flex-shrink-0" style="width: 10px; height: 10px; margin-left: -5px; background: <%= sHex %>;"></span>
                            <% } %>
                            <span class="pos-color-label text-truncate ms-1" style="max-width: 115px;"><%= pColor %> • <%= pat %></span>
                          <% } else { %>
                            <i class="fa fa-palette me-1"></i><span class="pos-color-label text-truncate" style="max-width: 115px;">Color • <%= pat %></span>
                          <% } %>
                        </button>
                      </td>
                      <td class="text-center">
                        <div class="d-inline-flex align-items-center justify-content-center gap-1">
                          <input type="number" class="form-control pos-table-input" style="width: 72px; height: 30px !important;" value="<%= (x.item_value && parseFloat(x.item_value) > 0) ? x.item_value : '' %>" placeholder="0.00" name="item_value" id="<%= isEditMode ? 'edit_POSservice_item_value' : 'POSservice_item_value' %>" data-id="<%= x.id %>" data-original-rate="<%= (x.original_rate && parseFloat(x.original_rate) > 0) ? x.original_rate : x.service_type_price %>" <%= isEditMode ? ('data-order_id="' + cart.id + '"') : '' %> min="0" step="0.25" <%= (login !== 'customer') ? '' : 'readonly' %>>
                          <% if (login !== 'customer') { %>
