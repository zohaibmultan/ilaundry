          <div class="card border rounded-3 mb-3 pos-inspection-top-card shadow-sm">
            <div class="card-body p-2 px-3">
              <div class="row g-2 align-items-center">
                <!-- Primary Color -->
                <div class="col-12 col-md-4">
                  <label class="form-label fs-12 fw-bold pos-modal-label mb-1 d-flex align-items-center gap-1">
                    <span class="rounded-circle bg-primary d-inline-block" style="width: 8px; height: 8px;"></span>
                    <span>Primary Color</span>
                  </label>
                  <select id="pos_modal_primary_color" class="form-select form-select-sm pos-select2-color" style="width: 100%;">
                    <option value="">-- Select Color --</option>
                    <% GARMENT_COLORS.forEach(function(c) { %>
                      <option value="<%= c.name %>" data-hex="<%= c.hex %>" <%= c.isGradient ? 'data-gradient="1"' : '' %> <%= c.border ? 'data-border="1"' : '' %>>
                        <%= c.name %>
                      </option>
                    <% }); %>
                  </select>
                </div>

                <!-- Secondary Color -->
                <div class="col-12 col-md-4">
                  <label class="form-label fs-12 fw-bold pos-modal-label text-muted mb-1 d-flex align-items-center gap-1">
                    <span class="rounded-circle bg-secondary d-inline-block" style="width: 8px; height: 8px;"></span>
                    <span>Secondary Color <small class="fw-normal text-muted">(Optional)</small></span>
                  </label>
                  <select id="pos_modal_secondary_color" class="form-select form-select-sm pos-select2-color" style="width: 100%;">
                    <option value="" data-none="1">None</option>
                    <% GARMENT_COLORS.forEach(function(c) { %>
                      <option value="<%= c.name %>" data-hex="<%= c.hex %>" <%= c.isGradient ? 'data-gradient="1"' : '' %> <%= c.border ? 'data-border="1"' : '' %>>
                        <%= c.name %>
                      </option>
                    <% }); %>
                  </select>
                </div>

                <!-- Garment Pattern -->
                <div class="col-12 col-md-4">
                  <label class="form-label fs-12 fw-bold pos-modal-label mb-1 d-flex align-items-center gap-1">
                    <i class="fa fa-th-large text-primary me-1" style="font-size: 11px;"></i>
                    <span>Garment Pattern</span>
                  </label>
                  <select id="pos_modal_pattern" class="form-select form-select-sm pos-select2-pattern" style="width: 100%;">
                    <% GARMENT_PATTERNS.forEach(function(p) { %>
                      <option value="<%= p %>" <%= p === 'Solid' ? 'selected' : '' %>>
                        <%= p %>
                      </option>
                    <% }); %>
                  </select>
                </div>
              </div>
            </div>
          </div>

