<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>
        <link rel="stylesheet" href="/css/pos-compact.css">

</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body pos-content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row pos-main-row">
                    <!-- left side service list part -->
                    <div class="d-none">
                        <input type="hiden" name="sym" value="<%= accessdata.symbol %>">
                        <input type="hiden" name="pls" value="<%= accessdata.plac %>">
                        <input type="hiden" name="thousands_separator" value="<%= accessdata.thousands_separator %>">
                    </div>

                    <div class="col-xl-7 col-lg-6">
                        <div class="pos-card">
                            <div class="pos-card-body">
                                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                    <div class="pos-search-box flex-grow-1 mb-0">
                                        <i class="fa fa-search pos-search-icon"></i>
                                        <input type="text" class="form-control pos-search-input" id="service_pos_search"
                                            placeholder="Search services..." autocomplete="off">
                                        <span class="pos-search-clear" id="pos_search_clear" style="display:none;"
                                            title="Clear search">
                                            <i class="fa fa-times"></i>
                                        </span>
                                    </div>

                                    <!-- Printing Server Live Status Badge -->
                                    <div class="dropdown pos-printer-dropdown">
                                        <button
                                            class="btn btn-sm pos-printer-badge-btn dropdown-toggle d-flex align-items-center gap-1"
                                            type="button" id="posPrinterStatusBtn" data-bs-toggle="dropdown"
                                            aria-expanded="false" title="Printing Server Status">
                                            <span class="pos-printer-dot dot-checking" id="posPrinterStatusDot"></span>
                                            <span class="pos-printer-label" id="posPrinterStatusText">Checking
                                                Printer...</span>
                                            <i class="fas fa-chevron-down ms-1"
                                                style="font-size: 9px; opacity: 0.7;"></i>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end pos-printer-popover p-3 shadow-lg"
                                            aria-labelledby="posPrinterStatusBtn"
                                            style="min-width: 290px; border-radius: 12px; z-index: 1060;">
                                            <div
                                                class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                                                <strong style="font-size: 13px;"><i
                                                        class="fas fa-print me-1 text-primary"></i> Silent Printing
                                                    Service</strong>
                                                <span class="badge" id="posPopoverStatusBadge">Checking</span>
                                            </div>
                                            <div class="small mb-2">
                                                <div class="d-flex justify-content-between text-muted mb-1">
                                                    <span>Server URL:</span>
                                                    <span class="fw-semibold text-dark" id="posPopoverServerUrl">
                                                        <%= accessdata?.masterstore?.printing_server_url
                                                            || 'http://127.0.0.1:4321' %>
                                                    </span>
                                                </div>
                                                <div class="d-flex justify-content-between text-muted mb-1">
                                                    <span>Active Printer:</span>
                                                    <span class="fw-semibold text-dark text-truncate"
                                                        style="max-width: 150px;" id="posPopoverPrinterName">
                                                        <%= accessdata?.masterstore?.invoice_printer_name
                                                            || 'System Default' %>
                                                    </span>
                                                </div>
                                                <div class="d-flex justify-content-between text-muted mb-1">
                                                    <span>Format:</span>
                                                    <span class="fw-semibold text-dark">
                                                        <%= accessdata?.masterstore?.invoice_printer_format==2
                                                            ? '58mm Roll' :
                                                            (accessdata?.masterstore?.invoice_printer_format==0
                                                            ? 'A4 Sheet' : '80mm Thermal' ) %>
                                                    </span>
                                                </div>
                                                <div class="d-flex justify-content-between text-muted">
                                                    <span>Mode:</span>
                                                    <span class="fw-semibold"
                                                        id="posPopoverModeText">Auto-detecting...</span>
                                                </div>
                                            </div>
                                            <div class="d-grid gap-2 pt-2 border-top">
                                                <button type="button" class="btn btn-outline-primary btn-xs w-100"
                                                    onclick="pingPosPrintingServer(true)">
                                                    <i class="fas fa-sync-alt me-1"></i> Check Connection Now
                                                </button>
                                                <% if (login==='master' ) { %>
                                                    <a href="/tool/setting"
                                                        class="btn btn-light btn-xs text-center text-muted w-100">
                                                        <i class="fas fa-cog me-1"></i> Hardware Settings
                                                    </a>
                                                    <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="pos-services-grid" id="pos_service">
                                    <% if(service_list.length < 1 && login=='master' && cart.store_id==0){ %>
                                        <div class="p-3 text-center w-100">
                                            <h5 class="text-center text-danger">
                                                <%= language.Please_Select_Store %>
                                            </h5>
                                        </div>
                                        <% }else if(service_list.length < 1){ %>
                                            <div class="p-3 text-center w-100">
                                                <img src="../images/empty.png"
                                                    style="max-height: 80px; margin-bottom: 8px;">
                                                <h5 class="text-center text-danger">
                                                    <%= language.Not_listed_any_services_yet %>
                                                </h5>
                                            </div>
                                            <% }else{ %>
                                                <% service_list.forEach(function(data){ %>
                                                    <a href="#" class="pos-service-item services"
                                                        data-name="<%= (data.name || '').toLowerCase() %>"
                                                        data-bs-toggle="modal" data-bs-target="#service_type_model"
                                                        id="POS_service" data-id="<%= data.id %>">
                                                        <div class="pos-service-tile">
                                                            <div class="pos-service-icon-box">
                                                                <img src="../../uploads/<%= data.image %>"
                                                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                                                    alt="<%= data.name %>">
                                                                <div class="pos-service-fallback-icon"
                                                                    style="display:none;">
                                                                    <i class="fa fa-tshirt"></i>
                                                                </div>
                                                            </div>
                                                            <span class="pos-service-name" title="<%= data.name %>">
                                                                <%= data.name %>
                                                            </span>
                                                        </div>
                                                    </a>
                                                    <% }) %>
                                                        <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- right side pos part -->
                    <div class="col-xl-5 col-lg-6">
                        <div class="pos-card pos-cart-card">
                            <div class="pos-card-body">
                                <div class="row g-2 mb-3">
                                    <div
                                        class="col-6 <%= (ismulty && login == 'master') || (ismulty && accessdata.logas != 'store' && accessdata.masterstore.customer_selection =='1' || accessdata.topbardata.store =='' ) || (typeof isStaff !== 'undefined' && isStaff) ? '': 'd-none' %>">
                                        <div class="pos-date-group">
                                            <label class="pos-field-label">Select Store <span class="text-danger">*</span></label>
                                            <% if (typeof isStaff !=='undefined' && isStaff) { %>
                                                <select class="default-select wide w-100" name="store" id="pos_store_id"
                                                    disabled style="background-color: #e9ecef; cursor: not-allowed;" required>
                                                    <option value="<%= staffStoreId %>" selected>
                                                        <%= staffStoreName || 'Assigned Store' %>
                                                    </option>
                                                </select>
                                                <input type="hidden" id="pos_staff_store_id"
                                                    value="<%= staffStoreId %>">
                                                <% } else { %>
                                                    <select class="default-select wide w-100" name="store"
                                                        id="pos_store_id" data-live-search="true" required>
                                                        <option value="0" <%= (!cart.store_id || cart.store_id == 0) ? 'selected' : '' %> disabled>Select Store *</option>
                                                        <% storeList.forEach(function(x){ %>
                                                            <option value="<%= x.id %>" <%= (cart.store_id == x.id) ? 'selected' : '' %>><%= x.name %></option>
                                                        <% }) %>
                                                    </select>
                                                <% } %>
                                        </div>
                                    </div>

                                    <div class="col-6 <%= login === 'customer'? 'd-none': '' %>">
                                        <div class="pos-date-group">
                                            <label class="pos-field-label">Select Customer <span class="text-danger">*</span></label>
                                             <div class="d-flex justify-content-between align-items-center">
                                                <% if (accessdata.logas==='custmor' ) { %>
                                                    <input type="hidden" id="single-select" name="customer"
                                                        value="<%= customerList[0]?.id || 0 %>">
                                                <% } else { %>
                                                    <select id="single-select" name="customer"
                                                        class="default-select wide w-100" data-live-search="true" required
                                                        <%= (!isStaff && (!cart.store_id || cart.store_id == 0)) ? 'disabled' : '' %>>
                                                        <option value="0" disabled <%= (!cart.customer_id || cart.customer_id == 0) ? 'selected' : '' %>>
                                                            <%= (!isStaff && (!cart.store_id || cart.store_id == 0)) ? 'Select Store First *' : 'Select Customer *' %>
                                                        </option>
                                                        <% customerList.forEach(function(x) { %>
                                                            <% let showExtra="" ; %>
                                                            <% if ((x.username=='' || x.username==null) &&
                                                                (x.email==null || x.email=='' ) &&
                                                                (x.number==null || x.number=='' ) ) { %>
                                                                <% if (accessdata.logas !='store' ) {
                                                                    showExtra=x.store_name; } %>
                                                            <% } else { %>
                                                                <% showExtra=x.number; %>
                                                            <% } %>
                                                            <% let selected = (cart.customer_id == x.id || (isStaff && (!cart.customer_id || cart.customer_id == 0) && (x.username == '' || x.username == null || (x.name && x.name.toLowerCase().includes('walk in'))))) ? 'selected' : ''; %>
                                                            <option value="<%= x.id %>" <%= selected %>>
                                                                <%= x.name %><% if (showExtra) { %> (<%= showExtra %>)<% } %>
                                                            </option>
                                                        <% }); %>
                                                    </select>
                                                    <button type="button"
                                                        class="btn btn-primary ms-2 pos-btn-add-customer"
                                                        data-bs-toggle="modal" data-bs-target="#addcustomer">
                                                        <i class="fa fa-plus"></i>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-4">
                                        <div class="pos-date-group">
                                            <label class="pos-field-label">Order #</label>
                                            <input type="text" id="pos_order_id" class="form-control pos-input-sm w-100"
                                                value="<%= cart.order_id %>" readonly title="Order ID">
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="pos-date-group">
                                            <label class="pos-field-label">
                                                <%= language.Order_Date || 'Order Date' %>
                                            </label>
                                            <% let new_date=new Date(cart.order_date) %>
                                                <% let year=new_date.getFullYear() %>
                                                    <% let new_day=(new_date.getDate() < 10 ? '0' : '' ) +
                                                        new_date.getDate() %>
                                                        <% let new_month=((new_date.getMonth()+1) < 10 ? '0' : '' ) +
                                                            (new_date.getMonth()+1) %>
                                                            <% let fullDate=`${year}-${new_month}-${new_day}` %>
                                                                <input type="date"
                                                                    class="form-control pos-input-sm w-100"
                                                                    id="POS_order_date" value="<%=fullDate %>"
                                                                    title="<%= language.Order_Date || 'Order Date' %>"
                                                                    <%=login==='customer' ? 'readonly' : '' %>>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="pos-date-group">
                                            <label class="pos-field-label">
                                                <%= language.Delivery_Date || 'Delivery Date' %>
                                            </label>
                                            <% let del_raw=cart.delivery_date || cart.order_date %>
                                                <% let del_date=new Date(del_raw) %>
                                                    <% let del_year=del_date.getFullYear() %>
                                                        <% let del_day=(del_date.getDate() < 10 ? '0' : '' ) +
                                                            del_date.getDate() %>
                                                            <% let del_month=((del_date.getMonth()+1) < 10 ? '0' : '' )
                                                                + (del_date.getMonth()+1) %>
                                                                <% let
                                                                    del_fullDate=`${del_year}-${del_month}-${del_day}`
                                                                    %>
                                                                    <input type="date"
                                                                        class="form-control pos-input-sm w-100"
                                                                        id="POS_delivery_date" name="pos_delivery_date"
                                                                        value="<%= del_fullDate %>"
                                                                        min="<%= fullDate %>"
                                                                        title="<%= language.Delivery_Date || 'Delivery Date' %>"
                                                                        <%=login==='customer' ? 'readonly' : '' %>>
                                        </div>
                                    </div>
                                </div>

                                <div class="pos-table-scroll">
                                    <table class="pos-cart-table table-bordered verticle-middle text-center">
                                        <thead>
                                            <tr>
                                                <th
                                                    style="width: 100%; text-align: left; padding-left: 8px !important;">
                                                    <%= language.Service %>
                                                </th>
                                                <th style="width: 80px; text-align: center;">
                                                    <%= language.Color %>
                                                </th>
                                                <th style="width: 100px;text-align: center;">
                                                    <%= language.Rate %>
                                                </th>
                                                <th style="width: 80px;text-align: center;">
                                                    <%= language.Qty %>
                                                </th>
                                                <th style="width: 50px;text-align: center;"></th>
                                            </tr>
                                        </thead>
                                        <tbody id="POS_service_added_list">
                                            <% cartservice.forEach(function(x){ %>
                                                <tr>
                                                    <td>
                                                        <div class="pos-cart-service-info">
                                                            <span class="pos-cart-item-title"
                                                                title="<%= x.service_name %>">
                                                                <%= x.service_name %>
                                                            </span>
                                                            <span class="pos-cart-item-badge">[<%= x.service_type_name
                                                                    %>]</span>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="color" class="pos-color-circle"
                                                            value="<%= x.service_color %>" id="POS_service_color"
                                                            data-id="<%= x.id %>">
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="number"
                                                            class="form-control pos-table-input pos-table-input-price"
                                                            value="<%= x.service_type_price %>"
                                                            name="service_type_price" id="POSservice_type_price"
                                                            data-id="<%= x.id %>" <%=login=='master' || login=='store'
                                                            ? '' : 'readonly' %>>
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="number"
                                                            class="form-control pos-table-input pos-table-input-qty"
                                                            id="POSservice_type_quntity"
                                                            value="<%= x.service_quntity %>" min="1"
                                                            data-id="<%= x.id %>">
                                                    </td>
                                                    <td class="text-center">
                                                        <a class="pos-btn-del" id="remove_service_list"
                                                            data-id="<%= x.id %>" title="Delete">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="pos-bottom-section">
                                    <div class="row g-1 align-items-center">
                                        <div class="col-5">
                                            <div
                                                class="<%= (accessdata.logas == 'custmor' && accessdata.roll.pos.includes('write'))|| accessdata.roll.pos.includes('write') ? 'd-block' : 'd-none' %>">
                                                <div class="pos-actions-grid">
                                                    <button type="button" class="btn btn-primary pos-btn-mini"
                                                        data-bs-toggle="modal" data-bs-target="#addons">
                                                        <i class="fa fa-plus-circle me-1"></i>
                                                        <%= language.Addons %>
                                                    </button>
                                                    <button type="button" class="btn btn-primary pos-btn-mini"
                                                        id="POS_coupon_model_show">
                                                        <i class="fa fa-tag me-1"></i>
                                                        <%= language.Coupon %>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-danger pos-btn-mini"
                                                        id="POS_clear">
                                                        <i class="fa fa-trash-alt me-1"></i>
                                                        <%= language.ClearAll %>
                                                    </button>
                                                    <button type="button" class="btn btn-light pos-btn-mini"
                                                        style="visibility: hidden;">
                                                    </button>
                                                </div>
                                                <button type="button" class="btn btn-success pos-btn-pay-primary"
                                                    id="POS_payment_model_show">
                                                    <span>
                                                        <%= language.Payment %>
                                                    </span> <i class="fas fa-arrow-right ms-2"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-7">
                                            <div class="pos-totals-container">
                                                <div class="pos-total-row">
                                                    <span class="pos-total-label">
                                                        <%= language.Sub_Total %>:
                                                    </span>
                                                    <span class="pos-total-value symbol possymbol" id="POS_sub_total">
                                                        <%= cart.sub_total.toFixed(2) %>
                                                    </span>
                                                </div>
                                                <div class="pos-total-row">
                                                    <span class="pos-total-label">
                                                        <%= language.Addon_Total %>:
                                                    </span>
                                                    <span class="pos-total-value symbol possymbol" id="POS_addon_total">
                                                        <%= cart.addon_price.toFixed(2) %>
                                                    </span>
                                                </div>
                                                <div class="pos-total-row">
                                                    <span class="pos-total-label">
                                                        <%= language.Coupon_Discount %>:
                                                    </span>
                                                    <span class="pos-total-value symbol possymbol"
                                                        id="POS_coupon_total">
                                                        <%= cart.coupon_discount.toFixed(2) %>
                                                    </span>
                                                </div>
                                                <div class="pos-total-row">
                                                    <span class="pos-total-label" id="POS_tax_percent">
                                                        <%= language.TAX %> (<%=cart.tax%> %):
                                                    </span>
                                                    <span class="pos-total-value symbol possymbol" id="POS_tax_total">
                                                        <%= cart.tax_amount.toFixed(2) %>
                                                    </span>
                                                </div>
                                                <div class="pos-total-row pos-total-row-gross">
                                                    <span class="pos-total-label">
                                                        <%= language.Gross_Total %>:
                                                    </span>
                                                    <span class="pos-total-value symbol possymbol" id="POS_gross_total">
                                                        <%= cart.gross_total.toFixed(2) %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!--********** Content body end **********-->

            <!-- Modal payment -->
            <div class="modal fade" id="POS_payment_model">
                <div class="modal-dialog modal-dialog-scrollable" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <%= language.Make_Payment %>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <!-- <form id="pyment_POS_cart" method="post" class="need-validation"> -->
                        <div class="modal-body" id="payment_sum">
                            <form id="posprintform" action="/admin/posprint" method="post" class="need-validation">
                                <div class="row g-2 align-items-center">

                                    <div class="col-12">
                                        <div class="row align-items-center">
                                            <div class="col-md-6 mb-1">
                                                <label class="form-label">
                                                    <%= language.Delivery_Date %>
                                                </label>
                                                <input type="date" class="form-control" name="deliverydate"
                                                    id="deliverydate">

                                                <input type="date" class="form-control" name="deliverydate_hidden"
                                                    id="deliverydate_hidden" hidden>
                                                <input type="hidden" id="POS_gross_order" value="" name="gross">
                                                <input type="hidden" id="POS_subtotal_order" value="" name="sub">
                                            </div>
                                            <div class="col-md-6 mb-1 <%= login === 'customer'? 'd-none': '' %>">
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <label class="form-label mb-0" for="POS_extra_discount_order">
                                                        <%= language.Extra_Discount %>
                                                    </label>
                                                    <div class="pos-discount-type-group" role="group"
                                                        aria-label="Discount Type">
                                                        <input type="radio" class="btn-check" name="discount_type"
                                                            id="pos_disc_type_fixed" value="fixed" checked
                                                            autocomplete="off">
                                                        <label class="pos-disc-btn active" for="pos_disc_type_fixed"
                                                            id="pos_disc_btn_fixed" title="Fixed Amount">Fix ($)</label>

                                                        <input type="radio" class="btn-check" name="discount_type"
                                                            id="pos_disc_type_percent" value="percent"
                                                            autocomplete="off">
                                                        <label class="pos-disc-btn" for="pos_disc_type_percent"
                                                            id="pos_disc_btn_percent" title="Percentage">%
                                                            Percent</label>
                                                    </div>
                                                </div>
                                                <div class="input-group pos-discount-input-group">
                                                    <span class="input-group-text pos-discount-prefix"
                                                        id="pos_discount_prefix">$</span>
                                                    <input type="number" id="POS_extra_discount_order"
                                                        class="form-control" placeholder="0.00" min="0" step="any"
                                                        autocomplete="off">
                                                </div>
                                                <input type="hidden" name="extradiscount" id="POS_extradiscount_hidden"
                                                    value="0">
                                            </div>
                                        </div>

                                        <div class="row text-center">
                                            <div id="show_pos_barcode">

                                            </div>
                                        </div>

                                        <small><span id="POS_worning" class="text-center text-danger "></span></small>
                                        <hr>

                                        <div class="row">
                                            <div class="col text-sm ">
                                                <%= language.Sub_Total %> :
                                            </div>
                                            <div class="col-auto text-sm payment_val paysymbol" id="payment_subtotal">$
                                                0.00</div>
                                        </div>

                                        <div class="row">
                                            <div class="col text-sm">
                                                <%= language.Addon %> :
                                            </div>
                                            <div class="col-auto text-sm payment_val paysymbol" id="payment_addons">$
                                                0.00</div>
                                        </div>

                                        <div class="row">
                                            <div class="col text-sm">
                                                <%= language.Extra_Discount %> <span
                                                        id="payment_extradiscount_percent_info"
                                                        class="text-primary font-weight-bold"></span> :
                                            </div>
                                            <div class="col-auto text-sm payment_val paysymbol extsymbol"
                                                id="payment_extradiscount">$ 0.00</div>
                                        </div>

                                        <div class="row">
                                            <div class="col text-sm">
                                                <%= language.Coupon_Discount %>:
                                            </div>
                                            <div class="col-auto text-sm payment_val paysymbol"
                                                id="payment_coupondiscount">$ 0.00</div>
                                        </div>

                                        <div class="row">
                                            <div class="col text-sm">
                                                <%= language.TAX %> <span id="payment_text_perdent"></span>:
                                            </div>
                                            <div class="col-auto text-sm payment_val paysymbol"
                                                id="payment_text_amount"> 0.00</div>
                                        </div>

                                        <hr>

                                        <div class="row">
                                            <div class="col text-sm">
                                                <%= language.Gross_Total %> :
                                            </div>
                                            <div class="col-auto text-sm paysymbol extsymbol" id="payment_grosstotal">
                                                21.00</div>
                                        </div>

                                        <hr>

                                        <div class="row align-items-center">
                                            <div class="col-md-6 mb-1">
                                                <label class="form-label">
                                                    <%= language.Paid_Amount %>
                                                </label>
