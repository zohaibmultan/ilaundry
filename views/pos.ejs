        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fa fa-times me-2"></i><%= language.Cancel %>
          </button>
          <button type="submit" value="submit" id="<%= isEditMode ? 'edit_addons_pos_cart_submit' : 'add_addons_pos_cart_submit' %>" class="btn btn-primary">
            <i class="fa fa-save me-2"></i><%= language.Save %>
          </button>
        </div>
      </form>
