          dropdownParent: $('#addcustomer'),
          placeholder: 'Select Store *',
          width: '100%',
          allowClear: false
        });
      }
    });

    // Automatically set customer phone number as default username and password
    $('#pos_add_cust_number').on('input', function() {
      const phoneVal = $(this).val();
      const $u = $('#pos_add_cust_username');
      const $p = $('#pos_add_cust_password');
      if (!$u.data('manual-edit') || $u.val() === '') {
        $u.val(phoneVal);
      }
      if (!$p.data('manual-edit') || $p.val() === '') {
        $p.val(phoneVal);
      }
    });

    $('#pos_add_cust_username').on('input', function() {
      $(this).data('manual-edit', true);
    });

    $('#pos_add_cust_password').on('input', function() {
      $(this).data('manual-edit', true);
    });

    $('#addcustomer').on('show.bs.modal', function() {
      $('#pos_add_cust_username').removeData('manual-edit');
      $('#pos_add_cust_password').removeData('manual-edit');
    });
  </script>
  <script>
    $('#posprintform').on('submit', function(e) {
      e.preventDefault();
      const paidAmount = parseFloat($('#paid_amount').val()) || 0;
      const paymentType = $('#POS_payment_type_list').val();

      if (paidAmount > 0 && (!paymentType || paymentType === '0')) {
        if (typeof toastr !== 'undefined') {
          toastr.warning('Please select a payment type for the paid amount.');
        } else {
          alert('Please select a payment type.');
        }
        if ($('#POS_payment_type_list').data('select2')) {
          $('#POS_payment_type_list').select2('open');
        } else {
          $('#POS_payment_type_list').focus();
        }
        return false;
      }

      // Prevent multiple submissions
      const $submitBtn = $('#printcheck');
      $submitBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-2"></i><%= language.Saving || "Saving..." %>');

      const formData = $(this).serialize();

      $.ajax({
        url: '/admin/save_order',
        type: 'POST',
        data: formData,
        dataType: 'json',
        success: function(res) {
          if (res && res.success) {
            window.location.href = '/admin/posprint?id=' + encodeURIComponent(res.id || res.order_id);
          } else {
            $submitBtn.prop('disabled', false).html('<i class="fa fa-print me-2"></i><%= language.Save %> & <%= language.Print %>');
            const errMsg = (res && res.message) ? res.message : 'Error placing order. Please try again.';
            if (typeof toastr !== 'undefined') {
              toastr.error(errMsg);
            } else {
              alert(errMsg);
            }
          }
        },
        error: function(xhr) {
          $submitBtn.prop('disabled', false).html('<i class="fa fa-print me-2"></i><%= language.Save %> & <%= language.Print %>');
          let errMsg = 'Server error placing order. Please try again.';
          try {
            const parsed = JSON.parse(xhr.responseText);
            if (parsed && parsed.message) errMsg = parsed.message;
          } catch (e) {}
          if (typeof toastr !== 'undefined') {
            toastr.error(errMsg);
          } else {
            alert(errMsg);
          }
        }
      });
      return false;
    });
  </script>
  <script src="/js/pos-print-client.js"></script>
  <script>
    (function() {
      const serverUrl = "<%= (typeof storePrinterConfig !== 'undefined' && storePrinterConfig && storePrinterConfig.printing_server_url) ? storePrinterConfig.printing_server_url : (accessdata?.masterstore?.printing_server_url || 'http://127.0.0.1:4321') %>";
      const silentEnabled = <%= ((typeof storePrinterConfig !== 'undefined' && storePrinterConfig && storePrinterConfig.silent_print_enabled !== null && storePrinterConfig.silent_print_enabled !== undefined) ? (storePrinterConfig.silent_print_enabled != 0) : (accessdata?.masterstore?.silent_print_enabled !== 0)) ? 'true' : 'false' %>;
      const targetPrinter = "<%= (typeof storePrinterConfig !== 'undefined' && storePrinterConfig && storePrinterConfig.invoice_printer_name) ? storePrinterConfig.invoice_printer_name : (accessdata?.masterstore?.invoice_printer_name || '') %>";
      const posClient = new POSPrintClient({
        baseUrl: serverUrl,
        timeout: 4000
      });

      async function pingPosPrintingServer(isManual) {
        const btn = document.getElementById('posPrinterStatusBtn');
        const dot = document.getElementById('posPrinterStatusDot');
        const text = document.getElementById('posPrinterStatusText');
        const popBadge = document.getElementById('posPopoverStatusBadge');
        const popMode = document.getElementById('posPopoverModeText');

        if (isManual && typeof toastr !== 'undefined') {
          toastr.info('Checking printing server at ' + serverUrl + '...', 'Connecting');
        }

        try {
          const health = await posClient.request('/health');
          if (health && health.status === 'running') {
            if (dot) dot.className = 'pos-printer-dot dot-online';
            if (text) {
              const shortName = targetPrinter ? (targetPrinter.length > 15 ? targetPrinter.substring(0, 15) + '...' : targetPrinter) : 'Ready';
              text.textContent = 'Silent Print: Online (' + shortName + ')';
            }
            if (btn) {
              btn.classList.remove('btn-outline-danger', 'btn-outline-secondary');
              btn.classList.add('btn-outline-success');
            }
            if (popBadge) {
              popBadge.className = 'badge bg-success text-white';
              popBadge.textContent = 'Online';
            }
            if (popMode) {
              popMode.className = 'fw-semibold text-success';
              popMode.textContent = silentEnabled ? 'Silent Zero-Click Spooler' : 'Silent Disabled (Native Print)';
            }
            if (isManual && typeof toastr !== 'undefined') {
              toastr.success('Printing Server is online! Ready for silent receipts.', 'Hardware Connected');
            }
          } else {
            throw new Error('Server offline');
          }
        } catch (e) {
          if (dot) dot.className = 'pos-printer-dot dot-offline';
          if (text) text.textContent = 'Silent Print: Offline';
          if (btn) {
            btn.classList.remove('btn-outline-success', 'btn-outline-secondary');
            btn.classList.add('btn-outline-danger');
          }
          if (popBadge) {
            popBadge.className = 'badge bg-danger text-white';
            popBadge.textContent = 'Offline';
          }
          if (popMode) {
            popMode.className = 'fw-semibold text-danger';
            popMode.textContent = 'Native Browser Dialog (Ctrl+P)';
          }
          if (isManual && typeof toastr !== 'undefined') {
            toastr.warning('Printing server is offline. Standard browser print dialog will be used.', 'Native Fallback Active');
          }
        }
      }

      window.pingPosPrintingServer = pingPosPrintingServer;

      // Responsive Mobile/Tablet Segmented View Switcher
      function switchPosMobileTab(tab) {
        const catalogCol = document.getElementById('posCatalogColumn');
        const cartCol = document.getElementById('posCartColumn');
        const btnCatalog = document.getElementById('posBtnShowCatalog');
        const btnCart = document.getElementById('posBtnShowCart');

        if (tab === 'catalog') {
          catalogCol?.classList.remove('pos-panel-hidden');
          cartCol?.classList.add('pos-panel-hidden');
          btnCatalog?.classList.add('active');
          btnCart?.classList.remove('active');
        } else {
          catalogCol?.classList.add('pos-panel-hidden');
          cartCol?.classList.remove('pos-panel-hidden');
          btnCart?.classList.add('active');
          btnCatalog?.classList.remove('active');
        }
      }
      window.switchPosMobileTab = switchPosMobileTab;

      // Update mobile cart badge count and empty cart state automatically
      function updatePosMobileCartBadge() {
        const cartList = document.getElementById('POS_service_added_list');
        const badge = document.getElementById('posMobileCartBadge');
        const emptyIndicator = document.getElementById('pos_empty_cart_indicator');
        const cartTable = document.getElementById('pos_cart_main_table');
        const count = cartList ? cartList.querySelectorAll('tr').length : 0;

        if (badge) {
          badge.textContent = count;
        }

        if (emptyIndicator) {
          if (count === 0) {
            emptyIndicator.classList.remove('d-none');
            emptyIndicator.classList.add('d-flex');
            if (cartTable) cartTable.classList.add('d-none');
          } else {
            emptyIndicator.classList.add('d-none');
            emptyIndicator.classList.remove('d-flex');
            if (cartTable) cartTable.classList.remove('d-none');
          }
        }

        if (typeof updatePosCheckoutBtnState === 'function') {
          updatePosCheckoutBtnState();
        }
      }
      window.updatePosMobileCartBadge = updatePosMobileCartBadge;


      window.POS_READY_SCHEDULE = <%- JSON.stringify((typeof readySchedule !== 'undefined' && readySchedule) ? readySchedule : (typeof locals !== 'undefined' && locals.readySchedule ? locals.readySchedule : {})) %>;
      window.POS_INITIAL_CATEGORIES = <%- JSON.stringify((typeof categoryList !== 'undefined' && categoryList) ? categoryList : []) %>;
      window.POS_INITIAL_SUBCATEGORIES = <%- JSON.stringify((typeof subcategoryList !== 'undefined' && subcategoryList) ? subcategoryList : []) %>;

      // Customer Intelligence & Memo UI Update Helper
      window.updatePosCustomerIntelligence = function(stats) {
        if (!stats) stats = {
          total_orders: 0,
          unpaid_orders: 0,
          unpaid_amount: 0,
          memo: ''
        };
        const sym = document.querySelector('input[name="sym"]')?.value || '$';
        const elTotal = document.getElementById('pos_cust_stat_total');
        const elUnpaid = document.getElementById('pos_cust_stat_unpaid');
        const elBalance = document.getElementById('pos_cust_stat_balance');
        const elMemoText = document.getElementById('pos_cust_memo_text');
        const elMemoInput = document.getElementById('pos_cust_memo_input');

        if (elTotal) elTotal.textContent = stats.total_orders || 0;
        if (elUnpaid) elUnpaid.textContent = stats.unpaid_orders || 0;
        if (elBalance) {
          const amt = parseFloat(stats.unpaid_amount || 0).toFixed(2);
          elBalance.textContent = sym + ' ' + amt;
        }

        const cleanMemo = (stats.memo && stats.memo.trim() !== '') ? stats.memo.trim() : '';
        if (elMemoText) {
          if (cleanMemo) {
            elMemoText.textContent = cleanMemo;
            elMemoText.classList.remove('text-muted');
          } else {
            elMemoText.innerHTML = '<em>No notes recorded for this customer.</em>';
            elMemoText.classList.add('text-muted');
          }
        }
        if (elMemoInput) {
          elMemoInput.value = cleanMemo;
        }
      };

      function fetchCurrentCustomerStats(customerId) {
        if (!customerId || customerId === '0' || customerId === 'null') {
          window.updatePosCustomerIntelligence({
            total_orders: 0,
            unpaid_orders: 0,
            unpaid_amount: 0,
            memo: ''
          });
          return;
        }
        fetch('/admin/customer-stats/' + encodeURIComponent(customerId))
          .then(r => r.json())
          .then(data => {
            if (data && data.success && data.stats) {
              window.updatePosCustomerIntelligence(data.stats);
            }
          })
          .catch(err => console.error('Error fetching customer stats:', err));
      }
      window.fetchCurrentCustomerStats = fetchCurrentCustomerStats;

      document.addEventListener('DOMContentLoaded', () => {
        // Auto-collapse sidebar to mini-icon mode for large POS workstation view
        const mainWrapper = document.getElementById('main-wrapper');
        if (mainWrapper) {
          mainWrapper.classList.add('menu-toggle');
        }
        const hamburger = document.querySelector('.hamburger');
        if (hamburger) {
          hamburger.classList.add('is-active');
        }

        // POS Sidebar Expand/Collapse Toggle Button
        const posSidebarBtn = document.getElementById('pos_sidebar_toggle');
        if (posSidebarBtn) {
          posSidebarBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const navControl = document.querySelector('.nav-control');
            if (navControl) {
              navControl.click();
            } else {
              if (mainWrapper) mainWrapper.classList.toggle('menu-toggle');
              if (hamburger) hamburger.classList.toggle('is-active');
            }
          });
        }

        // Initial customer intelligence stats population
        const custSelect = document.getElementById('single-select');
        if (custSelect && custSelect.value && custSelect.value !== '0') {
          fetchCurrentCustomerStats(custSelect.value);
        }

        if (typeof window.updatePosCheckoutBtnState === 'function') {
          window.updatePosCheckoutBtnState();
        }


        // Quick memo editing interactions
        const btnEditMemo = document.getElementById('btn_toggle_pos_memo_edit');
        const btnCancelMemo = document.getElementById('btn_cancel_pos_memo');
        const btnSaveMemo = document.getElementById('btn_save_pos_memo');
        const memoViewContainer = document.getElementById('pos_memo_view_container');
        const memoEditContainer = document.getElementById('pos_memo_edit_container');
        const memoInput = document.getElementById('pos_cust_memo_input');

        if (btnEditMemo && memoViewContainer && memoEditContainer) {
          btnEditMemo.addEventListener('click', (e) => {
            e.preventDefault();
            memoViewContainer.classList.add('d-none');
            memoEditContainer.classList.remove('d-none');
            if (memoInput) memoInput.focus();
          });
        }

        if (btnCancelMemo && memoViewContainer && memoEditContainer) {
          btnCancelMemo.addEventListener('click', (e) => {
            e.preventDefault();
            memoEditContainer.classList.add('d-none');
            memoViewContainer.classList.remove('d-none');
          });
        }

        if (btnSaveMemo) {
          btnSaveMemo.addEventListener('click', (e) => {
            e.preventDefault();
            const custId = custSelect ? custSelect.value : null;
            if (!custId || custId === '0') {
              if (typeof toastr !== 'undefined') toastr.warning('Please select a customer first');
              return;
            }
            const newMemo = memoInput ? memoInput.value : '';
            btnSaveMemo.disabled = true;
            btnSaveMemo.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Saving...';

            fetch('/coustomer/update-memo', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  customer_id: custId,
                  memo: newMemo
                })
              })
              .then(r => r.json())
              .then(res => {
                btnSaveMemo.disabled = false;
                btnSaveMemo.innerHTML = '<i class="fa fa-check me-1"></i>Save Note';
                if (res && res.success) {
                  if (memoEditContainer) memoEditContainer.classList.add('d-none');
                  if (memoViewContainer) memoViewContainer.classList.remove('d-none');
                  const elMemoText = document.getElementById('pos_cust_memo_text');
                  if (elMemoText) {
                    if (newMemo && newMemo.trim()) {
                      elMemoText.textContent = newMemo.trim();
                      elMemoText.classList.remove('text-muted');
                    } else {
                      elMemoText.innerHTML = '<em>No notes recorded for this customer.</em>';
                      elMemoText.classList.add('text-muted');
                    }
                  }
                  if (typeof toastr !== 'undefined') toastr.success('Customer memo updated successfully');
                } else {
                  if (typeof toastr !== 'undefined') toastr.error(res?.message || 'Failed to update memo');
                }
              })
              .catch(err => {
                btnSaveMemo.disabled = false;
                btnSaveMemo.innerHTML = '<i class="fa fa-check me-1"></i>Save Note';
                if (typeof toastr !== 'undefined') toastr.error('Failed to update memo');
              });
          });
        }

        pingPosPrintingServer(false);
        setInterval(() => pingPosPrintingServer(false), 25000);

        // Observe cart items list to update mobile badge automatically
        const cartList = document.getElementById('POS_service_added_list');
        if (cartList && window.MutationObserver) {
          const observer = new MutationObserver(() => updatePosMobileCartBadge());
          observer.observe(cartList, {
            childList: true
          });
        }
        updatePosMobileCartBadge();
      });
    })();
  </script>
</body>



</html>