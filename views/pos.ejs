  <div class="modal fade" id="pos_brand_modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
      <div class="modal-content">
        <div class="modal-header py-2 px-3">
          <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
            <i class="fa fa-tshirt text-primary"></i>
            <span><%= language.Garment_Inspection_Title || 'Garment Brand, Color & Pattern Inspection' %></span>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-3">
          <input type="hidden" id="pos_brand_modal_service_id" value="">
          <input type="hidden" id="pos_brand_modal_order_id" value="">
          <input type="hidden" id="pos_brand_modal_is_edit" value="0">
