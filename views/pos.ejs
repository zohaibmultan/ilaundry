              <label class="card h-100 border p-2 mb-0 d-flex flex-row align-items-center justify-content-between rounded-3 addon-clickable" for="update_customer_read_<%= data.id %>" role="button">
                <div class="d-flex align-items-center gap-2">
                  <input class="form-check-input m-0" type="checkbox" id="update_customer_read_<%= data.id %>" name="addon" value="<%= data.id %>" <%= cartAddonIds.includes(String(data.id)) ? 'checked' : '' %>>
                  <div>
                    <h6 class="mb-0 fw-semibold text-dark"><%= data.addon %></h6>
                    <small class="text-muted symbol possymbol"><%= data.price %></small>
                  </div>
                </div>
              </label>
            </div>
            <% }) %>
          </div>
