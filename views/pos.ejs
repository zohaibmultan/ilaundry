  <!-- Modal Add Customer -->
  <div class="modal fade" id="addcustomer" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-sm-down" role="document">
      <form action="/coustomer/register" method="post" class="modal-content need-validation">
        <div class="modal-header">
          <h5 class="modal-title"><%= language.Add_Coustomer_Detail %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <% if (typeof showStoreSelect !== 'undefined' && !showStoreSelect) { %>
          <input type="hidden" name="storeid" value="<%= typeof assignedStoreId !== 'undefined' ? assignedStoreId : '' %>">
          <% } %>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold">
                <%= language.Last_Name || 'Last Name' %> <span class="text-danger">*</span>
              </label>
              <input type="text" class="form-control" name="last_name" placeholder="Enter last name" required>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold">
                <%= language.First_Name || 'First Name' %> <span class="text-danger">*</span>
              </label>
              <input type="text" class="form-control" name="first_name" placeholder="Enter first name" required>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold">
                <%= language.Phone_Number %> <span class="text-danger">*</span>
              </label>
              <input type="number" class="form-control" name="number" id="pos_add_cust_number" placeholder="Enter phone number" required>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold">
                <%= language.Email %> <span class="text-danger">*</span>
              </label>
              <input type="email" class="form-control" name="email" placeholder="Enter email address" required>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold">
                <%= language.Customer_Type || 'Customer Type' %>
              </label>
              <select class="form-control form-select" name="customer_type">
                <% if (typeof customer_types !== 'undefined' && customer_types && customer_types.length > 0) { %>
                <% customer_types.forEach(function(ct, idx) { %>
                <option value="<%= ct.name %>" <%= idx === 0 ? 'selected' : '' %>><%= ct.name %><% if (ct.description) { %> - <%= ct.description %><% } %></option>
                <% }); %>
                <% } else { %>
                <option value="Counter • Counter" selected>Counter • Counter - Customer will drop-off and customer will pickup</option>
                <option value="Counter • Route">Counter • Route - Customer will drop-off and store will deliver</option>
                <option value="Route • Route">Route • Route - Store will pickup and store will deliver</option>
                <option value="Route • Counter">Route • Counter - Store will pickup and customer will pickup</option>
                <% } %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold">Date of Birth <span class="text-muted fw-normal fs-12">(Optional)</span></label>
              <input type="date" class="form-control" name="dob" id="pos_add_cust_dob" placeholder="YYYY-MM-DD">
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold"><%= language.Username %></label>
              <input type="text" class="form-control" name="username" id="pos_add_cust_username" placeholder="Defaults to phone number">
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold"><%= language.Password %></label>
              <input type="password" class="form-control" name="password" id="pos_add_cust_password" placeholder="Defaults to phone number">
            </div>

            <% if (typeof showStoreSelect !== 'undefined' && showStoreSelect) { %>
            <div class="col-md-12">
              <label class="form-label fw-bold">
                <%= language.Store_List || 'Store' %> <span class="text-danger">*</span>
              </label>
              <select class="form-control form-select" name="storeid" id="coupon_storlist_update" required>
                <option value="" disabled <%= (!cart.store_id || cart.store_id == 0) ? 'selected' : '' %>>
                  Select Store *
                </option>
                <% storeList.forEach(function(x) { %>
                <option value="<%= x.id %>" <%= (cart.store_id == x.id) ? 'selected' : '' %>>
                  <%= x.name %>
                </option>
                <% }) %>
              </select>
            </div>
            <% } %>

            <div class="col-md-12">
              <label class="form-label fw-bold">
                <%= language.Address || 'Address' %> <span class="text-danger">*</span>
              </label>
              <input type="text" class="form-control" name="address" placeholder="Enter street address" required>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-bold">
                <%= language.City || 'City' %> <span class="text-danger">*</span>
              </label>
              <input type="text" class="form-control" name="city" placeholder="Enter city" required>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-bold">
                <%= language.State || 'State' %> <span class="text-danger">*</span>
              </label>
              <input type="text" class="form-control" name="state" placeholder="Enter state" required>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-bold"><%= language.Zip_Code || 'Zip Code' %></label>
              <input type="text" class="form-control" name="zipcode" placeholder="Enter zip code">
            </div>

            <div class="col-12">
              <label class="form-label fw-bold"><%= language.Customer_Memo || 'Customer Memo / Note' %></label>
              <textarea class="form-control" name="memo" rows="2" placeholder="Special instructions, preferences, laundry notes..."></textarea>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fa fa-times me-2"></i><%= language.Cancel %>
          </button>
          <button type="submit" class="btn btn-primary">
            <i class="fa fa-save me-2"></i><%= language.Save %>
          </button>
        </div>
      </form>
    </div>
  </div>

