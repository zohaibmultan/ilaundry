                          <div class="fw-semibold fs-12 text-break" id="pos_cd_address">—</div>
                        </div>
                      </div>
                    </div>

                    <!-- Customer Memo / Notes -->
                    <div class="p-2.5 rounded border bg-warning-subtle border-warning-subtle mb-3">
                      <div class="d-flex align-items-center justify-content-between mb-1">
