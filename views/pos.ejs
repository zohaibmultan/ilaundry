            </label>
            <textarea class="form-control" id="pos_void_notes_input" rows="2" placeholder="Explain details or customer feedback..."></textarea>
          </div>
        </div>
        <div class="modal-footer bg-light border-top d-flex justify-content-between">
          <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">
            <i class="fa fa-times me-1"></i>Cancel
          </button>
          <button type="button" class="btn btn-danger px-4 fw-bold" id="btn_pos_confirm_void_submit">
            <i class="fa fa-ban me-1"></i>Confirm Void Order
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- New Order Confirmation Modal (when cart has items) -->
  <div class="modal fade" id="pos_new_order_confirm_modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header bg-primary-subtle text-primary border-bottom">
          <h5 class="modal-title fw-bold">
            <i class="fa fa-plus-circle text-primary me-2"></i>Start New Order?
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4 text-center">
          <div class="mb-3">
            <span class="badge bg-warning-subtle text-warning fs-4 p-3 rounded-circle">
              <i class="fa fa-shopping-basket"></i>
            </span>
          </div>
          <h6 class="fw-bold mb-2">Active Order In Progress (#<span id="pos_new_order_active_id"><%= cart.order_id %></span>)</h6>
          <p class="text-muted fs-13 mb-3">
            You currently have items in this order cart. To keep records accurate, would you like to <strong>Void</strong> this order with a reason, or discard and start fresh?
          </p>
          <div class="d-grid gap-2">
            <button type="button" class="btn btn-outline-danger fw-bold py-2" id="btn_pos_new_order_void_first">
              <i class="fa fa-ban me-1"></i>Void This Order First
            </button>
            <button type="button" class="btn btn-primary fw-bold py-2" id="btn_pos_new_order_discard_fresh">
              <i class="fa fa-redo me-1"></i>Discard & Start Fresh Order
            </button>
          </div>
        </div>
        <div class="modal-footer bg-light border-top justify-content-center">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
            <i class="fa fa-arrow-left me-1"></i>Stay on Current Order
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Logout Confirmation Modal -->
  <div class="modal fade" id="logoutConfirmModal" tabindex="-1" aria-labelledby="logoutConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
      <div class="modal-content text-center p-3 border-0 shadow-lg rounded-4">
        <div class="modal-body pt-4 pb-2">
          <div class="mb-3">
            <div class="p-3 bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
              <i class="fa fa-sign-out-alt fs-3"></i>
            </div>
          </div>
          <h4 class="mb-2 fw-bold text-dark-emphasis" id="logoutConfirmModalLabel">
            <%= language.Logout || 'Logout Confirmation' %>
          </h4>
          <p class="text-muted mb-4 fs-14">
            <%= language.Are_you_sure_logout || 'Are you sure you want to end your current session and log out?' %>
          </p>
          <div class="d-flex gap-2 justify-content-center">
            <button type="button" class="btn btn-outline-secondary px-3 py-2 fw-semibold" data-bs-dismiss="modal">
              <i class="fa fa-times me-1"></i><%= language.Cancel || 'Cancel' %>
            </button>
            <a href="/logout" class="btn btn-danger px-4 py-2 fw-semibold d-inline-flex align-items-center">
              <i class="fa fa-sign-out-alt me-1"></i><%= language.Logout || 'Yes, Logout' %>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('templet/footer') -%>
  </div>
  <!--********** Main wrapper end **********-->

  <%- include('templet/script') -%>
  <script src="/js/pos-print-client.js"></script>

  <!-- POS Core Client Runtime Script -->
  <script>
    (function() {
      "use strict";

      // Global Server Configuration Injections
      window.POS_READY_SCHEDULE = <%- JSON.stringify((typeof readySchedule !== 'undefined' && readySchedule) ? readySchedule : (typeof locals !== 'undefined' && locals.readySchedule ? locals.readySchedule : {})) %>;
      window.POS_INITIAL_CATEGORIES = <%- JSON.stringify((typeof categoryList !== 'undefined' && categoryList) ? categoryList : []) %>;
      window.POS_INITIAL_SUBCATEGORIES = <%- JSON.stringify((typeof subcategoryList !== 'undefined' && subcategoryList) ? subcategoryList : []) %>;
      window.POS_CUSTOMER_LIST = <%- JSON.stringify((typeof customerList !== 'undefined' && customerList) ? customerList : []) %>;

      const serverUrl = "<%= (typeof storePrinterConfig !== 'undefined' && storePrinterConfig && storePrinterConfig.printing_server_url) ? storePrinterConfig.printing_server_url : (accessdata?.masterstore?.printing_server_url || 'http://127.0.0.1:4321') %>";
      const silentEnabled = <%= ((typeof storePrinterConfig !== 'undefined' && storePrinterConfig && storePrinterConfig.silent_print_enabled !== null && storePrinterConfig.silent_print_enabled !== undefined) ? (storePrinterConfig.silent_print_enabled != 0) : (accessdata?.masterstore?.silent_print_enabled !== 0)) ? 'true' : 'false' %>;
      const targetPrinter = "<%= (typeof storePrinterConfig !== 'undefined' && storePrinterConfig && storePrinterConfig.invoice_printer_name) ? storePrinterConfig.invoice_printer_name : (accessdata?.masterstore?.invoice_printer_name || '') %>";

      const posClient = new POSPrintClient({
        baseUrl: serverUrl,
        timeout: 4000
      });

      // Ping Printing Server for Live Hardware Status
      async function pingPosPrintingServer(isManual) {
        const btn = document.getElementById('posPrinterStatusBtn');
        const dot = document.getElementById('posPrinterStatusDot');
        const text = document.getElementById('posPrinterStatusText');
        const popBadge = document.getElementById('posPopoverStatusBadge');
        const popMode = document.getElementById('posPopoverModeText');

        if (isManual && typeof toastr !== 'undefined') {
          toastr.info('Checking printing server at ' + serverUrl + '...', 'Connecting');
        }

        try {
          const health = await posClient.request('/health');
          if (health && health.status === 'running') {
            if (dot) dot.className = 'pos-printer-dot dot-online';
            if (text) {
              const shortName = targetPrinter ? (targetPrinter.length > 15 ? targetPrinter.substring(0, 15) + '...' : targetPrinter) : 'Ready';
              text.textContent = 'Silent Print: Online (' + shortName + ')';
            }
            if (btn) {
              btn.classList.remove('btn-outline-danger', 'btn-outline-secondary');
              btn.classList.add('btn-outline-success');
            }
            if (popBadge) {
              popBadge.className = 'badge bg-success text-white';
              popBadge.textContent = 'Online';
            }
            if (popMode) {
              popMode.className = 'fw-semibold text-success';
              popMode.textContent = silentEnabled ? 'Silent Zero-Click Spooler' : 'Silent Disabled (Native Print)';
            }
            if (isManual && typeof toastr !== 'undefined') {
              toastr.success('Printing Server is online! Ready for silent receipts.', 'Hardware Connected');
            }
          } else {
            throw new Error('Server offline');
          }
        } catch (e) {
          if (dot) dot.className = 'pos-printer-dot dot-offline';
          if (text) text.textContent = 'Silent Print: Offline';
          if (btn) {
            btn.classList.remove('btn-outline-success', 'btn-outline-secondary');
            btn.classList.add('btn-outline-danger');
          }
          if (popBadge) {
            popBadge.className = 'badge bg-danger text-white';
            popBadge.textContent = 'Offline';
          }
          if (popMode) {
            popMode.className = 'fw-semibold text-danger';
            popMode.textContent = 'Native Browser Dialog (Ctrl+P)';
          }
          if (isManual && typeof toastr !== 'undefined') {
            toastr.warning('Printing server is offline. Standard browser print dialog will be used.', 'Native Fallback Active');
          }
        }
      }
      window.pingPosPrintingServer = pingPosPrintingServer;

      // Mobile / Tablet Segmented View Switcher
      function switchPosMobileTab(tab) {
        const catalogCol = document.getElementById('posCatalogColumn');
        const cartCol = document.getElementById('posCartColumn');
        const btnCatalog = document.getElementById('posBtnShowCatalog');
        const btnCart = document.getElementById('posBtnShowCart');

        if (tab === 'catalog') {
          catalogCol?.classList.remove('pos-panel-hidden');
          cartCol?.classList.add('pos-panel-hidden');
          btnCatalog?.classList.add('active');
          btnCart?.classList.remove('active');
        } else {
          catalogCol?.classList.add('pos-panel-hidden');
          cartCol?.classList.remove('pos-panel-hidden');
          btnCart?.classList.add('active');
          btnCatalog?.classList.remove('active');
        }
      }
      window.switchPosMobileTab = switchPosMobileTab;

      // Mobile Cart Badge & Empty State Updater
      function updatePosMobileCartBadge() {
        const cartList = document.getElementById('POS_service_added_list');
        const badge = document.getElementById('posMobileCartBadge');
        const emptyIndicator = document.getElementById('pos_empty_cart_indicator');
        const cartTable = document.getElementById('pos_cart_main_table');
        const count = cartList ? cartList.querySelectorAll('tr').length : 0;

        if (badge) badge.textContent = count;

        if (emptyIndicator) {
          if (count === 0) {
            emptyIndicator.classList.remove('d-none');
            emptyIndicator.classList.add('d-flex');
            if (cartTable) cartTable.classList.add('d-none');
          } else {
            emptyIndicator.classList.add('d-none');
            emptyIndicator.classList.remove('d-flex');
            if (cartTable) cartTable.classList.remove('d-none');
          }
        }

        if (typeof window.updatePosCheckoutBtnState === 'function') {
          window.updatePosCheckoutBtnState();
        }
      }
      window.updatePosMobileCartBadge = updatePosMobileCartBadge;

      // Customer Intelligence & Memo UI Update Helper
      window.updatePosCustomerIntelligence = function(stats) {
        if (!stats) stats = { total_orders: 0, unpaid_orders: 0, unpaid_amount: 0, memo: '' };
        const sym = document.querySelector('input[name="sym"]')?.value || '$';
        const elTotal = document.getElementById('pos_cust_stat_total');
        const elUnpaid = document.getElementById('pos_cust_stat_unpaid');
        const elBalance = document.getElementById('pos_cust_stat_balance');
        const elMemoText = document.getElementById('pos_cust_memo_text');
        const elMemoInput = document.getElementById('pos_cust_memo_input');

        if (elTotal) elTotal.textContent = stats.total_orders || 0;
        if (elUnpaid) elUnpaid.textContent = stats.unpaid_orders || 0;
        if (elBalance) {
          const amt = parseFloat(stats.unpaid_amount || 0).toFixed(2);
          elBalance.textContent = sym + ' ' + amt;
        }

        const cleanMemo = (stats.memo && stats.memo.trim() !== '') ? stats.memo.trim() : '';
        if (elMemoText) {
          if (cleanMemo) {
            elMemoText.textContent = cleanMemo;
            elMemoText.classList.remove('text-muted');
          } else {
            elMemoText.innerHTML = '<em>No notes recorded for this customer.</em>';
            elMemoText.classList.add('text-muted');
          }
        }
        if (elMemoInput) {
          elMemoInput.value = cleanMemo;
        }
      };

      function fetchCurrentCustomerStats(customerId) {
        if (!customerId || customerId === '0' || customerId === 'null') {
          window.updatePosCustomerIntelligence({ total_orders: 0, unpaid_orders: 0, unpaid_amount: 0, memo: '' });
          return;
        }
        fetch('/admin/customer-stats/' + encodeURIComponent(customerId))
          .then(r => r.json())
          .then(data => {
            if (data && data.success && data.stats) {
              window.updatePosCustomerIntelligence(data.stats);
            }
          })
          .catch(err => console.error('Error fetching customer stats:', err));
      }
      window.fetchCurrentCustomerStats = fetchCurrentCustomerStats;

      // Document Ready Lifecycle
      document.addEventListener('DOMContentLoaded', function() {
        // Auto-collapse sidebar for wide POS layout
        const mainWrapper = document.getElementById('main-wrapper');
        if (mainWrapper) mainWrapper.classList.add('menu-toggle');
        const hamburger = document.querySelector('.hamburger');
        if (hamburger) hamburger.classList.add('is-active');

        // Sidebar Expand/Collapse Toggle Button
        const posSidebarBtn = document.getElementById('pos_sidebar_toggle');
        if (posSidebarBtn) {
          posSidebarBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const navControl = document.querySelector('.nav-control');
            if (navControl) {
              navControl.click();
            } else {
              if (mainWrapper) mainWrapper.classList.toggle('menu-toggle');
              if (hamburger) hamburger.classList.toggle('is-active');
            }
          });
        }

        // Initial Customer Intelligence Stats Population
        const custSelect = document.getElementById('single-select');
        if (custSelect && custSelect.value && custSelect.value !== '0') {
          fetchCurrentCustomerStats(custSelect.value);
        }

        if (typeof window.updatePosCheckoutBtnState === 'function') {
          window.updatePosCheckoutBtnState();
        }

        const activeOT = $('#edit_pos_order_type').length ? $('#edit_pos_order_type').val() : $('#pos_order_type').val();
        if (typeof window.updatePosScheduleGroupsVisibility === 'function') {
          window.updatePosScheduleGroupsVisibility(activeOT, $('#edit_pos_order_type').length > 0);
        }

        // Quick Memo Editing Handlers
        const btnEditMemo = document.getElementById('btn_toggle_pos_memo_edit');
        const btnCancelMemo = document.getElementById('btn_cancel_pos_memo');
        const btnSaveMemo = document.getElementById('btn_save_pos_memo');
        const memoViewContainer = document.getElementById('pos_memo_view_container');
        const memoEditContainer = document.getElementById('pos_memo_edit_container');
        const memoInput = document.getElementById('pos_cust_memo_input');

        if (btnEditMemo && memoViewContainer && memoEditContainer) {
          btnEditMemo.addEventListener('click', function(e) {
            e.preventDefault();
            memoViewContainer.classList.add('d-none');
            memoEditContainer.classList.remove('d-none');
            if (memoInput) memoInput.focus();
          });
        }

        if (btnCancelMemo && memoViewContainer && memoEditContainer) {
          btnCancelMemo.addEventListener('click', function(e) {
            e.preventDefault();
            memoEditContainer.classList.add('d-none');
            memoViewContainer.classList.remove('d-none');
          });
        }

        if (btnSaveMemo) {
          btnSaveMemo.addEventListener('click', function(e) {
            e.preventDefault();
            const custId = custSelect ? custSelect.value : null;
            if (!custId || custId === '0') {
              if (typeof toastr !== 'undefined') toastr.warning('Please select a customer first');
              return;
            }
            const newMemo = memoInput ? memoInput.value : '';
            btnSaveMemo.disabled = true;
            btnSaveMemo.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Saving...';

            fetch('/coustomer/update-memo', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ customer_id: custId, memo: newMemo })
            })
            .then(r => r.json())
            .then(res => {
              btnSaveMemo.disabled = false;
              btnSaveMemo.innerHTML = '<i class="fa fa-check me-1"></i>Save Note';
              if (res && res.success) {
                if (memoEditContainer) memoEditContainer.classList.add('d-none');
                if (memoViewContainer) memoViewContainer.classList.remove('d-none');
                const elMemoText = document.getElementById('pos_cust_memo_text');
                if (elMemoText) {
                  if (newMemo && newMemo.trim()) {
                    elMemoText.textContent = newMemo.trim();
                    elMemoText.classList.remove('text-muted');
                  } else {
                    elMemoText.innerHTML = '<em>No notes recorded for this customer.</em>';
                    elMemoText.classList.add('text-muted');
                  }
                }
                if (typeof toastr !== 'undefined') toastr.success('Customer memo updated successfully');
              } else {
                if (typeof toastr !== 'undefined') toastr.error(res?.message || 'Failed to update memo');
              }
            })
            .catch(() => {
              btnSaveMemo.disabled = false;
              btnSaveMemo.innerHTML = '<i class="fa fa-check me-1"></i>Save Note';
              if (typeof toastr !== 'undefined') toastr.error('Failed to update memo');
            });
          });
        }

        // Hardware Polling
        pingPosPrintingServer(false);
        setInterval(() => pingPosPrintingServer(false), 25000);

        // Observe cart items list for mobile badge updates
        const cartList = document.getElementById('POS_service_added_list');
        if (cartList && window.MutationObserver) {
          const observer = new MutationObserver(() => updatePosMobileCartBadge());
          observer.observe(cartList, { childList: true });
        }
        updatePosMobileCartBadge();
      });

      // jQuery Modal Initializations
      if (window.jQuery) {
        const $ = window.jQuery;

        // Payment Type Select2 in Modal
        $('#POS_payment_model').on('shown.bs.modal', function() {
          const $payList = $('#POS_payment_type_list');
          if ($payList.hasClass("select2-hidden-accessible")) {
            $payList.select2('destroy');
          }
          $payList.select2({
            dropdownParent: $('#POS_payment_model'),
            placeholder: 'Choose Payment Type',
            width: '100%',
            allowClear: false
          });
        });

        // Garment Inspection Modal Select2 Dropdowns (Primary, Secondary Color & Pattern)
        function formatColorSelect2Option(state) {
          if (!state.id) return state.text;
          var hex = $(state.element).data('hex');
          var isGrad = $(state.element).data('gradient');
          var isBorder = $(state.element).data('border');
          var isNone = $(state.element).data('none');
          if (isNone) {
            return $('<span><i class="fa fa-ban text-muted me-2" style="font-size: 11px;"></i>' + state.text + '</span>');
          }
          if (!hex) return state.text;
          var style = isGrad
            ? 'background: ' + hex + '; width: 14px; height: 14px;'
            : 'background-color: ' + hex + '; width: 14px; height: 14px;';
          var borderClass = isBorder ? ' border' : '';
          var $swatch = $('<span class="rounded-circle d-inline-block me-2 align-middle' + borderClass + '" style="' + style + '"></span>');
          var $text = $('<span>' + state.text + '</span>');
          return $('<span></span>').append($swatch).append($text);
        }

        $('#pos_brand_modal').on('shown.bs.modal', function() {
          const $prim = $('#pos_modal_primary_color');
          const $sec = $('#pos_modal_secondary_color');
          const $pat = $('#pos_modal_pattern');

          if (!$prim.hasClass("select2-hidden-accessible")) {
            $prim.select2({
              dropdownParent: $('#pos_brand_modal'),
              placeholder: '-- Select Color --',
              width: '100%',
              templateResult: formatColorSelect2Option,
              templateSelection: formatColorSelect2Option
            });
          }
          if (!$sec.hasClass("select2-hidden-accessible")) {
            $sec.select2({
              dropdownParent: $('#pos_brand_modal'),
              placeholder: 'None',
              width: '100%',
              templateResult: formatColorSelect2Option,
              templateSelection: formatColorSelect2Option
            });
          }
          if (!$pat.hasClass("select2-hidden-accessible")) {
            $pat.select2({
              dropdownParent: $('#pos_brand_modal'),
              placeholder: 'Select Pattern',
              width: '100%'
            });
          }
        });

        // =====================================================================
        // POS Customer Selection Modal Controller (Search + Right Details Panel)
        // =====================================================================
        let modalSelectedCustomerId = null;

        function escapeHtml(str) {
          if (str === null || str === undefined) return '';
          return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
        }

        function formatPosCustomerName(c) {
          if (!c) return '';
          const lName = (c.last_name || '').trim();
          const fName = (c.first_name || '').trim();
          if (lName && fName) return lName + ', ' + fName;
          return (c.name || fName || lName || 'Customer').trim();
        }

        function formatPosCustomerDisplayText(c) {
          if (!c) return '';
          const cName = formatPosCustomerName(c);
          const cPhone = (c.number || '').trim();
          return cPhone ? (cName + ' (' + cPhone + ')') : cName;
        }

        function getCustomerInitials(c) {
          const name = formatPosCustomerName(c);
          if (!name) return 'CU';
          const parts = name.replace(/,/g, ' ').trim().split(/\s+/).filter(Boolean);
          if (parts.length >= 2) {
            return (parts[0][0] + parts[1][0]).toUpperCase();
          }
          return name.substring(0, 2).toUpperCase();
        }

        window.syncPosCustomerDisplay = function(targetCustomerId) {
          const custId = (targetCustomerId !== undefined && targetCustomerId !== null)
            ? String(targetCustomerId)
            : String($('#single-select').val() || '0');
          const $displayInput = $('#pos_customer_display_input');
          if (!$displayInput.length) return;

          const isStoreUnselected = $('#pos_store_id').length > 0 && (!$('#pos_store_id').val() || $('#pos_store_id').val() === '0') && (!$('#pos_staff_store_id').val() || $('#pos_staff_store_id').val() === '0');
          if (isStoreUnselected) {
            $displayInput.val('');
            $displayInput.attr('placeholder', '<%= language.Select_Store_First || "Select Store First" %>');
            return;
          }
          $displayInput.attr('placeholder', '<%= language.Select_Customer || "Click to select customer..." %>');

          if (!custId || custId === '0') {
            $displayInput.val('');
            return;
          }

          const list = Array.isArray(window.POS_CUSTOMER_LIST) ? window.POS_CUSTOMER_LIST : [];
          const found = list.find(function(x) { return String(x.id) === custId; });
          if (found) {
            $displayInput.val(formatPosCustomerDisplayText(found));
          } else {
            const optText = $('#single-select option[value="' + custId + '"]').text().trim();
            $displayInput.val(optText || '');
          }
        };

        function renderPosCustomerModalDetails(c) {
          if (!c) {
            $('#pos_cust_detail_empty').removeClass('d-none').addClass('d-flex');
            $('#pos_cust_detail_content').addClass('d-none').removeClass('d-flex');
            $('#btn_pos_confirm_customer').prop('disabled', true);
            return;
          }

          $('#pos_cust_detail_empty').addClass('d-none').removeClass('d-flex');
          $('#pos_cust_detail_content').removeClass('d-none').addClass('d-flex');
          $('#btn_pos_confirm_customer').prop('disabled', false);

          const sym = document.querySelector('input[name="sym"]')?.value || '$';
          const fullName = formatPosCustomerName(c);
          const phone = (c.number && String(c.number).trim() !== '') ? String(c.number).trim() : '—';
          const email = (c.email && String(c.email).trim() !== '') ? String(c.email).trim() : '—';
          const addrParts = [c.address, c.city, c.state, c.zipcode].map(function(p) { return (p || '').trim(); }).filter(Boolean);
          const fullAddress = addrParts.length > 0 ? addrParts.join(', ') : 'No address on file';
          const custType = (c.customer_type && String(c.customer_type).trim() !== '') ? String(c.customer_type).trim() : 'Counter • Counter';
          const storeName = (c.store_name && String(c.store_name).trim() !== '') ? String(c.store_name).trim() : 'Store Customer';
          const memo = (c.memo && String(c.memo).trim() !== '') ? String(c.memo).trim() : '';
          const taxNum = (c.taxnumber && String(c.taxnumber).trim() !== '') ? ('Tax ID: ' + String(c.taxnumber).trim()) : '';

          $('#pos_cd_avatar').text(getCustomerInitials(c));
          $('#pos_cd_name').text(fullName);
          $('#pos_cd_id_badge').text('#' + c.id);
          $('#pos_cd_type_badge').text(custType);
          $('#pos_cd_store_name').text(storeName);
          $('#pos_cd_phone').text(phone);
          $('#pos_cd_email').text(email);
          $('#pos_cd_address').text(fullAddress);
          $('#pos_cd_tax').text(taxNum);

          if (memo) {
            $('#pos_cd_memo').text(memo).removeClass('text-muted fst-italic');
          } else {
            $('#pos_cd_memo').text('No notes recorded for this customer.').addClass('text-muted fst-italic');
          }

          const totalOrders = parseInt(c.total_orders, 10) || 0;
          const unpaidOrders = parseInt(c.unpaid_orders, 10) || 0;
          const unpaidAmt = parseFloat(c.unpaid_amount || 0).toFixed(2);

          $('#pos_cd_stat_total').text(totalOrders);
          $('#pos_cd_stat_unpaid').text(unpaidOrders);
          $('#pos_cd_stat_balance').text(sym + ' ' + unpaidAmt);

          // Fetch fresh live stats in background to ensure 100% real-time accuracy
          fetch('/admin/customer-stats/' + encodeURIComponent(c.id))
            .then(function(r) { return r.json(); })
            .then(function(data) {
              if (data && data.success && data.stats && String(modalSelectedCustomerId) === String(c.id)) {
                c.total_orders = data.stats.total_orders || 0;
                c.unpaid_orders = data.stats.unpaid_orders || 0;
                c.unpaid_amount = data.stats.unpaid_amount || 0;
                if (data.stats.memo !== undefined) c.memo = data.stats.memo;

                $('#pos_cd_stat_total').text(c.total_orders);
                $('#pos_cd_stat_unpaid').text(c.unpaid_orders);
                $('#pos_cd_stat_balance').text(sym + ' ' + parseFloat(c.unpaid_amount || 0).toFixed(2));
                if (c.memo && String(c.memo).trim() !== '') {
                  $('#pos_cd_memo').text(String(c.memo).trim()).removeClass('text-muted fst-italic');
                }
              }
            })
            .catch(function() {});
        }

        function renderPosCustomerModalList(query) {
          const list = Array.isArray(window.POS_CUSTOMER_LIST) ? window.POS_CUSTOMER_LIST : [];
          const q = (query || '').trim().toLowerCase();
          const $container = $('#pos_cust_modal_list');
          if (!$container.length) return;

          const filtered = list.filter(function(c) {
            if (!q) return true;
            const fullName = formatPosCustomerName(c).toLowerCase();
            const rawName = (c.name || '').toLowerCase();
            const fName = (c.first_name || '').toLowerCase();
            const lName = (c.last_name || '').toLowerCase();
            const phone = String(c.number || '').toLowerCase();
            const email = String(c.email || '').toLowerCase();
            return fullName.includes(q) || rawName.includes(q) || fName.includes(q) || lName.includes(q) || phone.includes(q) || email.includes(q);
          });

          $('#pos_cust_modal_count_badge').text(filtered.length + (filtered.length === 1 ? ' Customer' : ' Customers'));

          if (filtered.length === 0) {
            $container.html(
              '<div class="d-flex flex-column align-items-center justify-content-center text-center py-5 px-3">' +
                '<div class="text-muted mb-2"><i class="fa fa-search fa-2x opacity-50"></i></div>' +
                '<div class="fw-bold fs-13 mb-1">No matching customers found</div>' +
                '<p class="text-muted fs-11 mb-3">No customer matches "' + escapeHtml(query) + '" by name, phone, or email.</p>' +
                '<button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold" id="btn_empty_search_add_cust">' +
                  '<i class="fa fa-user-plus me-1"></i>Add New Customer' +
                '</button>' +
              '</div>'
            );
            return;
          }

          let html = '<div class="list-group list-group-flush">';
          filtered.forEach(function(c) {
            const isSelected = modalSelectedCustomerId && String(c.id) === String(modalSelectedCustomerId);
            const activeClass = isSelected ? ' active' : '';
            const fullName = escapeHtml(formatPosCustomerName(c));
            const phone = c.number ? escapeHtml(c.number) : '';
            const email = c.email ? escapeHtml(c.email) : '';
            const custType = escapeHtml(c.customer_type || 'Counter • Counter');
            const initials = escapeHtml(getCustomerInitials(c));

            let subLine = '';
            if (phone) {
              subLine += '<span class="me-3"><i class="fa fa-phone-alt me-1 opacity-75"></i>' + phone + '</span>';
            }
            if (email) {
              subLine += '<span class="text-truncate"><i class="fa fa-envelope me-1 opacity-75"></i>' + email + '</span>';
            }
            if (!subLine) {
              subLine = '<span class="fst-italic opacity-75">Walk-in / Default Profile</span>';
            }

            html +=
              '<div class="list-group-item list-group-item-action pos-cust-list-item d-flex align-items-center justify-content-between gap-2 py-2.5 px-3 cursor-pointer' + activeClass + '" data-cust-id="' + escapeHtml(c.id) + '" role="button" tabindex="0">' +
                '<div class="d-flex align-items-center gap-2.5 overflow-hidden">' +
                  '<div class="pos-cust-list-avatar rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0">' +
                    initials +
                  '</div>' +
                  '<div class="overflow-hidden">' +
                    '<div class="fw-bold fs-13 text-truncate pos-cust-item-name">' + fullName + '</div>' +
                    '<div class="fs-11 d-flex align-items-center flex-wrap pos-cust-item-sub text-muted">' + subLine + '</div>' +
                  '</div>' +
                '</div>' +
                '<span class="badge bg-light-subtle text-dark border fs-10 flex-shrink-0 pos-cust-item-badge">' + custType + '</span>' +
              '</div>';
          });
          html += '</div>';
          $container.html(html);
        }

        function confirmPosCustomerSelection(custId) {
          if (!custId || String(custId) === '0') return;
          const list = Array.isArray(window.POS_CUSTOMER_LIST) ? window.POS_CUSTOMER_LIST : [];
          const found = list.find(function(x) { return String(x.id) === String(custId); });

          const $select = $('#single-select');
          if ($select.find('option[value="' + custId + '"]').length === 0 && found) {
            $select.append(
              $('<option></option>')
                .attr('value', found.id)
                .attr('data-customer-type', found.customer_type || 'Counter • Counter')
                .attr('data-address', found.address || '')
                .attr('data-city', found.city || '')
                .attr('data-state', found.state || '')
                .attr('data-zipcode', found.zipcode || '')
                .text(formatPosCustomerDisplayText(found))
            );
          }

          $select.val(String(custId)).trigger('change');
          window.syncPosCustomerDisplay(custId);
          if (found && found.customer_type && typeof window.applyCustomerTypeToPos === 'function') {
            window.applyCustomerTypeToPos(found.customer_type);
          }
          $('#pos_customer_select_modal').modal('hide');
        }

        window.openPosCustomerSelectModal = function() {
          const $select = $('#single-select');
          const isStoreUnselected = $('#pos_store_id').length > 0 && (!$('#pos_store_id').val() || $('#pos_store_id').val() === '0') && (!$('#pos_staff_store_id').val() || $('#pos_staff_store_id').val() === '0');
          if ($select.prop('disabled') || isStoreUnselected) {
            if (typeof toastr !== 'undefined') {
              toastr.warning('<%= language.Select_Store_First || "Please select a store first." %>');
            }
            return;
          }
          $('#pos_customer_select_modal').modal('show');
        };

        // Trigger Modal when clicking on Customer display input or trigger box
        $(document).on('click', '#pos_customer_trigger_box, #pos_customer_display_input', function(e) {
          e.preventDefault();
          window.openPosCustomerSelectModal();
        });

        $(document).on('keydown', '#pos_customer_trigger_box, #pos_customer_display_input', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            window.openPosCustomerSelectModal();
          }
        });

        // Populate Modal on Show
        $('#pos_customer_select_modal').on('show.bs.modal', function() {
          $('#pos_cust_modal_search').val('');
          $('#btn_clear_cust_modal_search').addClass('d-none');

          const currentId = String($('#single-select').val() || '0');
          const list = Array.isArray(window.POS_CUSTOMER_LIST) ? window.POS_CUSTOMER_LIST : [];
          const currentObj = (currentId && currentId !== '0')
            ? list.find(function(x) { return String(x.id) === currentId; })
            : null;

          modalSelectedCustomerId = currentObj ? String(currentObj.id) : null;
          renderPosCustomerModalList('');
          renderPosCustomerModalDetails(currentObj || null);
        });

        $('#pos_customer_select_modal').on('shown.bs.modal', function() {
          $('#pos_cust_modal_search').trigger('focus');
          const $activeItem = $('#pos_cust_modal_list .pos-cust-list-item.active');
          if ($activeItem.length) {
            $activeItem[0].scrollIntoView({ block: 'nearest' });
          }
        });

        // Search input filtering (by Name, Phone, or Email)
        $(document).on('input', '#pos_cust_modal_search', function() {
          const val = $(this).val() || '';
          if (val.trim().length > 0) {
            $('#btn_clear_cust_modal_search').removeClass('d-none');
          } else {
            $('#btn_clear_cust_modal_search').addClass('d-none');
          }
          renderPosCustomerModalList(val);
        });

        $(document).on('click', '#btn_clear_cust_modal_search', function() {
          $('#pos_cust_modal_search').val('').trigger('input').trigger('focus');
        });

        // Single-click customer row -> Preview full details on Right Panel
        $(document).on('click', '#pos_cust_modal_list .pos-cust-list-item', function() {
          const custId = $(this).attr('data-cust-id');
          if (!custId) return;
          modalSelectedCustomerId = String(custId);
          $('#pos_cust_modal_list .pos-cust-list-item').removeClass('active');
          $(this).addClass('active');

          const list = Array.isArray(window.POS_CUSTOMER_LIST) ? window.POS_CUSTOMER_LIST : [];
          const found = list.find(function(x) { return String(x.id) === String(custId); });
          renderPosCustomerModalDetails(found || null);
        });

        // Double-click customer row -> Immediately confirm selection & close modal
        $(document).on('dblclick', '#pos_cust_modal_list .pos-cust-list-item', function() {
          const custId = $(this).attr('data-cust-id');
          if (!custId) return;
          confirmPosCustomerSelection(custId);
        });

        // Keyboard Enter on focused customer row -> Confirm selection
        $(document).on('keydown', '#pos_cust_modal_list .pos-cust-list-item', function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            const custId = $(this).attr('data-cust-id');
            if (custId) confirmPosCustomerSelection(custId);
          }
        });

        // Confirm Selection Button Click
        $(document).on('click', '#btn_pos_confirm_customer', function() {
          if (!modalSelectedCustomerId) return;
          confirmPosCustomerSelection(modalSelectedCustomerId);
        });

        // Switch from Customer Selection Modal to "+ New Customer" Modal
        $(document).on('click', '#btn_modal_open_add_customer, #btn_empty_search_add_cust', function() {
          const searchVal = ($('#pos_cust_modal_search').val() || '').trim();
          $('#pos_customer_select_modal').modal('hide');
          setTimeout(function() {
            if (searchVal) {
              if (/^\d+$/.test(searchVal)) {
                $('#pos_add_cust_number').val(searchVal).trigger('input');
              } else if (searchVal.includes('@')) {
                $('#addcustomer input[name="email"]').val(searchVal);
              } else {
                const parts = searchVal.split(/\s+/);
                if (parts.length > 1) {
                  $('#addcustomer input[name="first_name"]').val(parts[0]);
                  $('#addcustomer input[name="last_name"]').val(parts.slice(1).join(' '));
                } else {
                  $('#addcustomer input[name="last_name"]').val(searchVal);
                }
              }
            }
            $('#addcustomer').modal('show');
          }, 200);
        });

        // Add Customer Modal Setup
        $('#addcustomer').on('show.bs.modal', function() {
          const posStore = $('#pos_store_id').val();
          if ($('#coupon_storlist_update').length && posStore && posStore != '0') {
            $('#coupon_storlist_update').val(posStore).trigger('change');
          }
          $('#pos_add_cust_username').removeData('manual-edit');
          $('#pos_add_cust_password').removeData('manual-edit');
        });

        $('#addcustomer').on('shown.bs.modal', function() {
          if ($('#coupon_storlist_update').length) {
            $('#coupon_storlist_update').select2({
              dropdownParent: $('#addcustomer'),
              placeholder: 'Select Store *',
              width: '100%',
              allowClear: false
            });
          }
        });

        // Automatically set phone number as default username & password
        $('#pos_add_cust_number').on('input', function() {
          const phoneVal = $(this).val();
          const $u = $('#pos_add_cust_username');
          const $p = $('#pos_add_cust_password');
          if (!$u.data('manual-edit') || $u.val() === '') $u.val(phoneVal);
          if (!$p.data('manual-edit') || $p.val() === '') $p.val(phoneVal);
        });

        $('#pos_add_cust_username').on('input', function() {
          $(this).data('manual-edit', true);
        });

        $('#pos_add_cust_password').on('input', function() {
          $(this).data('manual-edit', true);
        });

        // ==========================================
        // Feature: POS "R" Button (Customer Racks & Order Pickup)
        // ==========================================
        let currentPosAvailableRacks = [];

        function loadStoreRacksForPos(callback) {
          const storeId = $('#pos_store_id').val() || '0';
          $.ajax({
            url: '/order/get-order-racks?order_id=0&store_id=' + encodeURIComponent(storeId),
            type: 'GET',
            dataType: 'json',
            success: function(res) {
              currentPosAvailableRacks = (res && res.racks) ? res.racks : [];
              if (callback) callback(currentPosAvailableRacks);
            },
            error: function() {
              currentPosAvailableRacks = [];
              if (callback) callback([]);
            }
          });
        }

        $(document).on('click', '#btn_pos_open_racks', function() {
          const customerId = $('#single-select').val();
          if (!customerId || customerId === '0') {
            if (typeof toastr !== 'undefined') {
              toastr.warning('Please select a customer first to view their active racks and orders.');
            } else {
              alert('Please select a customer first.');
            }
            $('#pos_customer_display_input').trigger('click');
            return;
          }

          const custDisplayName = $('#pos_customer_display_input').val() || 'Customer';
          $('#pos_racks_modal_cust_subtitle').text('Active outstanding invoices for ' + custDisplayName);
          $('#pos_racks_loading').removeClass('d-none');
          $('#pos_racks_content').addClass('d-none');
          $('#pos_racks_empty').addClass('d-none');
          $('#pos_customer_racks_modal').modal('show');

          loadCustomerActiveOrdersForPos(customerId);
        });

        function loadCustomerActiveOrdersForPos(customerId) {
          $.ajax({
            url: '/order/customer-active-orders/' + encodeURIComponent(customerId),
            type: 'GET',
            dataType: 'json',
            success: function(res) {
              $('#pos_racks_loading').addClass('d-none');
              if (!res || !res.orders || res.orders.length === 0) {
                $('#pos_racks_empty').removeClass('d-none');
                $('#pos_racks_content').addClass('d-none');
                return;
              }

              $('#pos_racks_empty').addClass('d-none');
              $('#pos_racks_content').removeClass('d-none');
              $('#pos_racks_order_count_badge').text(res.orders.length + ' Active Order' + (res.orders.length > 1 ? 's' : ''));

              const tbody = $('#pos_racks_orders_tbody');
              tbody.empty();

              res.orders.forEach(function(ord) {
                const isReady = ord.is_ready;
                const statusBadge = isReady
                  ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="fa fa-check-circle me-1"></i>Ready for Pickup</span>'
                  : '<span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1"><i class="fa fa-sync-alt fa-spin me-1"></i>' + escapeHtml(ord.status_name) + '</span>';

                let rackDisplay = '<span class="text-muted fst-italic">Unassigned</span>';
                if (ord.rack_names) {
                  rackDisplay = '<span class="badge bg-primary text-white fs-12 px-2 py-1"><i class="fa fa-layer-group me-1"></i>' + escapeHtml(ord.rack_names) + '</span>';
                }

                const balDue = parseFloat(ord.balance_amount) || 0;
                const balClass = balDue > 0 ? 'text-danger fw-bold' : 'text-success fw-bold';
                const balDisplay = '$' + balDue.toFixed(2);

                const tr = $(`
                  <tr>
                    <td>
                      <a href="/order/view/${ord.id}" target="_blank" class="fw-bold text-primary fs-14 text-decoration-none" title="View Order #${escapeHtml(ord.order_id)}">#${escapeHtml(ord.order_id)}</a>
                    </td>
                    <td class="text-muted small">${ord.order_date ? ord.order_date.split('T')[0] : '---'}</td>
                    <td class="small fw-semibold text-dark">${ord.ready_date ? ord.ready_date.split('T')[0] : '---'}</td>
                    <td>${statusBadge}</td>
                    <td>${rackDisplay}</td>
                    <td class="${balClass}">${balDisplay}</td>
                    <td class="text-end">
                      <div class="d-flex align-items-center justify-content-end gap-1 flex-wrap">
                        <a href="/admin/edit/${ord.id}" class="btn btn-xs btn-outline-info py-1 px-2 btn-pos-open-order"
                          title="Open and edit this order in POS">
                          <i class="fa fa-cash-register me-1"></i>Open in POS
                        </a>
                        <button type="button" class="btn btn-xs btn-outline-primary py-1 px-2 btn-pos-edit-order-rack"
                          data-order-id="${ord.id}"
                          data-order-no="${escapeHtml(ord.order_id)}"
                          data-status-name="${escapeHtml(ord.status_name)}"
                          data-rack-ids="${escapeHtml(ord.rack_ids || '')}"
                          title="Assign or change storage rack">
                          <i class="fa fa-layer-group me-1"></i>${ord.rack_ids ? 'Edit Rack' : 'Assign Rack'}
                        </button>
                        <button type="button" class="btn btn-xs ${isReady ? 'btn-success' : 'btn-outline-success'} py-1 px-2 btn-pos-release-order"
                          data-order-id="${ord.id}"
                          data-balance="${balDue}"
                          title="Pickup & Release Order">
                          <i class="fa fa-hand-holding me-1"></i>${balDue > 0 ? 'Pay & Release' : 'Release Order'}
                        </button>
                      </div>
                    </td>
                  </tr>
                `);
                tbody.append(tr);
              });
            },
            error: function(xhr) {
              $('#pos_racks_loading').addClass('d-none');
              $('#pos_racks_empty').removeClass('d-none');
              $('#pos_racks_content').addClass('d-none');
              if (typeof toastr !== 'undefined') {
                toastr.error('Failed to load customer orders.');
              }
            }
          });
        }

        // Open Rack Assignment Modal from POS
        $(document).on('click', '.btn-pos-edit-order-rack', function() {
          const orderId = $(this).attr('data-order-id');
          const orderNo = $(this).attr('data-order-no');
          const statusName = $(this).attr('data-status-name');
          const currentRackIds = ($(this).attr('data-rack-ids') || '').split(',').map(function(s){ return s.trim(); });

          $('#pos_assign_order_id').val(orderId);
          $('#pos_assign_force_confirm').val('0');
          $('#pos_assign_order_display').text('#' + orderNo);
          $('#pos_assign_status_display').text(statusName);
          $('#pos_rack_collision_alert').addClass('d-none');

          const container = $('#pos_rack_checkboxes_container');
          container.html('<div class="text-muted small text-center py-2"><i class="fa fa-spinner fa-spin me-1"></i>Loading racks...</div>');
          $('#pos_edit_rack_modal').modal('show');

          const fallbackStoreId = $('#pos_store_id').val() || '';
          $.ajax({
            url: '/order/get-order-racks?order_id=' + encodeURIComponent(orderId) + '&store_id=' + encodeURIComponent(fallbackStoreId),
            type: 'GET',
            dataType: 'json',
            success: function(res) {
              container.empty();
              const racks = (res && res.racks) ? res.racks : [];
              if (racks.length === 0) {
                container.html('<div class="text-muted small text-center py-2">No racks configured yet for this store.</div>');
                return;
              }

              racks.forEach(function(r) {
                const isChecked = currentRackIds.includes(String(r.id)) ||
                  (res.currentRackIds && res.currentRackIds.map(String).includes(String(r.id))) ||
                  (res.selectedRackIds && res.selectedRackIds.map(String).includes(String(r.id))) ||
                  Boolean(r.selected);
                const occCount = (typeof r.active_orders_count !== 'undefined') ? r.active_orders_count : (r.orderCount || 0);
                const occLabel = (occCount > 0 && !isChecked)
                  ? `<span class="badge bg-warning-subtle text-dark border ms-2" style="font-size: 10px;">Occupied (${occCount} ord)</span>`
                  : '';

                const row = $(`
                  <div class="form-check py-1 border-bottom d-flex align-items-center">
                    <input class="form-check-input pos-rack-cb" type="checkbox" name="rack_ids[]" value="${r.id}" id="pos_rack_cb_${r.id}" ${isChecked ? 'checked' : ''}>
                    <label class="form-check-label ms-2 fw-semibold text-dark cursor-pointer d-flex align-items-center" for="pos_rack_cb_${r.id}">
                      <span>${escapeHtml(r.rack_name)}</span>
                      ${occLabel}
                    </label>
                  </div>
                `);
                container.append(row);
              });
            },
            error: function() {
              container.html('<div class="text-danger small text-center py-2">Failed to load racks.</div>');
            }
          });
        });

        // Submit POS Rack Assignment Form
        $('#pos_assign_rack_form').on('submit', function(e) {
          e.preventDefault();
          submitPosRackAssignment();
        });

        $('#btn_confirm_shared_rack').on('click', function() {
          $('#pos_assign_force_confirm').val('1');
          submitPosRackAssignment();
        });

        function submitPosRackAssignment() {
          const orderId = $('#pos_assign_order_id').val();
          const forceConfirm = $('#pos_assign_force_confirm').val();
          const selected = [];
          $('.pos-rack-cb:checked').each(function() {
            selected.push($(this).val());
          });

          if (selected.length === 0) {
            if (typeof toastr !== 'undefined') toastr.warning('Please select at least one rack.');
            else alert('Please select at least one rack.');
            return;
          }

          const $btn = $('#btn_save_pos_rack');
          $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1"></i>Saving...');

          $.ajax({
            url: '/order/assign-racks',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
              order_id: orderId,
              rack_ids: selected,
              force_confirm: forceConfirm
            }),
            success: function(res) {
              $btn.prop('disabled', false).html('<i class="fa fa-save me-1"></i>Save Rack Position');
              if (res.status === 'warning' && res.requires_confirmation) {
                if (typeof toastr !== 'undefined') {
                  toastr.warning(res.message, 'Rack Collision Warning', { timeOut: 7000, closeButton: true });
                }
                $('#pos_rack_collision_msg').text(res.message);
                $('#pos_rack_collision_alert').removeClass('d-none');
                return;
              }

              if (res.status === 'success') {
                if (typeof toastr !== 'undefined') toastr.success(res.message);
                $('#pos_edit_rack_modal').modal('hide');
                const custId = $('#single-select').val();
                if (custId) loadCustomerActiveOrdersForPos(custId);
              } else {
                if (typeof toastr !== 'undefined') toastr.error(res.message || 'Error saving rack');
                else alert(res.message || 'Error saving rack');
              }
            },
            error: function(xhr) {
              $btn.prop('disabled', false).html('<i class="fa fa-save me-1"></i>Save Rack Position');
              let msg = 'Failed to save rack assignment.';
              try {
                const parsed = JSON.parse(xhr.responseText);
                if (parsed && parsed.message) msg = parsed.message;
              } catch(e) {}
              if (typeof toastr !== 'undefined') toastr.error(msg);
              else alert(msg);
            }
          });
        }

        // Release / Pay Order from POS Racks Modal
        $(document).on('click', '.btn-pos-release-order', function() {
          const orderId = $(this).attr('data-order-id');
          const bal = parseFloat($(this).attr('data-balance')) || 0;

          if (bal > 0) {
            // Open Payment Modal
            if (typeof open_patment_model === 'function') {
              $('#pos_customer_racks_modal').modal('hide');
              open_patment_model(orderId);
            } else {
              window.location.href = '/order/view/' + encodeURIComponent(orderId);
            }
          } else {
            // Balance is 0 -> Quick Confirmation to Release as Delivered
            if (!confirm('Customer balance is settled ($0.00). Mark Order #' + orderId + ' as Delivered / Released?')) {
              return;
            }

            $.ajax({
              url: '/order/updateorderstatus/' + encodeURIComponent(orderId),
              type: 'POST',
              data: { status: '4' }, // 4 = Deliver
              success: function(res) {
                if (typeof toastr !== 'undefined') toastr.success('Order released & marked Delivered successfully!');
                const custId = $('#single-select').val();
                if (custId) loadCustomerActiveOrdersForPos(custId);
              },
              error: function(xhr) {
                if (typeof toastr !== 'undefined') toastr.error('Failed to update status.');
              }
            });
          }
        });

        // Order Placement & POS Print Handler
        $('#posprintform').on('submit', function(e) {
          e.preventDefault();
          const paidAmount = parseFloat($('#paid_amount').val()) || 0;
          const paymentType = $('#POS_payment_type_list').val();

          if (paidAmount > 0 && (!paymentType || paymentType === '0')) {
            if (typeof toastr !== 'undefined') {
              toastr.warning('Please select a payment type for the paid amount.');
            } else {
              alert('Please select a payment type.');
            }
            if ($('#POS_payment_type_list').data('select2')) {
              $('#POS_payment_type_list').select2('open');
            } else {
              $('#POS_payment_type_list').focus();
            }
            return false;
          }

          const $submitBtn = $('#printcheck');
          $submitBtn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-2"></i><%= language.Saving || "Saving..." %>');

          const formData = $(this).serialize();

          $.ajax({
            url: '/admin/save_order',
            type: 'POST',
            data: formData,
            dataType: 'json',
            success: function(res) {
              if (res && res.success) {
                window.location.href = '/admin/posprint?id=' + encodeURIComponent(res.id || res.order_id);
              } else {
                $submitBtn.prop('disabled', false).html('<i class="fa fa-print me-2"></i><%= language.Print || "Print" %>');
                const errMsg = (res && res.message) ? res.message : 'Error placing order. Please try again.';
                if (typeof toastr !== 'undefined') {
                  toastr.error(errMsg);
                } else {
                  alert(errMsg);
                }
              }
            },
            error: function(xhr) {
              $submitBtn.prop('disabled', false).html('<i class="fa fa-print me-2"></i><%= language.Print || "Print" %>');
              let errMsg = 'Server error placing order. Please try again.';
              try {
                const parsed = JSON.parse(xhr.responseText);
                if (parsed && parsed.message) errMsg = parsed.message;
              } catch (e) {}
              if (typeof toastr !== 'undefined') {
                toastr.error(errMsg);
              } else {
                alert(errMsg);
              }
            }
          });
          return false;
        });
      }
    })();
  </script>
</body>

</html>
