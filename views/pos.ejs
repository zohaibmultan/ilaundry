  <!-- Garment Brand Lookup & Camera Inspection Modal -->
  <div class="modal fade" id="pos_brand_modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
      <div class="modal-content">
        <div class="modal-header py-2 px-3">
          <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
            <i class="fa fa-tshirt text-primary"></i>
            <span><%= language.Garment_Inspection_Title || 'Garment Brand, Color & Pattern Inspection' %></span>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-3">
          <input type="hidden" id="pos_brand_modal_service_id" value="">
          <input type="hidden" id="pos_brand_modal_order_id" value="">
          <input type="hidden" id="pos_brand_modal_is_edit" value="0">
          <input type="hidden" id="pos_brand_modal_original_rate" value="0">
          <input type="hidden" id="pos_brand_modal_selected_id" value="0">

          <!-- Top Row: Garment Colors & Pattern Inspection Bar -->
          <div class="card border rounded-3 mb-3 pos-inspection-top-card shadow-sm">
            <div class="card-body p-2 px-3">
              <div class="row g-2 align-items-center">
                <!-- Primary Color -->
                <div class="col-12 col-md-4">
                  <label class="form-label fs-12 fw-bold pos-modal-label mb-1 d-flex align-items-center gap-1">
                    <span class="rounded-circle bg-primary d-inline-block" style="width: 8px; height: 8px;"></span>
                    <span>Primary Color</span>
                  </label>
                  <select id="pos_modal_primary_color" class="form-select form-select-sm pos-select2-color" style="width: 100%;">
                    <option value="">-- Select Color --</option>
                    <% GARMENT_COLORS.forEach(function(c) { %>
                      <option value="<%= c.name %>" data-hex="<%= c.hex %>" <%= c.isGradient ? 'data-gradient="1"' : '' %> <%= c.border ? 'data-border="1"' : '' %>>
                        <%= c.name %>
                      </option>
                    <% }); %>
                  </select>
                </div>

                <!-- Secondary Color -->
                <div class="col-12 col-md-4">
                  <label class="form-label fs-12 fw-bold pos-modal-label text-muted mb-1 d-flex align-items-center gap-1">
                    <span class="rounded-circle bg-secondary d-inline-block" style="width: 8px; height: 8px;"></span>
                    <span>Secondary Color <small class="fw-normal text-muted">(Optional)</small></span>
                  </label>
                  <select id="pos_modal_secondary_color" class="form-select form-select-sm pos-select2-color" style="width: 100%;">
                    <option value="" data-none="1">None</option>
                    <% GARMENT_COLORS.forEach(function(c) { %>
                      <option value="<%= c.name %>" data-hex="<%= c.hex %>" <%= c.isGradient ? 'data-gradient="1"' : '' %> <%= c.border ? 'data-border="1"' : '' %>>
                        <%= c.name %>
                      </option>
                    <% }); %>
                  </select>
                </div>

                <!-- Garment Pattern -->
                <div class="col-12 col-md-4">
                  <label class="form-label fs-12 fw-bold pos-modal-label mb-1 d-flex align-items-center gap-1">
                    <i class="fa fa-th-large text-primary me-1" style="font-size: 11px;"></i>
                    <span>Garment Pattern</span>
                  </label>
                  <select id="pos_modal_pattern" class="form-select form-select-sm pos-select2-pattern" style="width: 100%;">
                    <% GARMENT_PATTERNS.forEach(function(p) { %>
                      <option value="<%= p %>" <%= p === 'Solid' ? 'selected' : '' %>>
                        <%= p %>
                      </option>
                    <% }); %>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3">
            <!-- Left Column: Multi-Camera View Box -->
            <div class="col-12 col-lg-5 d-flex flex-column">
              <div class="card border rounded-3 h-100 mb-0">
                <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between gap-2 flex-wrap">
                  <div class="d-flex align-items-center gap-1 fw-bold fs-13">
                    <i class="fa fa-video text-primary me-1"></i>
                    <span>Camera View</span>
                  </div>
                  <div class="d-flex align-items-center gap-1 flex-grow-1 justify-content-end">
                    <select id="pos_brand_camera_select" class="form-select form-select-sm py-1 px-2" style="max-width: 210px; font-size: 12px;" title="Select Camera">
                      <option value="">Detecting cameras...</option>
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" id="btn_pos_refresh_cameras" title="Refresh Camera List">
                      <i class="fa fa-sync-alt"></i>
                    </button>
                  </div>
                </div>
                <div class="card-body p-2 d-flex flex-column justify-content-between">
                  <div class="ratio ratio-4x3 bg-dark rounded-3 overflow-hidden position-relative border">
                    <video id="pos_brand_camera_video" autoplay playsinline muted class="w-100 h-100" style="object-fit: cover;"></video>
                    <canvas id="pos_brand_camera_canvas" class="w-100 h-100 position-absolute top-0 start-0 d-none" style="object-fit: cover;"></canvas>
                    <div id="pos_brand_ocr_overlay" class="position-absolute top-0 start-0 w-100 h-100 d-none flex-column align-items-center justify-content-center text-white text-center p-3" style="background: rgba(15, 23, 42, 0.75); z-index: 5;">
                      <div class="spinner-border text-primary mb-2" role="status"></div>
                      <span class="fs-12 fw-bold text-white">Analyzing tag with RapidOCR...</span>
                    </div>
                    <div id="pos_brand_camera_status" class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center text-white text-center p-3" style="background: rgba(15, 23, 42, 0.75);">
                      <i class="fa fa-camera fs-2 mb-2 opacity-75"></i>
                      <span class="fs-12" id="pos_brand_camera_status_text">Initializing camera stream...</span>
                    </div>
                  </div>
                  <div class="d-flex align-items-center justify-content-between gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-primary flex-grow-1 fw-bold" id="btn_pos_scan_cloth">
                      <i class="fa fa-camera-retro me-1" id="btn_pos_scan_cloth_icon"></i><span id="btn_pos_scan_cloth_text">Scan Cloth Details</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btn_pos_toggle_camera" title="Start / Stop Camera">
                      <i class="fa fa-power-off"></i>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right Column: Search & Brand Results List -->
            <div class="col-12 col-lg-7 d-flex flex-column">
              <div class="input-group mb-2">
                <span class="input-group-text bg-light-subtle"><i class="fa fa-search text-muted"></i></span>
                <input type="text" class="form-control" id="pos_brand_search_input" placeholder="Search brand in POS Search Key (e.g. ZARA, GUCCI, ARMANI, ZEGNA)..." autocomplete="off">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btn_pos_brand_search_clear" title="Clear Search">
                  <i class="fa fa-times"></i>
                </button>
              </div>

              <div class="table-responsive border rounded-3 flex-grow-1" style="max-height: 310px; min-height: 260px; overflow-y: auto;">
                <table class="table table-hover table-sm align-middle mb-0">
                  <thead class="table-light sticky-top">
                    <tr>
                      <th style="width: 34px;" class="text-center"></th>
                      <th>Brand / Label</th>
                      <th class="text-center">Category</th>
                      <th class="text-center">Upcharge</th>
                      <th class="text-center">Multiplier</th>
                    </tr>
                  </thead>
                  <tbody id="pos_brand_results_tbody">
                    <tr>
                      <td colspan="5" class="text-center py-4 text-muted">Loading brands...</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <!-- Selected Brand Preview Bar -->
              <div class="alert alert-primary py-2 px-3 mt-2 mb-0 d-flex align-items-center justify-content-between flex-wrap gap-2" id="pos_brand_preview_bar">
                <div class="fs-13">
                  <i class="fa fa-info-circle me-1"></i>
                  <span id="pos_brand_preview_text">Select a brand from the list above to preview rate override.</span>
                </div>
                <div class="fw-bold fs-13" id="pos_brand_preview_rate"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer py-2 px-3 d-flex justify-content-between">
          <button type="button" class="btn btn-outline-danger btn-sm" id="btn_pos_clear_brand">
            <i class="fa fa-eraser me-1"></i><%= language.Clear_Brand_Color_Pattern || 'Clear Brand, Color & Pattern' %>
          </button>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
              <i class="fa fa-times me-1"></i><%= language.Cancel || 'Cancel' %>
            </button>
            <button type="button" class="btn btn-primary btn-sm px-4 fw-bold" id="btn_pos_apply_brand">
              <i class="fa fa-check me-1"></i>OK
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Void Order Confirmation Modal -->
  <div class="modal fade" id="pos_void_confirm_modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header bg-danger-subtle text-danger border-bottom">
          <h5 class="modal-title fw-bold">
            <i class="fa fa-exclamation-triangle text-danger me-2"></i>Void Order Confirmation
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <input type="hidden" id="pos_void_target_order_id" value="<%= isEditMode ? cart.id : cart.order_id %>">
