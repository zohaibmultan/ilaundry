<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <%- include('templet/meta')-%>
</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>

    <%
        const activeNotifSettings = (typeof notifSettings !== 'undefined' && notifSettings) ? notifSettings : { email_enabled: 1, sms_enabled: 1, whatsapp_enabled: 1, push_enabled: 1, events: {} };
        const eventsList = (typeof notificationEvents !== 'undefined' && Array.isArray(notificationEvents)) ? notificationEvents : [];
        const activeEventsMap = activeNotifSettings.events || {};
        const selectedStore = (typeof targetStoreId !== 'undefined') ? Number(targetStoreId) : 0;
        const activeStoreObj = (typeof storeData !== 'undefined' && storeData) ? storeData : null;
        const isMasterUser = (typeof isMaster !== 'undefined') ? Boolean(isMaster) : false;
        const canEditSettings = (typeof canEdit !== 'undefined') ? Boolean(canEdit) : true;
        const isSmtpReady = (typeof smtpConfigured !== 'undefined') ? Boolean(smtpConfigured) : false;
        const isTwilioReady = (typeof twilioConfigured !== 'undefined') ? Boolean(twilioConfigured) : false;
        const isOpenWaReady = (typeof openwaConfigured !== 'undefined') ? Boolean(openwaConfigured) : false;
        const isPushReady = (typeof pushConfigured !== 'undefined') ? Boolean(pushConfigured) : false;
        const mailCfg = (typeof smtpConfig !== 'undefined' && smtpConfig) ? smtpConfig : {};
        const smsCfg = (typeof twilioConfig !== 'undefined' && twilioConfig) ? twilioConfig : {};
        const waCfg = (typeof openwaConfig !== 'undefined' && openwaConfig) ? openwaConfig : {};

        const categories = [
            {
                id: 'intake',
                title: '1. Order Intake & Modifications',
                subtitle: 'Notifications triggered when orders are placed, picked up, itemized, or modified',
                icon: 'fas fa-shopping-basket',
                badgeClass: 'badge-primary-glass',
                pillText: 'INTAKE & EDITS'
            },
            {
                id: 'processing',
                title: '2. Processing & Schedule Updates',
                subtitle: 'Updates while garments are being cleaned or when ready/delivery dates change',
                icon: 'fas fa-sync-alt',
                badgeClass: 'badge-ops-glass',
                pillText: 'IN PROCESS'
            },
            {
                id: 'ready',
                title: '3. Ready, Route Dispatch & Completion',
                subtitle: 'Alerts when garments are ready for pickup, out with driver, or delivered',
                icon: 'fas fa-shipping-fast',
                badgeClass: 'badge-primary-glass',
                pillText: 'READY & DELIVERY'
            },
            {
                id: 'billing',
                title: '4. Billing, Cancellations & Onboarding',
                subtitle: 'Payment confirmations, order cancellations/voids, and new customer welcome alerts',
                icon: 'fas fa-file-invoice-dollar',
                badgeClass: 'badge-ops-glass',
                pillText: 'BILLING & ACCOUNT'
            }
        ];
    %>

    <!--********** Content body start **********-->
    <div class="content-body">
        <div class="container-fluid pb-5 mb-5">

            <!-- Page Banner Header -->
            <div class="settings-banner mb-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">
                    <div class="d-flex align-items-center">
                        <div class="settings-icon-badge badge-primary-glass">
                            <i class="fas fa-bell"></i>
                        </div>
                        <div>
                            <h4 class="settings-card-title mb-1">
                                <%= language.Notification_Settings || 'Notification, Email (SMTP), Twilio SMS & Open-WA WhatsApp Settings' %>
                            </h4>
                            <p class="settings-card-subtitle mb-0">
                                Configure Email, Twilio SMS &amp; Open-WA WhatsApp gateways and automated customer alerts for
                                <strong class="text-primary">
                                    <%= selectedStore === 0 ? 'Global Defaults (All Stores)' : (activeStoreObj ? activeStoreObj.name : 'Store') %>
                                </strong>
                                <% if (selectedStore > 0) { %>
                                    <% if (activeNotifSettings.hasStoreOverride || activeNotifSettings.is_custom_store_override) { %>
                                        <span class="badge bg-primary-subtle text-primary ms-2">Custom Store Override Active</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary-subtle text-secondary ms-2">Inheriting Global Defaults</span>
                                    <% } %>
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <a href="/tool/notification-templates?store_id=<%= selectedStore %>" class="btn btn-primary btn-sm px-3 py-2 fw-semibold">
                            <i class="fas fa-file-signature me-1"></i> Customize WhatsApp, SMS &amp; Email Templates
                        </a>
                        <a href="/index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
                            <i class="fa fa-arrow-left me-1"></i> <%= language.Back_to_Dashboard || 'Back to Dashboard' %>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Master Admin Store Switcher -->
            <% if (isMasterUser) { %>
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-body p-3 d-flex align-items-center justify-content-between flex-wrap gap-3 bg-light-subtle rounded-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-layer-group text-primary fs-5"></i>
                            <div>
                                <span class="fw-bold d-block">Configuration Scope (Two-Tier Hierarchy):</span>
                                <small class="text-muted">Set Global Defaults for all stores, or select a specific branch to override</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <select class="form-select form-select-sm" id="notificationStoreSelector" onchange="switchNotificationStore(this.value)">
                                <option value="0" <%= selectedStore === 0 ? 'selected' : '' %>>
                                    🌐 Global Defaults (Inherited by All Stores)
                                </option>
                                <% if (typeof stores !== 'undefined' && Array.isArray(stores)) { %>
                                    <% stores.forEach(function(s) { %>
                                        <option value="<%= s.id %>" <%= Number(s.id) === selectedStore ? 'selected' : '' %>>
                                            🏪 <%= s.name %> (<%= s.city || 'Branch' %>)
                                        </option>
                                    <% }); %>
                                <% } %>
                            </select>
                            <% if (selectedStore > 0 && (activeNotifSettings.hasStoreOverride || activeNotifSettings.is_custom_store_override) && canEditSettings) { %>
                                <button type="button" class="btn btn-outline-warning btn-sm text-nowrap" onclick="resetStoreOverride(<%= selectedStore %>)">
                                    <i class="fas fa-undo me-1"></i> Reset to Global Defaults
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- View-Only Notice -->
            <% if (!canEditSettings) { %>
                <div class="alert alert-info py-2 px-3 mb-4 d-flex align-items-center rounded-3">
                    <i class="fas fa-info-circle me-2 fs-5"></i>
                    <span>You are viewing notification settings in <strong>View Only</strong> mode. Administrative edit privileges are required to modify switches.</span>
                </div>
            <% } %>

            <!-- Main Form -->
            <form action="/tool/notificationsetting" method="POST" id="notification_setting_form">
                <input type="hidden" name="target_store_id" value="<%= selectedStore %>">

                <div class="row g-4">
                    <!-- Master Channel Switches & Gateway Status -->
                    <div class="col-12 col-xl-8">
                        <div class="settings-section-card h-100">
                            <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center">
                                    <div class="settings-icon-badge badge-primary-glass">
                                        <i class="fas fa-sliders-h"></i>
                                    </div>
                                    <div>
                                        <h5 class="settings-card-title">Master Channel Switches</h5>
                                        <p class="settings-card-subtitle">Global kill-switches for Email, SMS, WhatsApp (Open-WA), and Push delivery</p>
                                    </div>
                                </div>
                                <% if (canEditSettings) { %>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="toggleAllEventChannels(true)">
                                            <i class="fas fa-check-double me-1"></i> Enable All Events
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleAllEventChannels(false)">
                                            <i class="fas fa-ban me-1"></i> Disable All Events
                                        </button>
                                    </div>
                                <% } %>
                            </div>

                            <div class="row g-3">
                                <!-- Email Channel Switch -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="p-3 rounded-3 border bg-light-subtle d-flex flex-column justify-content-between h-100">
                                        <div class="d-flex align-items-start justify-content-between mb-2">
                                            <div>
                                                <span class="fw-bold d-block">
                                                    <i class="fas fa-envelope text-primary me-1"></i> Email
                                                </span>
                                                <small class="text-muted">HTML receipts via SMTP</small>
                                            </div>
                                            <div class="form-check form-switch ms-2 m-0">
                                                <input class="form-check-input" type="checkbox" role="switch" id="master_email_enabled" name="email_enabled" value="1"
                                                    <%= Number(activeNotifSettings.email_enabled) === 1 ? 'checked' : '' %>
                                                    <%= !canEditSettings ? 'disabled' : '' %>>
                                            </div>
                                        </div>
                                        <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                                            <small class="text-muted">SMTP:</small>
                                            <% if (isSmtpReady) { %>
                                                <span class="badge bg-success-subtle text-success"><i class="fas fa-check-circle me-1"></i>Ready</span>
                                            <% } else { %>
                                                <span class="badge bg-warning-subtle text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Setup</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- SMS Channel Switch -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="p-3 rounded-3 border bg-light-subtle d-flex flex-column justify-content-between h-100">
                                        <div class="d-flex align-items-start justify-content-between mb-2">
                                            <div>
                                                <span class="fw-bold d-block">
                                                    <i class="fas fa-comment-sms text-info me-1"></i> SMS
                                                </span>
                                                <small class="text-muted">Text alerts via Twilio</small>
                                            </div>
                                            <div class="form-check form-switch ms-2 m-0">
                                                <input class="form-check-input" type="checkbox" role="switch" id="master_sms_enabled" name="sms_enabled" value="1"
                                                    <%= Number(activeNotifSettings.sms_enabled) === 1 ? 'checked' : '' %>
                                                    <%= !canEditSettings ? 'disabled' : '' %>>
                                            </div>
                                        </div>
                                        <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                                            <small class="text-muted">Twilio:</small>
                                            <% if (isTwilioReady) { %>
                                                <span class="badge bg-success-subtle text-success"><i class="fas fa-check-circle me-1"></i>Ready</span>
                                            <% } else { %>
                                                <span class="badge bg-warning-subtle text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Setup</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- WhatsApp (Open-WA) Channel Switch -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="p-3 rounded-3 border bg-light-subtle d-flex flex-column justify-content-between h-100">
                                        <div class="d-flex align-items-start justify-content-between mb-2">
                                            <div>
                                                <span class="fw-bold d-block">
                                                    <i class="fab fa-whatsapp text-success me-1"></i> WhatsApp
                                                </span>
                                                <small class="text-muted">Direct API via Open-WA</small>
                                            </div>
                                            <div class="form-check form-switch ms-2 m-0">
                                                <input class="form-check-input" type="checkbox" role="switch" id="master_whatsapp_enabled" name="whatsapp_enabled" value="1"
                                                    <%= Number(activeNotifSettings.whatsapp_enabled) === 1 ? 'checked' : '' %>
                                                    <%= !canEditSettings ? 'disabled' : '' %>>
                                            </div>
                                        </div>
                                        <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                                            <small class="text-muted">Open-WA:</small>
                                            <% if (isOpenWaReady) { %>
                                                <span class="badge bg-success-subtle text-success" id="master_openwa_cfg_badge"><i class="fas fa-check-circle me-1"></i>Ready</span>
                                            <% } else { %>
                                                <span class="badge bg-warning-subtle text-warning" id="master_openwa_cfg_badge"><i class="fas fa-exclamation-triangle me-1"></i>Setup</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Push Channel Switch -->
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="p-3 rounded-3 border bg-light-subtle d-flex flex-column justify-content-between h-100">
                                        <div class="d-flex align-items-start justify-content-between mb-2">
                                            <div>
                                                <span class="fw-bold d-block">
                                                    <i class="fas fa-bell text-warning me-1"></i> Push
                                                </span>
                                                <small class="text-muted">App &amp; web push alerts</small>
                                            </div>
                                            <div class="form-check form-switch ms-2 m-0">
                                                <input class="form-check-input" type="checkbox" role="switch" id="master_push_enabled" name="push_enabled" value="1"
                                                    <%= Number(activeNotifSettings.push_enabled) === 1 ? 'checked' : '' %>
                                                    <%= !canEditSettings ? 'disabled' : '' %>>
                                            </div>
                                        </div>
                                        <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                                            <small class="text-muted">OneSignal:</small>
                                            <% if (isPushReady) { %>
                                                <span class="badge bg-success-subtle text-success"><i class="fas fa-check-circle me-1"></i>Ready</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary-subtle text-secondary"><i class="fas fa-info-circle me-1"></i>Optional</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Live Test Notification Card -->
                    <div class="col-12 col-xl-4">
                        <div class="settings-section-card h-100">
                            <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center">
                                    <div class="settings-icon-badge badge-ops-glass">
                                        <i class="fas fa-paper-plane"></i>
                                    </div>
                                    <div>
                                        <h5 class="settings-card-title">Send Test Notification</h5>
                                        <p class="settings-card-subtitle">Verify Email, SMS or WhatsApp live</p>
                                    </div>
                                </div>
                                <span class="badge bg-info-subtle text-info">LIVE TEST</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-sm-5">
                                    <label class="form-label small fw-bold mb-1">Channel</label>
                                    <select class="form-select form-select-sm" id="test_notif_channel" onchange="updateTestRecipientPlaceholder()">
                                        <option value="whatsapp">WhatsApp (Open-WA)</option>
                                        <option value="email">Email (SMTP)</option>
                                        <option value="sms">SMS (Twilio)</option>
                                    </select>
                                </div>
                                <div class="col-12 col-sm-7">
                                    <label class="form-label small fw-bold mb-1">Recipient Address / Phone</label>
                                    <input type="text" class="form-control form-control-sm" id="test_notif_recipient" placeholder="e.g. +17185550199 or 03225126622">
                                </div>
                                <div class="col-12">
                                    <button type="button" class="btn btn-outline-primary btn-sm w-100 py-2 fw-semibold" id="btn_send_test_notif" onclick="triggerTestNotification()">
                                        <i class="fas fa-paper-plane me-1"></i> Send Test Message Now
                                    </button>
                                </div>
                                <div class="col-12">
                                    <div id="test_notif_feedback" class="small text-muted">
                                        <i class="fas fa-info-circle me-1"></i> Sends a sample diagnostic alert using this store's active gateway.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- =========================================================
                         COMBINED EMAIL (SMTP) & TWILIO (SMS) GATEWAY SETTINGS
                         ========================================================= -->
                    <!-- Email (SMTP) Gateway Configuration Card -->
                    <div class="col-12 col-xl-6">
                        <div class="settings-section-card h-100">
                            <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center">
                                    <div class="settings-icon-badge badge-primary-glass">
                                        <i class="fas fa-envelope-open-text"></i>
                                    </div>
                                    <div>
                                        <h5 class="settings-card-title"><%= language.Email_Setting || 'Email (SMTP) Gateway Settings' %></h5>
                                        <p class="settings-card-subtitle">Outgoing SMTP mail server, credentials, and sender address</p>
                                    </div>
                                </div>
                                <% if (isSmtpReady && String(mailCfg.status) !== '0') { %>
                                    <span class="badge bg-success-subtle text-success"><i class="fas fa-check-circle me-1"></i>SMTP ACTIVE</span>
                                <% } else if (mailCfg.host && String(mailCfg.status) === '0') { %>
                                    <span class="badge bg-warning-subtle text-warning"><i class="fas fa-pause-circle me-1"></i>SMTP PAUSED</span>
                                <% } else { %>
                                    <span class="badge bg-secondary-subtle text-secondary">SMTP GATEWAY</span>
                                <% } %>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-8">
                                    <label class="form-label fw-semibold small mb-1" for="smtp_host">
                                        <%= language.Mail_Host || 'Mail Host (SMTP Server)' %>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fas fa-globe text-primary"></i></span>
                                        <input type="text" class="form-control font-monospace" id="smtp_host" name="smtp_host"
                                            value="<%= mailCfg.host || '' %>" placeholder="e.g. smtp.gmail.com" <%= !canEditSettings ? 'readonly' : '' %>>
                                    </div>
                                    <% if (canEditSettings) { %>
                                        <div class="mt-2 d-flex flex-wrap gap-1 align-items-center">
                                            <small class="text-muted me-1 fw-semibold">Presets:</small>
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" onclick="applySmtpPreset('smtp.gmail.com', '587')">Gmail</button>
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" onclick="applySmtpPreset('smtp.office365.com', '587')">Outlook 365</button>
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" onclick="applySmtpPreset('smtp.mail.yahoo.com', '587')">Yahoo</button>
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" onclick="applySmtpPreset('smtp.sendgrid.net', '587')">SendGrid</button>
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" onclick="applySmtpPreset('smtp.mailgun.org', '587')">Mailgun</button>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-semibold small mb-1" for="smtp_port">
                                        <%= language.Mail_Port || 'SMTP Port' %>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fas fa-network-wired text-primary"></i></span>
                                        <input type="number" class="form-control font-monospace" id="smtp_port" name="smtp_port"
                                            value="<%= mailCfg.port || '587' %>" placeholder="587" min="1" max="65535" <%= !canEditSettings ? 'readonly' : '' %>>
                                    </div>
                                    <% if (canEditSettings) { %>
                                        <div class="mt-2 d-flex flex-wrap gap-1 align-items-center">
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" onclick="document.getElementById('smtp_port').value='587'">587 (TLS)</button>
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" onclick="document.getElementById('smtp_port').value='465'">465 (SSL)</button>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold small mb-1" for="smtp_username">
                                        <%= language.Mail_Username || 'SMTP Username / Email' %>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fas fa-user text-primary"></i></span>
                                        <input type="text" class="form-control" id="smtp_username" name="smtp_username"
                                            value="<%= mailCfg.username || '' %>" placeholder="notifications@yourdomain.com" <%= !canEditSettings ? 'readonly' : '' %>>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold small mb-1" for="smtp_password">
                                        <%= language.Mail_Password || 'SMTP Password / App Password' %>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fas fa-key text-primary"></i></span>
                                        <input type="password" class="form-control" id="smtp_password" name="smtp_password"
                                            value="<%= mailCfg.password || '' %>" placeholder="Enter SMTP or App Password" autocomplete="new-password" <%= !canEditSettings ? 'readonly' : '' %>>
                                        <button class="btn btn-outline-secondary" type="button" onclick="toggleSecretInput('smtp_password', this)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="col-12 col-md-7">
                                    <label class="form-label fw-semibold small mb-1" for="smtp_frommail">
                                        <%= language.From_Email_ID || 'From Email Address (Sender)' %>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fas fa-paper-plane text-primary"></i></span>
                                        <input type="email" class="form-control" id="smtp_frommail" name="smtp_frommail"
                                            value="<%= mailCfg.frommail || '' %>" placeholder="orders@yourdomain.com" <%= !canEditSettings ? 'readonly' : '' %>>
                                    </div>
                                </div>

                                <div class="col-12 col-md-5">
                                    <label class="form-label fw-semibold small mb-1" for="smtp_status">
                                        <%= language.Status || 'SMTP Gateway Status' %>
                                    </label>
                                    <select class="form-select form-select-sm" id="smtp_status" name="smtp_status" <%= !canEditSettings ? 'disabled' : '' %>>
                                        <option value="1" <%= (String(mailCfg.status) !== '0') ? 'selected' : '' %>>Active — Send Emails</option>
                                        <option value="0" <%= (String(mailCfg.status) === '0') ? 'selected' : '' %>>Disabled — Pause SMTP</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Twilio (SMS) Gateway Configuration Card -->
                    <div class="col-12 col-xl-6">
                        <div class="settings-section-card h-100">
                            <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center">
                                    <div class="settings-icon-badge badge-ops-glass">
                                        <i class="fas fa-comment-dots"></i>
                                    </div>
                                    <div>
                                        <h5 class="settings-card-title"><%= language.Twilio_SMS_Settings || 'Twilio (SMS) Gateway Settings' %></h5>
                                        <p class="settings-card-subtitle">Twilio API credentials and sender phone number for SMS text alerts</p>
                                    </div>
                                </div>
                                <% if (isTwilioReady) { %>
                                    <span class="badge bg-success-subtle text-success"><i class="fas fa-check-circle me-1"></i>TWILIO ACTIVE</span>
                                <% } else if (smsCfg.sid && String(smsCfg.status) === '0') { %>
                                    <span class="badge bg-warning-subtle text-warning"><i class="fas fa-pause-circle me-1"></i>TWILIO PAUSED</span>
                                <% } else { %>
                                    <span class="badge bg-secondary-subtle text-secondary">TWILIO SMS</span>
                                <% } %>
                            </div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-semibold small mb-1" for="twilio_sid">
                                        <%= language.Twilio_Account_SID || 'Twilio Account SID' %>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fas fa-id-badge text-success"></i></span>
                                        <input type="text" class="form-control font-monospace" id="twilio_sid" name="twilio_sid"
                                            value="<%= smsCfg.sid || '' %>" placeholder="e.g. ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX" <%= !canEditSettings ? 'readonly' : '' %>>
                                    </div>
                                    <small class="text-muted">Found on your Twilio Console Dashboard (starts with <code>AC</code>).</small>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold small mb-1" for="twilio_auth_token">
                                        <%= language.Twilio_Auth_Token || 'Twilio Auth Token' %>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fas fa-lock text-success"></i></span>
                                        <input type="password" class="form-control font-monospace" id="twilio_auth_token" name="twilio_auth_token"
                                            value="<%= smsCfg.token || '' %>" placeholder="Enter Twilio Auth Token" autocomplete="new-password" <%= !canEditSettings ? 'readonly' : '' %>>
                                        <button class="btn btn-outline-secondary" type="button" onclick="toggleSecretInput('twilio_auth_token', this)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold small mb-1" for="twilio_phone_no">
                                        <%= language.Twilio_Phone_Number || 'Twilio Sender Phone Number' %>
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fas fa-phone-alt text-success"></i></span>
                                        <input type="text" class="form-control font-monospace" id="twilio_phone_no" name="twilio_phone_no"
                                            value="<%= smsCfg.fromPhone || smsCfg.phone || '' %>" placeholder="e.g. +15550192834" <%= !canEditSettings ? 'readonly' : '' %>>
                                    </div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold small mb-1" for="twilio_status">
                                        Twilio SMS Gateway Status
                                    </label>
                                    <select class="form-select form-select-sm" id="twilio_status" name="twilio_status" <%= !canEditSettings ? 'disabled' : '' %>>
                                        <option value="1" <%= (String(smsCfg.status) !== '0') ? 'selected' : '' %>>Active — Deliver SMS Alerts</option>
                                        <option value="0" <%= (String(smsCfg.status) === '0') ? 'selected' : '' %>>Disabled — Pause Twilio SMS</option>
                                    </select>
                                </div>

                                <div class="col-12 col-md-6 d-flex align-items-end">
                                    <div class="p-2 rounded-3 border bg-light-subtle w-100 small text-muted">
                                        <i class="fas fa-info-circle text-primary me-1"></i>
                                        Use E.164 format (e.g. <code>+1...</code>) for the Twilio sender phone number.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Open-WA (WhatsApp) Gateway & Live Session Settings Card -->
                    <div class="col-12">
                        <div class="settings-section-card">
                            <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center">
                                    <div class="settings-icon-badge badge-primary-glass">
                                        <i class="fab fa-whatsapp text-success"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <h5 class="settings-card-title mb-0">Open-WA (WhatsApp API) Gateway Settings</h5>
                                            <% if (selectedStore > 0) { %>
                                                <% if (waCfg.hasStoreOverride) { %>
                                                    <span class="badge bg-primary-subtle text-primary">Store Override</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary-subtle text-secondary">Inherited Global Default</span>
                                                <% } %>
                                            <% } %>
                                        </div>
                                        <p class="settings-card-subtitle mb-0">Self-hosted Open-WA gateway URL, API key, active session name/UUID, and QR linking</p>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge bg-secondary-subtle text-secondary" id="openwa_live_badge">
                                        <i class="fas fa-circle-notch fa-spin me-1"></i>Checking Session...
                                    </span>
                                    <button type="button" class="btn btn-outline-success btn-sm fw-semibold" id="btn_open_openwa_qr_modal" onclick="openOpenWaQrModal()">
                                        <i class="fas fa-qrcode me-1"></i> Session Status &amp; Scan QR
                                    </button>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-semibold small mb-1" for="openwa_base_url">
                                        Open-WA Server Base URL
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fas fa-server text-success"></i></span>
                                        <input type="url" class="form-control font-monospace" id="openwa_base_url" name="openwa_base_url"
                                            value="<%= waCfg.baseUrl || '' %>" placeholder="http://your-openwa-host:2785" <%= !canEditSettings ? 'readonly' : '' %>>
                                    </div>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-semibold small mb-1" for="openwa_api_key">
                                        Open-WA API Key (<code>X-API-Key</code>)
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fas fa-key text-success"></i></span>
                                        <input type="password" class="form-control font-monospace" id="openwa_api_key" name="openwa_api_key"
                                            value="<%= waCfg.apiKey || '' %>" placeholder="owa_k1_..." autocomplete="new-password" <%= !canEditSettings ? 'readonly' : '' %>>
                                        <button class="btn btn-outline-secondary" type="button" onclick="toggleSecretInput('openwa_api_key', this)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-semibold small mb-1" for="openwa_session_id">
                                        WhatsApp Session Name or UUID
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle"><i class="fab fa-whatsapp text-success"></i></span>
                                        <input type="text" class="form-control font-monospace" id="openwa_session_id" name="openwa_session_id"
                                            value="<%= waCfg.sessionId || '' %>" placeholder="i-cleaners" <%= !canEditSettings ? 'readonly' : '' %>>
                                        <button class="btn btn-outline-secondary" type="button" onclick="refreshOpenWaLiveStatus(true)" title="Load available sessions from Open-WA server">
                                            <i class="fas fa-sync-alt"></i>
                                        </button>
                                    </div>
                                    <select class="form-select form-select-sm mt-2 d-none" id="openwa_session_picker" onchange="applySelectedOpenWaSession(this.value)" <%= !canEditSettings ? 'disabled' : '' %>>
                                        <option value="">-- Select Server Session --</option>
                                    </select>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-semibold small mb-1" for="openwa_country_code">
                                        Default Country Code (10-digit numbers)
                                    </label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light-subtle">+</span>
                                        <input type="text" class="form-control font-monospace" id="openwa_country_code" name="openwa_country_code"
                                            value="<%= waCfg.defaultCountryCode || '1' %>" placeholder="1" maxlength="5" <%= !canEditSettings ? 'readonly' : '' %>>
                                    </div>
                                    <% if (canEditSettings) { %>
                                        <div class="mt-2 d-flex flex-wrap gap-1 align-items-center">
                                            <small class="text-muted me-1 fw-semibold">Presets:</small>
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" onclick="setOpenWaCountryCode('1')">+1 USA/CA</button>
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" onclick="setOpenWaCountryCode('92')">+92 PK</button>
                                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-0 px-2" onclick="setOpenWaCountryCode('44')">+44 UK</button>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-semibold small mb-1" for="openwa_status">
                                        Open-WA Gateway Status
                                    </label>
                                    <select class="form-select form-select-sm" id="openwa_status" name="openwa_status" <%= !canEditSettings ? 'disabled' : '' %>>
                                        <option value="1" <%= (String(waCfg.status) !== '0') ? 'selected' : '' %>>Active — Deliver WhatsApp Messages</option>
                                        <option value="0" <%= (String(waCfg.status) === '0') ? 'selected' : '' %>>Disabled — Pause Open-WA Gateway</option>
                                    </select>
                                </div>

                                <div class="col-12 col-md-4 d-flex align-items-end">
                                    <div class="p-2 rounded-3 border bg-light-subtle w-100 small text-muted">
                                        <i class="fas fa-info-circle text-success me-1"></i>
                                        Numbers starting with <code>+</code> or <code>03...</code> keep their country code; 10-digit local numbers prepend <code>+<%= waCfg.defaultCountryCode || '1' %></code>.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4 Categorized Event Cards (12 Events Total) -->
                    <% categories.forEach(function(cat) { %>
                        <% const catEvents = eventsList.filter(function(ev) { return ev.category === cat.id; }); %>
                        <div class="col-12 col-xl-6">
                            <div class="settings-section-card mb-2">
                                <div class="settings-card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-center">
                                        <div class="settings-icon-badge <%= cat.badgeClass %>">
                                            <i class="<%= cat.icon %>"></i>
                                        </div>
                                        <div>
                                            <h5 class="settings-card-title"><%= cat.title %></h5>
                                            <p class="settings-card-subtitle"><%= cat.subtitle %></p>
                                        </div>
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary"><%= cat.pillText %></span>
                                </div>

                                <div class="d-flex flex-column gap-3">
                                    <% catEvents.forEach(function(ev) { %>
                                        <%
                                            const evState = activeEventsMap[ev.key] || { email: ev.defaultEmail, sms: ev.defaultSms, whatsapp: ev.defaultWhatsapp };
                                            const isEmailChecked = Boolean(evState.email === true || Number(evState.email) === 1);
                                            const isSmsChecked = Boolean(evState.sms === true || Number(evState.sms) === 1);
                                            const isWhatsappChecked = Boolean(evState.whatsapp === true || Number(evState.whatsapp) === 1);
                                        %>
                                        <div class="p-3 rounded-3 border bg-light-subtle">
                                            <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                                                <div class="pe-2">
                                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        <i class="<%= ev.icon %> text-primary"></i>
                                                        <span class="fw-bold"><%= ev.title %></span>
                                                        <span class="badge bg-secondary-subtle text-secondary fw-normal"><%= ev.badge %></span>
                                                    </div>
                                                    <small class="text-muted d-block mt-1"><%= ev.description %></small>
                                                </div>

                                                <div class="d-flex align-items-center gap-3 ms-auto pt-1 flex-wrap">
                                                    <a href="/tool/notification-templates?store_id=<%= selectedStore %>#event_card_<%= ev.key %>"
                                                        class="btn btn-xs btn-outline-primary rounded-pill py-1 px-2 text-nowrap"
                                                        title="Customize WhatsApp, SMS & Email template for <%= ev.title %>">
                                                        <i class="fas fa-pen-fancy me-1"></i>Edit Template
                                                    </a>

                                                    <!-- Email Switch for Event -->
                                                    <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                                                        <input class="form-check-input event-email-toggle" type="checkbox" role="switch"
                                                            id="event_<%= ev.key %>_email"
                                                            name="event_<%= ev.key %>_email"
                                                            value="1"
                                                            <%= isEmailChecked ? 'checked' : '' %>
                                                            <%= !canEditSettings ? 'disabled' : '' %>>
                                                        <label class="form-check-label small fw-semibold" for="event_<%= ev.key %>_email">
                                                            <i class="fas fa-envelope text-primary me-1"></i>Email
                                                        </label>
                                                    </div>

                                                    <!-- SMS Switch for Event -->
                                                    <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                                                        <input class="form-check-input event-sms-toggle" type="checkbox" role="switch"
                                                            id="event_<%= ev.key %>_sms"
                                                            name="event_<%= ev.key %>_sms"
                                                            value="1"
                                                            <%= isSmsChecked ? 'checked' : '' %>
                                                            <%= !canEditSettings ? 'disabled' : '' %>>
                                                        <label class="form-check-label small fw-semibold" for="event_<%= ev.key %>_sms">
                                                            <i class="fas fa-comment-sms text-info me-1"></i>SMS
                                                        </label>
                                                    </div>

                                                    <!-- WhatsApp Switch for Event -->
                                                    <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                                                        <input class="form-check-input event-whatsapp-toggle" type="checkbox" role="switch"
                                                            id="event_<%= ev.key %>_whatsapp"
                                                            name="event_<%= ev.key %>_whatsapp"
                                                            value="1"
                                                            <%= isWhatsappChecked ? 'checked' : '' %>
                                                            <%= !canEditSettings ? 'disabled' : '' %>>
                                                        <label class="form-check-label small fw-semibold" for="event_<%= ev.key %>_whatsapp">
                                                            <i class="fab fa-whatsapp text-success me-1"></i>WhatsApp
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Sticky Glass Save Footer Bar -->
                <div class="settings-sticky-footer">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge light badge-primary d-none d-md-inline-flex">
                            <i class="fas fa-bell me-1"></i>
                            Scope: <%= selectedStore === 0 ? 'Global Defaults' : (activeStoreObj ? activeStoreObj.name : 'Store Override') %>
                        </span>
                        <small class="text-muted d-none d-sm-inline">
                            Saves Email (SMTP), Twilio (SMS), Open-WA (WhatsApp), and all 12 Event Notification Switches together.
                        </small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="reset" class="btn btn-secondary px-3">
                            <i class="fas fa-undo me-1"></i> <%= language.Reset || 'Reset Form' %>
                        </button>
                        <% if (canEditSettings) { %>
                            <button type="submit" id="btn_save_notification_settings" class="btn btn-primary px-4">
                                <i class="fas fa-save me-2"></i> <%= language.Save_Data || 'Save All Notification Settings' %>
                            </button>
                        <% } %>
                    </div>
                </div>
            </form>

        </div>
    </div>
    <!--********** Content body end **********-->

    <!-- Open-WA Session Status & QR Linking Modal -->
    <div class="modal fade" id="openWaSessionModal" tabindex="-1" aria-labelledby="openWaSessionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom">
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="openWaSessionModalLabel">
                            <i class="fab fa-whatsapp text-success me-2"></i>Open-WA Session &amp; QR Link
                        </h5>
                        <small class="text-muted" id="openwa_modal_server_label"></small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="openwa_modal_status_card" class="p-3 rounded-3 border bg-light-subtle mb-3">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                            <span class="fw-bold" id="openwa_modal_session_name">Checking...</span>
                            <span class="badge bg-secondary-subtle text-secondary" id="openwa_modal_state_badge">LOADING</span>
                        </div>
                        <div class="small text-muted" id="openwa_modal_session_meta">Connecting to Open-WA API...</div>
                    </div>

                    <div id="openwa_modal_qr_wrap" class="text-center p-3 rounded-3 border bg-light-subtle mb-3 d-none">
                        <div class="fw-semibold small mb-2">
                            <i class="fas fa-qrcode text-success me-1"></i>Open WhatsApp on your phone &rarr; Linked Devices &rarr; Scan QR:
                        </div>
                        <img id="openwa_modal_qr_img" src="" alt="Open-WA WhatsApp QR Code" class="img-fluid rounded border p-2 bg-white" style="max-width: 240px;">
                        <div class="small text-muted mt-2">
                            Status refreshes automatically every 5 seconds while this window is open.
                        </div>
                    </div>

                    <div id="openwa_modal_alert" class="alert alert-danger py-2 px-3 small d-none mb-3"></div>

                    <% if (canEditSettings) { %>
                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="refreshOpenWaModal()">
                                <i class="fas fa-sync-alt me-1"></i>Refresh Status / QR
                            </button>
                            <button type="button" class="btn btn-success btn-sm" onclick="runOpenWaSessionAction('start')">
                                <i class="fas fa-play me-1"></i>Start / Create Session
                            </button>
                            <button type="button" class="btn btn-outline-warning btn-sm" onclick="runOpenWaSessionAction('restart')">
                                <i class="fas fa-redo me-1"></i>Restart
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="runOpenWaSessionAction('logout')">
                                <i class="fas fa-sign-out-alt me-1"></i>Unlink Device
                            </button>
                        </div>
                    <% } %>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <%- include('templet/footer')-%>
    <%- include('templet/script')-%>

    <script>
        var openWaQrPollTimer = null;

        function switchNotificationStore(storeId) {
            window.location.href = '/tool/notificationsetting?store_id=' + encodeURIComponent(storeId);
        }

        function applySmtpPreset(host, port) {
            var hostEl = document.getElementById('smtp_host');
            var portEl = document.getElementById('smtp_port');
            if (hostEl && !hostEl.readOnly) hostEl.value = host;
            if (portEl && !portEl.readOnly) portEl.value = port;
        }

        function setOpenWaCountryCode(code) {
            var ccEl = document.getElementById('openwa_country_code');
            if (ccEl && !ccEl.readOnly) ccEl.value = code;
        }

        function applySelectedOpenWaSession(val) {
            if (!val) return;
            var sessInput = document.getElementById('openwa_session_id');
            if (sessInput && !sessInput.readOnly) {
                sessInput.value = val;
                refreshOpenWaLiveStatus(false);
            }
        }

        function toggleSecretInput(inputId, btnEl) {
            var input = document.getElementById(inputId);
            if (!input) return;
            var icon = btnEl ? btnEl.querySelector('i') : null;
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                if (icon) icon.className = 'fas fa-eye';
            }
        }

        function toggleAllEventChannels(enable) {
            var checkboxes = document.querySelectorAll('.event-email-toggle, .event-sms-toggle, .event-whatsapp-toggle');
            checkboxes.forEach(function (cb) {
                if (!cb.disabled) {
                    cb.checked = Boolean(enable);
                }
            });
            var masterEmail = document.getElementById('master_email_enabled');
            var masterSms = document.getElementById('master_sms_enabled');
            var masterWa = document.getElementById('master_whatsapp_enabled');
            if (enable) {
                if (masterEmail && !masterEmail.disabled) masterEmail.checked = true;
                if (masterSms && !masterSms.disabled) masterSms.checked = true;
                if (masterWa && !masterWa.disabled) masterWa.checked = true;
            }
        }

        function updateTestRecipientPlaceholder() {
            var channelSelect = document.getElementById('test_notif_channel');
            var recipientInput = document.getElementById('test_notif_recipient');
            if (!channelSelect || !recipientInput) return;
            if (channelSelect.value === 'whatsapp') {
                recipientInput.placeholder = 'e.g. +17185550199 or 03225126622';
            } else if (channelSelect.value === 'sms') {
                recipientInput.placeholder = '+15550192834';
            } else {
                recipientInput.placeholder = 'customer@example.com';
            }
        }

        function updateOpenWaLiveBadge(session, errMsg) {
            var badge = document.getElementById('openwa_live_badge');
            if (!badge) return;
            if (errMsg) {
                badge.className = 'badge bg-danger-subtle text-danger';
                badge.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Unreachable';
                badge.title = errMsg;
                return;
            }
            if (!session) {
                badge.className = 'badge bg-warning-subtle text-warning';
                badge.innerHTML = '<i class="fas fa-unlink me-1"></i>Session Not Found';
                return;
            }
            var st = String(session.status || '').toLowerCase();
            if (st === 'ready') {
                badge.className = 'badge bg-success-subtle text-success';
                badge.innerHTML = '<i class="fas fa-check-circle me-1"></i>Connected' + (session.phone ? ' (' + session.phone + ')' : '');
            } else if (st === 'qr_ready') {
                badge.className = 'badge bg-warning-subtle text-warning';
                badge.innerHTML = '<i class="fas fa-qrcode me-1"></i>Scan QR to Connect';
            } else if (st === 'initializing' || st === 'authenticating') {
                badge.className = 'badge bg-info-subtle text-info';
                badge.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>' + st.toUpperCase();
            } else {
                badge.className = 'badge bg-secondary-subtle text-secondary';
                badge.innerHTML = '<i class="fas fa-pause-circle me-1"></i>' + (st ? st.toUpperCase() : 'OFFLINE');
            }
        }

        function getOpenWaFormParams() {
            var baseEl = document.getElementById('openwa_base_url');
            var keyEl = document.getElementById('openwa_api_key');
            var sessEl = document.getElementById('openwa_session_id');
            return {
                store_id: '<%= selectedStore %>',
                base_url: baseEl ? baseEl.value.trim() : '',
                api_key: keyEl ? keyEl.value.trim() : '',
                session_id: sessEl ? sessEl.value.trim() : ''
            };
        }

        async function refreshOpenWaLiveStatus(showPicker) {
            try {
                var p = getOpenWaFormParams();
                if (!p.base_url || !p.api_key) {
                    updateOpenWaLiveBadge(null, 'Not configured');
                    return null;
                }
                var qs = new URLSearchParams(p);
                var resp = await fetch('/tool/notificationsetting/openwa-session?' + qs.toString());
                var data = await resp.json();
                if (!data || !data.success) {
                    updateOpenWaLiveBadge(null, (data && data.message) || 'Open-WA error');
                    return data;
                }

                updateOpenWaLiveBadge(data.session, null);

                var picker = document.getElementById('openwa_session_picker');
                if (picker && Array.isArray(data.sessions) && data.sessions.length > 0) {
                    var currentVal = (document.getElementById('openwa_session_id')?.value || '').trim().toLowerCase();
                    var opts = '<option value="">-- Switch Session (' + data.sessions.length + ' found on server) --</option>';
                    data.sessions.forEach(function (s) {
                        var isMatch = (String(s.name || '').toLowerCase() === currentVal || String(s.id || '').toLowerCase() === currentVal);
                        var phoneSuffix = s.phone ? (' · +' + s.phone) : '';
                        opts += '<option value="' + String(s.name || s.id).replace(/"/g, '&quot;') + '"' + (isMatch ? ' selected' : '') + '>' +
                            (s.name || s.id) + ' [' + String(s.status || '').toUpperCase() + phoneSuffix + ']</option>';
                    });
                    picker.innerHTML = opts;
                    if (showPicker) {
                        picker.classList.remove('d-none');
                    }
                }
                return data;
            } catch (err) {
                updateOpenWaLiveBadge(null, err.message);
                return null;
            }
        }

        function renderOpenWaModalData(data) {
            var sessNameEl = document.getElementById('openwa_modal_session_name');
            var badgeEl = document.getElementById('openwa_modal_state_badge');
            var metaEl = document.getElementById('openwa_modal_session_meta');
            var qrWrap = document.getElementById('openwa_modal_qr_wrap');
            var qrImg = document.getElementById('openwa_modal_qr_img');
            var alertEl = document.getElementById('openwa_modal_alert');

            if (alertEl) alertEl.classList.add('d-none');

            if (!data || !data.success) {
                if (sessNameEl) sessNameEl.textContent = getOpenWaFormParams().session_id || 'Open-WA';
                if (badgeEl) {
                    badgeEl.className = 'badge bg-danger-subtle text-danger';
                    badgeEl.textContent = 'ERROR';
                }
                if (metaEl) metaEl.textContent = 'Unable to inspect Open-WA session.';
                if (qrWrap) qrWrap.classList.add('d-none');
                if (alertEl) {
                    alertEl.textContent = (data && data.message) || 'Open-WA connection error.';
                    alertEl.classList.remove('d-none');
                }
                return;
            }

            updateOpenWaLiveBadge(data.session, null);
            var s = data.session;
            if (!s) {
                if (sessNameEl) sessNameEl.textContent = getOpenWaFormParams().session_id || 'Not Found';
                if (badgeEl) {
                    badgeEl.className = 'badge bg-warning-subtle text-warning';
                    badgeEl.textContent = 'NOT CREATED';
                }
                if (metaEl) metaEl.textContent = 'Click "Start / Create Session" below to initialize this WhatsApp session on your Open-WA server.';
                if (qrWrap) qrWrap.classList.add('d-none');
                return;
            }

            if (sessNameEl) sessNameEl.textContent = s.name + ' (' + s.id + ')';
            var st = String(s.status || '').toLowerCase();
            if (badgeEl) {
                if (st === 'ready') {
                    badgeEl.className = 'badge bg-success-subtle text-success';
                    badgeEl.textContent = 'CONNECTED (READY)';
                } else if (st === 'qr_ready') {
                    badgeEl.className = 'badge bg-warning-subtle text-warning';
                    badgeEl.textContent = 'QR READY — SCAN';
                } else {
                    badgeEl.className = 'badge bg-info-subtle text-info';
                    badgeEl.textContent = st.toUpperCase();
                }
            }

            var metaParts = [];
            if (s.phone) metaParts.push('Linked Number: +' + s.phone);
            if (s.pushName) metaParts.push('Account: ' + s.pushName);
            metaParts.push('Engine: ' + (s.engineLoaded ? 'Running' : 'Stopped'));
            if (s.lastError) metaParts.push('Last Error: ' + s.lastError);
            if (metaEl) metaEl.textContent = metaParts.join(' · ');

            if (data.qrCode && st !== 'ready') {
                if (qrImg) qrImg.src = data.qrCode;
                if (qrWrap) qrWrap.classList.remove('d-none');
            } else {
                if (qrWrap) qrWrap.classList.add('d-none');
            }
        }

        async function refreshOpenWaModal() {
            var p = getOpenWaFormParams();
            var serverLabel = document.getElementById('openwa_modal_server_label');
            if (serverLabel) serverLabel.textContent = p.base_url || '';
            var data = await refreshOpenWaLiveStatus(false);
            renderOpenWaModalData(data);
        }

        async function openOpenWaQrModal() {
            var modalEl = document.getElementById('openWaSessionModal');
            if (modalEl && typeof bootstrap !== 'undefined') {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
            await refreshOpenWaModal();
            clearInterval(openWaQrPollTimer);
            openWaQrPollTimer = setInterval(refreshOpenWaModal, 5000);
        }

        async function runOpenWaSessionAction(action) {
            var alertEl = document.getElementById('openwa_modal_alert');
            var metaEl = document.getElementById('openwa_modal_session_meta');
            if (action === 'logout' && !confirm('Unlink the connected WhatsApp device from this Open-WA session?')) {
                return;
            }
            if (alertEl) alertEl.classList.add('d-none');
            if (metaEl) metaEl.textContent = 'Executing "' + action + '" on Open-WA server...';
            try {
                var p = getOpenWaFormParams();
                var resp = await fetch('/tool/notificationsetting/openwa-session/action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        store_id: p.store_id,
                        action: action,
                        base_url: p.base_url,
                        api_key: p.api_key,
                        session_id: p.session_id
                    })
                });
                var data = await resp.json();
                renderOpenWaModalData(data);
                if (data && data.success && typeof toastr !== 'undefined') {
                    toastr.success('Open-WA session action "' + action + '" completed.');
                }
            } catch (err) {
                if (alertEl) {
                    alertEl.textContent = err.message || 'Action failed.';
                    alertEl.classList.remove('d-none');
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            refreshOpenWaLiveStatus(false);
            var modalEl = document.getElementById('openWaSessionModal');
            if (modalEl) {
                modalEl.addEventListener('hidden.bs.modal', function () {
                    clearInterval(openWaQrPollTimer);
                    openWaQrPollTimer = null;
                });
            }
        });

        async function resetStoreOverride(storeId) {
            if (!confirm('Reset this store\'s custom notification settings and inherit Global Defaults instead?')) {
                return;
            }
            try {
                var response = await fetch('/tool/notificationsetting/reset', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ store_id: storeId })
                });
                var data = await response.json();
                if (data && data.success) {
                    if (typeof toastr !== 'undefined') {
                        toastr.success(data.message || 'Reset to global defaults');
                    }
                    window.location.reload();
                } else {
                    alert((data && data.message) || 'Failed to reset settings');
                }
            } catch (err) {
                console.error(err);
                alert('Error resetting store override');
            }
        }

        async function triggerTestNotification() {
            var channelEl = document.getElementById('test_notif_channel');
            var recipientEl = document.getElementById('test_notif_recipient');
            var btnEl = document.getElementById('btn_send_test_notif');
            var feedbackEl = document.getElementById('test_notif_feedback');

            var channel = channelEl ? channelEl.value : 'email';
            var recipient = recipientEl ? recipientEl.value.trim() : '';

            if (!recipient) {
                if (feedbackEl) {
                    feedbackEl.className = 'small text-danger fw-semibold';
                    feedbackEl.innerHTML = '<i class="fas fa-exclamation-circle me-1"></i> Please enter a recipient ' + ((channel === 'sms' || channel === 'whatsapp') ? 'phone number' : 'email address') + '.';
                }
                return;
            }

            if (btnEl) {
                btnEl.disabled = true;
                btnEl.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Sending...';
            }
            if (feedbackEl) {
                feedbackEl.className = 'small text-muted';
                feedbackEl.innerHTML = '<i class="fas fa-circle-notch fa-spin me-1"></i> Dispatching test ' + channel.toUpperCase() + ' notification...';
            }

            try {
                var response = await fetch('/tool/notificationsetting/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        store_id: <%= selectedStore %>,
                        channel: channel,
                        recipient: recipient
                    })
                });
                var result = await response.json();
                if (result && result.success) {
                    if (feedbackEl) {
                        feedbackEl.className = 'small text-success fw-semibold';
                        feedbackEl.innerHTML = '<i class="fas fa-check-circle me-1"></i> ' + result.message;
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.success(result.message);
                    }
                } else {
                    var errMsg = (result && result.message) ? result.message : 'Test failed';
                    if (feedbackEl) {
                        feedbackEl.className = 'small text-danger fw-semibold';
                        feedbackEl.innerHTML = '<i class="fas fa-times-circle me-1"></i> ' + errMsg;
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.error(errMsg);
                    }
                }
            } catch (err) {
                if (feedbackEl) {
                    feedbackEl.className = 'small text-danger fw-semibold';
                    feedbackEl.innerHTML = '<i class="fas fa-times-circle me-1"></i> Network error while sending test.';
                }
            } finally {
                if (btnEl) {
                    btnEl.disabled = false;
                    btnEl.innerHTML = '<i class="fas fa-paper-plane me-1"></i> Send Test Message Now';
                }
            }
        }
    </script>
</body>

</html>
