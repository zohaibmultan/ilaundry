<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>
        <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card ">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <%= language.Expence_Category_List %>
                                </h3>
                                <button
                                    class="btn btn-rounded btn-sm btn-primary <%= accessdata.roll.expense.includes('write') ?'':'d-none' %>"
                                    data-bs-toggle="modal" data-bs-target="#addexpcat"><i class="fa fa-plus color-info me-2 text-white"></i>
                                    <%= language.Add_Category %>
                                </button>
                            </div>
                            <div class="card-body">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="row g-2 mb-3">
                                    <div class="<%= ismulty ? 'col-12 col-md-4 col-lg-4' : 'col-12 col-md-6 col-lg-6' %>">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                                            <input class="form-control" type="search" id="dtExpCatSearch" placeholder="<%= language.Search || 'Search expense categories...' %>">
                                        </div>
                                    </div>
                                    <div class="<%= ismulty ? 'col-12 col-sm-4 col-md-3 col-lg-3' : 'col-12 col-sm-6 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtExpCatType">
                                            <option value="all"><%= language.All_Type || 'All Types' %></option>
                                            <% (type || []).forEach(function(t) { %>
                                                <option value="<%= t.id %>"><%= t.type_name %></option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <% if (ismulty) { %>
                                        <div class="col-12 col-sm-4 col-md-3 col-lg-3">
                                            <select class="form-select" id="dtExpCatStore">
                                                <option value="all"><%= language.All_Store || 'All Stores' %></option>
                                                <% (storeList || []).forEach(function(st) { %>
                                                    <option value="<%= st.id %>"><%= st.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    <% } %>

                                    <div class="<%= ismulty ? 'col-12 col-sm-4 col-md-2 col-lg-2' : 'col-12 col-sm-6 col-md-3 col-lg-3' %>">
                                        <select class="form-select" id="dtExpCatPageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_expcat_table" class="table display server-side-dt" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th><%= language.Category_Name %></th>
                                                <th><%= language.Category_Type %></th>
                                                <th class="<%= ismulty ? '': 'd-none' %>"><%= language.Store_Name %></th>
                                                <th style="width: 110px;"><%= language.Status %></th>
                                                <th class="text-center <%= accessdata.roll.expense.includes('edit') || accessdata.roll.expense.includes('delete') ?'':'d-none' %>" style="width: 110px;">
                                                    <%= language.Action %>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <!--********** Content body end **********-->

        <!-- Modal update -->
        <div class="modal fade" id="updateexpcat">
            <div class="modal-dialog  modal-dialog-scrollable" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Coustomer_Detail %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/coustomer/update/" id="updateexpcat_form" method="post" class="need-validation">

                            <div class="row g-1 align-items-center">
                                <div class="row g-1 align-items-center">
                                    <div class="form-group">
                                        <label><strong>
                                                <%= language.Category_Name %>
                                            </strong></label>
                                        <input type="text" class="form-control " id="name" name="name" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="type"><strong>
                                                <%= language.Category_Type %>
                                            </strong></label>
                                        <select class="form-control wide mb-3" id="cttyid" name="type_id" required>
                                            <% type.forEach(function(data){ %>
                                                <option value="<%=data.id%>">
                                                    <%= data.type_name%>
                                                </option>
                                                <% }) %>

                                        </select>
                                    </div>

                                </div>
                            </div>
                    </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                                    <%= language.Cancel %>
                                </button>
                                <button type="submit" class="btn btn-sm  btn-primary">
                                    <%= language.Save %>
                                </button>
                            </div>
                        </form>



                </div>
            </div>
        </div>
        <!-- <<<<<<<<<<<<<<<<<<<<<<<<<<<>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> -->
        <!-- Modal add -->
        <div class="modal fade" id="addexpcat">
            <div class="modal-dialog  modal-dialog-scrollable" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Add_Expence_Category %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/expense/addexpcate" method="post" class="need-validation">

                            <div class="row g-1 align-items-center">
                                <div class="col-md-12 mb-1 <%= ismulty ? '': 'd-none' %>">
                                    <div class="form-group">
                                        <label class="form-label"><strong>
                                                <%= language.Store_List %>
                                            </strong><span class="text-danger">*</span></label>
                                        <select class="form-control wide mb-3" name="storeid"
                                            id="expense_cat_add_admin" required >
                                            <option value="" selected disabled> Select Store </option>
                                            <% storeList.forEach(function(x){ %>
                                                <option value="<%= x.id %>">
                                                    <%= x.name %>
                                                </option>
                                                <% }) %>


                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label><strong>
                                            <%= language.Category_Name %>
                                        </strong></label>
                                    <input type="text" class="form-control " name="name" required>
                                </div>
                                <div class="form-group">
                                    <label for="type_id"><strong>
                                            <%= language.Category_Type %>
                                        </strong></label>
                                    <select class="form-control wide" id="type_id" name="type_id" required>
                                        <% type.forEach(function(data){ %>
                                            <option value="<%=data.id%>">
                                                <%= data.type_name%>
                                            </option>
                                            <% }) %>

                                    </select>
                                </div>

                            </div>
                    </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                                    <%= language.Cancel %>
                                </button>
                                <button type="submit" class="btn btn-sm  btn-primary">
                                    <%= language.Save %>
                                </button>
                            </div>
                        </form>



                </div>
            </div>


        </div>
        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

            <!--**********************************
            Footer end
        ***********************************-->

            </div>

            <!--********** Main wrapper end **********-->
            <%- include('templet/script')-%>

                <script>
                    $('#addexpcat').on('shown.bs.modal', function () {

                        $('#expense_cat_add_admin').select2({
                            dropdownParent: $('#addexpcat'),
                            placeholder: 'Select Store(s)',
                            width: '100%',
                            allowClear: true
                        });
                    });


                    $('#addexpcat').on('shown.bs.modal', function () {

                        $('#type_id').select2({
                            dropdownParent: $('#addexpcat'),
                            placeholder: 'Select Category(cat)',
                            width: '100%',
                            allowClear: true
                        });
                    });

                    $('#updateexpcat').on('shown.bs.modal', function () {

                        $('#cttyid').select2({
                            dropdownParent: $('#updateexpcat'),
                            placeholder: 'Select Category(cat)',
                            width: '100%',
                            allowClear: true
                        });
                    });
                </script>

                <script>
                    function escapeHtml(str) {
                        if (!str) return '';
                        return String(str)
                          .replace(/&/g, '&amp;')
                          .replace(/</g, '&lt;')
                          .replace(/>/g, '&gt;')
                          .replace(/"/g, '&quot;')
                          .replace(/'/g, '&#039;');
                    }

                    $(document).ready(function() {
                        const isMultistore = <%= ismulty ? 'true' : 'false' %>;

                        const columns = [
                            {
                                data: null,
                                orderable: false,
                                searchable: false,
                                render: function(data, type, row, meta) {
                                    return meta.settings._iDisplayStart + meta.row + 1;
                                }
                            },
                            {
                                data: 'cat_name',
                                render: function(data) {
                                    return `<span class="fw-semibold text-dark">${escapeHtml(data)}</span>`;
                                }
                            },
                            {
                                data: 'type_name',
                                render: function(data) {
                                    return `<span class="badge light badge-primary">${escapeHtml(data || '-')}</span>`;
                                }
                            },
                            {
                                data: 'store',
                                visible: isMultistore,
                                render: function(data) {
                                    return `<span class="badge light badge-light text-dark">${escapeHtml(data || 'All Stores')}</span>`;
                                }
                            },
                            {
                                data: 'delet_flage',
                                render: function(data) {
                                    if (parseInt(data) === 0) {
                                        return '<span class="badge-status-pill badge-status-active">Active</span>';
                                    } else {
                                        return '<span class="badge-status-pill badge-status-inactive">Deactive</span>';
                                    }
                                }
                            },
                            {
                                data: null,
                                orderable: false,
                                searchable: false,
                                className: 'text-center',
                                render: function(data, type, row) {
                                    const editBtn = row.canEdit ? `
                                        <a href="#" class="btn-tbl-action btn-tbl-edit" 
                                           id="expcataction" data-bs-toggle="modal"
                                           data-bs-target="#updateexpcat"
                                           data-catname="${escapeHtml(row.cat_name)}"
                                           data-exp_cat_type_id="${row.exp_cat_type_id}"
                                           data-id="${row.id}" 
                                           data-storeid="${row.store_ID}"
                                           title="<%= language.Edit || 'Edit' %>">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>` : '';

                                    const deleteBtn = row.canDelete ? `
                                        <a href="/expense/deletexpcat/${row.id}" 
                                           class="btn-tbl-action btn-tbl-delete" 
                                           title="<%= language.Delete || 'Delete' %>">
                                            <i class="fa fa-trash"></i>
                                        </a>` : '';

                                    return `<div class="tbl-action-group">${editBtn}${deleteBtn}</div>`;
                                }
                            }
                        ];

                        window.initServerDataTable('#server_expcat_table', {
                            ajaxUrl: '/expense/categorylist/data',
                            columns: columns,
                            searchInput: '#dtExpCatSearch',
                            pageLengthSelect: '#dtExpCatPageLength',
                            filterSelectors: {
                                category_type_id: '#dtExpCatType',
                                store_id: '#dtExpCatStore'
                            },
                            order: [[0, 'desc']],
                            language: {
                                emptyTable: '<%= language.No_data_available_in_table || "No categories found" %>'
                            }
                        });
                    });
                </script>
</body>


</html>