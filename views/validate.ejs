<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="iLaundry">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= data?.app_name || 'iLaundry' %> &bull; License Validation</title>

    <!-- Early Theme Loader -->
    <script>
        (function () {
            try {
                function getCookie(name) {
                    var nameEQ = name + "=";
                    var ca = document.cookie.split(';');
                    for (var i = 0; i < ca.length; i++) {
                        var c = ca[i];
                        while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                        if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
                    }
                    return null;
                }
                var savedTheme = getCookie('theme_version') || localStorage.getItem('theme_version') || 'light';
                if (savedTheme === 'dark') {
                    document.documentElement.setAttribute('data-theme-version', 'dark');
                    document.documentElement.classList.add('dark-only');
                } else {
                    document.documentElement.setAttribute('data-theme-version', 'light');
                    document.documentElement.classList.remove('dark-only');
                }
            } catch (e) { }
        })();
    </script>

    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="/uploads/<%= data?.app_favicon || '' %>">
    <link href="/vendor/bootstrap-select/dist/css/bootstrap-select.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/liquid-glass-theme.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Toastr -->
    <link rel="stylesheet" href="/vendor/toastr/css/toastr.min.css">
</head>

<body>
    <div class="auth-split-wrapper">
        <!-- Floating Theme Switcher -->
        <div class="auth-top-controls">
            <button type="button" class="auth-theme-btn" id="auth_theme_toggle" title="Switch Theme">
                <i class="fas fa-moon lighticon"></i>
                <i class="fas fa-sun darkicon d-none"></i>
                <span id="theme_label">Dark Mode</span>
            </button>
        </div>

        <!-- Left Canvas: License Activation Showcase -->
        <div class="auth-hero-canvas">
            <div class="auth-hero-glow-1"></div>
            <div class="auth-hero-glow-2"></div>

            <div class="auth-hero-brand">
                <img src="/uploads/<%= data?.app_logo || '' %>" class="auth-hero-brand-logo" alt="<%= data?.app_name || 'iLaundry' %> Logo">
                <h2 class="auth-hero-brand-title"><%= data?.app_name || 'iLaundry' %></h2>
            </div>

            <div class="auth-hero-content">
                <div class="auth-hero-badge">
                    <i class="fas fa-certificate"></i> Product License Activation
                </div>
                <h1 class="auth-hero-heading">
                    Validate &amp; Authorize<br>Your Installation.
                </h1>
                <p class="auth-hero-lead">
                    Enter your legitimate Envato purchase code to authorize this domain and unlock ongoing system updates, multi-store sync, and priority customer support.
                </p>

                <div class="auth-hero-pills">
                    <div class="auth-hero-pill">
                        <div class="auth-pill-icon"><i class="fas fa-check-double"></i></div>
                        <div>
                            <div class="auth-pill-text">Official Verification</div>
                            <div class="fs-11 text-muted">Direct Envato API Handshake</div>
                        </div>
                    </div>
                    <div class="auth-hero-pill">
                        <div class="auth-pill-icon"><i class="fas fa-cloud-download-alt"></i></div>
                        <div>
                            <div class="auth-pill-text">Automated Upgrades</div>
                            <div class="fs-11 text-muted">Feature &amp; Security Releases</div>
                        </div>
                    </div>
                    <div class="auth-hero-pill">
                        <div class="auth-pill-icon"><i class="fas fa-server"></i></div>
                        <div>
                            <div class="auth-pill-text">Domain Bound</div>
                            <div class="fs-11 text-muted">Single License Compliance</div>
                        </div>
                    </div>
                    <div class="auth-hero-pill">
                        <div class="auth-pill-icon"><i class="fas fa-life-ring"></i></div>
                        <div>
                            <div class="auth-pill-text">Enterprise Support</div>
                            <div class="fs-11 text-muted">Dedicated SLA Channels</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="auth-hero-footer">
                <span><%= data?.footer_text || 'Copyright &copy; 2026 iLaundry Inc.' %></span>
                <span><i class="fas fa-circle text-success me-1 fs-9"></i> Licensing Gateway</span>
            </div>
        </div>

        <!-- Right Canvas: Validation Form -->
        <div class="auth-form-canvas">
            <div class="auth-glass-card">
                <div class="auth-card-header">
                    <a href="/">
                        <img src="/uploads/<%= data?.app_logo || '' %>" class="auth-card-logo" alt="<%= data?.app_name || 'iLaundry' %>">
                    </a>
                    <h3 class="auth-card-title">Activate Domain</h3>
                    <p class="auth-card-subtitle">
                        Please enter your Envato Purchase Code below to validate this deployment.
                    </p>
                </div>

                <div id="getmsg" class="mb-3"></div>

                <div class="mb-3">
                    <label class="form-label mb-1"><strong>Envato Purchase Code</strong> <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-key text-muted"></i></span>
                        <input type="text" class="form-control" placeholder="e.g. 12345678-abcd-1234-abcd-1234567890ab" id="inputCode" required autofocus>
                    </div>
                    <div class="fs-11 text-muted mt-1">Found in your CodeCanyon Downloads receipt file.</div>
                </div>

                <button type="button" id="sub_activate" class="auth-submit-btn mt-4">
                    <i class="fas fa-shield-alt me-1"></i> Activate Domain &amp; Continue
                </button>

                <div class="text-center mt-4 pt-2 border-top">
                    <p class="fs-13 text-muted mb-0">
                        Already activated? 
                        <a href="/" class="text-primary fw-bold text-decoration-none ms-1">
                            <i class="fas fa-sign-in-alt me-1"></i> Return to Sign In
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <%- include('templet/script')-%>

    <!-- Theme Switcher Script -->
    <script>
        function setCookie(name, value, days) {
            var expires = "";
            if (days) {
                var date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }
            document.cookie = name + "=" + (value || "") + expires + "; path=/";
        }

        function getCookie(name) {
            var nameEQ = name + "=";
            var ca = document.cookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
            }
            return null;
        }

        function applyAuthTheme(theme) {
            if (theme === 'dark') {
                $('html, body').attr('data-theme-version', 'dark').addClass('dark-only');
                $('.lighticon').addClass('d-none');
                $('.darkicon').removeClass('d-none');
                $('#theme_label').text('Light Mode');
            } else {
                $('html, body').attr('data-theme-version', 'light').removeClass('dark-only');
                $('.lighticon').removeClass('d-none');
                $('.darkicon').addClass('d-none');
                $('#theme_label').text('Dark Mode');
            }
        }

        $(document).ready(function () {
            var currentTheme = getCookie('theme_version') || localStorage.getItem('theme_version') || 'light';
            applyAuthTheme(currentTheme);

            $('#auth_theme_toggle').on('click', function (e) {
                e.preventDefault();
                var active = $('html').attr('data-theme-version');
                var newTheme = (active === 'dark') ? 'light' : 'dark';
                setCookie('theme_version', newTheme, 365);
                localStorage.setItem('theme_version', newTheme);
                applyAuthTheme(newTheme);
            });
        });
    </script>
</body>
</html>