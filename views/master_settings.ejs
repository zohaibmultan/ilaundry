<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>
</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>

    <!--********** Content body start **********-->
    <div class="content-body">
        <div class="container-fluid" style="min-height: 100vh; padding-bottom: 90px;">
            
            <!-- Page Banner Header -->
            <div class="settings-banner">
                <div class="d-flex align-items-center">
                    <div class="settings-icon-badge badge-primary-glass">
                        <i class="fas fa-sliders-h"></i>
                    </div>
                    <div>
                        <h4 class="settings-card-title mb-1" style="font-size: 18px !important;">Master System Settings</h4>
                        <p class="settings-card-subtitle mb-0">Global configuration, brand identity, POS hardware, branch rules, and integrations</p>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge <%= masterstore.type == 1 ? 'bg-primary-subtle text-primary' : 'bg-secondary-subtle text-secondary' %>">
                        <i class="fas fa-store me-1"></i> <%= masterstore.type == 1 ? 'Multi-Store Enabled' : 'Single Store' %>
                    </span>
                    <span class="badge bg-info-subtle text-info">
                        <i class="fas fa-dollar-sign me-1"></i> Currency: <%= masterstore.currency_symbol || '$' %>
                    </span>
                </div>
            </div>

            <!-- Master Settings Form -->
            <form action="/tool/setmasterdata" method="post" enctype="multipart/form-data" id="master_setting">
                
                <div class="row">

                    <div class="col-lg-6 col-md-12">
                        <div class="row">                        
                            <!-- ==========================================
                                1. BRAND & VISUAL IDENTITY CARD
                                ========================================== -->
                            <div class="col-12">
                                <div class="settings-section-card">
                                    <div class="settings-card-header">
                                        <div class="d-flex align-items-center">
                                            <div class="settings-icon-badge badge-primary-glass">
                                                <i class="fas fa-building"></i>
                                            </div>
                                            <div>
                                                <h5 class="settings-card-title">Brand & Visual Identity</h5>
                                                <p class="settings-card-subtitle">Application branding, store logo, browser favicon, and footer</p>
                                            </div>
                                        </div>
                                        <span class="badge bg-info-subtle text-info">BRANDING</span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label"><%= language.App_Name || 'App Name' %></label>
                                            <input type="text" class="form-control" name="appname"
                                                value="<%= masterstore.app_name %>" placeholder="Enter Application Name">
                                        </div>

                                        <div class="col-sm-6">
                                            <div class="preview-upload-box">
                                                <label class="form-label d-block text-start mb-2"><%= language.Logo || 'Store Logo' %></label>
                                                <div class="preview mb-2 d-flex align-items-center justify-content-center" style="height: 80px;">
                                                    <img id="file-preview" src="../uploads/<%= masterstore.app_logo %>" 
                                                        style="max-height: 75px; max-width: 100%; object-fit: contain;" alt="Logo">
                                                </div>
                                                <input class="d-none" type="file" id="logo" name="logo" accept="image/*" onchange="showPreview(event);">
                                                <label class="btn btn-outline-primary btn-xs w-100 mb-0" for="logo">
                                                    <i class="fas fa-upload me-1"></i> Upload Logo
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-sm-6">
                                            <div class="preview-upload-box">
                                                <label class="form-label d-block text-start mb-2"><%= language.Favicon || 'Browser Favicon' %></label>
                                                <div class="preview mb-2 d-flex align-items-center justify-content-center" style="height: 80px;">
                                                    <img id="file-favicon" src="../uploads/<%= masterstore.app_favicon %>" 
                                                        style="max-height: 50px; max-width: 50px; object-fit: contain;" alt="Favicon">
                                                </div>
                                                <input class="d-none" type="file" id="favicon" name="favicon" accept="image/*" onchange="showfavicon(event);">
                                                <label class="btn btn-outline-primary btn-xs w-100 mb-0" for="favicon">
                                                    <i class="fas fa-upload me-1"></i> Upload Favicon
                                                </label>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Footer Copyright Text</label>
                                            <input type="text" class="form-control" name="footer"
                                                value="<%= masterstore.footer %>" placeholder="e.g. Copyright 2026 © iCleaners">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ==========================================
                                4. CURRENCY & LOCALIZATION CARD
                                ========================================== -->
                            <div class="col-12">
                                <div class="settings-section-card">
                                    <div class="settings-card-header">
                                        <div class="d-flex align-items-center">
                                            <div class="settings-icon-badge badge-currency-glass">
                                                <i class="fas fa-coins"></i>
                                            </div>
                                            <div>
                                                <h5 class="settings-card-title">Currency & Localization</h5>
                                                <p class="settings-card-subtitle">Monetary formatting, decimal markers, and operational timezone</p>
                                            </div>
                                        </div>
                                        <span class="badge bg-warning-subtle text-warning">LOCALIZATION</span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-sm-6">
                                            <label class="form-label"><%= language.Currency || 'Currency Symbol' %></label>
                                            <input type="text" class="form-control" name="currency"
                                                value="<%= masterstore.currency_symbol %>" placeholder="e.g. $, €, £, Rs">
                                        </div>

                                        <div class="col-sm-6 d-flex flex-column justify-content-end">
                                            <div class="settings-toggle-row mb-1">
                                                <div class="form-check form-switch d-flex align-items-center justify-content-between mb-0">
                                                    <label class="form-check-label mb-0" for="Symbol_Placement" style="font-size: 11.5px;">
                                                        Symbol on Right (e.g. 100$)
                                                    </label>
                                                    <input class="form-check-input" type="checkbox" id="Symbol_Placement" name="Symbol_Placement" value="1"
                                                        <%= masterstore.currency_placement == 1 ? 'checked' : '' %>>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-sm-6">
                                            <label class="form-label"><%= language.Thousands_Separator || 'Thousands Separator' %></label>
                                            <select class="form-control form-select" name="thousands_separator">
                                                <option value="1" <%= masterstore.thousands_separator == 1 ? 'selected' : '' %>>, (Comma - 1,000.00)</option>
                                                <option value="2" <%= masterstore.thousands_separator == 2 ? 'selected' : '' %>>. (Full Stop - 1.000,00)</option>
                                                <option value="3" <%= masterstore.thousands_separator == 3 ? 'selected' : '' %>>` (Apostrophe - 1`000.00)</option>
                                                <option value="4" <%= masterstore.thousands_separator == 4 ? 'selected' : '' %>>None (1000.00)</option>
                                                <option value="5" <%= masterstore.thousands_separator == 5 ? 'selected' : '' %>>Space (1 000.00)</option>
                                            </select>
                                        </div>

                                        <div class="col-sm-6">
                                            <label class="form-label"><%= language.Timezone || 'Store Timezone' %></label>
                                            <select class="form-control form-select" name="timezone" id="timezone" data-id="<%= masterstore.timezone %>">
                                                <option value selected disabled>Choose Timezone</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <div class="row">
                            <!-- ==========================================
                                3. STORE ARCHITECTURE & APPROVAL RULES CARD
                                ========================================== -->
                            <div class="col-12">
                                <div class="settings-section-card">
                                    <div class="settings-card-header">
                                        <div class="d-flex align-items-center">
                                            <div class="settings-icon-badge badge-ops-glass">
                                                <i class="fas fa-sitemap"></i>
                                            </div>
                                            <div>
                                                <h5 class="settings-card-title">Store Architecture & Operations</h5>
                                                <p class="settings-card-subtitle">Multi-store topology, customer isolation, and auto-approval policies</p>
                                            </div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success">OPERATIONS</span>
                                    </div>

                                    <div class="row g-3">
                                        <!-- Multi-Store Switch -->
                                        <div class="col-12">
                                            <div class="settings-toggle-row">
                                                <div class="form-check form-switch d-flex align-items-center justify-content-between mb-0">
                                                    <div>
                                                        <label class="form-check-label fw-bold mb-0" for="multy">
                                                            <%= language.Single_Store_or_Multi_Store || 'Multi-Store Branch Architecture' %>
                                                        </label>
                                                        <div class="text-muted" style="font-size: 11px;">Enable to run independent branches with isolated inventories</div>
                                                    </div>
                                                    <input class="form-check-input" type="checkbox" id="multy" name="multy" value="1" <%= masterstore.type == 1 ? 'checked' : '' %>>
                                                </div>
                                            </div>

                                            <!-- Source Store dropdown if single store -->
                                            <div class="<%= masterstore.type != 1 ? '' : 'd-none' %> mt-3" id="store_source">
                                                <label class="form-label" for="fromStore">Default Primary Store</label>
                                                <select class="form-select" id="fromStore" name="fromStore">
                                                    <option value="">Select Primary Store</option>
                                                    <% storeList.forEach(function(store) { %>
                                                        <option value="<%= store.id %>" <%= masterstore.fromStore == store.id ? 'selected' : '' %>>
                                                            <%= store.name %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                        </div>

                                        <!-- Customer Store Selection Switch -->
                                        <div class="col-12 <%= masterstore.type == 1 ? '' : 'd-none' %>" id="custmor_selection_main">
                                            <div class="settings-toggle-row">
                                                <div class="form-check form-switch d-flex align-items-center justify-content-between mb-0">
                                                    <div>
                                                        <label class="form-check-label fw-bold mb-0" for="custmor_selection">
                                                            <%= language.Disable_select_store || 'Hide Store Filter in Customer Section' %>
                                                        </label>
                                                        <div class="text-muted" style="font-size: 11px;">Restricts cashier view to only customers registered in their own store</div>
                                                    </div>
                                                    <input class="form-check-input" type="checkbox" id="custmor_selection" name="custmor_selection" value="1" <%= masterstore.customer_selection == 1 ? 'checked' : '' %>>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Customer Auto Approved -->
                                        <div class="col-sm-6">
                                            <div class="settings-toggle-row">
                                                <div class="form-check form-switch d-flex align-items-center justify-content-between mb-0">
                                                    <div>
                                                        <label class="form-check-label fw-bold mb-0" for="customer_approved">
                                                            <%= language.Customer_Auto_Approved || 'Customer Auto-Approve' %>
                                                        </label>
                                                        <div class="text-muted" style="font-size: 11px;">Auto-validate new customer signups</div>
                                                    </div>
                                                    <input class="form-check-input" type="checkbox" id="customer_approved" name="customer_approved" value="1" <%= masterstore.customer_autoapprove == 1 ? 'checked' : '' %>>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Store Auto Approved -->
                                        <div class="col-sm-6">
                                            <div class="settings-toggle-row">
                                                <div class="form-check form-switch d-flex align-items-center justify-content-between mb-0">
                                                    <div>
                                                        <label class="form-check-label fw-bold mb-0" for="store_approved">
                                                            <%= language.Store_Auto_Approved || 'Branch Auto-Approve' %>
                                                        </label>
                                                        <div class="text-muted" style="font-size: 11px;">Auto-validate new store requests</div>
                                                    </div>
                                                    <input class="form-check-input" type="checkbox" id="store_approved" name="store_approved" value="1" <%= masterstore.store_autoapprove == 1 ? 'checked' : '' %>>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Multi-Language Support Switch -->
                                        <div class="col-12">
                                            <div class="settings-toggle-row">
                                                <div class="form-check form-switch d-flex align-items-center justify-content-between mb-0">
                                                    <div>
                                                        <label class="form-check-label fw-bold mb-0" for="multi_language_enabled">
                                                            <%= language.Multi_Language_Support || 'Multi-Language Support' %>
                                                        </label>
                                                        <div class="text-muted" style="font-size: 11px;">Enable to show the language dropdown in the header. When disabled, the system strictly enforces English and hides the selector.</div>
                                                    </div>
                                                    <input class="form-check-input" type="checkbox" id="multi_language_enabled" name="multi_language_enabled" value="1" <%= (masterstore.multi_language_enabled !== 0 && masterstore.multi_language_enabled !== '0') ? 'checked' : '' %>>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 d-none">
                                            <label class="form-label"><%= language.Default_Store_Roll || 'Default Store Role' %></label>
                                            <select class="form-control" name="storeroll">
                                                <option value="0" selected>Choose Role</option>
                                                <% roll.forEach(function(data){ %>
                                                    <option value="<%= data.id %>" <%= data.rollType == 'master' ? 'selected' : '' %>><%= data.roll %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- Sticky Glass Save Footer Bar -->
                <div class="settings-sticky-footer">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge light badge-primary d-none d-md-inline-flex">
                            <i class="fas fa-shield-alt me-1"></i> Master Admin Mode
                        </span>
                        <small class="text-muted d-none d-sm-inline">All changes update instantly upon saving.</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="reset" class="btn btn-secondary px-3">
                            <i class="fas fa-undo me-2"></i> Reset
                        </button>
                        <button type="submit" id="master_setting_submit" class="btn btn-primary px-4">
                            <i class="fas fa-save me-2"></i> <%= language.Save_Data || 'Save All Settings' %>
                        </button>
                    </div>
                </div>

            </form>

        </div>
    </div>
    <!--********** Content body end **********-->

    <!-- Confirmation Modal for Multi-Store Switch -->
    <div class="modal fade" id="POS_coupon_model" tabindex="-1" aria-labelledby="POSCouponModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="POSCouponModalLabel">
                        <%= language.Confirmation || 'Confirmation' %>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <p class="mb-0" style="font-size: 13px !important;">
                            <strong><%= language.Note || 'Note' %> :</strong>
                            <%= language.Are_you_sure_you_want_to_switch_Multi_Store_Branch_to_Single || 'Are you sure you want to switch from Multi-Store to Single Store?' %>
                        </p>
                    </div>
                    <p style="font-size: 13px !important;">
                        <%= language.All_customer_data_will_be_moved_to_the_store_you_select_as_the_single_store || 'All store data will be scoped to your primary selected store.' %>
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" id="multy_confirm">
                        <i class="fa fa-check me-2"></i><%= language.Confirm || 'Confirm' %>
                    </button>
                    <button class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('templet/footer')-%>

    <!-- Scripts -->
    <%- include('templet/script')-%>
    <script src="/js/pos-print-client.js"></script>

    <script>
        // Multi-store confirmation modal handling
        document.getElementById("multy_confirm").addEventListener("click", function () {
            const modalElement = document.getElementById('POS_coupon_model');
            const modal = bootstrap.Modal.getInstance(modalElement);
            modalElement.setAttribute('data-confirm', 'true');

            document.getElementById('multy').checked = false;
            document.getElementById('store_source').classList.remove('d-none');
            document.getElementById('fromStore').setAttribute('required', 'true');

            if (typeof $ !== 'undefined' && $('#fromStore').select2) {
                $('#fromStore').select2({ placeholder: "Search Source Store", width: '100%' });
            }

            modal.hide();
        });

        document.getElementById("multy").addEventListener("change", function () {
            const isChecked = this.checked;
            if (isChecked) {
                document.getElementById('store_source').classList.add('d-none');
                document.getElementById('fromStore').value = '';
                document.getElementById('fromStore').removeAttribute('required');
                const custMain = document.getElementById('custmor_selection_main');
                if (custMain) custMain.classList.remove('d-none');
            } else {
                const modalElement = document.getElementById('POS_coupon_model');
                if (modalElement) {
                    const myModal = new bootstrap.Modal(modalElement);
                    myModal.show();
                }
            }
        });

        document.getElementById('POS_coupon_model').addEventListener('hidden.bs.modal', function () {
            const modalElement = document.getElementById('POS_coupon_model');
            const isConfirm = modalElement.getAttribute('data-confirm') === 'true';
            if (!isConfirm) {
                document.getElementById('multy').checked = true;
                document.getElementById('store_source').classList.add('d-none');
                document.getElementById('fromStore').removeAttribute('required');
            }
            modalElement.removeAttribute('data-confirm');
        });

        // Show/Hide password toggle for API keys
        function togglePassVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                if (icon) icon.className = 'fas fa-eye';
            }
        }
    </script>
</body>
</html>