<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
  <!-- meta and links start -->
  <%- include('templet/meta')-%>
</head>

<body>
  <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
  <!--********** Content body start **********-->

  <div class="content-body">
    <div class="container-fluid" style="min-height: 100vh;">
      <%
        const isMaster = (accessdata?.logas === 'master' || (accessdata?.roll && accessdata.roll.rollType === 'master'));
        const canWriteRack = accessdata?.logas !== 'custmor' && (
          isMaster ||
          (accessdata?.roll?.orders && (accessdata.roll.orders.includes('write') || accessdata.roll.orders.includes('edit'))) ||
          (accessdata?.roll?.service && accessdata.roll.service.includes('write'))
        );
      %>
      <div class="row">
        <div class="col-12">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                  <i class="fa fa-layer-group text-primary me-2"></i><%= language.Racks || 'Garment Racks' %>
                </h3>
                <small class="text-muted"><%= language.Racks_Subtitle || 'Manage garment storage racks and monitor active order item counts per rack' %></small>
              </div>
              <div>
                <% if (canWriteRack) { %>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addRackModal">
                  <i class="fa fa-plus me-2"></i><%= language.Add_New_Rack || 'Add New Rack' %>
                </button>
                <% } %>
              </div>
            </div>

            <div class="card-body p-4">
              <!-- Invoice Search Bar (Two-Way Search: Find Rack Location by Invoice #) -->
              <div class="card border border-primary border-opacity-25 bg-light-subtle rounded-3 mb-4 p-3 shadow-none">
                <div class="row align-items-center g-2">
                  <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center gap-2">
                      <div class="bg-primary text-white rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="fa fa-search-location"></i>
                      </div>
                      <div>
                        <strong class="d-block text-dark fs-14">Search Invoice Rack Location</strong>
                        <small class="text-muted">Enter or scan ticket # to locate clean garments instantly</small>
                      </div>
                    </div>
                  </div>
                  <div class="col-12 col-md-6">
                    <div class="input-group">
                      <span class="input-group-text bg-white border-end-0"><i class="fa fa-barcode text-primary"></i></span>
                      <input type="text" class="form-control border-start-0" id="rack_invoice_search_input" placeholder="Enter invoice / order # (e.g. 100005, B100001)...">
                      <button class="btn btn-primary btn-sm" type="button" id="btn_search_rack_invoice">
                        <i class="fa fa-search me-1"></i> Locate Rack
                      </button>
                    </div>
                  </div>
                  <div class="col-12 col-md-2 text-md-end">
                    <button class="btn btn-outline-secondary btn-sm" type="button" id="btn_clear_invoice_search">
                      <i class="fa fa-times me-1"></i> Clear Search
                    </button>
                  </div>
                </div>

                <!-- Invoice Search Results Container -->
                <div id="rack_invoice_results_box" class="mt-3 pt-3 border-top d-none">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-bold small text-uppercase text-primary" id="rack_search_result_count">Found Matching Orders</span>
                    <small class="text-muted">Click any order to view full details</small>
                  </div>
                  <div class="table-responsive">
                    <table class="table table-sm table-bordered bg-white align-middle mb-0">
                      <thead class="table-light fs-12">
                        <tr>
                          <th>Invoice #</th>
                          <th>Customer</th>
                          <th>Phone</th>
                          <th>Status</th>
                          <th>Rack Location</th>
                          <th>Balance</th>
                          <th class="text-end">Action</th>
                        </tr>
                      </thead>
                      <tbody id="rack_invoice_results_tbody" class="fs-13"></tbody>
                    </table>
                  </div>
                </div>
              </div>

              <!-- Server-side DataTable Toolbar -->
              <div class="row g-2 mb-3">
                <div class="<%= ismulty ? 'col-12 col-md-6 col-lg-6' : 'col-12 col-md-8 col-lg-9' %>">
                  <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                    <input class="form-control" type="search" id="dtRackSearch" placeholder="<%= language.Search_Racks || 'Search racks by name...' %>">
                  </div>
                </div>

                <% if (ismulty) { %>
                <div class="col-6 col-md-3 col-lg-3">
                  <select class="form-select" id="dtRackStore">
                    <option value="all"><%= language.All_Store || 'All Stores' %></option>
                    <% (storeList || []).forEach(function(st) { %>
                    <option value="<%= st.id %>"><%= st.name %></option>
                    <% }) %>
                  </select>
                </div>
                <% } %>

                <div class="<%= ismulty ? 'col-6 col-md-3 col-lg-3' : 'col-12 col-md-4 col-lg-3' %>">
                  <select class="form-select" id="dtRackPageLength">
                    <option value="10">10 <%= language.Entries || 'entries' %></option>
                    <option value="25">25 <%= language.Entries || 'entries' %></option>
                    <option value="50">50 <%= language.Entries || 'entries' %></option>
                    <option value="100">100 <%= language.Entries || 'entries' %></option>
                  </select>
                </div>
              </div>

              <div class="table-responsive">
                <table id="server_racks_table" class="table display server-side-dt" style="width: 100%;">
                  <thead>
                    <tr>
                      <th style="width: 60px;">#</th>
                      <th><%= language.Rack_Name || 'Rack Name' %></th>
                      <th><%= language.Number_of_Items || 'Items in Rack' %></th>
                      <th class="<%= ismulty ? '' : 'd-none' %>"><%= language.Store_Name || 'Store Name' %></th>
                      <th class="text-center" style="width: 130px;"><%= language.Action || 'Action' %></th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--********** Content body end **********-->

  <!-- Modal: Add Rack -->
  <div class="modal fade" id="addRackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">
            <i class="fa fa-plus-circle text-primary me-2"></i><%= language.Add_New_Rack || 'Add New Rack' %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form action="/order/racks/add" method="post" id="addRackForm">
          <div class="modal-body">
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label fw-bold" for="rack_name_input">
                  <%= language.Rack_Name || 'Rack Name' %> <span class="text-danger">*</span>
                </label>
                <input type="text" class="form-control" name="rack_name" id="rack_name_input" placeholder="e.g., Rack A-1, Conveyor 2, Shelf B" required>
              </div>

              <% if (ismulty) { %>
              <div class="col-12">
                <label class="form-label fw-bold" for="add_rack_store_select">
                  <%= language.Store_List || 'Store' %> <span class="text-danger">*</span>
                </label>
                <select class="form-select" name="store_id" id="add_rack_store_select" required>
                  <option value="" selected disabled>Select Store</option>
                  <% (storeList || []).forEach(function(st) { %>
                  <option value="<%= st.id %>"><%= st.name %></option>
                  <% }) %>
                </select>
              </div>
              <% } %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
            </button>
            <button type="submit" class="btn btn-primary">
              <i class="fa fa-save me-2"></i><%= language.Save || 'Save Rack' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal: Edit Rack -->
  <div class="modal fade" id="editRackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">
            <i class="fas fa-pencil-alt text-primary me-2"></i><%= language.Edit_Rack || 'Edit Rack' %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form action="" method="post" id="editRackForm">
          <div class="modal-body">
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label fw-bold" for="rack_name_update">
                  <%= language.Rack_Name || 'Rack Name' %> <span class="text-danger">*</span>
                </label>
                <input type="text" class="form-control" name="rack_name_update" id="rack_name_update" placeholder="Enter Rack Name" required>
              </div>

              <% if (ismulty) { %>
              <div class="col-12">
                <label class="form-label fw-bold" for="edit_rack_store_select">
                  <%= language.Store_List || 'Store' %> <span class="text-danger">*</span>
                </label>
                <select class="form-select" name="store_id_update" id="edit_rack_store_select" required>
                  <% (storeList || []).forEach(function(st) { %>
                  <option value="<%= st.id %>"><%= st.name %></option>
                  <% }) %>
                </select>
              </div>
              <% } %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
            </button>
            <button type="submit" class="btn btn-primary">
              <i class="fa fa-save me-2"></i><%= language.Save || 'Save Changes' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal: View Active Orders in Rack (Drilldown) -->
  <div class="modal fade" id="viewRackOrdersModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content border-0 shadow">
        <div class="modal-header border-bottom py-3 px-4 bg-light-subtle d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <div class="bg-primary text-white rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
              <i class="fa fa-layer-group"></i>
            </div>
            <div>
              <h5 class="modal-title fw-bold text-dark mb-0" id="view_rack_modal_title">Rack Garments</h5>
              <small class="text-muted" id="view_rack_modal_subtitle">Active orders currently occupying this rack</small>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div id="rack_orders_loading" class="text-center py-4">
            <i class="fa fa-spinner fa-spin fa-2x text-primary mb-2"></i>
            <div class="text-muted small">Loading rack orders...</div>
          </div>
          <div id="rack_orders_empty" class="text-center py-4 d-none">
            <i class="fa fa-check-circle fa-3x text-success mb-2"></i>
            <h6 class="fw-bold text-dark">This Rack is Currently Empty</h6>
            <p class="text-muted small mb-0">No active or pending orders are assigned to this position.</p>
          </div>
          <div id="rack_orders_table_box" class="d-none">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light fs-12">
                  <tr>
                    <th>Invoice #</th>
                    <th>Customer Name</th>
                    <th>Phone</th>
                    <th>Target Ready</th>
                    <th>Status</th>
                    <th>Balance</th>
                    <th class="text-end">Action</th>
                  </tr>
                </thead>
                <tbody id="rack_orders_tbody" class="fs-13"></tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="modal-footer border-top py-2 px-4 bg-light-subtle">
          <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: Delete Rack Confirmation -->
  <div class="modal fade" id="deleteRackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 430px;">
      <div class="modal-content text-center p-3" style="border-radius: 16px;">
        <div class="modal-body pt-4">
          <div class="mb-3">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
              <i class="fa fa-trash-alt"></i>
            </div>
          </div>
          <h4 class="mb-2 fw-bold text-dark"><%= language.Delete_Rack || 'Delete Rack' %></h4>
          <p class="text-muted mb-1" id="deleteRackPromptText"><%= language.Are_you_sure_delete || 'Are you sure you want to delete this rack?' %></p>
          <p class="fw-bold text-danger fs-5 mb-2" id="deleteRackModalTitle"></p>
          <div id="deleteRackInUseAlert" class="alert alert-warning text-start small py-2 px-3 mb-3 d-none">
            <i class="fa fa-lock me-1"></i>
            <span id="deleteRackInUseMsg"></span>
          </div>
          <p class="text-xs text-muted mb-4" id="deleteRackSubtext"><%= language.Action_cannot_be_undone || 'This action cannot be undone.' %></p>
          <div class="d-flex gap-2 justify-content-center">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
            </button>
            <a href="#" id="deleteRackConfirmBtn" class="btn btn-danger">
              <i class="fa fa-trash me-2"></i><%= language.Delete || 'Yes, Delete' %>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('templet/footer')-%>
  </div>
  <%- include('templet/script')-%>

  <script>
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    $(document).ready(function() {
      const isMultistore = <%= ismulty ? 'true' : 'false' %>;

      const columns = [
        {
          data: null,
          orderable: false,
          searchable: false,
          render: function(data, type, row, meta) {
            return meta.settings._iDisplayStart + meta.row + 1;
          }
        },
        {
          data: 'rack_name',
          render: function(data, type, row) {
            return '<div class="d-flex align-items-center gap-2">' +
              '<span class="badge bg-primary-subtle text-primary border px-2 py-1"><i class="fa fa-layer-group"></i></span>' +
              '<span class="fw-bold text-dark fs-6">' + escapeHtml(data) + '</span>' +
              '</div>';
          }
        },
        {
          data: 'itemCount',
          orderable: false,
          render: function(data, type, row) {
            const items = parseInt(row.itemCount || 0, 10);
            const orders = parseInt(row.orderCount || 0, 10);
            if (orders > 0) {
              const orderLinks = (row.activeOrders || []).slice(0, 4).map(function(o) {
                return '<a href="/order/view/' + o.id + '" class="text-primary fw-semibold text-decoration-none">#' + escapeHtml(o.order_id) + '</a>';
              }).join(', ') + ((row.activeOrders && row.activeOrders.length > 4) ? ' +' + (row.activeOrders.length - 4) + ' more' : '');

              return '<div class="d-flex flex-column gap-1">' +
                '<div class="d-flex align-items-center gap-2 flex-wrap">' +
                '<span class="badge bg-success text-white px-2 py-1"><i class="fa fa-tshirt me-1"></i>' + items + ' ' + (items === 1 ? 'Item' : 'Items') + '</span>' +
                '<span class="badge bg-info-subtle text-info border px-2 py-1">' + orders + ' Active ' + (orders === 1 ? 'Order' : 'Orders') + '</span>' +
                '</div>' +
                (orderLinks ? '<div class="small text-muted">Orders: ' + orderLinks + '</div>' : '') +
                '</div>';
            }
            return '<span class="badge bg-light-subtle text-muted border px-2 py-1">0 Items (Empty)</span>';
          }
        },
        {
          data: 'store_name',
          visible: isMultistore,
          render: function(data) {
            return '<span class="badge bg-light-subtle text-dark border px-2 py-1">' + escapeHtml(data || 'Store') + '</span>';
          }
        },
        {
          data: null,
          orderable: false,
          searchable: false,
          className: 'text-center',
          render: function(data, type, row) {
            const editBtn = row.canEdit ? (
              '<button type="button" class="btn-dt-action btn-edit btn-edit-rack" ' +
              'data-bs-toggle="modal" data-bs-target="#editRackModal" ' +
              'data-id="' + row.id + '" ' +
              'data-name="' + escapeHtml(row.rack_name || '') + '" ' +
              'data-storeid="' + (row.store_id || '') + '" ' +
              'title="<%= language.Edit || "Edit" %>">' +
              '<i class="fas fa-pencil-alt"></i></button>'
            ) : '';

            let deleteBtn = '';
            if (row.canDelete) {
              const inUseFlag = row.inUse ? '1' : '0';
              const inUseTitle = row.inUse
                ? 'Cannot delete: Used in ' + row.orderCount + ' active order(s)'
                : '<%= language.Delete || "Delete" %>';
              deleteBtn = '<button type="button" class="btn-dt-action btn-delete btn-delete-rack ' + (row.inUse ? 'opacity-50' : '') + '" ' +
                'data-bs-toggle="modal" data-bs-target="#deleteRackModal" ' +
                'data-id="' + row.id + '" ' +
                'data-name="' + escapeHtml(row.rack_name || '') + '" ' +
                'data-inuse="' + inUseFlag + '" ' +
                'data-ordercount="' + (row.orderCount || 0) + '" ' +
                'data-itemcount="' + (row.itemCount || 0) + '" ' +
                'title="' + escapeHtml(inUseTitle) + '">' +
                '<i class="fa ' + (row.inUse ? 'fa-lock' : 'fa-trash') + '"></i></button>';
            }

      // Action button to drilldown into active rack orders
      const drilldownBtn = row.orderCount > 0 ? (
        '<button type="button" class="btn-dt-action btn-view btn-view-rack-orders" ' +
        'data-id="' + row.id + '" ' +
        'data-name="' + escapeHtml(row.rack_name || '') + '" ' +
        'title="View orders on this rack">' +
        '<i class="fa fa-eye"></i></button>'
      ) : '';

      return '<div class="server-dt-actions justify-content-center">' + drilldownBtn + editBtn + deleteBtn + '</div>';
          }
        }
      ];

      window.initServerDataTable('#server_racks_table', {
        ajaxUrl: '/order/racks/data',
        columns: columns,
        searchInput: '#dtRackSearch',
        pageLengthSelect: '#dtRackPageLength',
        filterSelectors: {
          store_id: '#dtRackStore'
        },
        order: [[1, 'asc']],
        language: {
          emptyTable: '<%= language.No_Racks_Found || "No garment racks found. Click Add New Rack to create one." %>'
        }
      });

      function populateEditRackModal($btn) {
        if (!$btn || !$btn.length) return;
        const id = String($btn.attr('data-id') || '').replace(/['"]/g, '').trim();
        const name = $btn.attr('data-name') || '';
        const storeId = $btn.attr('data-storeid') || '';

        $('#editRackForm').attr('action', '/order/racks/update/' + id);
        $('#rack_name_update').val(name);
        if ($('#edit_rack_store_select').length && storeId) {
          $('#edit_rack_store_select').val(storeId);
        }
      }

      $(document).on('click', '.btn-edit-rack', function() {
        populateEditRackModal($(this));
      });

      $('#editRackModal').on('show.bs.modal', function(e) {
        if (e.relatedTarget) {
          populateEditRackModal($(e.relatedTarget));
        }
      });

      $('#editRackForm').on('submit', function(e) {
        const action = $(this).attr('action');
        if (!action || action === '' || action.includes('undefined')) {
          e.preventDefault();
          alert('Invalid destination: please re-open the dialog and try again.');
          return false;
        }
      });

      function populateDeleteRackModal($btn) {
        if (!$btn || !$btn.length) return;
        const id = String($btn.attr('data-id') || '').replace(/['"]/g, '').trim();
        const name = $btn.attr('data-name') || '';
        const inUse = String($btn.attr('data-inuse') || '0') === '1';
        const orderCount = parseInt($btn.attr('data-ordercount') || '0', 10);
        const itemCount = parseInt($btn.attr('data-itemcount') || '0', 10);

        $('#deleteRackModalTitle').text(name || ('#' + id));
        if (inUse) {
          $('#deleteRackInUseAlert').removeClass('d-none');
          $('#deleteRackInUseMsg').text(
            'This rack currently holds ' + itemCount + ' item(s) across ' + orderCount + ' active order(s). You cannot delete a rack while it is in use.'
          );
          $('#deleteRackConfirmBtn').addClass('d-none').attr('href', '#');
          $('#deleteRackSubtext').addClass('d-none');
        } else {
          $('#deleteRackInUseAlert').addClass('d-none');
          $('#deleteRackConfirmBtn').removeClass('d-none').attr('href', '/order/racks/delete/' + id);
          $('#deleteRackSubtext').removeClass('d-none');
        }
      }

      $(document).on('click', '.btn-delete-rack', function() {
        populateDeleteRackModal($(this));
      });

      // Two-Way Search: Locate Rack by Invoice Number
      function searchInvoiceRack() {
        const query = ($('#rack_invoice_search_input').val() || '').trim();
        if (!query) {
          if (typeof toastr !== 'undefined') toastr.warning('Please enter an invoice or order number.');
          else alert('Please enter an invoice or order number.');
          $('#rack_invoice_search_input').focus();
          return;
        }

        const $btn = $('#btn_search_rack_invoice');
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1"></i>Searching...');

        $.ajax({
          url: '/order/racks/search-invoice?q=' + encodeURIComponent(query),
          type: 'GET',
          dataType: 'json',
          success: function(res) {
            $btn.prop('disabled', false).html('<i class="fa fa-search me-1"></i>Locate Rack');
            const box = $('#rack_invoice_results_box');
            const tbody = $('#rack_invoice_results_tbody');
            tbody.empty();

            if (!res || !res.found || !res.results || res.results.length === 0) {
              box.removeClass('d-none');
              $('#rack_search_result_count').text('No Results Found');
              tbody.html('<tr><td colspan="7" class="text-center text-muted py-3">No active orders found matching "' + escapeHtml(query) + '".</td></tr>');
              return;
            }

            box.removeClass('d-none');
            $('#rack_search_result_count').text('Found ' + res.results.length + ' Matching Order(s)');

            res.results.forEach(function(r) {
              const rackBadge = r.has_racks
                ? '<span class="badge bg-primary text-white fs-12 px-2 py-1"><i class="fa fa-layer-group me-1"></i>' + escapeHtml(r.rack_names) + '</span>'
                : '<span class="badge bg-warning-subtle text-warning border px-2 py-1">Unassigned</span>';

              const balDue = parseFloat(r.balance_amount) || 0;
              const balClass = balDue > 0 ? 'text-danger fw-bold' : 'text-success fw-bold';

              const rowHtml = `
                <tr>
                  <td><a href="/order/view/${r.id}" class="fw-bold text-primary">#${escapeHtml(r.order_id)}</a></td>
                  <td><strong class="text-dark">${escapeHtml(r.customer_name)}</strong></td>
                  <td class="small text-muted">${escapeHtml(r.customer_phone || '---')}</td>
                  <td><span class="badge bg-light-subtle text-dark border">${escapeHtml(r.status_name || 'Active')}</span></td>
                  <td>${rackBadge}</td>
                  <td class="${balClass}">$${balDue.toFixed(2)}</td>
                  <td class="text-end">
                    <a href="/order/view/${r.id}" class="btn btn-xs btn-outline-primary py-1 px-2">
                      <i class="fa fa-eye me-1"></i>View Order
                    </a>
                  </td>
                </tr>
              `;
              tbody.append(rowHtml);
            });
          },
          error: function() {
            $btn.prop('disabled', false).html('<i class="fa fa-search me-1"></i>Locate Rack');
            if (typeof toastr !== 'undefined') toastr.error('Failed to search invoice rack location.');
          }
        });
      }

      $('#btn_search_rack_invoice').on('click', function() {
        searchInvoiceRack();
      });

      $('#rack_invoice_search_input').on('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          searchInvoiceRack();
        }
      });

      $('#btn_clear_invoice_search').on('click', function() {
        $('#rack_invoice_search_input').val('');
        $('#rack_invoice_results_box').addClass('d-none');
        $('#rack_invoice_results_tbody').empty();
      });

      // Rack Drilldown: Click to view all orders on a specific rack
      $(document).on('click', '.btn-view-rack-orders', function() {
        const rackId = $(this).attr('data-id');
        const rackName = $(this).attr('data-name');
        if (!rackId) return;

        $('#view_rack_modal_title').text('Rack ' + rackName + ' — Current Orders');
        $('#rack_orders_loading').removeClass('d-none');
        $('#rack_orders_empty').addClass('d-none');
        $('#rack_orders_table_box').addClass('d-none');
        $('#viewRackOrdersModal').modal('show');

        $.ajax({
          url: '/order/racks/orders-by-rack/' + encodeURIComponent(rackId),
          type: 'GET',
          dataType: 'json',
          success: function(res) {
            $('#rack_orders_loading').addClass('d-none');
            if (!res || !res.orders || res.orders.length === 0) {
              $('#rack_orders_empty').removeClass('d-none');
              return;
            }

            $('#rack_orders_table_box').removeClass('d-none');
            const tbody = $('#rack_orders_tbody');
            tbody.empty();

            res.orders.forEach(function(ord) {
              const balDue = parseFloat(ord.balance_amount) || 0;
              const balClass = balDue > 0 ? 'text-danger fw-bold' : 'text-success fw-bold';

              const tr = `
                <tr>
                  <td><a href="/order/view/${ord.id}" class="fw-bold text-primary">#${escapeHtml(ord.order_id)}</a></td>
                  <td><strong>${escapeHtml(ord.customer_name)}</strong></td>
                  <td class="small text-muted">${escapeHtml(ord.customer_phone || '---')}</td>
                  <td class="small">${ord.ready_date ? ord.ready_date.split('T')[0] : '---'}</td>
                  <td><span class="badge bg-primary-subtle text-primary border">${escapeHtml(ord.status_name || 'In Process')}</span></td>
                  <td class="${balClass}">$${balDue.toFixed(2)}</td>
                  <td class="text-end">
                    <a href="/order/view/${ord.id}" class="btn btn-xs btn-outline-primary py-1 px-2">
                      <i class="fa fa-eye me-1"></i>View
                    </a>
                  </td>
                </tr>
              `;
              tbody.append(tr);
            });
          },
          error: function() {
            $('#rack_orders_loading').addClass('d-none');
            if (typeof toastr !== 'undefined') toastr.error('Failed to load rack orders.');
          }
        });
      });

      $('#deleteRackModal').on('show.bs.modal', function(e) {
        if (e.relatedTarget) {
          populateDeleteRackModal($(e.relatedTarget));
        }
      });
    });
  </script>
</body>

</html>

