<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
  <!-- meta and links start -->
  <%- include('templet/meta')-%>
</head>

<body>
  <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
  <!--********** Content body start **********-->

  <div class="content-body">
    <div class="container-fluid" style="min-height: 100vh;">
      <%
        const isMaster = (accessdata?.logas === 'master' || (accessdata?.roll && accessdata.roll.rollType === 'master'));
        const canWriteRack = accessdata?.logas !== 'custmor' && (
          isMaster ||
          (accessdata?.roll?.orders && (accessdata.roll.orders.includes('write') || accessdata.roll.orders.includes('edit'))) ||
          (accessdata?.roll?.service && accessdata.roll.service.includes('write'))
        );
      %>
      <div class="row">
        <div class="col-12">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <h3 class="card-title mb-1 fw-bold text-dark d-flex align-items-center">
                  <i class="fa fa-layer-group text-primary me-2"></i><%= language.Racks || 'Garment Racks' %>
                </h3>
                <small class="text-muted"><%= language.Racks_Subtitle || 'Manage garment storage racks and monitor active order item counts per rack' %></small>
              </div>
              <div>
                <% if (canWriteRack) { %>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addRackModal">
                  <i class="fa fa-plus me-2"></i><%= language.Add_New_Rack || 'Add New Rack' %>
                </button>
                <% } %>
              </div>
            </div>

            <div class="card-body p-4">
              <!-- Server-side DataTable Toolbar -->
              <div class="row g-2 mb-3">
                <div class="<%= ismulty ? 'col-12 col-md-6 col-lg-6' : 'col-12 col-md-8 col-lg-9' %>">
                  <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                    <input class="form-control" type="search" id="dtRackSearch" placeholder="<%= language.Search_Racks || 'Search racks by name...' %>">
                  </div>
                </div>

                <% if (ismulty) { %>
                <div class="col-6 col-md-3 col-lg-3">
                  <select class="form-select" id="dtRackStore">
                    <option value="all"><%= language.All_Store || 'All Stores' %></option>
                    <% (storeList || []).forEach(function(st) { %>
                    <option value="<%= st.id %>"><%= st.name %></option>
                    <% }) %>
                  </select>
                </div>
                <% } %>

                <div class="<%= ismulty ? 'col-6 col-md-3 col-lg-3' : 'col-12 col-md-4 col-lg-3' %>">
                  <select class="form-select" id="dtRackPageLength">
                    <option value="10">10 <%= language.Entries || 'entries' %></option>
                    <option value="25">25 <%= language.Entries || 'entries' %></option>
                    <option value="50">50 <%= language.Entries || 'entries' %></option>
                    <option value="100">100 <%= language.Entries || 'entries' %></option>
                  </select>
                </div>
              </div>

              <div class="table-responsive">
                <table id="server_racks_table" class="table display server-side-dt" style="width: 100%;">
                  <thead>
                    <tr>
                      <th style="width: 60px;">#</th>
                      <th><%= language.Rack_Name || 'Rack Name' %></th>
                      <th><%= language.Number_of_Items || 'Items in Rack' %></th>
                      <th class="<%= ismulty ? '' : 'd-none' %>"><%= language.Store_Name || 'Store Name' %></th>
                      <th class="text-center" style="width: 130px;"><%= language.Action || 'Action' %></th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--********** Content body end **********-->

  <!-- Modal: Add Rack -->
  <div class="modal fade" id="addRackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">
            <i class="fa fa-plus-circle text-primary me-2"></i><%= language.Add_New_Rack || 'Add New Rack' %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form action="/order/racks/add" method="post" id="addRackForm">
          <div class="modal-body">
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label fw-bold" for="rack_name_input">
                  <%= language.Rack_Name || 'Rack Name' %> <span class="text-danger">*</span>
                </label>
                <input type="text" class="form-control" name="rack_name" id="rack_name_input" placeholder="e.g., Rack A-1, Conveyor 2, Shelf B" required>
              </div>

              <% if (ismulty) { %>
              <div class="col-12">
                <label class="form-label fw-bold" for="add_rack_store_select">
                  <%= language.Store_List || 'Store' %> <span class="text-danger">*</span>
                </label>
                <select class="form-select" name="store_id" id="add_rack_store_select" required>
                  <option value="" selected disabled>Select Store</option>
                  <% (storeList || []).forEach(function(st) { %>
                  <option value="<%= st.id %>"><%= st.name %></option>
                  <% }) %>
                </select>
              </div>
              <% } %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
            </button>
            <button type="submit" class="btn btn-primary">
              <i class="fa fa-save me-2"></i><%= language.Save || 'Save Rack' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal: Edit Rack -->
  <div class="modal fade" id="editRackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">
            <i class="fas fa-pencil-alt text-primary me-2"></i><%= language.Edit_Rack || 'Edit Rack' %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form action="" method="post" id="editRackForm">
          <div class="modal-body">
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label fw-bold" for="rack_name_update">
                  <%= language.Rack_Name || 'Rack Name' %> <span class="text-danger">*</span>
                </label>
                <input type="text" class="form-control" name="rack_name_update" id="rack_name_update" placeholder="Enter Rack Name" required>
              </div>

              <% if (ismulty) { %>
              <div class="col-12">
                <label class="form-label fw-bold" for="edit_rack_store_select">
                  <%= language.Store_List || 'Store' %> <span class="text-danger">*</span>
                </label>
                <select class="form-select" name="store_id_update" id="edit_rack_store_select" required>
                  <% (storeList || []).forEach(function(st) { %>
                  <option value="<%= st.id %>"><%= st.name %></option>
                  <% }) %>
                </select>
              </div>
              <% } %>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
            </button>
            <button type="submit" class="btn btn-primary">
              <i class="fa fa-save me-2"></i><%= language.Save || 'Save Changes' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal: Delete Rack Confirmation -->
  <div class="modal fade" id="deleteRackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 430px;">
      <div class="modal-content text-center p-3" style="border-radius: 16px;">
        <div class="modal-body pt-4">
          <div class="mb-3">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.12); display: inline-flex; align-items: center; justify-content: center; color: #ef4444; font-size: 28px;">
              <i class="fa fa-trash-alt"></i>
            </div>
          </div>
          <h4 class="mb-2 fw-bold text-dark"><%= language.Delete_Rack || 'Delete Rack' %></h4>
          <p class="text-muted mb-1" id="deleteRackPromptText"><%= language.Are_you_sure_delete || 'Are you sure you want to delete this rack?' %></p>
          <p class="fw-bold text-danger fs-5 mb-2" id="deleteRackModalTitle"></p>
          <div id="deleteRackInUseAlert" class="alert alert-warning text-start small py-2 px-3 mb-3 d-none">
            <i class="fa fa-lock me-1"></i>
            <span id="deleteRackInUseMsg"></span>
          </div>
          <p class="text-xs text-muted mb-4" id="deleteRackSubtext"><%= language.Action_cannot_be_undone || 'This action cannot be undone.' %></p>
          <div class="d-flex gap-2 justify-content-center">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
              <i class="fa fa-times me-2"></i><%= language.Cancel || 'Cancel' %>
            </button>
            <a href="#" id="deleteRackConfirmBtn" class="btn btn-danger">
              <i class="fa fa-trash me-2"></i><%= language.Delete || 'Yes, Delete' %>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('templet/footer')-%>
  </div>
  <%- include('templet/script')-%>

  <script>
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    $(document).ready(function() {
      const isMultistore = <%= ismulty ? 'true' : 'false' %>;

      const columns = [
        {
          data: null,
          orderable: false,
          searchable: false,
          render: function(data, type, row, meta) {
            return meta.settings._iDisplayStart + meta.row + 1;
          }
        },
        {
          data: 'rack_name',
          render: function(data, type, row) {
            return '<div class="d-flex align-items-center gap-2">' +
              '<span class="badge bg-primary-subtle text-primary border px-2 py-1"><i class="fa fa-layer-group"></i></span>' +
              '<span class="fw-bold text-dark fs-6">' + escapeHtml(data) + '</span>' +
              '</div>';
          }
        },
        {
          data: 'itemCount',
          orderable: false,
          render: function(data, type, row) {
            const items = parseInt(row.itemCount || 0, 10);
            const orders = parseInt(row.orderCount || 0, 10);
            if (orders > 0) {
              const orderLinks = (row.activeOrders || []).slice(0, 4).map(function(o) {
                return '<a href="/order/view/' + o.id + '" class="text-primary fw-semibold text-decoration-none">#' + escapeHtml(o.order_id) + '</a>';
              }).join(', ') + ((row.activeOrders && row.activeOrders.length > 4) ? ' +' + (row.activeOrders.length - 4) + ' more' : '');

              return '<div class="d-flex flex-column gap-1">' +
                '<div class="d-flex align-items-center gap-2 flex-wrap">' +
                '<span class="badge bg-success text-white px-2 py-1"><i class="fa fa-tshirt me-1"></i>' + items + ' ' + (items === 1 ? 'Item' : 'Items') + '</span>' +
                '<span class="badge bg-info-subtle text-info border px-2 py-1">' + orders + ' Active ' + (orders === 1 ? 'Order' : 'Orders') + '</span>' +
                '</div>' +
                (orderLinks ? '<div class="small text-muted">Orders: ' + orderLinks + '</div>' : '') +
                '</div>';
            }
            return '<span class="badge bg-light-subtle text-muted border px-2 py-1">0 Items (Empty)</span>';
          }
        },
        {
          data: 'store_name',
          visible: isMultistore,
          render: function(data) {
            return '<span class="badge bg-light-subtle text-dark border px-2 py-1">' + escapeHtml(data || 'Store') + '</span>';
          }
        },
        {
          data: null,
          orderable: false,
          searchable: false,
          className: 'text-center',
          render: function(data, type, row) {
            const editBtn = row.canEdit ? (
              '<button type="button" class="btn-dt-action btn-edit btn-edit-rack" ' +
              'data-bs-toggle="modal" data-bs-target="#editRackModal" ' +
              'data-id="' + row.id + '" ' +
              'data-name="' + escapeHtml(row.rack_name || '') + '" ' +
              'data-storeid="' + (row.store_id || '') + '" ' +
              'title="<%= language.Edit || "Edit" %>">' +
              '<i class="fas fa-pencil-alt"></i></button>'
            ) : '';

            let deleteBtn = '';
            if (row.canDelete) {
              const inUseFlag = row.inUse ? '1' : '0';
              const inUseTitle = row.inUse
                ? 'Cannot delete: Used in ' + row.orderCount + ' active order(s)'
                : '<%= language.Delete || "Delete" %>';
              deleteBtn = '<button type="button" class="btn-dt-action btn-delete btn-delete-rack ' + (row.inUse ? 'opacity-50' : '') + '" ' +
                'data-bs-toggle="modal" data-bs-target="#deleteRackModal" ' +
                'data-id="' + row.id + '" ' +
                'data-name="' + escapeHtml(row.rack_name || '') + '" ' +
                'data-inuse="' + inUseFlag + '" ' +
                'data-ordercount="' + (row.orderCount || 0) + '" ' +
                'data-itemcount="' + (row.itemCount || 0) + '" ' +
                'title="' + escapeHtml(inUseTitle) + '">' +
                '<i class="fa ' + (row.inUse ? 'fa-lock' : 'fa-trash') + '"></i></button>';
            }

            return '<div class="server-dt-actions justify-content-center">' + editBtn + deleteBtn + '</div>';
          }
        }
      ];

      window.initServerDataTable('#server_racks_table', {
        ajaxUrl: '/order/racks/data',
        columns: columns,
        searchInput: '#dtRackSearch',
        pageLengthSelect: '#dtRackPageLength',
        filterSelectors: {
          store_id: '#dtRackStore'
        },
        order: [[1, 'asc']],
        language: {
          emptyTable: '<%= language.No_Racks_Found || "No garment racks found. Click Add New Rack to create one." %>'
        }
      });

      function populateEditRackModal($btn) {
        if (!$btn || !$btn.length) return;
        const id = String($btn.attr('data-id') || '').replace(/['"]/g, '').trim();
        const name = $btn.attr('data-name') || '';
        const storeId = $btn.attr('data-storeid') || '';

        $('#editRackForm').attr('action', '/order/racks/update/' + id);
        $('#rack_name_update').val(name);
        if ($('#edit_rack_store_select').length && storeId) {
          $('#edit_rack_store_select').val(storeId);
        }
      }

      $(document).on('click', '.btn-edit-rack', function() {
        populateEditRackModal($(this));
      });

      $('#editRackModal').on('show.bs.modal', function(e) {
        if (e.relatedTarget) {
          populateEditRackModal($(e.relatedTarget));
        }
      });

      $('#editRackForm').on('submit', function(e) {
        const action = $(this).attr('action');
        if (!action || action === '' || action.includes('undefined')) {
          e.preventDefault();
          alert('Invalid destination: please re-open the dialog and try again.');
          return false;
        }
      });

      function populateDeleteRackModal($btn) {
        if (!$btn || !$btn.length) return;
        const id = String($btn.attr('data-id') || '').replace(/['"]/g, '').trim();
        const name = $btn.attr('data-name') || '';
        const inUse = String($btn.attr('data-inuse') || '0') === '1';
        const orderCount = parseInt($btn.attr('data-ordercount') || '0', 10);
        const itemCount = parseInt($btn.attr('data-itemcount') || '0', 10);

        $('#deleteRackModalTitle').text(name || ('#' + id));
        if (inUse) {
          $('#deleteRackInUseAlert').removeClass('d-none');
          $('#deleteRackInUseMsg').text(
            'This rack currently holds ' + itemCount + ' item(s) across ' + orderCount + ' active order(s). You cannot delete a rack while it is in use.'
          );
          $('#deleteRackConfirmBtn').addClass('d-none').attr('href', '#');
          $('#deleteRackSubtext').addClass('d-none');
        } else {
          $('#deleteRackInUseAlert').addClass('d-none');
          $('#deleteRackConfirmBtn').removeClass('d-none').attr('href', '/order/racks/delete/' + id);
          $('#deleteRackSubtext').removeClass('d-none');
        }
      }

      $(document).on('click', '.btn-delete-rack', function() {
        populateDeleteRackModal($(this));
      });

      $('#deleteRackModal').on('show.bs.modal', function(e) {
        if (e.relatedTarget) {
          populateDeleteRackModal($(e.relatedTarget));
        }
      });
    });
  </script>
</body>

</html>

