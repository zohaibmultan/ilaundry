<!DOCTYPE html>
<html lang="en" class="h-100">


<head>
    <!-- meta and links start -->
    <%- include('templet/meta')-%>

</head>

<body>
    <%- include('templet/preloder_topbar_sidebar',{titel: accessdata?.topbardata?.name})-%>
        <!--********** Content body start **********-->

        <div class="content-body">

            <div class="container-fluid" style="min-height: 100vh;">
                <div class="row">
                    <div class="col-12">
                        <div class="card ">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <%= language.Service_Addons %>
                                </h3>
                                <button
                                    class="btn btn-sm btn-rounded btn-primary <%= accessdata.roll.service.includes('write') ?'':'d-none' %>"
                                    data-bs-toggle="modal" data-bs-target="#service_addons">
                                    <i class="fa fa-plus color-info me-2"></i>
                                    <%= language.Add_New_Addons %>
                                </button>
                            </div>
                            <div class="d-none">
                                <input type="hiden" name="sym" value="<%= accessdata.symbol %>">
                                <input type="hiden" name="pls" value="<%= accessdata.plac %>">
                                <input type="hiden" name="thousands_separator"
                                    value="<%= accessdata.thousands_separator %>">
                            </div>
                            <div class="card-body">
                                <!-- Server-side DataTable Toolbar -->
                                <div class="server-dt-toolbar">
                                    <div class="server-dt-search">
                                        <i class="fa fa-search"></i>
                                        <input type="search" id="dtAddonSearch" placeholder="<%= language.Search || 'Search addons...' %>">
                                    </div>
                                    <div class="server-dt-filters">
                                        <select class="server-dt-select" id="dtAddonStatus">
                                            <option value="all"><%= language.All_Status || 'All Status' %></option>
                                            <option value="0"><%= language.Active || 'Active' %></option>
                                            <option value="1"><%= language.Deactive || 'Deactive' %></option>
                                        </select>

                                        <% if (ismulty) { %>
                                            <select class="server-dt-select" id="dtAddonStore">
                                                <option value="all"><%= language.All_Store || 'All Stores' %></option>
                                                <% (storeList || []).forEach(function(st) { %>
                                                    <option value="<%= st.id %>"><%= st.name %></option>
                                                <% }) %>
                                            </select>
                                        <% } %>

                                        <select class="server-dt-select" id="dtAddonPageLength">
                                            <option value="10">10 <%= language.Entries || 'entries' %></option>
                                            <option value="25">25 <%= language.Entries || 'entries' %></option>
                                            <option value="50">50 <%= language.Entries || 'entries' %></option>
                                            <option value="100">100 <%= language.Entries || 'entries' %></option>
                                        </select>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table id="server_addons_table" class="table display server-side-dt" style="width: 100%;">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th><%= language.Addons %></th>
                                                <th><%= language.Price %></th>
                                                <th class="<%= ismulty ? '': 'd-none' %>"><%= language.Store_Name %></th>
                                                <th style="width: 110px;"><%= language.Status %></th>
                                                <th class="text-center" style="width: 110px;"><%= language.Action %></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <!--********** Content body end **********-->

        <!-- Modal update -->
        <div class="modal fade" id="service_addons_update">
            <div class="modal-dialog  modal-dialog-scrollable" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Edit_Service_Addons %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="" id="updateaddon_form" method="post" class="need-validation">

                            <div class="row g-1 align-items-center">
                                <div class="form-group">
                                    <label><strong>
                                            <%= language.Addon_Name %>
                                        </strong><span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="addon_name_update"
                                        id="addon_name_update" placeholder="Enter Addon Name" required>
                                </div>

                                <div class="form-group">
                                    <label><strong>
                                            <%= language.Addon_Price %>
                                        </strong><span class="text-danger">*</span></label>
                                    <input type="flot" class="form-control" name="addon_price_update"
                                        id="addon_price_update" placeholder="Enter Addon Price" required>
                                </div>

                                <div class="form-group">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="active_addon_update"
                                            name="active_update" value="0">
                                        <label class="form-check-label" for="active_addon_update">
                                            <%= language.Is_Active %> ?
                                        </label>
                                    </div>
                                </div>
                            </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                            <%= language.Cancel %>
                        </button>
                        <button type="submit" class="btn btn-sm  btn-primary">
                            <%= language.Save %>
                        </button>
                    </div>
                    </form>



                </div>
            </div>
        </div>

        <!-- Modal add -->
        <div class="modal fade" id="service_addons">
            <div class="modal-dialog  modal-dialog-scrollable" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <%= language.Add_Service_Addons %>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/services/addaddon" method="post" class="need-validation">

                            <div class="row g-1 align-items-center">
                                <div class="form-group">
                                    <label><strong>
                                            <%= language.Addon_Name %>
                                        </strong><span class="text-danger">*</span></label>
                                    <input type="text" class="form-control " name="addon_name" id="addon_name"
                                        placeholder="Enter Addon Name" required>
                                </div>

                                <div class="form-group">
                                    <label><strong>
                                            <%= language.Addon_Price %>
                                        </strong><span class="text-danger">*</span></label>
                                    <input type="flot" class="form-control " name="addon_price" id="addon_price"
                                        placeholder="Enter Addon Price" required>
                                </div>

                                <div class="col-md-12 mb-1 <%= ismulty ? '': 'd-none' %>">
                                    <div class="form-group">
                                        <label class="form-label"><strong>
                                                <%= language.Store_List %>
                                            </strong><span class="text-danger">*</span></label>
                                        <select class="form-control wide mb-3" name="storeid" id="coupon_addon">
                                            <option value="" selected disabled> Select Store </option>
                                            <% storeList.forEach(function(x){ %>
                                                <option value="<%= x.id %>">
                                                    <%= x.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="active" name="active"
                                            value="0">
                                        <label class="form-check-label" for="active">
                                            <%= language.Is_Active %>
                                        </label>
                                    </div>
                                </div>
                            </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                            <%= language.Cancel %>
                        </button>
                        <button type="submit" class="btn btn-sm  btn-primary">
                            <%= language.Save %>
                        </button>
                    </div>

                    </form>

                </div>

            </div>
        </div>

        </div>
        <!--**********************************
            Footer start
        ***********************************-->
        <%- include('templet/footer')-%>

            <!--**********************************
            Footer end
        ***********************************-->

            </div>

            <!--********** Main wrapper end **********-->
            <%- include('templet/script')-%>


                <script>
                    function escapeHtml(str) {
                        if (!str) return '';
                        return String(str)
                          .replace(/&/g, '&amp;')
                          .replace(/</g, '&lt;')
                          .replace(/>/g, '&gt;')
                          .replace(/"/g, '&quot;')
                          .replace(/'/g, '&#039;');
                    }

                    $(document).ready(function() {
                        const isMultistore = <%= ismulty ? 'true' : 'false' %>;

                        const columns = [
                            {
                                data: null,
                                orderable: false,
                                searchable: false,
                                render: function(data, type, row, meta) {
                                    return meta.settings._iDisplayStart + meta.row + 1;
                                }
                            },
                            {
                                data: 'addon',
                                render: function(data, type, row) {
                                    return `<span class="fw-semibold text-dark">${escapeHtml(data)}</span>`;
                                }
                            },
                            {
                                data: 'price',
                                render: function(data, type, row) {
                                    return `<span class="fw-semibold">${window.formatDtCurrency(data)}</span>`;
                                }
                            },
                            {
                                data: 'store',
                                visible: isMultistore,
                                render: function(data, type, row) {
                                    return `<span class="badge light badge-light text-dark">${escapeHtml(data || 'All Stores')}</span>`;
                                }
                            },
                            {
                                data: 'status',
                                render: function(data, type, row) {
                                    if (parseInt(data) === 0) {
                                        return '<span class="badge-status-pill badge-status-active">Active</span>';
                                    } else {
                                        return '<span class="badge-status-pill badge-status-inactive">Deactive</span>';
                                    }
                                }
                            },
                            {
                                data: null,
                                orderable: false,
                                searchable: false,
                                className: 'text-center',
                                render: function(data, type, row) {
                                    const editBtn = row.canEdit ? `
                                        <a href="#" class="btn-tbl-action btn-tbl-edit" 
                                           id="services_addons_update" 
                                           data-bs-toggle="modal" 
                                           data-bs-target="#service_addons_update"
                                           data-id="${row.id}" 
                                           data-addon="${escapeHtml(row.addon)}" 
                                           data-price="${row.price}" 
                                           data-status="${row.status}"
                                           title="<%= language.Edit || 'Edit' %>">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>` : '';

                                    const deleteBtn = row.canDelete ? `
                                        <a href="/services/deletaddon/${row.id}" 
                                           class="btn-tbl-action btn-tbl-delete" 
                                           id="delete" 
                                           title="<%= language.Delete || 'Delete' %>">
                                            <i class="fa fa-trash"></i>
                                        </a>` : '';

                                    return `<div class="tbl-action-group">${editBtn}${deleteBtn}</div>`;
                                }
                            }
                        ];

                        window.initServerDataTable('#server_addons_table', {
                            ajaxUrl: '/services/addon/data',
                            columns: columns,
                            searchInput: '#dtAddonSearch',
                            pageLengthSelect: '#dtAddonPageLength',
                            filterSelectors: {
                                status: '#dtAddonStatus',
                                store_id: '#dtAddonStore'
                            },
                            order: [[0, 'desc']],
                            language: {
                                emptyTable: '<%= language.No_data_available_in_table || "No addons found" %>'
                            }
                        });

                        $('#service_addons').on('shown.bs.modal', function () {
                            $('#coupon_addon').select2({
                                dropdownParent: $('#service_addons'),
                                placeholder: 'Select Store(s)',
                                width: '100%',
                                allowClear: true
                            });
                        });
                    });
                </script>
</body>


</html>