    <!-- Early Theme Loader (Prevents FOUC) -->
    <script>
        (function () {
            try {
                function getCookie(name) {
                    var nameEQ = name + "=";
                    var ca = document.cookie.split(';');
                    for (var i = 0; i < ca.length; i++) {
                        var c = ca[i];
                        while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                        if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
                    }
                    return null;
                }
                var savedTheme = getCookie('theme_version') || localStorage.getItem('theme_version') || 'light';
                if (savedTheme === 'dark') {
                    document.documentElement.setAttribute('data-theme-version', 'dark');
                    document.documentElement.classList.add('dark-only');
                } else {
                    document.documentElement.setAttribute('data-theme-version', 'light');
                    document.documentElement.classList.remove('dark-only');
                }
            } catch (e) { }
        })();
    </script>

    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="/uploads/<%= data?.app_favicon || '' %>">
    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

