<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="iCleaners">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= data?.app_name || '' %> - Sign In
    </title>

    <!-- Early Theme Loader (Prevents FOUC) -->
    <script>
        (function () {
            try {
                function getCookie(name) {
                    var nameEQ = name + "=";
                    var ca = document.cookie.split(';');
                    for (var i = 0; i < ca.length; i++) {
                        var c = ca[i];
                        while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                        if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
                    }
                    return null;
                }
                var savedTheme = getCookie('theme_version') || localStorage.getItem('theme_version') || 'light';
                if (savedTheme === 'dark') {
                    document.documentElement.setAttribute('data-theme-version', 'dark');
                    document.documentElement.classList.add('dark-only');
                } else {
                    document.documentElement.setAttribute('data-theme-version', 'light');
                    document.documentElement.classList.remove('dark-only');
                }
            } catch (e) { }
        })();
    </script>

    <!-- Language & RTL Early Bootstrap -->
    <script>
        window.APP_LANG = "<%= typeof language_name !== 'undefined' ? language_name : 'en' %>";
        window.APP_IS_RTL = <%= typeof isRTL !== 'undefined' && isRTL ? 'true' : 'false' %>;
        window.__ = function(key, fallback) {
            var dict = <%- typeof langJson !== 'undefined' ? langJson : '{}' %>;
            return dict[key] || fallback || (key ? String(key).replace(/_/g, ' ') : '');
        };
        if (window.APP_IS_RTL) {
            document.documentElement.setAttribute('dir', 'rtl');
            document.documentElement.classList.add('rtl');
        } else {
            document.documentElement.setAttribute('dir', 'ltr');
            document.documentElement.classList.remove('rtl');
        }
    </script>

    <!-- Favicon icon -->
    <link rel="icon" type="image/png" sizes="16x16" href="/uploads/<%= data?.app_favicon || '' %>">
    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" type="text/css" href="/vendor/flag-icon.css">
    <link href="/vendor/bootstrap-select/dist/css/bootstrap-select.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/liquid-glass-theme.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Toastr -->
    <link rel="stylesheet" href="/vendor/toastr/css/toastr.min.css">
</head>

<body>
    <div class="auth-split-wrapper">
        <!-- Floating Top-Right Controls: Theme & Language -->
        <div class="auth-top-controls d-flex align-items-center gap-2">
            <!-- Language Switcher Dropdown -->
            <div class="dropdown">
                <button type="button" class="auth-theme-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="<%= language.Select_Language || 'Select Language' %>">
                    <i class="fas fa-globe text-primary"></i>
                    <span class="text-uppercase fw-bold fs-12"><%= typeof language_name !== 'undefined' ? language_name : 'en' %></span>
                </button>
                <div class="dropdown-menu dropdown-menu-end lang-glass-menu shadow-lg p-2" style="min-width: 240px; z-index: 1060;">
                    <div class="d-flex align-items-center justify-content-between pb-2 mb-2 border-bottom">
                        <span class="fs-12 fw-bold text-uppercase text-secondary"><%= language.Select_Language || 'Select Language' %></span>
                        <i class="fa fa-globe text-primary fs-12"></i>
                    </div>
                    <div class="lang-grid more_lang active">
                        <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'en') ? 'active' : '' %>" data-value="en">
                            <i class="flag-icon flag-icon-us rounded-1"></i>
                            <span class="lang-txt flex-grow-1">English</span>
                            <% if (typeof language_name !== 'undefined' && language_name === 'en') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                        </div>
                        <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'in') ? 'active' : '' %>" data-value="in">
                            <i class="flag-icon flag-icon-in rounded-1"></i>
                            <span class="lang-txt flex-grow-1">Hindi</span>
                            <% if (typeof language_name !== 'undefined' && language_name === 'in') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                        </div>
                        <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'pt') ? 'active' : '' %>" data-value="pt">
                            <i class="flag-icon flag-icon-pt rounded-1"></i>
                            <span class="lang-txt flex-grow-1">Português</span>
                            <% if (typeof language_name !== 'undefined' && language_name === 'pt') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                        </div>
                        <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'es') ? 'active' : '' %>" data-value="es">
                            <i class="flag-icon flag-icon-es rounded-1"></i>
                            <span class="lang-txt flex-grow-1">Español</span>
                            <% if (typeof language_name !== 'undefined' && language_name === 'es') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                        </div>
                        <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'fr') ? 'active' : '' %>" data-value="fr">
                            <i class="flag-icon flag-icon-fr rounded-1"></i>
                            <span class="lang-txt flex-grow-1">Français</span>
                            <% if (typeof language_name !== 'undefined' && language_name === 'fr') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                        </div>
                        <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'cn') ? 'active' : '' %>" data-value="cn">
                            <i class="flag-icon flag-icon-cn rounded-1"></i>
                            <span class="lang-txt flex-grow-1">中文</span>
                            <% if (typeof language_name !== 'undefined' && language_name === 'cn') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                        </div>
                        <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'ae') ? 'active' : '' %>" data-value="ae">
                            <i class="flag-icon flag-icon-ae rounded-1"></i>
                            <span class="lang-txt flex-grow-1">العربية</span>
                            <% if (typeof language_name !== 'undefined' && language_name === 'ae') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                        </div>
                        <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'id') ? 'active' : '' %>" data-value="id">
                            <i class="flag-icon flag-icon-id rounded-1"></i>
                            <span class="lang-txt flex-grow-1">Bahasa</span>
                            <% if (typeof language_name !== 'undefined' && language_name === 'id') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                        </div>
                        <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'ph') ? 'active' : '' %>" data-value="ph">
                            <i class="flag-icon flag-icon-ph rounded-1"></i>
                            <span class="lang-txt flex-grow-1">Filipino</span>
                            <% if (typeof language_name !== 'undefined' && language_name === 'ph') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                        </div>
                        <div class="lang-grid-item lang <%= (typeof language_name !== 'undefined' && language_name === 'uk') ? 'active' : '' %>" data-value="uk">
                            <i class="flag-icon flag-icon-uk rounded-1"></i>
                            <span class="lang-txt flex-grow-1">Ukrainian</span>
                            <% if (typeof language_name !== 'undefined' && language_name === 'uk') { %><i class="fa fa-check fs-10 text-primary ms-auto"></i><% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Theme Switcher -->
            <button type="button" class="auth-theme-btn" id="auth_theme_toggle" title="Switch Theme">
                <i class="fas fa-moon lighticon"></i>
                <i class="fas fa-sun darkicon d-none"></i>
                <span id="theme_label">Dark Mode</span>
            </button>
        </div>

        <!-- Left Canvas: Branding & Feature Highlights -->
        <div class="auth-hero-canvas">
            <div class="auth-hero-glow-1"></div>
            <div class="auth-hero-glow-2"></div>

            <div class="auth-hero-brand">
                <img src="/uploads/<%= data?.app_logo || '' %>" class="auth-hero-brand-logo"
                    alt="<%= data?.app_name || '' %> Logo">
            </div>

            <div class="auth-hero-content">
                <h1 class="auth-hero-heading">
                    Streamline your cleaning operations and POS billing.
                </h1>
                <p class="auth-hero-lead">
                    Multi-store control, high-speed POS, garment tracking, and financial analytics—engineered into one centralized executive command center.
                </p>
            </div>

            <div class="auth-hero-footer">
                <span>
                    Copyright &copy; 2026 <%= data?.app_name || '' %> All rights reserved.
                </span>
            </div>
        </div>

        <!-- Right Canvas: Auth Form -->
        <div class="auth-form-canvas">
            <div class="auth-glass-card">
                <div class="auth-card-header">
                    <a href="/">
                        <img src="/uploads/<%= data?.app_logo || '' %>" class="auth-card-logo"
                            alt="<%= data?.app_name || '' %>">
                    </a>
                    <h3 class="auth-card-title"><%= language.Sign_In_Account || 'Sign In to Your Account' %></h3>
                    <p class="auth-card-subtitle">
                        <%= language.Welcome_back || 'Welcome back' %>!
                    </p>
                </div>

                <form action="/login" method="POST" class="need-validation" id="login_form">
                    <!-- Username / Email / Number -->
                    <div class="mb-3">
                        <label class="form-label mb-1">
                            <strong><%= language.Username_Email_Phone || 'Username, Email or Phone' %></strong> 
                            <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-user text-muted"></i>
                            </span>
                            <input type="text" class="form-control" name="username" placeholder="<%= language.Enter_Username || 'Enter your username' %>" required autofocus>
                        </div>
                    </div>

                    <!-- Password with Eye Toggle -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0"><strong><%= language.Password || 'Password' %></strong> <span
                                    class="text-danger">*</span></label>
                            <a href="/forgot-password" class="fs-12 text-primary fw-semibold text-decoration-none"
                                title="Reset your password">
                                <%= language.Forgot_Password || 'Forgot Password?' %>
                            </a>
                        </div>
                        <div class="input-group position-relative">
                            <span class="input-group-text">
                                <i class="fas fa-lock text-muted"></i>
                            </span>
                            <input type="password" class="form-control pe-5 rounded-end" id="login_password" name="password" placeholder="<%= language.Enter_Password || 'Enter your password' %>" required autocomplete="current-password" style="border-top-right-radius: 0.75rem !important; border-bottom-right-radius: 0.75rem !important;">
                            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('login_password', this)" title="Toggle password visibility" aria-label="Toggle password visibility">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Remember Preference -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check custom-checkbox mb-0">
                            <input type="checkbox" class="form-check-input" id="basic_checkbox_1">
                            <label class="form-check-label fs-12 text-muted" for="basic_checkbox_1"><%= language.Remember_Preference || 'Remember my preference' %></label>
                        </div>
                    </div>

                    <!-- Sign In Submit -->
                    <button type="submit" class="auth-submit-btn" id="login_submit_btn">
                        <i class="fas fa-sign-in-alt me-1"></i> <%= language.Sign_In || 'Sign In' %>
                    </button>
                </form>

                <% if (typeof show_demo_accounts === 'undefined' || show_demo_accounts) { %>
                <!-- Quick Demo Credentials Pill Bar -->
                <div class="auth-demo-bar">
                    <div class="fs-11 fw-bold text-muted text-uppercase tracking-wider">
                        <i class="fas fa-bolt text-warning me-1"></i> <%= language.One_Click_Demo_Logins || 'One-Click Demo Logins' %>
                    </div>
                    <div class="auth-demo-pills">
                        <button type="button" class="auth-demo-pill" id="demo_master_admin"
                            title="Super Admin: admin / 123456">
                            <i class="fas fa-crown text-warning me-1"></i> Admin
                        </button>
                        <button type="button" class="auth-demo-pill" id="demo_store_manager"
                            title="Store Manager: manager / 123456">
                            <i class="fas fa-user-tie text-info me-1"></i> Manager
                        </button>
                        <button type="button" class="auth-demo-pill" id="demo_order_delete"
                            title="Order Delete: orderdelete / 123456">
                            <i class="fas fa-shield-alt text-danger me-1"></i> Order Delete
                        </button>
                        <button type="button" class="auth-demo-pill" id="demo_cashier"
                            title="Cashier: cashier / 123456">
                            <i class="fas fa-cash-register text-success me-1"></i> Cashier
                        </button>
                        <button type="button" class="auth-demo-pill" id="demo_customer"
                            title="Customer: customer / 123456">
                            <i class="fas fa-user text-primary me-1"></i> Customer
                        </button>
                    </div>
                    <div class="auth-demo-hint">
                        <i class="fas fa-key fs-10 text-muted opacity-75"></i> Default Password: <code class="auth-demo-code">123456</code>
                    </div>
                </div>
                <% } %>



                <!-- Registration Links -->
                <% const customer=(typeof rollverify !=='undefined' && rollverify) ? rollverify.find(r=> r.rollType ===
                    'customer') : null;
                    const store = (typeof rollverify !== 'undefined' && rollverify) ? rollverify.find(r => r.rollType
                    === 'store') : null;
                    let showstore = data?.type == '1' && store && store.roll_status == 'active';
                    let showcustomer = customer && customer.roll_status == 'active';
                    %>

                    <div class="text-center mt-4 pt-2 border-top">
                        <p class="fs-14 text-muted mb-2">
                            Don't have an account yet?
                        </p>
                        <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                            <a href="/register" class="btn btn-sm btn-outline-primary fw-semibold px-3 py-2 fs-14">
                                <i class="fas fa-user-plus me-1"></i> Customer Sign Up
                            </a>
                            <% if (data?.type=='1' && (typeof enable_store_signup === 'undefined' || enable_store_signup)) { %>
                                <a href="/shopregister"
                                    class="btn btn-sm btn-outline-secondary fw-semibold px-3 py-2 fs-14">
                                    <i class="fas fa-store me-1"></i> Store Sign Up
                                </a>
                                <% } %>
                        </div>
                    </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/vendor/global/global.min.js"></script>
    <script src="/vendor/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="/vendor/toastr/js/toastr.min.js"></script>
    <script>
        if (typeof toastr !== 'undefined') {
            toastr.options = toastr.options || {};
            toastr.options.closeButton = true;
            toastr.options.closeHtml = '<button type="button" class="toast-close-button" aria-label="Close">&times;</button>';
            toastr.options.progressBar = true;
            toastr.options.positionClass = "toast-bottom-right";
            toastr.options.timeOut = 5000;
            toastr.options.extendedTimeOut = 1500;
            toastr.options.newestOnTop = true;
        }
    </script>

    <!-- Theme Switcher & Interactive Scripts -->
    <script>
        function setCookie(name, value, days) {
            var expires = "";
            if (days) {
                var date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }
            document.cookie = name + "=" + (value || "") + expires + "; path=/";
        }

        function getCookie(name) {
            var nameEQ = name + "=";
            var ca = document.cookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
            }
            return null;
        }

        function applyAuthTheme(theme) {
            if (theme === 'dark') {
                $('html, body').attr('data-theme-version', 'dark').addClass('dark-only');
                $('.lighticon').addClass('d-none');
                $('.darkicon').removeClass('d-none');
                $('#theme_label').text('Light Mode');
            } else {
                $('html, body').attr('data-theme-version', 'light').removeClass('dark-only');
                $('.lighticon').removeClass('d-none');
                $('.darkicon').addClass('d-none');
                $('#theme_label').text('Dark Mode');
            }
        }

        function togglePasswordVisibility(fieldId, btn) {
            var input = document.getElementById(fieldId);
            var icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        $(document).ready(function () {
            var currentTheme = getCookie('theme_version') || localStorage.getItem('theme_version') || 'light';
            applyAuthTheme(currentTheme);

            $('#auth_theme_toggle').on('click', function (e) {
                e.preventDefault();
                var active = $('html').attr('data-theme-version');
                var newTheme = (active === 'dark') ? 'light' : 'dark';
                setCookie('theme_version', newTheme, 365);
                localStorage.setItem('theme_version', newTheme);
                applyAuthTheme(newTheme);
            });

            <% if (typeof show_demo_accounts === 'undefined' || show_demo_accounts) { %>
            // Quick Demo Credential buttons
            $('#demo_master_admin').on('click', function () {
                $('input[name=username]').val('admin');
                $('#login_password').val('123456');
                toastr.info('Loaded credentials for <b>Admin</b> (admin)', { timeOut: 2500, escapeHtml: false });
            });

            $('#demo_store_manager').on('click', function () {
                $('input[name=username]').val('manager');
                $('#login_password').val('123456');
                toastr.info('Loaded credentials for <b>Manager</b> (manager)', { timeOut: 2500, escapeHtml: false });
            });

            $('#demo_order_delete').on('click', function () {
                $('input[name=username]').val('orderdelete');
                $('#login_password').val('123456');
                toastr.info('Loaded credentials for <b>Order Delete</b> (orderdelete)', { timeOut: 2500, escapeHtml: false });
            });

            $('#demo_cashier').on('click', function () {
                $('input[name=username]').val('cashier');
                $('#login_password').val('123456');
                toastr.info('Loaded credentials for <b>Cashier</b> (cashier)', { timeOut: 2500, escapeHtml: false });
            });

            $('#demo_customer').on('click', function () {
                $('input[name=username]').val('customer');
                $('#login_password').val('123456');
                toastr.info('Loaded credentials for <b>Customer</b> (customer)', { timeOut: 2500, escapeHtml: false });
            });
            <% } %>
            // Language selector click handler
            $(document).on('click', '.lang', function () {
                var lang = $(this).attr('data-value');
                var base_url = window.location.origin;
                $.ajax({
                    url: base_url + '/lang/' + lang,
                    type: 'GET',
                    dataType: 'JSON',
                    success: function () {
                        location.reload();
                    }
                });
            });
        });
    </script>

    <!-- Toastr Notifications -->
    <% if(typeof success !=='undefined' && success && success.length> 0){ %>
        <script>
            toastr.success('<%- success %>', {
                timeOut: 8000,
                closeButton: true,
                progressBar: true,
                positionClass: "toast-bottom-right",
                escapeHtml: false
            });
        </script>
        <% } %>

            <% if(typeof error !=='undefined' && error && error.length> 0){ %>
                <script>
                    toastr.error('<%= error %>', {
                        timeOut: 6000,
                        closeButton: true,
                        progressBar: true,
                        positionClass: "toast-top-right"
                    });
                </script>
                <% } %>
</body>

</html>