# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout.
*.js text eol=lf
*.json text eol=lf
*.ejs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.env* text eol=lf
*.sql text eol=lf

# Declare binary files - do not touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

